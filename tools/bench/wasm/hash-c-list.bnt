//! SHA-256 の境界の費用を比較する（設計書 07-02「測る項目」）。
dependency WasmHash
  path "../../../crates/benitoite/testdata/packages/libraries.files/wasm-hash"
end dependency

import WasmHash.Digest
import Benitoite.Unofficial.Hash
import Benitoite.Unofficial.IO.File
import Benitoite.Unofficial.IO.Clock
import Benitoite.Unofficial.IO.Console
import Benitoite.Unofficial.IO.Process
import Runner

function main() -> Result[Unit, String] uses State, File.Read, Clock.Time, Console.Write, Process.Environment
  bind path <- try Runner.argument(0) or return
  bind count <- try Runner.rounds(1) or return
  bind bytes <- try Result.mapError(r: File.readBytes(path), f: lambda(error: IOError) -> String return IOError.message(error) end lambda) or return
  bind items <- Bytes.toList(bytes)
  return Runner.measure(count: count, work: lambda() -> Result[List[Byte], String] uses State return Result.Ok(Digest.sha256List(items)) end lambda, render: lambda(value: List[Byte]) -> String return Bytes.toHex(Bytes.fromList(value)) end lambda)
end function
