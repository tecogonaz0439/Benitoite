//! 正規表現の保持と作り直しの費用を比較する（設計書 07-02「測る項目」）。
dependency WasmRegex
  path "../../../crates/benitoite/testdata/packages/libraries.files/wasm-regex"
end dependency

import WasmRegex.Pattern
import Benitoite.Unofficial.Regex
import Benitoite.Unofficial.IO.File
import Benitoite.Unofficial.IO.Clock
import Benitoite.Unofficial.IO.Console
import Benitoite.Unofficial.IO.Process
import Runner

function main() -> Result[Unit, String] uses State, File.Read, Clock.Time, Console.Write, Process.Environment
  bind task <- try Runner.argument(0)
  bind path <- try Runner.argument(1)
  bind count <- try Runner.rounds(2)
  bind source <- "[a-z]+[0-9]+"
  bind input <- try Result.mapError(r: File.readText(path), f: lambda(error: IOError) -> String return IOError.message(error) end lambda)
  bind pattern <- try Pattern.compile(source)
  if task = "match" then
    return Runner.measure(count: count, work: lambda() -> Result[Boolean, String] uses State return Result.Ok(Pattern.isMatch(pattern: pattern, text: input)) end lambda, render: lambda(value: Boolean) -> String return if value then "true" else "false" end if end lambda)
  end if
  if task = "count" then
    return Runner.measure(count: count, work: lambda() -> Result[Integer, String] uses State return Result.Ok(Pattern.count(pattern: pattern, text: input)) end lambda, render: lambda(value) -> String return Integer.toString(value) end lambda)
  end if
  if task = "find-all" then
    return Runner.measure(count: count, work: lambda() -> Result[Integer, String] uses State return Result.Ok(List.length(Pattern.findAll(pattern: pattern, text: input))) end lambda, render: lambda(value) -> String return Integer.toString(value) end lambda)
  end if
  return Result.Error("unknown Regex task")
end function
