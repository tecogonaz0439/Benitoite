//! JSON の課題を独立したプロセスで測る（設計書 07-02「測る項目」）。
import Benitoite.Unofficial.Json
import Benitoite.Unofficial.IO.File
import Benitoite.Unofficial.IO.Clock
import Benitoite.Unofficial.IO.Console
import Benitoite.Unofficial.IO.Process
import Runner

function read(value: Json.Value) -> String
  bind row <- Option.unwrapOr(Json.at(value, 0), Json.Value.Null)
  return Json.stringify(Json.Value.Array(List.map(["id", "label", "nested"], lambda(key: String) -> Json.Value
    return Option.unwrapOr(Json.get(row, key), Json.Value.Null)
  end lambda)))
end function

function main() -> Result[Unit, String] uses State, File.Read, Clock.Time, Console.Write, Process.Environment
  bind task <- try Runner.argument(0)
  bind path <- try Runner.argument(1)
  bind count <- try Runner.rounds(2)
  bind source <- try Result.mapError(File.readText(path), lambda(e: IOError) -> String return IOError.message(e) end lambda)
  if task = "deep" then
    bind value <- List.fold(List.range(0, 1000), Json.Value.Null, lambda(v: Json.Value, _i: Integer) -> Json.Value return Json.Value.Array([v]) end lambda)
    return Runner.measure(1, lambda() -> Result[String, String] uses State return Result.Ok(Json.stringify(value)) end lambda, lambda(s: String) -> String return s end lambda)
  end if
  if task = "parse" then
    return Runner.measure(count, lambda() -> Result[Json.Value, String] uses State return Result.mapError(Json.parse(source), Json.ParseError.message) end lambda, Json.stringify)
  end if
  if task = "stringify" then
    bind value <- try Result.mapError(Json.parse(source), Json.ParseError.message)
    return Runner.measure(count, lambda() -> Result[String, String] uses State return Result.Ok(Json.stringify(value)) end lambda, lambda(s: String) -> String return s end lambda)
  end if
  if task = "read" then
    return Runner.measure(count, lambda() -> Result[String, String] uses State
      bind value <- try Result.mapError(Json.parse(source), Json.ParseError.message)
      return Result.Ok(read(value))
    end lambda, lambda(s: String) -> String return s end lambda)
  end if
  if task = "pretty" then
    return Runner.measure(count, lambda() -> Result[String, String] uses State
      bind value <- try Result.mapError(Json.parse(source), Json.ParseError.message)
      return Result.Ok(Json.stringifyPretty(value))
    end lambda, lambda(s: String) -> String return s end lambda)
  end if
  if task = "validate" then
    return Runner.measure(count, lambda() -> Result[Unit, String] uses State return Result.map(Result.mapError(Json.parse(source), Json.ParseError.message), lambda(_value: Json.Value) -> Unit return () end lambda) end lambda, lambda(_value: Unit) -> String return "valid" end lambda)
  end if
  if task = "canonical" then
    bind value <- try Result.mapError(Json.parse(source), Json.ParseError.message)
    Console.writeLine(Json.stringify(value))
    return Result.Ok(())
  end if
  if task = "verify" then
    bind value <- try Result.mapError(Json.parse(source), Json.ParseError.message)
    return Runner.measure(1, lambda() -> Result[String, String] uses State return Result.Ok(Json.stringify(value)) end lambda, lambda(s: String) -> String return s end lambda)
  end if
  return Result.Error("unknown JSON task")
end function
