;; 代入した欄を ABI の独立した配置で変更し、同じ誤りを共有する往復を避ける。
(component
  (core module $m
    (memory (export "memory") 1)
    (func (export "realloc") (param i32 i32 i32 i32) (result i32) i32.const 1024)
    (func (export "box") (param i64) (result i64)
      local.get 0 i64.const 7 i64.add)
    (func (export "envelope") (param i32 i64) (result i32)
      i32.const 0 local.get 0 i32.store8
      i32.const 8 local.get 1 i64.const 9 i64.add i64.store i32.const 0)
    (func (export "phantom") (param i32))
    (func (export "result") (param i32 i64)))
  (core instance $i (instantiate $m))
  (type $box0 (record (field "value" s64)))
  (export $box "box-type" (type $box0))
  (type $nested0 (record (field "value" $box)))
  (export $nested "nested-type" (type $nested0))
  (type $envelope0 (variant (case "wrapped" s64) (case "empty")))
  (export $envelope "envelope-type" (type $envelope0))
  (type $phantom0 (enum "empty"))
  (export $phantom "phantom-type" (type $phantom0))
  (type $result0 (record (field "value" (result (error s64)))))
  (export $result "result-type" (type $result0))
  (func (export "box") (param "v" $box) (result $box)
    (canon lift (core func $i "box") (memory (core memory $i "memory")) (realloc (core func $i "realloc"))))
  (func (export "nested") (param "v" $nested) (result $nested)
    (canon lift (core func $i "box") (memory (core memory $i "memory")) (realloc (core func $i "realloc"))))
  (func (export "envelope") (param "v" $envelope) (result $envelope)
    (canon lift (core func $i "envelope") (memory (core memory $i "memory")) (realloc (core func $i "realloc"))))
  (func (export "phantom") (param "v" $phantom) (canon lift (core func $i "phantom")))
  (func (export "result") (param "v" $result) (canon lift (core func $i "result"))))
