//! 選択ビットと全選択の結果を照合する flags の比較入力。
import Benitoite.Unofficial.IO.Console
import Benitoite.Unofficial.IO.Process
import Runner

data D1
  F1
end data

@external("wasm", "guests/flags.wasm", "f1")
function f1(v: Set[D1]) -> Pair[Set[D1], Integer]
data D8
  F1
  F2
  F3
  F4
  F5
  F6
  F7
  F8
end data

@external("wasm", "guests/flags.wasm", "f8")
function f8(v: Set[D8]) -> Pair[Set[D8], Integer]
data D9
  F1
  F2
  F3
  F4
  F5
  F6
  F7
  F8
  F9
end data

@external("wasm", "guests/flags.wasm", "f9")
function f9(v: Set[D9]) -> Pair[Set[D9], Integer]
data D16
  F1
  F2
  F3
  F4
  F5
  F6
  F7
  F8
  F9
  F10
  F11
  F12
  F13
  F14
  F15
  F16
end data

@external("wasm", "guests/flags.wasm", "f16")
function f16(v: Set[D16]) -> Pair[Set[D16], Integer]
data D17
  F1
  F2
  F3
  F4
  F5
  F6
  F7
  F8
  F9
  F10
  F11
  F12
  F13
  F14
  F15
  F16
  F17
end data

@external("wasm", "guests/flags.wasm", "f17")
function f17(v: Set[D17]) -> Pair[Set[D17], Integer]
data D32
  F1
  F2
  F3
  F4
  F5
  F6
  F7
  F8
  F9
  F10
  F11
  F12
  F13
  F14
  F15
  F16
  F17
  F18
  F19
  F20
  F21
  F22
  F23
  F24
  F25
  F26
  F27
  F28
  F29
  F30
  F31
  F32
end data

@external("wasm", "guests/flags.wasm", "f32")
function f32(v: Set[D32]) -> Pair[Set[D32], Integer]
@external("wasm", "guests/flags.wasm", "clear")
function clear(v: Set[D32]) -> Set[D32]
function main() -> Result[Unit, String] uses Console.Write, Process.Environment
  bind Pair(n, rounds) <- try Runner.settings() or return
  bind source1 <- Set.fromList(List.take(xs: [D1.F1], n: n))
  bind expected1 <- Pair(Set.fromList([D1.F1]), Integer.shiftLeft(a: 1, n: Integer.minimum(a: n, b: 1)) - 1)
  bind source8 <- Set.fromList(List.take(xs: [D8.F1, D8.F2, D8.F3, D8.F4, D8.F5, D8.F6, D8.F7, D8.F8], n: n))
  bind expected8 <- Pair(Set.fromList([D8.F1, D8.F2, D8.F3, D8.F4, D8.F5, D8.F6, D8.F7, D8.F8]), Integer.shiftLeft(a: 1, n: Integer.minimum(a: n, b: 8)) - 1)
  bind source9 <- Set.fromList(List.take(xs: [D9.F1, D9.F2, D9.F3, D9.F4, D9.F5, D9.F6, D9.F7, D9.F8, D9.F9], n: n))
  bind expected9 <- Pair(Set.fromList([D9.F1, D9.F2, D9.F3, D9.F4, D9.F5, D9.F6, D9.F7, D9.F8, D9.F9]), Integer.shiftLeft(a: 1, n: Integer.minimum(a: n, b: 9)) - 1)
  bind source16 <- Set.fromList(List.take(xs: [D16.F1, D16.F2, D16.F3, D16.F4, D16.F5, D16.F6, D16.F7, D16.F8, D16.F9, D16.F10, D16.F11, D16.F12, D16.F13, D16.F14, D16.F15, D16.F16], n: n))
  bind expected16 <- Pair(Set.fromList([D16.F1, D16.F2, D16.F3, D16.F4, D16.F5, D16.F6, D16.F7, D16.F8, D16.F9, D16.F10, D16.F11, D16.F12, D16.F13, D16.F14, D16.F15, D16.F16]), Integer.shiftLeft(a: 1, n: Integer.minimum(a: n, b: 16)) - 1)
  bind source17 <- Set.fromList(List.take(xs: [D17.F1, D17.F2, D17.F3, D17.F4, D17.F5, D17.F6, D17.F7, D17.F8, D17.F9, D17.F10, D17.F11, D17.F12, D17.F13, D17.F14, D17.F15, D17.F16, D17.F17], n: n))
  bind expected17 <- Pair(Set.fromList([D17.F1, D17.F2, D17.F3, D17.F4, D17.F5, D17.F6, D17.F7, D17.F8, D17.F9, D17.F10, D17.F11, D17.F12, D17.F13, D17.F14, D17.F15, D17.F16, D17.F17]), Integer.shiftLeft(a: 1, n: Integer.minimum(a: n, b: 17)) - 1)
  bind source32 <- Set.fromList(List.take(xs: [D32.F1, D32.F2, D32.F3, D32.F4, D32.F5, D32.F6, D32.F7, D32.F8, D32.F9, D32.F10, D32.F11, D32.F12, D32.F13, D32.F14, D32.F15, D32.F16, D32.F17, D32.F18, D32.F19, D32.F20, D32.F21, D32.F22, D32.F23, D32.F24, D32.F25, D32.F26, D32.F27, D32.F28, D32.F29, D32.F30, D32.F31, D32.F32], n: n))
  bind expected32 <- Pair(Set.fromList([D32.F1, D32.F2, D32.F3, D32.F4, D32.F5, D32.F6, D32.F7, D32.F8, D32.F9, D32.F10, D32.F11, D32.F12, D32.F13, D32.F14, D32.F15, D32.F16, D32.F17, D32.F18, D32.F19, D32.F20, D32.F21, D32.F22, D32.F23, D32.F24, D32.F25, D32.F26, D32.F27, D32.F28, D32.F29, D32.F30, D32.F31, D32.F32]), Integer.shiftLeft(a: 1, n: Integer.minimum(a: n, b: 32)) - 1)

  return Runner.verify(rounds: rounds, work: lambda() -> Boolean
    bind c0 <- f1(source1) = expected1
    bind c1 <- f8(source8) = expected8
    bind c2 <- f9(source9) = expected9
    bind c3 <- f16(source16) = expected16
    bind c4 <- f17(source17) = expected17
    bind c5 <- f32(source32) = expected32
    bind c6 <- clear(source32) = Set.empty()
    return c0 and c1 and c2 and c3 and c4 and c5 and c6
  end lambda)
end function
