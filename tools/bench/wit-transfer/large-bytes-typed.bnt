//! 既存の型と構文だけで Bytes を渡し、開始前の版と比較する入力。
import Benitoite.Unofficial.IO.Console
import Benitoite.Unofficial.IO.Process
import Runner

@external("wasm", "guests/primitives.wasm", "bytes")
function bytes(v: Bytes) -> Bytes

function main() -> Result[Unit, String] uses Console.Write, Process.Environment
  bind Pair(n, rounds) <- try Runner.settings()
  bind low <- try Option.okOr(o: Byte.fromInteger(0), error: "byte out of range")
  bind middle <- try Option.okOr(o: Byte.fromInteger(128), error: "byte out of range")
  bind high <- try Option.okOr(o: Byte.fromInteger(255), error: "byte out of range")
  bind flippedMiddle <- try Option.okOr(o: Byte.fromInteger(127), error: "byte out of range")
  bind source <- Bytes.fromList(List.map(xs: List.range(start: 0, stop: n), f: lambda(value: Integer) -> Byte
 return
    if value mod 3 = 0 then low else if value mod 3 = 1 then middle else high end if
  end lambda))
  bind expected <- Bytes.fromList(List.map(xs: List.range(start: 0, stop: n), f: lambda(value: Integer) -> Byte
 return
    if value mod 3 = 0 then high else if value mod 3 = 1 then flippedMiddle else low end if
  end lambda))

  return Runner.verify(rounds: rounds, work: lambda() -> Boolean
    bind typed <- bytes(source)
    return typed = expected
  end lambda)
end function
