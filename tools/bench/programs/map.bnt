import Benitoite.Unofficial.IO.Console
import Benitoite.Unofficial.IO.Process

function keys(count: Integer, seed: Integer, values: List[Integer]) -> List[Integer]
  return if count = 0 then values else
    bind next <- (seed * 48271 + 11) mod 2147483647
    keys(count: count - 1, seed: next, values: List.append(xs: values, x: next))
  end if
end function

function removeKeys(values: List[Integer], index: Integer, m: Map[Integer, Integer], s: Set[Integer]) -> Pair[Map[Integer, Integer], Set[Integer]]
  return match List.get(xs: values, i: index) with
    case Option.None -> Pair(m, s)
    case Option.Some(key) -> removeKeys(values: values, index: index + 2, m: Map.remove(m: m, k: key), s: Set.remove(s: s, x: key))
  end match
end function

function main() -> Result[Unit, String] uses Console.Write, Process.Environment
  return match Option.map(o: List.get(xs: Process.arguments(), i: 0), f: lambda(value) return Integer.parse(value) end lambda) |> Option.unwrapOr(o: _, fallback: Option.None) with
    case Option.None -> Result.Error("expected a non-negative key count")
    case Option.Some(count) -> if count < 0 then Result.Error("expected a non-negative key count") else
      bind values <- keys(count: count, seed: 1, values: [])
      bind m <- List.fold(xs: values, initial: Map.empty(), f: lambda(acc, value) return Map.set(m: acc, k: value, value: value) end lambda)
      bind s <- List.fold(xs: values, initial: Set.empty(), f: lambda(acc, value) return Set.add(s: acc, x: value) end lambda)
      bind mapFound <- List.fold(xs: values, initial: 0, f: lambda(acc, value)
        return acc + match Map.get(m: m, k: value) with
          case Option.Some(_) -> 1
          case Option.None -> 0
        end match
      end lambda)
      bind setFound <- List.fold(xs: values, initial: 0, f: lambda(acc, value) return acc + if Set.contains(s: s, x: value) then 1 else 0 end if end lambda)
      bind remaining <- removeKeys(values: values, index: 0, m: m, s: s)
      Console.writeLine(Integer.toString(Map.size(Pair.first(remaining))))
      Console.writeLine(Integer.toString(Set.size(Pair.second(remaining))))
      Console.writeLine(Integer.toString(mapFound))
      Console.writeLine(Integer.toString(setFound))
      Result.Ok(())
    end if
  end match
end function
