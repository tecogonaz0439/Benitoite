import Benitoite.Unofficial.IO.Console
import Benitoite.Unofficial.IO.Process

function readCount() -> Result[Integer, String] uses Process.Environment
  return match List.head(Process.arguments()) with
    case Option.None -> Result.Error("expected one non-negative integer argument")
    case Option.Some(argument) -> match Integer.parse(argument) with
      case Option.None -> Result.Error("expected one non-negative integer argument")
      case Option.Some(count) -> if count < 0 then
        Result.Error("expected one non-negative integer argument")
      else
        Result.Ok(count)
      end if
    end match
  end match
end function

data Tree
  Leaf(Integer)
  Branch(Tree, Tree)
end data

function buildTree(depth: Integer) -> Tree
  return if depth = 0 then
    Tree.Leaf(1)
  else
    Tree.Branch(buildTree(depth - 1), buildTree(depth - 1))
  end if
end function

function sumLeaves(tree: Tree) -> Integer
  return match tree with
    case Tree.Leaf(value) -> value
    case Tree.Branch(left, right) -> sumLeaves(left) + sumLeaves(right)
  end match
end function

function churn(count: Integer, total: Integer) -> Integer
  return if count = 0 then total else
    bind values <- List.range(0, 128)
    bind text <- String.repeat("x", 1024)
    churn(count - 1, total + List.length(values) + String.byteLength(text))
  end if
end function
function keep(tree: Tree) -> Integer
  bind temporary <- churn(2000, 0)
  return temporary + sumLeaves(tree)
end function

function main() -> Result[Unit, String] uses Console.Write, Process.Environment
  return match readCount() with
    case Result.Error(message) -> Result.Error(message)
    case Result.Ok(count) ->
      Console.writeLine(Integer.toString(keep(buildTree(count))))
      Result.Ok(())
  end match
end function
