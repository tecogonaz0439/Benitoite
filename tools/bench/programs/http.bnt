import Benitoite.Unofficial.Network.Http
import Benitoite.Unofficial.IO.Console
import Benitoite.Unofficial.IO.Process

function readInteger(index: Integer) -> Result[Integer, String] uses Process.Environment
  return match List.get(xs: Process.arguments(), i: index) with
    case Option.None -> Result.Error("expected non-negative integer arguments")
    case Option.Some(argument) -> match Integer.parse(argument) with
      case Option.Some(n) -> if n >= 0 then Result.Ok(n) else Result.Error("expected non-negative integer arguments") end if
      case Option.None -> Result.Error("expected non-negative integer arguments")
    end match
  end match
end function

function compute(done: Reference[Boolean], value: Integer) -> Unit uses State
  // 終了の印を読むまでは計算し続け、呼び出しの予算による切り替えを測る（設計書 07-02）。
  return if Reference.get(done) then () else compute(done: done, value: (value * 17 + 11) mod 65521) end if
end function

function serve(listener: Http.Listener, group: TaskGroup, count: Integer, tasks: List[Task[Result[Unit, String]]]) -> Result[Unit, String] uses Http.Listen, State
  return if count = 0 then
    List.fold(xs: tasks, initial: Result.Ok(()), f: lambda(acc, value)
      bind _ <- try acc or return
      return Task.await(value)
    end lambda)
  else
    bind exchange <- try Http.accept(listener) |> Result.mapError(r: _, f: lambda(error) return NetworkError.message(error) end lambda) or return
    bind task <- TaskGroup.spawn(group: group, action: lambda()
      with current = exchange do
        return Http.respond(exchange: current, response: Http.text(status: 200, s: "ok")) |> Result.mapError(r: _, f: lambda(error) return NetworkError.message(error) end lambda)
      end with
    end lambda)
    serve(listener: listener, group: group, count: count - 1, tasks: List.append(xs: tasks, x: task))
  end if
end function

function main() -> Result[Unit, String] uses Http.Listen, Console.Write, Process.Environment, State
  bind count <- try readInteger(0) or return
  bind busy <- try readInteger(1) or return
  with listener = try Http.listen(host: "127.0.0.1", port: 0) |> Result.mapError(r: _, f: lambda(error) return NetworkError.message(error) end lambda) or return, group = TaskGroup.open() do
    bind done <- Reference.new(false)
    bind worker <- TaskGroup.spawn(group: group, action: lambda()
      return if busy = 0 then () else compute(done: done, value: 1) end if
    end lambda)
    Console.writeLine(Integer.toString(Http.listenerPort(listener)))
    bind result <- serve(listener: listener, group: group, count: count, tasks: [])
    Reference.set(reference: done, value: true)
    Task.await(worker)
    return result
  end with
end function
