import Benitoite.Unofficial.IO.Console
import Benitoite.Unofficial.IO.Process

data Expr
  Lit(Integer)
  Add(Expr, Expr)
  Inc(Expr)
  Scale(Expr, Integer)
end data

function readCount() -> Result[Integer, String] uses Process.Environment
  return match List.head(Process.arguments()) with
    case Option.None -> Result.Error("expected one non-negative integer argument")
    case Option.Some(argument) -> match Integer.parse(argument) with
      case Option.None -> Result.Error("expected one non-negative integer argument")
      case Option.Some(count) -> if count < 0 then
        Result.Error("expected one non-negative integer argument")
      else
        Result.Ok(count)
      end if
    end match
  end match
end function

function buildExpression(depth: Integer) -> Expr
  return if depth = 0 then
    Expr.Lit(1)
  else
    bind smaller <- buildExpression(depth - 1)
    match Integer.floorModulo(depth, 3) with
      case 0 -> Expr.Add(smaller, Expr.Lit(depth))
      case 1 -> Expr.Inc(smaller)
      case _ -> Expr.Scale(smaller, 1)
    end match
  end if
end function

function evaluate(expression: Expr) -> Integer
  return match expression with
    case Expr.Lit(value) -> value
    case Expr.Add(left, right) -> evaluate(left) + evaluate(right)
    case Expr.Inc(inner) -> evaluate(inner) + 1
    case Expr.Scale(inner, factor) -> evaluate(inner) * factor
  end match
end function

// 式の深さは固定し、入力の回数だけ評価を繰り返す。深さを入力にすると、比較対象の処理系の再帰の上限に先に達するからである。
function repeatEvaluate(expression: Expr, count: Integer, total: Integer) -> Integer
  return if count = 0 then
    total
  else
    repeatEvaluate(expression, count - 1, total + evaluate(expression))
  end if
end function

function main() -> Result[Unit, String] uses Console.Write, Process.Environment
  return match readCount() with
    case Result.Error(message) -> Result.Error(message)
    case Result.Ok(count) ->
      Console.writeLine(Integer.toString(repeatEvaluate(buildExpression(500), count, 0)))
      Result.Ok(())
  end match
end function
