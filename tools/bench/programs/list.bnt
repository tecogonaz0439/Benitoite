fn readCount() -> Result[Int, String] uses IO {
  match List.head(Process.args()) {
    None => Err("expected one non-negative integer argument")
    Some(argument) => match Int.parse(argument) {
      None => Err("expected one non-negative integer argument")
      Some(count) => if count < 0 {
        Err("expected one non-negative integer argument")
      } else {
        Ok(count)
      }
    }
  }
}

fn main() -> Result[Unit, String] uses IO {
  match readCount() {
    Err(message) => Err(message)
    Ok(count) => {
      let values = List.range(0, count)
      let mapped = List.map(values, fn(value) { value * 3 })
      let filtered = List.filter(mapped, fn(value) { Int.mod(value, 2) == 0 })
      let total = List.fold(filtered, 0, fn(accumulator, value) { accumulator + value })
      Console.println(Int.toString(total))
      Ok(())
    }
  }
}
