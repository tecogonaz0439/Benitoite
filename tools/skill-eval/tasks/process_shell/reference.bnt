import Benitoite.Unofficial.IO.Console
import Benitoite.Unofficial.IO.Process

function main() -> Result[Unit, String] uses Process.Run, Console.Write
  bind errors <- try Process.shell("grep ' ERROR ' app.log | cut -d ' ' -f 3 | LC_ALL=C sort -u") |> Result.mapError(_, IOError.message)
  bind components <- String.lines(Process.Output.standardOutput(errors))
  List.forEach(components, lambda(name) Console.writeLine(name) end lambda)
  Console.writeLine("components with errors: ${List.length(components)}")
  bind fatal <- try Process.shell("grep -q ' FATAL ' app.log") |> Result.mapError(_, IOError.message)
  bind code <- Process.Output.exitCode(fatal)
  Console.writeLine(if code = 0 then "FATAL lines: found" else "FATAL lines: none (grep exit code ${code})" end if)
  return Result.Ok(())
end function
