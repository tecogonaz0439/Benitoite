import Benitoite.Unofficial.IO.Console
import Benitoite.Unofficial.IO.File

function numbered(items: List[String], index: Integer, acc: List[String]) -> List[String]
  return match items with
    case [] -> List.reverse(acc)
    case [first, ..rest] -> numbered(rest, index + 1, List.prepend(acc, "${index}. ${first}"))
  end match
end function

function main() -> Result[Unit, String] uses File.Read, File.Write, Console.Write
  bind lines <- try File.readLines("todo.txt") |> Result.mapError(_, IOError.message)
  bind items <- List.filter(List.map(lines, String.trim), lambda(line) return line <> "" end lambda)
  bind output <- String.join(numbered(items, 1, []), "\n") + "\n"
  bind _ <- try File.writeText("todo-numbered.txt", output) |> Result.mapError(_, IOError.message)
  Console.writeLine("wrote ${List.length(items)} items to todo-numbered.txt")
  return Result.Ok(())
end function
