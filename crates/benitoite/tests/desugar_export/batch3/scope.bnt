import Benitoite.Unofficial.Scope

function checkedHost() -> Result[Scope.CheckedHost, Scope.ScopeError]
  return Scope.checkHost(pattern: "*.EXAMPLE.COM", host: "API.EXAMPLE.COM")
end function

function checkedPath() -> Result[Scope.CheckedPath, Scope.ScopeError]
  return Scope.checkPath(pattern: "/資料/**", path: "/資料/*.txt")
end function

function checkedEndpoint() -> Result[Scope.CheckedEndpoint, Scope.ScopeError]
  return Scope.checkEndpoint(hostPattern: "**.example.com", host: "a.b.example.com", minimumPort: 0, maximumPort: 65535, port: 65535)
end function

function endpointPort(value: Scope.CheckedEndpoint) -> Integer
  return Scope.endpointPort(value)
end function

function dynamicHost(pattern: String, host: String) -> Result[Scope.CheckedHost, Scope.ScopeError]
  return Scope.checkHost(pattern: pattern, host: host)
end function
