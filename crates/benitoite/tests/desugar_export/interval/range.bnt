import Benitoite.Unofficial.Range

function lower() -> Result[Range.CheckedInteger, Range.RangeError]
  return Range.checkInteger(value: 0, maximum: 10, minimum: 0)
end function

function lowerValue() -> Integer
  return match Range.checkInteger(value: 0, maximum: 10, minimum: 0) with
    case Result.Ok(checked) -> Range.value(value: checked)
    case Result.Error(_) -> -99
  end match
end function

function upper() -> Result[Range.CheckedInteger, Range.RangeError]
  return Range.checkInteger(value: 10, maximum: 10, minimum: 0)
end function

function upperValue() -> Integer
  return match Range.checkInteger(value: 10, maximum: 10, minimum: 0) with
