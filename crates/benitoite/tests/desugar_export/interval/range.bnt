function nestedInner() -> Integer
  return match Range.checkInteger(value: 5, maximum: 10, minimum: 0) with
    case Result.Ok(outer) ->
      match Range.checkInteger(value: 105, maximum: 110, minimum: 100) with
        case Result.Ok(inner) -> Range.value(value: inner)
        case Result.Error(_) -> -99
      end match
    case Result.Error(_) -> -99
  end match
end function

function nestedOuter() -> Integer
  return match Range.checkInteger(value: 5, maximum: 10, minimum: 0) with
    case Result.Ok(outer) ->
      match Range.checkInteger(value: 105, maximum: 110, minimum: 100) with
        case Result.Ok(inner) -> Range.value(value: outer)
        case Result.Error(_) -> -99
      end match
    case Result.Error(_) -> -99
  end match
end function

function unrelated(other: Range.CheckedInteger) -> Integer
  return match Range.checkInteger(value: 5, maximum: 10, minimum: 0) with
    case Result.Ok(checked) -> Range.value(value: other)
    case Result.Error(_) -> -99
  end match
end function

function unrelatedCaller() -> Integer
  return match Range.checkInteger(value: 105, maximum: 110, minimum: 100) with
    case Result.Ok(other) -> unrelated(other: other)
    case Result.Error(_) -> -99
  end match
end function

function threeFields(checked: Range.CheckedInteger) -> List[Integer]
  return [Range.minimum(value: checked), Range.maximum(value: checked), Range.value(value: checked)]
end function

function increment() -> Integer
  return match Range.checkInteger(value: 9, maximum: 9, minimum: 0) with
    case Result.Ok(checked) -> Range.value(value: checked) + 1
    case Result.Error(_) -> -99
  end match
end function

