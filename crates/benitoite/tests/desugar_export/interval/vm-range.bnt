function importedAlias() -> Integer
  return match R.checkInteger(value: 5, maximum: 10, minimum: 0) with
    case Result.Ok(checked) -> R.value(value: checked)
    case Result.Error(_) -> -99
  end match
end function

function savedResult() -> Integer
  bind result <- Range.checkInteger(value: 5, maximum: 10, minimum: 0)
  return match result with
    case Result.Ok(checked) -> Range.value(value: checked)
    case Result.Error(_) -> -99
  end match
end function

function argumentOrder() -> Result[Range.CheckedInteger, Range.RangeError]
  return Range.checkInteger(value: 2 + 3, maximum: 9 + 1, minimum: 1 - 1)
end function

function firstArgumentFailure() -> Result[Range.CheckedInteger, Range.RangeError]
  return Range.checkInteger(value: 8 div 0, maximum: 9 + 1, minimum: 1 - 1)
end function

function secondArgumentFailure() -> Result[Range.CheckedInteger, Range.RangeError]
  return Range.checkInteger(value: 2 + 3, maximum: 8 div 0, minimum: 1 - 1)
end function

function argumentReturn() -> Integer
  bind _ <- Range.checkInteger(value: (block
    return 42
  end block), maximum: 9 + 1, minimum: 1 - 1)
  return 0
end function
