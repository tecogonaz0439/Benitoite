// spec: 01-02 文法
// spec: 01-01 改行による区切り
import Benitoite.Unofficial.IO.Console

function main() -> Unit uses Console.Write
  bind price <- 7
  bind quantity <- 6
  bind total <- price
    * quantity

  bind count <- [1, 2, 3]
    |> List.filter(lambda(value: Integer) return value > 1 end lambda)
    |> List.length

  return if true then
    Console.writeLine(Integer.toString(total + count))
  else
    Console.writeLine("bad")
  end if
end function
