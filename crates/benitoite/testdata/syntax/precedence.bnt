// spec: 01-02 演算子の優先順位と結合性
import Benitoite.Unofficial.IO.Console

function main() -> Unit uses Console.Write
  Console.writeLine(Integer.toString(1 + 2 * 3))
  Console.writeLine(Integer.toString(-2 * 3))
  bind a <- false
  bind b <- true
  bind c <- false
  if not a and b then
    Console.writeLine("true")
  else
    Console.writeLine("false")
  end if
  return if a or b and c then
    Console.writeLine("true")
  else
    Console.writeLine("false")
  end if
end function
