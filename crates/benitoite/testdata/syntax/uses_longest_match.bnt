// spec: 01-02 文法
import Benitoite.Unofficial.IO.Console

function accepts(callback: function((function() -> Unit uses Console.Write), Integer) -> Unit) -> Unit
  return ()
end function

function returnsCallback() -> function() -> Unit uses Console.Write
  return lambda() -> Unit uses Console.Write return Console.writeLine("callback") end lambda
end function

function main() -> Unit
  return ()
end function
