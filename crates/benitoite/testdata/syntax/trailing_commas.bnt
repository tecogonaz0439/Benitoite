// spec: 01-02 文法
// spec: 01-02 プログラムと宣言
import Benitoite.Unofficial.IO.Console

function identity[T,](value: T,) -> T
  return value
end function
function count[T,](values: List[T,]) -> Integer
  return List.length(values)
end function
function add(left: Integer, right: Integer,) -> Integer
  return left + right
end function

function main() -> Unit uses Console.Write
  bind values <- [3, 4,]
  return Console.writeLine(Integer.toString(add(identity(1,), identity(2,),) + count(values)))
end function
