// spec: 01-02 部分適用のプレースホルダ
import Benitoite.Unofficial.IO.Console

function clamp(low: Integer, value: Integer, high: Integer) -> Integer
  return if value < low then low else if value > high then high else value end if
end function

function between(low: Integer, value: Integer, high: Integer) -> Boolean
  return value >= low and value <= high
end function

function applyToNine(callback: function(Integer) -> Integer) -> Integer
  return callback(9)
end function
function useFunction(f: function(function(Integer) -> Integer) -> Integer, g: function(Integer) -> Integer) -> Integer
  return f(g(_))
end function

function main() -> Unit uses Console.Write
  bind clampMiddle <- clamp(0, _, 100)
  bind inRange <- between(_, 5, _)
  bind nested <- useFunction(applyToNine, lambda(value: Integer) return value + 1 end lambda)
  Console.writeLine(Integer.toString(clampMiddle(80) + nested))
  return if inRange(3, 8) then
    Console.writeLine("true")
  else
    Console.writeLine("false")
  end if
end function
