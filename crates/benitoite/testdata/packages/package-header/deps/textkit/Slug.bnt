language "0.0.3"
/// 前後の空白を除き、小文字にし、空白の連なりを "-" にする。"  Hello World " は "hello-world" になる。
public function slug(text: String) -> String
  bind words <- String.split(String.toLowercase(String.trim(text)), " ")
    |> List.filter(_, lambda(w) return w <> "" end lambda)
  return String.join(words, "-")
end function

/// 文字数が width を超えるときは、width 文字で切って "..." を付ける。
public function truncate(text: String, width: Integer) -> String
  if String.characterCount(text) <= width then
    return text
  end if
  return Option.unwrapOr(String.characterSlice(text, 0, width), text) + "..."
end function
