language "0.0.6"
/// 前後の空白を除き、小文字にし、空白の連なりを "-" にする。"  Hello World " は "hello-world" になる。
public function slug(text: String) -> String
  bind words <- String.split(s: String.toLowercase(String.trim(text)), separator: " ")
    |> List.filter(xs: _, p: lambda(value) return value <> "" end lambda)
  return String.join(xs: words, separator: "-")
end function

/// 文字数が width を超えるときは、width 文字で切って "..." を付ける。
public function truncate(text: String, width: Integer) -> String
  if String.characterCount(text) <= width then
    return text
  end if
  return Option.unwrapOr(o: String.characterSlice(s: text, start: 0, stop: width), fallback: text) + "..."
end function
