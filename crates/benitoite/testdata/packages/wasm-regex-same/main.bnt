// spec: 01-02 外部の関数の宣言
// 関門: 実際のゲストとパッケージを CLI で使い、組み込み版との契約を比べる。
// 空の一致・バイト位置・置換・診断の違いは型変換のテストだけでは捕まらない。
dependency WasmRegex
  path "../libraries.files/wasm-regex"
end dependency
import Benitoite.Trait
import Benitoite.Unofficial.Regex
import Benitoite.Unofficial.Json
import Benitoite.Unofficial.IO.Console
import WasmRegex.Pattern

function native(m: Regex.Match) -> Triple[String, Integer, Integer]
  return Triple(Regex.matchText(m), Regex.matchByteStart(m), Regex.matchByteEnd(m))
end function

function guest(m: Pattern.Found) -> Triple[String, Integer, Integer]
  return Triple(Pattern.matchText(m), Pattern.matchByteStart(m), Pattern.matchByteEnd(m))
end function

function quoted(s: String) -> String
  return Json.stringify(Json.Value.String(s))
end function

function compare(source: String, text: String) -> Result[Unit, String] uses State, Console.Write
  bind a <- Regex.compile(source)
  bind c <- Pattern.compile(source)
  return match Pair(a, c) with
    case Pair(Result.Error(x), Result.Error(y)) ->
      bind pure <- Pattern.isMatchOnce(source, text) = Result.Error(x) and Pattern.findAllOnce(source, text) = Result.Error(x) and Pattern.countOnce(source, text) = Result.Error(x)
      Console.writeLine("error " + quoted(x) + " | resource=${x = y} pure=${pure}")
      if x = y and pure then Result.Ok(()) else Result.Error("compile mismatch") end if
    case Pair(Result.Ok(x), Result.Ok(y)) ->
      bind am <- Regex.isMatch(x, text)
      bind first <- Option.map(Regex.find(x, text), native)
      bind all <- List.map(Regex.findAll(x, text), native)
      bind replacement <- Regex.replaceAll(x, text, "$1\\literal")
      bind resource <- Pattern.isMatch(y, text) = am and Option.map(Pattern.find(y, text), guest) = first and List.map(Pattern.findAll(y, text), guest) = all and Pattern.replaceAll(y, text, "$1\\literal") = replacement and Pattern.count(y, text) = List.length(all)
      bind reused <- Pattern.isMatch(y, text) = am and List.map(Pattern.findAll(y, text), guest) = all
      bind pure <- Pattern.isMatchOnce(source, text) = Result.Ok(am) and Result.map(Pattern.findAllOnce(source, text), lambda(matches: List[Pattern.Found]) -> List[Triple[String, Integer, Integer]] return List.map(matches, guest) end lambda) = Result.Ok(all) and Pattern.countOnce(source, text) = Result.Ok(List.length(all))
      Console.writeLine(quoted(source) + " " + quoted(text) + " | A=${am} first=${Trait.Show.show(first)} all=${Trait.Show.show(all)} replace=" + quoted(replacement) + " | resource=${resource} reused=${reused} pure=${pure}")
      if resource and reused and pure then Result.Ok(()) else Result.Error("match mismatch") end if
    case _ -> Result.Error("compile status mismatch")
  end match
end function

function main() -> Result[Unit, String] uses State, Console.Write
  bind cases <- [Pair("[a-z]+", "one 12 two"), Pair("a*", "aa日b"), Pair("\\b", "é 日"), Pair("", "é😀"), Pair("(.)", "é😀"), Pair("\\w+", "日本語 café"), Pair("z+", "abc"), Pair("a*", ""), Pair("(", "x"), Pair("[", "x"), Pair(String.repeat("é", 2100) + "(", "x")]
  return List.fold(cases, Result.Ok(()), lambda(acc: Result[Unit, String], pair: Pair[String, String]) -> Result[Unit, String] uses State, Console.Write
    bind _ <- try acc
    return compare(Pair.first(pair), Pair.second(pair))
  end lambda)
end function
