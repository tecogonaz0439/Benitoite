//! 明示の作業列で深い JSON の値を書く（設計書 03-08「Json」）。
import Benitoite.Unofficial.Json
import Parts
import Strings
import Numbers

// 要素をすべて積まず、現在の並びと位置を保存して作業列の長さを抑える。
data Work
  Done
  Visit(Json.Value, Integer, Work)
  Items(List[Json.Value], Boolean, Integer, Work)
  Members(List[Pair[String, Json.Value]], Integer, Integer, Work)
end data

/// 明示の作業列で JSON を書く。
public(package) function write(value: Json.Value, pretty: Boolean) -> String
  return writeFrom(work: Work.Visit(value, 0, Work.Done), parts: Parts.empty(), pretty: pretty)
end function

function indent(depth: Integer, pretty: Boolean) -> String
  return if pretty then "\n" + String.repeat(s: "  ", n: depth) else "" end if
end function

function writeFrom(work: Work, parts: Parts.Buffer, pretty: Boolean) -> String
  return match work with
    case Work.Done -> Parts.finish(parts)
    case Work.Items(items, first, depth, rest) ->
      match items with
        case [] -> writeFrom(work: rest, parts: Parts.append(parts: parts, part: indent(depth: depth - 1, pretty: pretty) + "]"), pretty: pretty)
        case [value, ..remaining] ->
          bind before <- (if first then "" else "," end if) + indent(depth: depth, pretty: pretty)
          writeFrom(work: Work.Visit(value, depth, Work.Items(remaining, false, depth, rest)), parts: Parts.append(parts: parts, part: before), pretty: pretty)
      end match
    case Work.Members(members, i, depth, rest) ->
      match List.get(xs: members, i: i) with
        case Option.None -> writeFrom(work: rest, parts: Parts.append(parts: parts, part: indent(depth: depth - 1, pretty: pretty) + "}"), pretty: pretty)
        case Option.Some(Pair(key, value)) ->
          bind before <- (if i = 0 then "" else "," end if) + indent(depth: depth, pretty: pretty) + Strings.quoted(key) + (if pretty then ": " else ":" end if)
          writeFrom(work: Work.Visit(value, depth, Work.Members(members, i + 1, depth, rest)), parts: Parts.append(parts: parts, part: before), pretty: pretty)
      end match
    case Work.Visit(value, depth, rest) ->
      match value with
        case Json.Value.Null -> writeFrom(work: rest, parts: Parts.append(parts: parts, part: "null"), pretty: pretty)
        case Json.Value.Boolean(b) -> writeFrom(work: rest, parts: Parts.append(parts: parts, part: if b then "true" else "false" end if), pretty: pretty)
        case Json.Value.Integer(n) -> writeFrom(work: rest, parts: Parts.append(parts: parts, part: Integer.toString(n)), pretty: pretty)
        case Json.Value.Float(n) -> writeFrom(work: rest, parts: Parts.append(parts: parts, part: Numbers.written(n)), pretty: pretty)
        case Json.Value.String(s) -> writeFrom(work: rest, parts: Parts.append(parts: parts, part: Strings.quoted(s)), pretty: pretty)
        case Json.Value.Array(items) ->
          match items with
            case [] -> writeFrom(work: rest, parts: Parts.append(parts: parts, part: "[]"), pretty: pretty)
            case _ -> writeFrom(work: Work.Items(items, true, depth + 1, rest), parts: Parts.append(parts: parts, part: "["), pretty: pretty)
          end match
        case Json.Value.Object(members) ->
          if Map.size(members) = 0 then
            writeFrom(work: rest, parts: Parts.append(parts: parts, part: "{}"), pretty: pretty)
          else
            writeFrom(work: Work.Members(Map.toList(members), 0, depth + 1, rest), parts: Parts.append(parts: parts, part: "{"), pretty: pretty)
          end if
      end match
  end match
end function
