//! JSON の構文の誤りの文言を一か所に置く（設計書 03-08「Json」）。

public(package) const eofList: String = "EOF while parsing a list"
public(package) const eofObject: String = "EOF while parsing an object"
public(package) const eofString: String = "EOF while parsing a string"
public(package) const eofValue: String = "EOF while parsing a value"
public(package) const colon: String = "expected `:`"
public(package) const listEnd: String = "expected `,` or `]`"
public(package) const objectEnd: String = "expected `,` or `}`"
public(package) const ident: String = "expected ident"
public(package) const value: String = "expected value"
public(package) const escape: String = "invalid escape"
public(package) const number: String = "invalid number"
public(package) const range: String = "number out of range"
public(package) const unicode: String = "invalid unicode code point"
public(package) const control: String = "control character (\\u0000-\\u001F) found while parsing a string"
public(package) const key: String = "key must be a string"
public(package) const surrogate: String = "lone leading surrogate in hex escape"
public(package) const comma: String = "trailing comma"
public(package) const trailing: String = "trailing characters"
public(package) const hexEnd: String = "unexpected end of hex escape"
public(package) const depth: String = "recursion limit exceeded"
