//! JSON の文字列と UTF-16 のエスケープを読む（設計書 03-08「Json」）。
import Benitoite.Unofficial.Json
import Scan
import Text
import Parts

/// 引用符の中身を復号し、閉じる引用符の直後を返す。
public(package) function read(input: Scan.Input, start: Integer) -> Result[Pair[String, Integer], Json.ParseError]
  return readFrom(input: input, start: start, i: start, parts: Parts.empty())
end function

// エスケープのない区間は一度で切り出し、非 ASCII のバイトを一文字ずつ復号しない。
function readFrom(input: Scan.Input, start: Integer, i: Integer, parts: Parts.Buffer) -> Result[Pair[String, Integer], Json.ParseError]
  bind b <- Scan.byte(input: input, position: i)
  if b = -1 then return Result.Error(Scan.eof(input: input, message: Text.eofString)) end if
  if b = 34 then
    return Result.Ok(Pair(Parts.finish(Parts.append(parts: parts, part: Scan.slice(input: input, start: start, stop: i))), i + 1))
  end if
  if b < 32 then return Result.Error(Scan.error(input: input, consumed: i + 1, message: Text.control)) end if
  if b = 92 then
    bind Pair(part, next) <- try escape(input: input, i: i + 1)
    return readFrom(input: input, start: next, i: next, parts: Parts.append(parts: Parts.append(parts: parts, part: Scan.slice(input: input, start: start, stop: i)), part: part))
  end if
  return readFrom(input: input, start: start, i: i + 1, parts: parts)
end function

function escape(input: Scan.Input, i: Integer) -> Result[Pair[String, Integer], Json.ParseError]
  return match Scan.byte(input: input, position: i) with
    case -1 -> Result.Error(Scan.eof(input: input, message: Text.eofString))
    case 34 -> Result.Ok(Pair("\"", i + 1))
    case 92 -> Result.Ok(Pair("\\", i + 1))
    case 47 -> Result.Ok(Pair("/", i + 1))
    case 98 -> Result.Ok(Pair("\u{08}", i + 1))
    case 102 -> Result.Ok(Pair("\u{0c}", i + 1))
    case 110 -> Result.Ok(Pair("\n", i + 1))
    case 114 -> Result.Ok(Pair("\r", i + 1))
    case 116 -> Result.Ok(Pair("\t", i + 1))
    case 117 -> unicode(input: input, i: i + 1)
    case _ -> Result.Error(Scan.error(input: input, consumed: i + 1, message: Text.escape))
  end match
end function

function hex(b: Integer) -> Integer
  return if Scan.digit(b) then b - 48 else if b >= 65 and b <= 70 then b - 55 else if b >= 97 and b <= 102 then b - 87 else -1 end if
end function

function fourHex(input: Scan.Input, i: Integer) -> Result[Integer, Json.ParseError]
  if i + 4 > Scan.Input.length(input) then return Result.Error(Scan.eof(input: input, message: Text.eofString)) end if
  bind a <- hex(Scan.byte(input: input, position: i))
  bind b <- hex(Scan.byte(input: input, position: i + 1))
  bind c <- hex(Scan.byte(input: input, position: i + 2))
  bind d <- hex(Scan.byte(input: input, position: i + 3))
  return if a < 0 or b < 0 or c < 0 or d < 0 then
    Result.Error(Scan.error(input: input, consumed: i + 4, message: Text.escape))
  else
    Result.Ok(a * 4096 + b * 256 + c * 16 + d)
  end if
end function

function unicode(input: Scan.Input, i: Integer) -> Result[Pair[String, Integer], Json.ParseError]
  bind n <- try fourHex(input: input, i: i)
  if n >= 56320 and n <= 57343 then return Result.Error(Scan.error(input: input, consumed: i + 4, message: Text.surrogate)) end if
  if n < 55296 or n > 56319 then return scalar(input: input, n: n, next: i + 4) end if
  bind next <- i + 4
  if Scan.byte(input: input, position: next) = -1 then return Result.Error(Scan.eof(input: input, message: Text.eofString)) end if
  if Scan.byte(input: input, position: next) <> 92 then return Result.Error(Scan.error(input: input, consumed: next + 1, message: Text.hexEnd)) end if
  if Scan.byte(input: input, position: next + 1) = -1 then return Result.Error(Scan.eof(input: input, message: Text.eofString)) end if
  if Scan.byte(input: input, position: next + 1) <> 117 then return Result.Error(Scan.error(input: input, consumed: next + 2, message: Text.hexEnd)) end if
  bind low <- try fourHex(input: input, i: next + 2)
  if low < 56320 or low > 57343 then return Result.Error(Scan.error(input: input, consumed: next + 6, message: Text.surrogate)) end if
  return scalar(input: input, n: (n - 55296) * 1024 + low - 56320 + 65536, next: next + 6)
end function

function scalar(input: Scan.Input, n: Integer, next: Integer) -> Result[Pair[String, Integer], Json.ParseError]
  return match Character.fromInteger(n) with
    case Option.Some(c) -> Result.Ok(Pair(Character.toString(c), next))
    case Option.None -> Result.Error(Scan.error(input: input, consumed: next, message: Text.unicode))
  end match
end function

/// JSON の引用符とエスケープを付ける。
public(package) function quoted(source: String) -> String
  return quoteFrom(input: Scan.input(source), start: 0, i: 0, parts: Parts.append(parts: Parts.empty(), part: "\""))
end function

function quoteFrom(input: Scan.Input, start: Integer, i: Integer, parts: Parts.Buffer) -> String
  bind b <- Scan.byte(input: input, position: i)
  if b = -1 then return Parts.finish(Parts.append(parts: Parts.append(parts: parts, part: Scan.slice(input: input, start: start, stop: i)), part: "\"")) end if
  if b = 34 or b = 92 or b < 32 then
    bind escaped <- match b with
      case 34 -> "\\\""
      case 92 -> "\\\\"
      case 8 -> "\\b"
      case 12 -> "\\f"
      case 10 -> "\\n"
      case 13 -> "\\r"
      case 9 -> "\\t"
      case _ -> "\\u00" + hexDigit(b div 16) + hexDigit(b mod 16)
    end match
    return quoteFrom(input: input, start: i + 1, i: i + 1, parts: Parts.append(parts: Parts.append(parts: parts, part: Scan.slice(input: input, start: start, stop: i)), part: escaped))
  end if
  return quoteFrom(input: input, start: start, i: i + 1, parts: parts)
end function

function hexDigit(n: Integer) -> String
  return Option.unwrapOr(o: String.byteSlice(s: "0123456789abcdef", start: n, stop: n + 1), fallback: "")
end function
