import Benitoite.Unofficial.IO.File

/// 作業の一件。
public record Item
  done: Boolean
  title: String
end record

/// ファイルを読み、作業の一覧を返す。形の合わない行は読み飛ばす。
public function load(path: String) -> Result[List[Item], IOError] uses File.Read
  bind text <- try File.readText(path)
  bind items <- List.fold(xs: String.lines(text), initial: [], f: lambda(acc: List[Item], value: String) -> List[Item]
    return match parseLine(value) with
      case Option.Some(item) -> List.append(xs: acc, x: item)
      case Option.None -> acc
    end match
  end lambda)
  return Result.Ok(items)
end function

/// 作業の一覧をファイルに書く。
public function save(path: String, items: List[Item]) -> Result[Unit, IOError] uses File.Write
  bind text <- String.join(xs: List.map(xs: items, f: lambda(value) return formatLine(value) end lambda), separator: "\n") + "\n"
  return File.writeText(path: path, text: text)
end function

/// title の作業を済みにした一覧を返す。
public function complete(items: List[Item], title: String) -> List[Item]
  return List.map(xs: items, f: lambda(value)
    if Item.title(value) = title then
      return Item(..value, done: true)
    end if
    return value
  end lambda)
end function

function parseLine(line: String) -> Option[Item]
  bind rest <- Option.unwrapOr(o: String.characterSlice(s: line, start: 4, stop: String.characterCount(line)), fallback: "")
  if String.startsWith(s: line, prefix: "[x] ") then
    return Option.Some(Item(done: true, title: rest))
  end if
  if String.startsWith(s: line, prefix: "[ ] ") then
    return Option.Some(Item(done: false, title: rest))
  end if
  return Option.None
end function

function formatLine(item: Item) -> String
  bind mark <- if Item.done(item) then "[x]" else "[ ]" end if
  return "${mark} ${Item.title(item)}"
end function
