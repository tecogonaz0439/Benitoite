// spec: 01-03 依存のパッケージの取り込み
dependency Textkit
  path "deps/textkit"
end dependency
import Benitoite.Unofficial.IO.Console
import Textkit.Slug
function main() -> Unit uses Console.Write
  Console.writeLine(Slug.slug("  Hello   World "))
  Console.writeLine(Slug.truncate("こんにちは世界", 5))
end function
