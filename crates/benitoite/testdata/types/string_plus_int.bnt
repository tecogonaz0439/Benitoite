// spec: 01-06 演算子の型付け
// spec: 01-04 String
// spec: 01-04 型の変換
function main() -> Unit
    bind integer: Integer <- 4
    bind decimal: Float <- 2.5
    bind character: Character <- 'x'
    bind _ <- "n = " + integer
    bind _ <- "n = " + decimal
    bind _ <- "n = " + character
    return ()
end function
