// spec: 01-06 等値の型
// spec: 01-06 型
data Nest[T]
    Leaf(T)
    Deep(Nest[List[T]])
end data

function main() -> Unit
    bind number <- Nest.Leaf(1)
    bind _ <- number = number
    bind callback <- Nest.Leaf(lambda() return () end lambda)
    bind _ <- callback = callback
    return ()
end function
