// spec: 01-06 等値の型
// spec: 01-05 prelude が定める型
// spec: 01-04 型の一覧
import Benitoite.Unofficial.IO.Console

function show_bool(value: Boolean) -> String
    return if value then "true" else "false" end if
end function

data Wrapped[T]
    WrappedValue(T)
end data

function main() -> Unit uses Console.Write
    bind value <- Wrapped.WrappedValue([1, 2])
    Console.writeLine(show_bool(value = Wrapped.WrappedValue([1, 2])))
    Console.writeLine(show_bool([1, 2] = [1, 2]))
    return Console.writeLine(show_bool(Option.Some(0.0 / 0.0) = Option.Some(0.0 / 0.0)))
end function
