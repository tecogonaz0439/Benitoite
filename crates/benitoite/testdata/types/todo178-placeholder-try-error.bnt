// spec: 01-02 部分適用のプレースホルダ
// 関門: 生成する関数の戻り値と継続の境界を CLI の結果・診断で確かめる。
function add(a: Integer, b: Integer) -> Integer
  return a + b
end function
function probe() -> Option[Integer]
  bind f <- add(try Option.None, _)
  bind _ <- Integer.toString(f(1))
  return Option.Some(1)
end function
function main() -> Unit
end function
