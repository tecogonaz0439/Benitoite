// spec: 01-06 等値の型
// spec: 01-06 型
import Benitoite.Unofficial.IO.Console

function show_bool(value: Boolean) -> String
    return if value then "true" else "false" end if
end function

data Nest[T]
    Leaf(T)
    Deep(Nest[List[T]])
end data

function main() -> Unit uses Console.Write
    bind number <- Nest.Leaf(1)
    return Console.writeLine(show_bool(number = number))
end function
