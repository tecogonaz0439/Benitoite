// spec: 01-06 演算子の型付け
import Benitoite.Unofficial.IO.Console

function main() -> Unit uses Console.Write
    bind add <- lambda(left, right) return left + right end lambda
    Console.writeLine(Integer.toString(add(left: 1, right: 2)))
    return Console.writeLine(Integer.toString(add(left: 3, right: 4)))
end function
