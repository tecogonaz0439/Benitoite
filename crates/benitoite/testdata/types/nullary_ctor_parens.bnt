// spec: 01-05 値の構築
// spec: 01-05 パターン
// spec: 01-05 prelude が定める型
data Tree
    Leaf
    Branch
end data

function bad_pattern(value: Tree) -> Unit
    return match value with
        case Tree.Leaf() -> ()
        case Tree.Branch -> ()
    end match
end function

function main() -> Unit
    bind _ <- Tree.Leaf()
    bind _ <- Option.None()
    return ()
end function
