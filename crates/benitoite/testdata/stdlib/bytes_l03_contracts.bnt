// spec: 01-06 等値の型
// spec: 01-06 鍵の型（初回リリース版）
// 設計書 03-06「Bytes と ByteOrder（初回リリース版）」。
// 関門: 型検査・構造の等しさ・Map の鍵順への接続をスクリプトで確かめる。
import Benitoite.Trait
import Benitoite.Unofficial.IO.Console
function main() -> Unit uses Console.Write
  bind bytes <- Bytes.fromHex("0102") |> Option.unwrapOr(o: _, fallback: Bytes.empty())
  bind binary <- Bytes.fromBinary("00000001 00000010") |> Option.unwrapOr(o: _, fallback: Bytes.empty())
  bind integers <- Bytes.fromIntegers([1, 2]) |> Option.unwrapOr(o: _, fallback: Bytes.empty())
  bind copied <- Bytes.fromList(Bytes.toList(bytes))
  Console.writeLine(Trait.Show.show(bytes = binary and binary = integers and copied = bytes and bytes <> Bytes.empty()))
  bind one <- Bytes.fromHex("01") |> Option.unwrapOr(o: _, fallback: Bytes.empty())
  bind two <- Bytes.fromHex("02") |> Option.unwrapOr(o: _, fallback: Bytes.empty())
  bind zero <- Bytes.fromHex("00ff") |> Option.unwrapOr(o: _, fallback: Bytes.empty())
  bind high <- Bytes.fromHex("ff") |> Option.unwrapOr(o: _, fallback: Bytes.empty())
  bind m <- Map.fromList([Pair(high, 9), Pair(bytes, 2), Pair(two, 3), Pair(one, 1), Pair(zero, 0), Pair(Bytes.empty(), -1), Pair(binary, 20)])
  Console.writeLine(String.join(xs: List.map(xs: Map.keys(m), f: lambda(value) return Bytes.toHex(value) end lambda), separator: ","))
  Console.writeLine(Trait.Show.show(Map.values(m) = [-1, 0, 1, 20, 3, 9] and Map.get(m: m, k: integers) = Option.Some(20)))
  bind encoded <- Bytes.fromSigned(n: -129, count: 2, order: ByteOrder.LittleEndian) |> Option.unwrapOr(o: _, fallback: Bytes.empty())
  bind unsigned <- Bytes.fromUnsigned(n: 258, count: 2, order: ByteOrder.BigEndian) |> Option.unwrapOr(o: _, fallback: Bytes.empty())
  bind utf8 <- String.toUTF8("é")
  Console.writeLine(Trait.Show.show(Bytes.readSigned(b: encoded, offset: 0, count: 2, order: ByteOrder.LittleEndian) = Option.Some(-129) and Bytes.toHex(encoded) = "7fff" and Bytes.readUnsigned(b: unsigned, offset: 0, count: 2, order: ByteOrder.BigEndian) = Option.Some(258) and Bytes.toBinary(one) = "00000001" and Bytes.get(b: bytes, i: 1) = Byte.fromInteger(2) and Bytes.slice(b: bytes, start: 1, stop: 2) = Option.Some(two) and Bytes.concatenate(a: one, b: two) = bytes and Bytes.length(utf8) = 2 and String.fromUTF8(utf8) = Option.Some("é")))
end function
