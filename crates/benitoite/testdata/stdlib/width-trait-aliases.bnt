// 作成時の関門: 別名モジュールの全転送関数と同一の型クラス辞書の選択を守る。
// 元のモジュールの試験は別名の関数を呼ばず、ここでは独立した期待値を使う。
import Benitoite.Trait
import Benitoite.Unofficial.IO.Console

function showInteger64(x: Integer64.Integer64) -> String
  return Trait.Show.show(x)
end function

function showFloat64(x: Float64.Float64) -> String
  return Trait.Show.show(x)
end function

function showUnsignedInteger8(x: UnsignedInteger8.UnsignedInteger8) -> String
  return Trait.Show.show(x)
end function

function showUnsignedInteger(x: UnsignedInteger.UnsignedInteger) -> String
  return Trait.Show.show(x)
end function

function main() -> Unit uses Console.Write
  Console.writeLine(Trait.Show.show(Integer64.toString(-42)))
  Console.writeLine(Trait.Show.show(Integer64.parse("42")))
  Console.writeLine(Trait.Show.show(Integer64.toFloat(42)))
  Console.writeLine(Trait.Show.show(Integer64.floorDivide(-7, 3)))
  Console.writeLine(Trait.Show.show(Integer64.floorModulo(-7, 3)))
  Console.writeLine(Trait.Show.show(Integer64.absolute(-42)))
  Console.writeLine(Trait.Show.show(Integer64.minimum(-1, 1)))
  Console.writeLine(Trait.Show.show(Integer64.maximum(-1, 1)))
  Console.writeLine(Trait.Show.show(Integer64.bitwiseAnd(12, 10)))
  Console.writeLine(Trait.Show.show(Integer64.bitwiseOr(12, 10)))
  Console.writeLine(Trait.Show.show(Integer64.bitwiseExclusiveOr(12, 10)))
  Console.writeLine(Trait.Show.show(Integer64.bitwiseNot(0)))
  Console.writeLine(Trait.Show.show(Integer64.shiftLeft(1, 63)))
  Console.writeLine(Trait.Show.show(Integer64.shiftRight(-8, 1)))
  Console.writeLine(Trait.Show.show(Integer64.shiftRightUnsigned(-8, 1)))
  Console.writeLine(Trait.Show.show(Float64.toString(-0.0)))
  Console.writeLine(Trait.Show.show(Float64.parse("1.5")))
  Console.writeLine(Trait.Show.show(Float64.truncate(-1.5)))
  Console.writeLine(Trait.Show.show(Float64.isNaN(0.0 / 0.0)))
  Console.writeLine(Trait.Show.show(Float64.absolute(-1.5)))
  Console.writeLine(Trait.Show.show(Float64.floor(-1.5)))
  Console.writeLine(Trait.Show.show(Float64.ceiling(-1.5)))
  Console.writeLine(Trait.Show.show(Float64.round(-0.5)))
  Console.writeLine(Trait.Show.show(Float64.squareRoot(4.0)))
  Console.writeLine(Trait.Show.show(UnsignedInteger8.fromInteger(255)))
  Console.writeLine(Trait.Show.show(UnsignedInteger8.toInteger(255u8)))
  Console.writeLine(Trait.Show.show(UnsignedInteger8.toString(255u8)))
  Console.writeLine(Trait.Show.show(UnsignedInteger8.bitwiseAnd(12u8, 10u8)))
  Console.writeLine(Trait.Show.show(UnsignedInteger8.bitwiseOr(12u8, 10u8)))
  Console.writeLine(Trait.Show.show(UnsignedInteger8.bitwiseExclusiveOr(12u8, 10u8)))
  Console.writeLine(Trait.Show.show(UnsignedInteger8.bitwiseNot(0u8)))
  Console.writeLine(Trait.Show.show(UnsignedInteger8.shiftLeft(255u8, 7)))
  Console.writeLine(Trait.Show.show(UnsignedInteger8.shiftRight(255u8, 7)))
  Console.writeLine(Trait.Show.show(UnsignedInteger.fromInteger(42)))
  Console.writeLine(Trait.Show.show(UnsignedInteger.toInteger(18446744073709551615u64)))
  Console.writeLine(Trait.Show.show(UnsignedInteger.parse("18446744073709551615")))
  Console.writeLine(Trait.Show.show(UnsignedInteger.toString(18446744073709551615u64)))
  Console.writeLine(Trait.Show.show(UnsignedInteger.toFloat(42u64)))
  Console.writeLine(Trait.Show.show(UnsignedInteger.toDecimal(18446744073709551615u64)))
  Console.writeLine(Trait.Show.show(UnsignedInteger.fromDecimal(18446744073709551615m)))
  Console.writeLine(Trait.Show.show(UnsignedInteger.absolute(42u64)))
  Console.writeLine(Trait.Show.show(UnsignedInteger.minimum(1u64, 2u64)))
  Console.writeLine(Trait.Show.show(UnsignedInteger.maximum(1u64, 2u64)))
  Console.writeLine(Trait.Show.show(UnsignedInteger.floorDivide(7u64, 3u64)))
  Console.writeLine(Trait.Show.show(UnsignedInteger.floorModulo(7u64, 3u64)))
  Console.writeLine(Trait.Show.show(UnsignedInteger.bitwiseAnd(12u64, 10u64)))
  Console.writeLine(Trait.Show.show(UnsignedInteger.bitwiseOr(12u64, 10u64)))
  Console.writeLine(Trait.Show.show(UnsignedInteger.bitwiseExclusiveOr(12u64, 10u64)))
  Console.writeLine(Trait.Show.show(UnsignedInteger.bitwiseNot(0u64)))
  Console.writeLine(Trait.Show.show(UnsignedInteger.shiftLeft(1u64, 63)))
  Console.writeLine(Trait.Show.show(UnsignedInteger.shiftRight(18446744073709551615u64, 63)))
  Console.writeLine(showInteger64(-42))
  Console.writeLine(showFloat64(-0.0))
  Console.writeLine(showUnsignedInteger8(255u8))
  Console.writeLine(showUnsignedInteger(18446744073709551615u64))
  Console.writeLine("${Trait.Order.compare(1s64, 1) = Trait.Ordering.Equal}")
  Console.writeLine("${Trait.Order.compare(1.0f64, 1.0) = Trait.Ordering.Equal}")
  Console.writeLine("${Trait.Order.compare(255u8, 255u8) = Trait.Ordering.Equal}")
  Console.writeLine("${Trait.Order.compare(18446744073709551615u64, 18446744073709551615u64) = Trait.Ordering.Equal}")
end function
