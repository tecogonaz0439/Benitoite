// spec: 01-06 標準の型クラス（初回リリース版）
// 設計書 03-06「Map と Set（初回リリース版）」「標準の型クラス（初回リリース版）」。
// 関門: CLI の取り込み・型・エフェクトと関数の組み合わせから得る出力を守る。
// 登録や呼び出しの接続漏れは本体の単体テストで届かず、専用の差し込み口は不要である。
import Benitoite.Trait
import Benitoite.Unofficial.IO.Console
function main() -> Unit uses Console.Write
  bind original <- Map.fromList([Pair("b", 2), Pair("a", 1), Pair("c", 3)])
  bind changed <- Map.set(m: original, k: "b", value: 20) |> Map.remove(m: _, k: "c")
  Console.writeLine(Trait.Show.show(original))
  Console.writeLine(Trait.Show.show(Map.keys(changed)))
  Console.writeLine(Trait.Show.show(Map.values(changed)))
  Console.writeLine(Trait.Show.show(Map.get(m: changed, k: "b")))
  Console.writeLine(Trait.Show.show(Map.size(changed) = 2 and not Map.contains(m: changed, k: "c")))
  bind mapped <- Map.map(m: original, f: lambda(key, value)
    Console.writeLine(key)
    return value * 10
  end lambda)
  Console.writeLine(Trait.Show.show(Map.filter(m: mapped, p: lambda(key, value) return key <> "b" and value >= 10 end lambda)))
  Console.writeLine(Map.fold(m: original, initial: "", f: lambda(acc, key, value) return acc + key + Integer.toString(value) end lambda))
  Map.forEach(m: changed, f: lambda(key, value) Console.writeLine(key + ":" + Integer.toString(value)) end lambda)
  bind emptyMap: Map[String, Integer] <- Trait.Monoid.empty()
  Console.writeLine(Trait.Show.show(Trait.Semigroup.combine(x: emptyMap, y: Trait.Semigroup.combine(x: original, y: changed))))
  bind initial <- Set.fromList([3, 1, 2])
  bind other <- Set.add(s: Set.remove(s: initial, x: 2), x: 4)
  Console.writeLine(Trait.Show.show(initial))
  Console.writeLine(Trait.Show.show(Set.size(other) = 3 and Set.contains(s: other, x: 4) and not Set.contains(s: other, x: 2)))
  Console.writeLine(Trait.Show.show(Set.intersection(a: initial, b: other)))
  Console.writeLine(Trait.Show.show(Set.difference(a: initial, b: other)))
  bind mappedSet <- Set.map(s: initial, f: lambda(value)
    Console.writeLine(Integer.toString(value))
    return value mod 2
  end lambda)
  Console.writeLine(Trait.Show.show(mappedSet))
  Console.writeLine(Trait.Show.show(Set.filter(s: initial, p: lambda(value) return value > 1 end lambda)))
  Console.writeLine(Integer.toString(Set.fold(s: initial, initial: 0, f: lambda(acc, value) return acc * 10 + value end lambda)))
  Set.forEach(s: other, f: lambda(value) Console.writeLine(Integer.toString(value)) end lambda)
  bind emptySet: Set[Integer] <- Trait.Monoid.empty()
  Console.writeLine(Trait.Show.show(Trait.Semigroup.combine(x: emptySet, y: Set.union(a: initial, b: other))))
end function
