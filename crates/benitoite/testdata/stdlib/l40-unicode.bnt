// 設計書 03-06「Character」「String」。
// 関門: CLI の取り込み・型・エフェクトと関数の組み合わせから得る出力を守る。
// 登録や呼び出しの接続漏れは本体の単体テストで届かず、専用の差し込み口は不要である。
import Benitoite.Trait
import Benitoite.Unofficial.IO.Console
function main() -> Unit uses Console.Write
  Console.writeLine(Trait.Show.show(List.map(['é', '3', 'Ⅷ', ' ', 'Ω', 'ß'], Character.isAlphabetic)))
  Console.writeLine(Trait.Show.show(List.map(['3', 'Ⅷ', '½', 'a'], Character.isNumeric)))
  Console.writeLine(Trait.Show.show(Character.isWhitespace('　') and not Character.isASCIIWhitespace('　')))
  Console.writeLine(Trait.Show.show(Character.isUppercase('Ω') and Character.isLowercase('ß')))
  Console.writeLine(Character.toUppercase('ß') + "/" + Character.toLowercase('Σ'))
  Console.writeLine(String.toUppercase("Straße"))
  Console.writeLine(String.toLowercase("ΟΣ ΣΟ"))
end function
