// 作成時の関門: 標準モジュールの toString の公開と CLI の出力を守る。
// ランタイムの数値比較では文字列化の登録漏れや表記の取り違えを捕まえない。
// 実行器の二方式と参照実行器で同じ出力を確かめ、差し込み口は加えない。
import Benitoite.Unofficial.IO.Console
function main() -> Unit uses Console.Write
  Console.writeLine(Integer8.toString(Integer8.fromInteger(-128) |> Option.unwrapOr(_, 0s8)))
  Console.writeLine(Integer8.toString(Integer8.fromInteger(0) |> Option.unwrapOr(_, 0s8)))
  Console.writeLine(Integer8.toString(Integer8.fromInteger(127) |> Option.unwrapOr(_, 0s8)))
  Console.writeLine(Integer16.toString(Integer16.fromInteger(-32768) |> Option.unwrapOr(_, 0s16)))
  Console.writeLine(Integer16.toString(Integer16.fromInteger(0) |> Option.unwrapOr(_, 0s16)))
  Console.writeLine(Integer16.toString(Integer16.fromInteger(32767) |> Option.unwrapOr(_, 0s16)))
  Console.writeLine(Integer32.toString(Integer32.fromInteger(-2147483648) |> Option.unwrapOr(_, 0s32)))
  Console.writeLine(Integer32.toString(Integer32.fromInteger(0) |> Option.unwrapOr(_, 0s32)))
  Console.writeLine(Integer32.toString(Integer32.fromInteger(2147483647) |> Option.unwrapOr(_, 0s32)))
  Console.writeLine(UnsignedInteger16.toString(UnsignedInteger16.fromInteger(0) |> Option.unwrapOr(_, 0u16)))
  Console.writeLine(UnsignedInteger16.toString(UnsignedInteger16.fromInteger(0) |> Option.unwrapOr(_, 0u16)))
  Console.writeLine(UnsignedInteger16.toString(UnsignedInteger16.fromInteger(65535) |> Option.unwrapOr(_, 0u16)))
  Console.writeLine(UnsignedInteger32.toString(UnsignedInteger32.fromInteger(0) |> Option.unwrapOr(_, 0u32)))
  Console.writeLine(UnsignedInteger32.toString(UnsignedInteger32.fromInteger(0) |> Option.unwrapOr(_, 0u32)))
  Console.writeLine(UnsignedInteger32.toString(UnsignedInteger32.fromInteger(4294967295) |> Option.unwrapOr(_, 0u32)))
end function
