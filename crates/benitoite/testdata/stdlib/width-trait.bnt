// 作成時の関門: 新しい数の辞書の選択と全順序を CLI の出力で守る。
// 演算子の試験は Show/Order の登録と NaN の全順序を呼ばない。
import Benitoite.Trait
import Benitoite.Unofficial.IO.Console

function orderingText(value: Trait.Ordering) -> String
  return match value with
    case Trait.Ordering.Less -> "Less"
    case Trait.Ordering.Equal -> "Equal"
    case Trait.Ordering.Greater -> "Greater"
  end match
end function

function main() -> Unit uses Console.Write
  Console.writeLine(Trait.Show.show([-128s8, 127s8]))
  Console.writeLine(orderingText(Trait.Order.compare(x: -128s8, y: 127s8)))
  Console.writeLine(orderingText(Trait.Order.compare(x: 127s8, y: -128s8)))
  Console.writeLine(orderingText(Trait.Order.compare(x: 127s8, y: 127s8)))
  Console.writeLine(Trait.Show.show([-32768s16, 32767s16]))
  Console.writeLine(orderingText(Trait.Order.compare(x: -32768s16, y: 32767s16)))
  Console.writeLine(orderingText(Trait.Order.compare(x: 32767s16, y: -32768s16)))
  Console.writeLine(orderingText(Trait.Order.compare(x: 32767s16, y: 32767s16)))
  Console.writeLine(Trait.Show.show([-2147483648s32, 2147483647s32]))
  Console.writeLine(orderingText(Trait.Order.compare(x: -2147483648s32, y: 2147483647s32)))
  Console.writeLine(orderingText(Trait.Order.compare(x: 2147483647s32, y: -2147483648s32)))
  Console.writeLine(orderingText(Trait.Order.compare(x: 2147483647s32, y: 2147483647s32)))
  Console.writeLine(Trait.Show.show([0u16, 65535u16]))
  Console.writeLine(orderingText(Trait.Order.compare(x: 0u16, y: 65535u16)))
  Console.writeLine(orderingText(Trait.Order.compare(x: 65535u16, y: 0u16)))
  Console.writeLine(orderingText(Trait.Order.compare(x: 65535u16, y: 65535u16)))
  Console.writeLine(Trait.Show.show([0u32, 4294967295u32]))
  Console.writeLine(orderingText(Trait.Order.compare(x: 0u32, y: 4294967295u32)))
  Console.writeLine(orderingText(Trait.Order.compare(x: 4294967295u32, y: 0u32)))
  Console.writeLine(orderingText(Trait.Order.compare(x: 4294967295u32, y: 4294967295u32)))
  Console.writeLine(Trait.Show.show([0u64, 18446744073709551615u64]))
  Console.writeLine(orderingText(Trait.Order.compare(x: 0u64, y: 18446744073709551615u64)))
  Console.writeLine(orderingText(Trait.Order.compare(x: 18446744073709551615u64, y: 0u64)))
  Console.writeLine(orderingText(Trait.Order.compare(x: 18446744073709551615u64, y: 18446744073709551615u64)))
  Console.writeLine(Trait.Show.show([0.1f32, -0.0f32, 1.0f32 / 0.0f32, 0.0f32 / 0.0f32]))
  Console.writeLine(orderingText(Trait.Order.compare(x: 1.0f32, y: 2.0f32)))
  Console.writeLine(orderingText(Trait.Order.compare(x: 2.0f32, y: 1.0f32)))
  Console.writeLine(orderingText(Trait.Order.compare(x: -0.0f32, y: 0.0f32)))
  Console.writeLine(orderingText(Trait.Order.compare(x: 0.0f32 / 0.0f32, y: 1.0f32 / 0.0f32)))
  Console.writeLine(orderingText(Trait.Order.compare(x: -1.0f32 / 0.0f32, y: 0.0f32 / 0.0f32)))
  Console.writeLine(orderingText(Trait.Order.compare(x: 0.0f32 / 0.0f32, y: Float32.squareRoot(-1.0f32))))
end function
