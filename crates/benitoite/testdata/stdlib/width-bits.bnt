// 作成時の関門: 全幅のビット演算と 0・幅−1 のシフトを CLI の独立した期待値で守る。
// 旧 Integer・Byte の試験は新しい幅の登録と切り捨て・符号の補充を検査できない。
import Benitoite.Unofficial.IO.Console

function main() -> Unit uses Console.Write
  Console.writeLine("${Integer8.bitwiseAnd(a: 12s8, b: 10s8)} ${Integer8.bitwiseOr(a: 12s8, b: 10s8)} ${Integer8.bitwiseExclusiveOr(a: 12s8, b: 10s8)} ${Integer8.bitwiseNot(0s8)} ${Integer8.shiftLeft(a: -1s8, n: 0)} ${Integer8.shiftLeft(a: -1s8, n: 7)} ${Integer8.shiftRight(a: -1s8, n: 0)} ${Integer8.shiftRight(a: -1s8, n: 7)} ${Integer8.shiftRightUnsigned(a: -1s8, n: 0)} ${Integer8.shiftRightUnsigned(a: -1s8, n: 7)} ${Integer8.shiftLeft(a: -128s8, n: 1)} ${Integer8.shiftRight(a: -8s8, n: 1)} ${Integer8.shiftRightUnsigned(a: -8s8, n: 1)}")
  Console.writeLine("${Integer16.bitwiseAnd(a: 12s16, b: 10s16)} ${Integer16.bitwiseOr(a: 12s16, b: 10s16)} ${Integer16.bitwiseExclusiveOr(a: 12s16, b: 10s16)} ${Integer16.bitwiseNot(0s16)} ${Integer16.shiftLeft(a: -1s16, n: 0)} ${Integer16.shiftLeft(a: -1s16, n: 15)} ${Integer16.shiftRight(a: -1s16, n: 0)} ${Integer16.shiftRight(a: -1s16, n: 15)} ${Integer16.shiftRightUnsigned(a: -1s16, n: 0)} ${Integer16.shiftRightUnsigned(a: -1s16, n: 15)} ${Integer16.shiftLeft(a: -32768s16, n: 1)} ${Integer16.shiftRight(a: -8s16, n: 1)} ${Integer16.shiftRightUnsigned(a: -8s16, n: 1)}")
  Console.writeLine("${Integer32.bitwiseAnd(a: 12s32, b: 10s32)} ${Integer32.bitwiseOr(a: 12s32, b: 10s32)} ${Integer32.bitwiseExclusiveOr(a: 12s32, b: 10s32)} ${Integer32.bitwiseNot(0s32)} ${Integer32.shiftLeft(a: -1s32, n: 0)} ${Integer32.shiftLeft(a: -1s32, n: 31)} ${Integer32.shiftRight(a: -1s32, n: 0)} ${Integer32.shiftRight(a: -1s32, n: 31)} ${Integer32.shiftRightUnsigned(a: -1s32, n: 0)} ${Integer32.shiftRightUnsigned(a: -1s32, n: 31)} ${Integer32.shiftLeft(a: -2147483648s32, n: 1)} ${Integer32.shiftRight(a: -8s32, n: 1)} ${Integer32.shiftRightUnsigned(a: -8s32, n: 1)}")
  Console.writeLine("${UnsignedInteger16.bitwiseAnd(a: 12u16, b: 10u16)} ${UnsignedInteger16.bitwiseOr(a: 12u16, b: 10u16)} ${UnsignedInteger16.bitwiseExclusiveOr(a: 12u16, b: 10u16)} ${UnsignedInteger16.bitwiseNot(0u16)} ${UnsignedInteger16.shiftLeft(a: 65535u16, n: 0)} ${UnsignedInteger16.shiftLeft(a: 65535u16, n: 15)} ${UnsignedInteger16.shiftRight(a: 65535u16, n: 0)} ${UnsignedInteger16.shiftRight(a: 65535u16, n: 15)} ${UnsignedInteger16.shiftLeft(a: 32768u16, n: 1)} ${UnsignedInteger16.shiftRight(a: 8u16, n: 1)}")
  Console.writeLine("${UnsignedInteger32.bitwiseAnd(a: 12u32, b: 10u32)} ${UnsignedInteger32.bitwiseOr(a: 12u32, b: 10u32)} ${UnsignedInteger32.bitwiseExclusiveOr(a: 12u32, b: 10u32)} ${UnsignedInteger32.bitwiseNot(0u32)} ${UnsignedInteger32.shiftLeft(a: 4294967295u32, n: 0)} ${UnsignedInteger32.shiftLeft(a: 4294967295u32, n: 31)} ${UnsignedInteger32.shiftRight(a: 4294967295u32, n: 0)} ${UnsignedInteger32.shiftRight(a: 4294967295u32, n: 31)} ${UnsignedInteger32.shiftLeft(a: 2147483648u32, n: 1)} ${UnsignedInteger32.shiftRight(a: 8u32, n: 1)}")
  Console.writeLine("${UnsignedInteger64.bitwiseAnd(a: 12u64, b: 10u64)} ${UnsignedInteger64.bitwiseOr(a: 12u64, b: 10u64)} ${UnsignedInteger64.bitwiseExclusiveOr(a: 12u64, b: 10u64)} ${UnsignedInteger64.bitwiseNot(0u64)} ${UnsignedInteger64.shiftLeft(a: 18446744073709551615u64, n: 0)} ${UnsignedInteger64.shiftLeft(a: 18446744073709551615u64, n: 63)} ${UnsignedInteger64.shiftRight(a: 18446744073709551615u64, n: 0)} ${UnsignedInteger64.shiftRight(a: 18446744073709551615u64, n: 63)} ${UnsignedInteger64.shiftLeft(a: 9223372036854775808u64, n: 1)} ${UnsignedInteger64.shiftRight(a: 8u64, n: 1)}")
end function
