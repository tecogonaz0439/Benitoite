// 作成時の関門: 全幅のビット演算と 0・幅−1 のシフトを CLI の独立した期待値で守る。
// 旧 Integer・Byte の試験は新しい幅の登録と切り捨て・符号の補充を検査できない。
import Benitoite.Unofficial.IO.Console

function main() -> Unit uses Console.Write
  Console.writeLine("${Integer8.bitwiseAnd(12s8, 10s8)} ${Integer8.bitwiseOr(12s8, 10s8)} ${Integer8.bitwiseExclusiveOr(12s8, 10s8)} ${Integer8.bitwiseNot(0s8)} ${Integer8.shiftLeft(-1s8, 0)} ${Integer8.shiftLeft(-1s8, 7)} ${Integer8.shiftRight(-1s8, 0)} ${Integer8.shiftRight(-1s8, 7)} ${Integer8.shiftRightUnsigned(-1s8, 0)} ${Integer8.shiftRightUnsigned(-1s8, 7)} ${Integer8.shiftLeft(-128s8, 1)} ${Integer8.shiftRight(-8s8, 1)} ${Integer8.shiftRightUnsigned(-8s8, 1)}")
  Console.writeLine("${Integer16.bitwiseAnd(12s16, 10s16)} ${Integer16.bitwiseOr(12s16, 10s16)} ${Integer16.bitwiseExclusiveOr(12s16, 10s16)} ${Integer16.bitwiseNot(0s16)} ${Integer16.shiftLeft(-1s16, 0)} ${Integer16.shiftLeft(-1s16, 15)} ${Integer16.shiftRight(-1s16, 0)} ${Integer16.shiftRight(-1s16, 15)} ${Integer16.shiftRightUnsigned(-1s16, 0)} ${Integer16.shiftRightUnsigned(-1s16, 15)} ${Integer16.shiftLeft(-32768s16, 1)} ${Integer16.shiftRight(-8s16, 1)} ${Integer16.shiftRightUnsigned(-8s16, 1)}")
  Console.writeLine("${Integer32.bitwiseAnd(12s32, 10s32)} ${Integer32.bitwiseOr(12s32, 10s32)} ${Integer32.bitwiseExclusiveOr(12s32, 10s32)} ${Integer32.bitwiseNot(0s32)} ${Integer32.shiftLeft(-1s32, 0)} ${Integer32.shiftLeft(-1s32, 31)} ${Integer32.shiftRight(-1s32, 0)} ${Integer32.shiftRight(-1s32, 31)} ${Integer32.shiftRightUnsigned(-1s32, 0)} ${Integer32.shiftRightUnsigned(-1s32, 31)} ${Integer32.shiftLeft(-2147483648s32, 1)} ${Integer32.shiftRight(-8s32, 1)} ${Integer32.shiftRightUnsigned(-8s32, 1)}")
  Console.writeLine("${UnsignedInteger16.bitwiseAnd(12u16, 10u16)} ${UnsignedInteger16.bitwiseOr(12u16, 10u16)} ${UnsignedInteger16.bitwiseExclusiveOr(12u16, 10u16)} ${UnsignedInteger16.bitwiseNot(0u16)} ${UnsignedInteger16.shiftLeft(65535u16, 0)} ${UnsignedInteger16.shiftLeft(65535u16, 15)} ${UnsignedInteger16.shiftRight(65535u16, 0)} ${UnsignedInteger16.shiftRight(65535u16, 15)} ${UnsignedInteger16.shiftLeft(32768u16, 1)} ${UnsignedInteger16.shiftRight(8u16, 1)}")
  Console.writeLine("${UnsignedInteger32.bitwiseAnd(12u32, 10u32)} ${UnsignedInteger32.bitwiseOr(12u32, 10u32)} ${UnsignedInteger32.bitwiseExclusiveOr(12u32, 10u32)} ${UnsignedInteger32.bitwiseNot(0u32)} ${UnsignedInteger32.shiftLeft(4294967295u32, 0)} ${UnsignedInteger32.shiftLeft(4294967295u32, 31)} ${UnsignedInteger32.shiftRight(4294967295u32, 0)} ${UnsignedInteger32.shiftRight(4294967295u32, 31)} ${UnsignedInteger32.shiftLeft(2147483648u32, 1)} ${UnsignedInteger32.shiftRight(8u32, 1)}")
  Console.writeLine("${UnsignedInteger64.bitwiseAnd(12u64, 10u64)} ${UnsignedInteger64.bitwiseOr(12u64, 10u64)} ${UnsignedInteger64.bitwiseExclusiveOr(12u64, 10u64)} ${UnsignedInteger64.bitwiseNot(0u64)} ${UnsignedInteger64.shiftLeft(18446744073709551615u64, 0)} ${UnsignedInteger64.shiftLeft(18446744073709551615u64, 63)} ${UnsignedInteger64.shiftRight(18446744073709551615u64, 0)} ${UnsignedInteger64.shiftRight(18446744073709551615u64, 63)} ${UnsignedInteger64.shiftLeft(9223372036854775808u64, 1)} ${UnsignedInteger64.shiftRight(8u64, 1)}")
end function
