// spec: 01-03 トップレベルの名前空間
// spec: 01-03 型パラメータとエフェクト変数の有効範囲
import Benitoite.Unofficial.IO.Console

function main() -> Unit uses Console.Write
  return if isEven(8) then
    Console.writeLine("even")
  else
    Console.writeLine("odd")
  end if
end function

function isEven(value: Integer) -> Boolean
  return if value = 0 then true else isOdd(value - 1) end if
end function

function isOdd(value: Integer) -> Boolean
  return if value = 0 then false else isEven(value - 1) end if
end function

data First
  Wrap(Second)
end data
data Second
  WrapAgain(First)
end data
