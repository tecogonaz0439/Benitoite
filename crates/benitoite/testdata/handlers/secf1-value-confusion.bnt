// spec: 01-06 エフェクトの宣言とハンドラの型付け（初回リリース版）
// spec: 01-12 ハンドラ
// 外のセルを使って、Integer を String として組み込みに渡せない。
effect Swap
  function store[T](x: T) -> T
end effect

function main() -> Unit uses State
  bind cell <- Reference.new(Option.None)
  handle
    bind _ <- store(42)
    bind text <- store("hello")
    bind _ <- String.characterCount(text)
  with
    case store(x) ->
      bind prev <- Reference.get(cell)
      Reference.set(cell, Option.Some(x))
      match prev with
        case Option.Some(p) -> resume(p)
        case Option.None -> resume(x)
      end match
  end handle
end function
