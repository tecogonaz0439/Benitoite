// spec: 01-06 エフェクトの宣言とハンドラの型付け（初回リリース版）
// spec: 01-12 ハンドラ
// 外で作った単相なラムダの引数型に、節の型パラメータを入れられない。
effect Swap
  function store[T](x: T) -> T
end effect

function main() -> Unit
  bind accept <- lambda(value) end lambda
  handle
    bind _ <- store(42)
  with
    case store(x) ->
      accept(x)
      resume(x)
  end handle
end function
