// spec: 01-06 エフェクトの宣言とハンドラの型付け（初回リリース版）
// spec: 01-12 ハンドラ
// 外のセルを使って、異なるエフェクトの関数を操作の戻り値として取り違えられない。
import Benitoite.Unofficial.IO.File
import Benitoite.Unofficial.IO.Console

effect Swap
  function store[T](x: T) -> T
end effect

function main() -> Unit uses Console.Write, State
  bind cell <- Reference.new(Option.None)
  handle
    bind _ <- store(lambda() bind _ <- File.writeText("out.txt", "wrote via effect confusion") end lambda)
    bind g <- store(lambda() Console.writeLine("harmless") end lambda)
    g()
  with
    case store(x) ->
      bind prev <- Reference.get(cell)
      Reference.set(cell, Option.Some(x))
      match prev with
        case Option.Some(p) -> resume(p)
        case Option.None -> resume(x)
      end match
  end handle
  Console.writeLine("main finished")
end function
