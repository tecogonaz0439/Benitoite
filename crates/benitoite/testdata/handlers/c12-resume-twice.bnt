// spec: 01-07 利用者が定義するエフェクトとハンドラ（初回リリース版）
// spec: 01-06 エフェクトの宣言とハンドラの型付け（初回リリース版）
// 関門: 一回限りの継続の実行時診断を守り、二度目の再開を許す退行を捕まえる。
// CLI への接続と診断・出力を守る。段ごとのテストではこの接続を通らず、専用の差し込み口は要らない。
import Benitoite.Unofficial.IO.Console
effect Ask
  function ask() -> Integer
end effect

function main() -> Unit uses Console.Write
  bind value <- handle
    ask() + 1
  with
    case ask() ->
      bind first <- resume(10)
      Console.writeLine(Integer.toString(first))
      resume(20)
  end handle
  Console.writeLine(Integer.toString(value))
end function
