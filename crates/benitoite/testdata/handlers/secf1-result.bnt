// spec: 01-06 エフェクトの宣言とハンドラの型付け（初回リリース版）
// spec: 01-12 ハンドラ
// handle の結果型の未確定の要素に、節の型パラメータを入れられない。
effect Swap
  function store[T](x: T) -> T
end effect

function main() -> Unit
  bind _ <- handle
    bind _ <- store(42)
    Option.None
  with
    case store(x) -> Option.Some(x)
  end handle
end function
