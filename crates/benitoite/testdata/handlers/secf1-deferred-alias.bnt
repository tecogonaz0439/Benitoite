// spec: 01-06 ハンドラの型付け、01-12 ハンドラの節の型パラメータの範囲
// 外の変数に結び付けた関数の未確定の型にも、後から節の型パラメータを入れられない。
effect Swap
  function store[T](x: T) -> T
end effect

function main() -> Unit
  bind accept <- lambda(value) end lambda
  handle
    bind _ <- store(42)
  with
    case store(x) ->
      bind f <- lambda(value) return value end lambda
      accept(f)
      bind _ <- f(x)
      resume(x)
  end handle
end function
