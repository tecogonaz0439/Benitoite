// spec: 01-06 エフェクトの宣言とハンドラの型付け（初回リリース版）
// spec: 01-12 ハンドラ
// 外の節で作ったセルにも、内側の節の型パラメータを入れられない。
effect Swap
  function store[T](x: T) -> T
end effect

function main() -> Unit uses State
  handle
    bind _ <- store(42)
  with
    case store(x) ->
      bind cell <- Reference.new(Option.None)
      handle
        bind _ <- store("inner")
      with
        case store(y) ->
          Reference.set(cell, Option.Some(y))
          resume(y)
      end handle
      resume(x)
  end handle
end function
