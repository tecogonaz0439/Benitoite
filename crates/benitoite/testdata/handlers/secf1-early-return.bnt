// spec: 01-06 エフェクトの宣言とハンドラの型付け（初回リリース版）
// spec: 01-12 ハンドラ
// 外のラムダの戻り値型に、節からの return で型パラメータを入れられない。
effect Swap
  function store[T](x: T) -> T
end effect

function main() -> Unit
  bind f <- lambda()
    handle
      bind _ <- store(42)
    with
      case store(x) -> return Option.Some(x)
    end handle
    return Option.None
  end lambda
  bind _ <- f()
end function
