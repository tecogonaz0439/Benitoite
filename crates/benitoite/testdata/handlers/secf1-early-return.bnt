// spec: 01-06 ハンドラの型付け、01-12 ハンドラの節の型パラメータの範囲
// 外のラムダの戻り値型に、節からの return で型パラメータを入れられない。
effect Swap
  function store[T](x: T) -> T
end effect

function main() -> Unit
  bind f <- lambda()
    handle
      bind _ <- store(42)
    with
      case store(x) -> return Option.Some(x)
    end handle
    return Option.None
  end lambda
  bind _ <- f()
end function
