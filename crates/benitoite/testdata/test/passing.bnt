// spec: 01-02 属性（初回リリース版）
// 06-04「テストの関数」「結果の報告」: 成功するテストだけのファイルは終了状態 0 で終わる。

function add(left: Integer, right: Integer) -> Integer
  return left + right
end function

@test("add sums two numbers")
function addSums() -> Unit uses Assert.Check
  Assert.equal(actual: add(left: 1, right: 2), expected: 3)
end function

@test
function addIsCommutative() -> Unit uses Assert.Check
  Assert.notEqual(actual: add(left: 1, right: 2), expected: 4)
  Assert.isTrue(condition: add(left: 2, right: 5) = add(left: 5, right: 2), message: "add is commutative")
end function

@test
function returnsOk() -> Result[Unit, String]
  return Result.Ok(())
end function
