// spec: 01-06 エフェクト変数の具体化
import Benitoite.Unofficial.IO.Console

function map_and_print(values: List[Integer]) -> List[Integer]
    return List.map(values, lambda(value)
        Console.writeLine(Integer.toString(value))
        return value
    end lambda)
end function

function main() -> Unit
    return ()
end function
