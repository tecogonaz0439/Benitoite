// spec: 01-12 型付け規則
// spec: 01-12 計算
import Benitoite.Unofficial.IO.Console

function make() -> function() -> Unit
    return lambda() return () end lambda
end function

function widen() -> (function() -> Unit uses IO.All)
    return make()
end function

function main() -> Unit uses IO.All
    bind action <- widen()
    action()
    return Console.writeLine("widened")
end function
