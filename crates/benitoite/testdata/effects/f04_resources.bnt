// spec: 01-10 `with` の構文
import Benitoite.Unofficial.IO.File

function headers(src: String, dst: String) -> Result[Pair[String, String], String] uses File.Read, State
  with input = try File.openReader(src) |> Result.mapError(_, IOError.message),
       other = try File.openReader(dst) |> Result.mapError(_, IOError.message) do
    bind first <- try File.readLine(input) |> Result.mapError(_, IOError.message)
    bind second <- try File.readLine(other) |> Result.mapError(_, IOError.message)
    return Result.Ok(Pair(Option.unwrapOr(first, ""), Option.unwrapOr(second, "")))
  end with
end function

function main() -> Unit
  ()
end function
