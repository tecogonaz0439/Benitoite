// spec: 01-10 `with` の構文
import Benitoite.Unofficial.IO.File
function firstLine(path: String) -> Result[Option[String], String] uses File.Read, State
  with reader = try File.openReader(path) |> Result.mapError(r: _, f: lambda(error) return IOError.message(error) end lambda) do
    bind line <- try File.readLine(reader) |> Result.mapError(r: _, f: lambda(error) return IOError.message(error) end lambda)
    return Result.Ok(line)
  end with
end function

function main() -> Unit
  ()
end function
