// spec: 01-06 エフェクト変数の具体化
// spec: 01-06 標準ライブラリの関数の型
// spec: 01-07 組み込みのエフェクト
import Benitoite.Unofficial.IO.Console

function main() -> Unit uses Console.Write
    bind pure_values <- List.map([1, 2], lambda(value) return value + 1 end lambda)
    Console.writeLine(Integer.toString(List.length(pure_values)))
    bind _ <- List.map([1, 2], lambda(value)
        Console.writeLine(Integer.toString(value))
        return value
    end lambda)
    return ()
end function
