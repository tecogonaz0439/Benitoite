// spec: 01-06 エフェクト変数の具体化
import Benitoite.Unofficial.IO.Console

function choose[effect E](unused: function() -> Unit uses IO.All, E, action: function() -> Unit uses E) -> Unit uses E
    return action()
end function

function main() -> Unit
    choose(unused: lambda() return () end lambda, action: lambda() return Console.writeLine("used") end lambda)
    return ()
end function
