// spec: 01-06 エフェクトの包含
fn runAll(actions: List[fn() -> Unit uses IO]) -> Unit uses IO {
    let _ = List.map(actions, fn(action) { action() })
    ()
}

fn main() -> Unit uses IO {
    let pure: fn() -> Unit uses IO = fn() { () }
    let _ = runAll([pure, fn() { Console.println("ran") }])
    ()
}
