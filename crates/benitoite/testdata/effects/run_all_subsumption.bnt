// spec: 01-06 エフェクトの包含
import Benitoite.Unofficial.IO.Console

function runAll(actions: List[function() -> Unit uses IO.All]) -> Unit uses IO.All
    bind _ <- List.map(actions, lambda(action) return action() end lambda)
    return ()
end function

function main() -> Unit uses IO.All
    bind pure: function() -> Unit uses IO.All <- lambda() return () end lambda
    bind _ <- runAll([pure, lambda() return Console.writeLine("ran") end lambda])
    return ()
end function
