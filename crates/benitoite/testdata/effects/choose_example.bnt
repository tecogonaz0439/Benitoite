// spec: 01-06 エフェクト変数の具体化
import Benitoite.Unofficial.IO.Console

function choose[effect E](unused: function() -> Unit uses IO.All, E, action: function() -> Unit uses E) -> Unit uses E
    return action()
end function

function main() -> Unit uses IO.All
    choose(lambda() return Console.writeLine("unused") end lambda, lambda() return () end lambda)
    return Console.writeLine("chosen")
end function
