// spec: 01-06 エフェクトの包含
import Benitoite.Unofficial.IO.Console

function applyAll(actions: List[function() -> Unit uses IO.All]) -> Unit uses IO.All
    bind _ <- List.map(actions, lambda(action) return action() end lambda)
    return ()
end function

function main() -> Unit uses IO.All
    bind _ <- applyAll([lambda() return () end lambda, lambda() return Console.writeLine("first") end lambda])
    bind _ <- applyAll([lambda() return Console.writeLine("second") end lambda, lambda() return () end lambda])
    return ()
end function
