// spec: 01-06 エフェクトの包含
fn applyAll(actions: List[fn() -> Unit uses IO]) -> Unit uses IO {
    let _ = List.map(actions, fn(action) { action() })
    ()
}

fn main() -> Unit uses IO {
    let _ = applyAll([fn() { () }, fn() { Console.println("first") }])
    let _ = applyAll([fn() { Console.println("second") }, fn() { () }])
    ()
}
