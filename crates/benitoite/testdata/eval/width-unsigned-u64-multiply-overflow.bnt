import Benitoite.Unofficial.IO.Console
function calculate(a: UnsignedInteger64, b: UnsignedInteger64) -> UnsignedInteger64
  return a * b
end function
function main() -> Unit uses Console.Write
  bind _ <- calculate(a: 18446744073709551615u64, b: 2u64)
  Console.writeLine("unreachable")
end function
