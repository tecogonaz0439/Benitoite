// spec: 01-04 型の変換
import Benitoite.Unofficial.IO.Console

function show_int(value: Option[Integer]) -> String
  return match value with
    case Option.Some(number) -> "Some(" + Integer.toString(number) + ")"
    case Option.None -> "None"
  end match
end function

function show_float(value: Option[Float]) -> String
  return match value with
    case Option.Some(number) -> "Some(" + Float.toString(number) + ")"
    case Option.None -> "None"
  end match
end function

function main() -> Unit uses Console.Write
  Console.writeLine(show_int(Integer.parse("-42")))
  Console.writeLine(show_int(Integer.parse("1_000")))
  Console.writeLine(show_int(Integer.parse("+42")))
  Console.writeLine(show_int(Integer.parse(" 42")))
  Console.writeLine(show_int(Integer.parse("9223372036854775808")))
  Console.writeLine(show_float(Float.parse("42")))
  Console.writeLine(show_float(Float.parse("1.5e2")))
  Console.writeLine(show_float(Float.parse("NaN")))
  Console.writeLine(show_float(Float.parse("Infinity")))
  Console.writeLine(show_float(Float.parse(" 1.0")))
  return Console.writeLine(show_float(Float.parse("-1e-9999")))
end function
