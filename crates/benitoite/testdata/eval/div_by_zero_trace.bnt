// spec: 01-08 実行時エラーによる停止
import Benitoite.Unofficial.IO.Console

function ratio(a: Integer, b: Integer) -> Integer
  return a div b
end function

function main() -> Unit uses Console.Write
  bind values <- [10, 20, 30]
  bind divisor <- 0
  bind ratios <- List.map(values, lambda(value) return ratio(value, divisor) + 1 end lambda)
  return Console.writeLine(Integer.toString(List.length(ratios)))
end function
