// spec: 01-04 String
// spec: 01-04 型の一覧
import Benitoite.Unofficial.IO.Console

function show_string(value: Option[String]) -> String
  return match value with
    case Option.Some(text) -> "Some(" + text + ")"
    case Option.None -> "None"
  end match
end function

function show_char(value: Option[Character]) -> String
  return match value with
    case Option.Some(character) -> "Some(" + Character.toString(character) + ")"
    case Option.None -> "None"
  end match
end function

function main() -> Unit uses Console.Write
  bind text <- "Aé😀"
  Console.writeLine(Integer.toString(String.byteLength(text)))
  Console.writeLine(Integer.toString(String.characterCount(text)))
  Console.writeLine(show_string(String.byteSlice(s: text, start: 1, stop: 3)))
  Console.writeLine(show_string(String.byteSlice(s: text, start: 2, stop: 4)))
  Console.writeLine(show_string(String.byteSlice(s: text, start: 0, stop: 7)))
  Console.writeLine(show_char(String.characterAt(s: text, i: 2)))
  Console.writeLine(show_char(String.characterAt(s: text, i: -1)))
  Console.writeLine(show_char(String.characterAt(s: text, i: 3)))
  Console.writeLine(show_string(String.characterSlice(s: text, start: 1, stop: 3)))
  Console.writeLine(show_string(String.characterSlice(s: text, start: 0, stop: 4)))
  Console.writeLine(show_string(String.characterSlice(s: text, start: -1, stop: 1)))
  return Console.writeLine(show_string(String.byteSlice(s: text, start: 3, stop: 2)))
end function
