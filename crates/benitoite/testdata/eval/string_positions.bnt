// spec: 01-04 String
// spec: 01-04 型の一覧
import Benitoite.Unofficial.IO.Console

function show_string(value: Option[String]) -> String
  return match value with
    case Option.Some(text) -> "Some(" + text + ")"
    case Option.None -> "None"
  end match
end function

function show_char(value: Option[Character]) -> String
  return match value with
    case Option.Some(character) -> "Some(" + Character.toString(character) + ")"
    case Option.None -> "None"
  end match
end function

function main() -> Unit uses Console.Write
  bind text <- "Aé😀"
  Console.writeLine(Integer.toString(String.byteLength(text)))
  Console.writeLine(Integer.toString(String.characterCount(text)))
  Console.writeLine(show_string(String.byteSlice(text, 1, 3)))
  Console.writeLine(show_string(String.byteSlice(text, 2, 4)))
  Console.writeLine(show_string(String.byteSlice(text, 0, 7)))
  Console.writeLine(show_char(String.characterAt(text, 2)))
  Console.writeLine(show_char(String.characterAt(text, -1)))
  Console.writeLine(show_char(String.characterAt(text, 3)))
  Console.writeLine(show_string(String.characterSlice(text, 1, 3)))
  Console.writeLine(show_string(String.characterSlice(text, 0, 4)))
  Console.writeLine(show_string(String.characterSlice(text, -1, 1)))
  return Console.writeLine(show_string(String.byteSlice(text, 3, 2)))
end function
