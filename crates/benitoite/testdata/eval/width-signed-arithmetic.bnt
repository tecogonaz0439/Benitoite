// 算術の値は独立した期待値との差で確かめる。差を最小値・最大値へ加えて
// 両方ともあふれないのは差が 0 のときだけなので、比較と文字列化を必要としない。
import Benitoite.Unofficial.IO.Console
const sum8: Integer8 = 40s8 + 2s8
const difference8: Integer8 = 40s8 - 2s8
const product8: Integer8 = -7s8 * 2s8
const quotient8: Integer8 = -7s8 div 3s8
const remainder8: Integer8 = -7s8 mod 3s8
const negative8: Integer8 = -(7s8)
const special8: Integer8 = -128s8 mod -1s8
function check8(actual: Integer8, expected: Integer8) -> Unit
  bind difference <- actual - expected
  bind _ <- difference + 127s8
  bind _ <- difference + -128s8
end function
function add8(a: Integer8, b: Integer8) -> Integer8
  return a + b
end function
function subtract8(a: Integer8, b: Integer8) -> Integer8
  return a - b
end function
function multiply8(a: Integer8, b: Integer8) -> Integer8
  return a * b
end function
function divide8(a: Integer8, b: Integer8) -> Integer8
  return a div b
end function
function modulo8(a: Integer8, b: Integer8) -> Integer8
  return a mod b
end function
function negate8(a: Integer8) -> Integer8
  return -a
end function
const sum16: Integer16 = 40s16 + 2s16
const difference16: Integer16 = 40s16 - 2s16
const product16: Integer16 = -7s16 * 2s16
const quotient16: Integer16 = -7s16 div 3s16
const remainder16: Integer16 = -7s16 mod 3s16
const negative16: Integer16 = -(7s16)
const special16: Integer16 = -32768s16 mod -1s16
function check16(actual: Integer16, expected: Integer16) -> Unit
  bind difference <- actual - expected
  bind _ <- difference + 32767s16
  bind _ <- difference + -32768s16
end function
function add16(a: Integer16, b: Integer16) -> Integer16
  return a + b
end function
function subtract16(a: Integer16, b: Integer16) -> Integer16
  return a - b
end function
function multiply16(a: Integer16, b: Integer16) -> Integer16
  return a * b
end function
function divide16(a: Integer16, b: Integer16) -> Integer16
  return a div b
end function
function modulo16(a: Integer16, b: Integer16) -> Integer16
  return a mod b
end function
function negate16(a: Integer16) -> Integer16
  return -a
end function
const sum32: Integer32 = 40s32 + 2s32
const difference32: Integer32 = 40s32 - 2s32
const product32: Integer32 = -7s32 * 2s32
const quotient32: Integer32 = -7s32 div 3s32
const remainder32: Integer32 = -7s32 mod 3s32
const negative32: Integer32 = -(7s32)
const special32: Integer32 = -2147483648s32 mod -1s32
function check32(actual: Integer32, expected: Integer32) -> Unit
  bind difference <- actual - expected
  bind _ <- difference + 2147483647s32
  bind _ <- difference + -2147483648s32
end function
function add32(a: Integer32, b: Integer32) -> Integer32
  return a + b
end function
function subtract32(a: Integer32, b: Integer32) -> Integer32
  return a - b
end function
function multiply32(a: Integer32, b: Integer32) -> Integer32
  return a * b
end function
function divide32(a: Integer32, b: Integer32) -> Integer32
  return a div b
end function
function modulo32(a: Integer32, b: Integer32) -> Integer32
  return a mod b
end function
function negate32(a: Integer32) -> Integer32
  return -a
end function
function main() -> Unit uses Console.Write
  check8(actual: sum8, expected: 42s8)
  check8(actual: add8(a: 40s8, b: 2s8), expected: sum8)
  check8(actual: difference8, expected: 38s8)
  check8(actual: subtract8(a: 40s8, b: 2s8), expected: difference8)
  check8(actual: product8, expected: -14s8)
  check8(actual: multiply8(a: -7s8, b: 2s8), expected: product8)
  check8(actual: quotient8, expected: -2s8)
  check8(actual: divide8(a: -7s8, b: 3s8), expected: quotient8)
  check8(actual: remainder8, expected: -1s8)
  check8(actual: modulo8(a: -7s8, b: 3s8), expected: remainder8)
  check8(actual: special8, expected: 0s8)
  check8(actual: modulo8(a: -128s8, b: -1s8), expected: special8)
  check8(actual: negative8, expected: -7s8)
  check8(actual: negate8(7s8), expected: negative8)
  check8(actual: add8(a: -128s8, b: 0s8), expected: -128s8)
  check8(actual: add8(a: 127s8, b: 0s8), expected: 127s8)
  check8(actual: subtract8(a: -128s8, b: 0s8), expected: -128s8)
  check8(actual: multiply8(a: 127s8, b: 1s8), expected: 127s8)
  check8(actual: multiply8(a: -128s8, b: 1s8), expected: -128s8)
  check8(actual: divide8(a: -128s8, b: 1s8), expected: -128s8)
  check8(actual: divide8(a: 127s8, b: 1s8), expected: 127s8)
  check8(actual: divide8(a: 7s8, b: -3s8), expected: -2s8)
  check8(actual: divide8(a: -7s8, b: -3s8), expected: 2s8)
  check8(actual: modulo8(a: 7s8, b: -3s8), expected: 1s8)
  check8(actual: modulo8(a: -7s8, b: -3s8), expected: -1s8)
  check8(actual: modulo8(a: -128s8, b: 1s8), expected: 0s8)
  check8(actual: negate8(127s8), expected: -127s8)
  check8(actual: negate8(0s8), expected: 0s8)
  Console.writeLine("s8 arithmetic ok")
  check16(actual: sum16, expected: 42s16)
  check16(actual: add16(a: 40s16, b: 2s16), expected: sum16)
  check16(actual: difference16, expected: 38s16)
  check16(actual: subtract16(a: 40s16, b: 2s16), expected: difference16)
  check16(actual: product16, expected: -14s16)
  check16(actual: multiply16(a: -7s16, b: 2s16), expected: product16)
  check16(actual: quotient16, expected: -2s16)
  check16(actual: divide16(a: -7s16, b: 3s16), expected: quotient16)
  check16(actual: remainder16, expected: -1s16)
  check16(actual: modulo16(a: -7s16, b: 3s16), expected: remainder16)
  check16(actual: special16, expected: 0s16)
  check16(actual: modulo16(a: -32768s16, b: -1s16), expected: special16)
  check16(actual: negative16, expected: -7s16)
  check16(actual: negate16(7s16), expected: negative16)
  check16(actual: add16(a: -32768s16, b: 0s16), expected: -32768s16)
  check16(actual: add16(a: 32767s16, b: 0s16), expected: 32767s16)
  check16(actual: subtract16(a: -32768s16, b: 0s16), expected: -32768s16)
  check16(actual: multiply16(a: 32767s16, b: 1s16), expected: 32767s16)
  check16(actual: multiply16(a: -32768s16, b: 1s16), expected: -32768s16)
  check16(actual: divide16(a: -32768s16, b: 1s16), expected: -32768s16)
  check16(actual: divide16(a: 32767s16, b: 1s16), expected: 32767s16)
  check16(actual: divide16(a: 7s16, b: -3s16), expected: -2s16)
  check16(actual: divide16(a: -7s16, b: -3s16), expected: 2s16)
  check16(actual: modulo16(a: 7s16, b: -3s16), expected: 1s16)
  check16(actual: modulo16(a: -7s16, b: -3s16), expected: -1s16)
  check16(actual: modulo16(a: -32768s16, b: 1s16), expected: 0s16)
  check16(actual: negate16(32767s16), expected: -32767s16)
  check16(actual: negate16(0s16), expected: 0s16)
  Console.writeLine("s16 arithmetic ok")
  check32(actual: sum32, expected: 42s32)
  check32(actual: add32(a: 40s32, b: 2s32), expected: sum32)
  check32(actual: difference32, expected: 38s32)
  check32(actual: subtract32(a: 40s32, b: 2s32), expected: difference32)
  check32(actual: product32, expected: -14s32)
  check32(actual: multiply32(a: -7s32, b: 2s32), expected: product32)
  check32(actual: quotient32, expected: -2s32)
  check32(actual: divide32(a: -7s32, b: 3s32), expected: quotient32)
  check32(actual: remainder32, expected: -1s32)
  check32(actual: modulo32(a: -7s32, b: 3s32), expected: remainder32)
  check32(actual: special32, expected: 0s32)
  check32(actual: modulo32(a: -2147483648s32, b: -1s32), expected: special32)
  check32(actual: negative32, expected: -7s32)
  check32(actual: negate32(7s32), expected: negative32)
  check32(actual: add32(a: -2147483648s32, b: 0s32), expected: -2147483648s32)
  check32(actual: add32(a: 2147483647s32, b: 0s32), expected: 2147483647s32)
  check32(actual: subtract32(a: -2147483648s32, b: 0s32), expected: -2147483648s32)
  check32(actual: multiply32(a: 2147483647s32, b: 1s32), expected: 2147483647s32)
  check32(actual: multiply32(a: -2147483648s32, b: 1s32), expected: -2147483648s32)
  check32(actual: divide32(a: -2147483648s32, b: 1s32), expected: -2147483648s32)
  check32(actual: divide32(a: 2147483647s32, b: 1s32), expected: 2147483647s32)
  check32(actual: divide32(a: 7s32, b: -3s32), expected: -2s32)
  check32(actual: divide32(a: -7s32, b: -3s32), expected: 2s32)
  check32(actual: modulo32(a: 7s32, b: -3s32), expected: 1s32)
  check32(actual: modulo32(a: -7s32, b: -3s32), expected: -1s32)
  check32(actual: modulo32(a: -2147483648s32, b: 1s32), expected: 0s32)
  check32(actual: negate32(2147483647s32), expected: -2147483647s32)
  check32(actual: negate32(0s32), expected: 0s32)
  Console.writeLine("s32 arithmetic ok")
end function
