// spec: 01-08 評価順序
import Benitoite.Unofficial.IO.Console

function consume(_first: Unit, _second: Unit) -> Unit
  return ()
end function

function nest(value: Unit) -> Unit
  return value
end function

function main() -> Unit uses Console.Write
  return consume(Console.writeLine("a"), nest(Console.writeLine("b")))
end function
