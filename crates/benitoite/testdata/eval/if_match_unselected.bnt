// spec: 01-08 評価順序
import Benitoite.Unofficial.IO.Console

data Choice
  First
  Second
end data

function main() -> Unit uses Console.Write
  if true then
    Console.writeLine("if-selected")
  else
    Console.writeLine("if-unselected")
  end if
  return match Choice.First with
    case Choice.First -> Console.writeLine("match-selected")
    case Choice.Second -> Console.writeLine("match-unselected")
  end match
end function
