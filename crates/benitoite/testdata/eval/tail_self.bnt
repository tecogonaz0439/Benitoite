// spec: 01-08 末尾呼び出し
import Benitoite.Unofficial.IO.Console

function sum_to(n: Integer, acc: Integer) -> Integer
  return if n = 0 then acc else sum_to(n - 1, acc + n) end if
end function

function main() -> Unit uses Console.Write
  return Console.writeLine(Integer.toString(sum_to(1000000, 0)))
end function
