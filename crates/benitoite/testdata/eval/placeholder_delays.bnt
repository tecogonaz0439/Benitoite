// spec: 01-08 評価順序
fn mark(label: String, value: Int) -> Int uses IO {
  Console.println(label)
  value
}

fn add(left: Int, right: Int) -> Int { left + right }

fn main() -> Unit uses IO {
  let add_ten = add(mark("fixed", 10), _)
  Console.println(Int.toString(add_ten(mark("argument-1", 1))))
  Console.println(Int.toString(add_ten(mark("argument-2", 2))))
}
