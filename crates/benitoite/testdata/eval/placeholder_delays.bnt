// spec: 01-08 評価順序
import Benitoite.Unofficial.IO.Console

function mark(label: String, value: Integer) -> Integer uses Console.Write
  Console.writeLine(label)
  return value
end function

function add(left: Integer, right: Integer) -> Integer
  return left + right
end function

function main() -> Unit uses Console.Write
  bind add_ten <- add(left: mark(label: "fixed", value: 10), right: _)
  Console.writeLine(Integer.toString(add_ten(mark(label: "argument-1", value: 1))))
  return Console.writeLine(Integer.toString(add_ten(mark(label: "argument-2", value: 2))))
end function
