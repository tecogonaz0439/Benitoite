// spec: 01-08 末尾呼び出し
import Benitoite.Unofficial.IO.Console

function is_even(n: Integer) -> Boolean
  return if n = 0 then true else is_odd(n - 1) end if
end function

function is_odd(n: Integer) -> Boolean
  return if n = 0 then false else is_even(n - 1) end if
end function

function main() -> Unit uses Console.Write
  return Console.writeLine(if is_even(1000000) then "true" else "false" end if)
end function
