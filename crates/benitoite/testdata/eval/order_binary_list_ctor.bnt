// spec: 01-08 評価順序
import Benitoite.Unofficial.IO.Console

data Pair
  Pair(Integer, Integer)
end data

function mark(label: String, value: Integer) -> Integer uses Console.Write
  Console.writeLine(label)
  return value
end function

function main() -> Unit uses Console.Write
  bind total <- mark(label: "binary-left", value: 1) + mark(label: "binary-right", value: 2)
  bind values <- [mark(label: "list-1", value: 3), mark(label: "list-2", value: 4)]
  bind pair <- Pair(mark(label: "constructor-1", value: 5), mark(label: "constructor-2", value: 6))
  return match pair with
    case Pair(left, right) ->
      Console.writeLine(Integer.toString(total + Option.unwrapOr(o: List.get(xs: values, i: 1), fallback: 0) + left + right))

  end match
end function
