// spec: 01-08 評価順序
import Benitoite.Unofficial.IO.Console

data Pair
  Pair(Integer, Integer)
end data

function mark(label: String, value: Integer) -> Integer uses Console.Write
  Console.writeLine(label)
  return value
end function

function main() -> Unit uses Console.Write
  bind total <- mark("binary-left", 1) + mark("binary-right", 2)
  bind values <- [mark("list-1", 3), mark("list-2", 4)]
  bind pair <- Pair(mark("constructor-1", 5), mark("constructor-2", 6))
  return match pair with
    case Pair(left, right) ->
      Console.writeLine(Integer.toString(total + Option.unwrapOr(List.get(values, 1), 0) + left + right))

  end match
end function
