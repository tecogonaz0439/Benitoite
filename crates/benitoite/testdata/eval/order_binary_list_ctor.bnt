// spec: 01-08 評価順序
type Pair { Pair(Int, Int) }

fn mark(label: String, value: Int) -> Int uses IO {
  Console.println(label)
  value
}

fn main() -> Unit uses IO {
  let total = mark("binary-left", 1) + mark("binary-right", 2)
  let values = [mark("list-1", 3), mark("list-2", 4)]
  let pair = Pair.Pair(mark("constructor-1", 5), mark("constructor-2", 6))
  match pair {
    Pair.Pair(left, right) => {
      Console.println(Int.toString(total + Option.unwrapOr(List.get(values, 1), 0) + left + right))
    }
  }
}
