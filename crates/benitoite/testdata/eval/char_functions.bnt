// spec: 01-04 Character
import Benitoite.Unofficial.IO.Console

function show_char(value: Option[Character]) -> String
  return match value with
    case Option.Some(character) -> "Some(" + Character.toString(character) + ")"
    case Option.None -> "None"
  end match
end function

function bool_text(value: Boolean) -> String
  return if value then "true" else "false" end if
end function

function main() -> Unit uses Console.Write
  Console.writeLine(Integer.toString(Character.toInteger('A')))
  Console.writeLine(show_char(Character.fromInteger(1114111)))
  Console.writeLine(show_char(Character.fromInteger(55296)))
  Console.writeLine(show_char(Character.fromInteger(1114112)))
  Console.writeLine(show_char(Character.fromInteger(-1)))
  Console.writeLine(Character.toString('é'))
  Console.writeLine(bool_text(Character.isASCIIDigit('7')))
  Console.writeLine(bool_text(Character.isASCIIDigit('é')))
  Console.writeLine(bool_text(Character.isASCIIWhitespace(' ')))
  Console.writeLine(bool_text(Character.isASCIIWhitespace('\t')))
  Console.writeLine(bool_text(Character.isASCIIWhitespace('\n')))
  Console.writeLine(bool_text(Character.isASCIIWhitespace('\r')))
  return Console.writeLine(bool_text(Character.isASCIIWhitespace('\u{b}')))
end function
