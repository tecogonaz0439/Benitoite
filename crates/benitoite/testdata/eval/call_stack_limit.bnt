// spec: 01-08 資源の不足
import Benitoite.Unofficial.IO.Console

function recurse(n: Integer) -> Integer
  return if n = 0 then
    0
  else
    bind result <- recurse(n - 1)
    result + 1
  end if
end function

function main() -> Unit uses Console.Write
  return Console.writeLine(Integer.toString(recurse(10000)))
end function
