// spec: 01-04 Float
import Benitoite.Unofficial.IO.Console

function bool_text(value: Boolean) -> String
  return if value then "true" else "false" end if
end function

function main() -> Unit uses Console.Write
  bind positive_infinity <- 1.0 / 0.0
  bind nan <- 0.0 / 0.0
  Console.writeLine(Float.toString(positive_infinity))
  Console.writeLine(Float.toString(nan))
  Console.writeLine(Float.toString(Float.absolute(-2.5)))
  Console.writeLine(Float.toString(Float.squareRoot(9.0)))
  Console.writeLine(Float.toString(Float.squareRoot(-1.0)))
  Console.writeLine(Float.toString(1.5 + 2.5))
  Console.writeLine(Float.toString(5.0 - 2.0))
  Console.writeLine(Float.toString(2.0 * 3.0))
  Console.writeLine(bool_text(0.0 = -0.0))
  Console.writeLine(bool_text(nan = nan))
  Console.writeLine(bool_text(nan <> nan))
  Console.writeLine(bool_text(nan < 0.0))
  return Console.writeLine(bool_text(Float.isNaN(nan)))
end function
