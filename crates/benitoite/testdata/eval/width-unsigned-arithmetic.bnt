// 定数と引数経由の算術を、独立した期待値との差で確かめる。差が負なら減算で、
// 正なら最大値への加算で停止するため、比較と文字列化を必要としない。
import Benitoite.Unofficial.IO.Console
function check16(actual: UnsignedInteger16, expected: UnsignedInteger16) -> Unit
  bind difference <- actual - expected
  bind _ <- difference + 65535u16
end function
function add16(a: UnsignedInteger16, b: UnsignedInteger16) -> UnsignedInteger16
  return a + b
end function
function subtract16(a: UnsignedInteger16, b: UnsignedInteger16) -> UnsignedInteger16
  return a - b
end function
function multiply16(a: UnsignedInteger16, b: UnsignedInteger16) -> UnsignedInteger16
  return a * b
end function
function divide16(a: UnsignedInteger16, b: UnsignedInteger16) -> UnsignedInteger16
  return a div b
end function
function modulo16(a: UnsignedInteger16, b: UnsignedInteger16) -> UnsignedInteger16
  return a mod b
end function
const sum16: UnsignedInteger16 = 32768u16 + 1u16
const difference16: UnsignedInteger16 = 65535u16 - 1u16
const product16: UnsignedInteger16 = 16384u16 * 2u16
const quotient16: UnsignedInteger16 = 65535u16 div 2u16
const remainder16: UnsignedInteger16 = 65535u16 mod 32768u16
function check32(actual: UnsignedInteger32, expected: UnsignedInteger32) -> Unit
  bind difference <- actual - expected
  bind _ <- difference + 4294967295u32
end function
function add32(a: UnsignedInteger32, b: UnsignedInteger32) -> UnsignedInteger32
  return a + b
end function
function subtract32(a: UnsignedInteger32, b: UnsignedInteger32) -> UnsignedInteger32
  return a - b
end function
function multiply32(a: UnsignedInteger32, b: UnsignedInteger32) -> UnsignedInteger32
  return a * b
end function
function divide32(a: UnsignedInteger32, b: UnsignedInteger32) -> UnsignedInteger32
  return a div b
end function
function modulo32(a: UnsignedInteger32, b: UnsignedInteger32) -> UnsignedInteger32
  return a mod b
end function
const sum32: UnsignedInteger32 = 2147483648u32 + 1u32
const difference32: UnsignedInteger32 = 4294967295u32 - 1u32
const product32: UnsignedInteger32 = 1073741824u32 * 2u32
const quotient32: UnsignedInteger32 = 4294967295u32 div 2u32
const remainder32: UnsignedInteger32 = 4294967295u32 mod 2147483648u32
function check64(actual: UnsignedInteger64, expected: UnsignedInteger64) -> Unit
  bind difference <- actual - expected
  bind _ <- difference + 18446744073709551615u64
end function
function add64(a: UnsignedInteger64, b: UnsignedInteger64) -> UnsignedInteger64
  return a + b
end function
function subtract64(a: UnsignedInteger64, b: UnsignedInteger64) -> UnsignedInteger64
  return a - b
end function
function multiply64(a: UnsignedInteger64, b: UnsignedInteger64) -> UnsignedInteger64
  return a * b
end function
function divide64(a: UnsignedInteger64, b: UnsignedInteger64) -> UnsignedInteger64
  return a div b
end function
function modulo64(a: UnsignedInteger64, b: UnsignedInteger64) -> UnsignedInteger64
  return a mod b
end function
const sum64: UnsignedInteger64 = 9223372036854775808u64 + 1u64
const difference64: UnsignedInteger64 = 18446744073709551615u64 - 1u64
const product64: UnsignedInteger64 = 4611686018427387904u64 * 2u64
const quotient64: UnsignedInteger64 = 18446744073709551615u64 div 2u64
const remainder64: UnsignedInteger64 = 18446744073709551615u64 mod 9223372036854775808u64
function main() -> Unit uses Console.Write
  check16(actual: sum16, expected: 32769u16)
  check16(actual: difference16, expected: 65534u16)
  check16(actual: product16, expected: 32768u16)
  check16(actual: quotient16, expected: 32767u16)
  check16(actual: remainder16, expected: 32767u16)
  check16(actual: add16(a: 32768u16, b: 1u16), expected: 32769u16)
  check16(actual: add16(a: 65534u16, b: 1u16), expected: 65535u16)
  check16(actual: add16(a: 65535u16, b: 0u16), expected: 65535u16)
  check16(actual: add16(a: 0u16, b: 65535u16), expected: 65535u16)
  check16(actual: subtract16(a: 65535u16, b: 1u16), expected: 65534u16)
  check16(actual: subtract16(a: 65535u16, b: 32768u16), expected: 32767u16)
  check16(actual: subtract16(a: 0u16, b: 0u16), expected: 0u16)
  check16(actual: subtract16(a: 65535u16, b: 65535u16), expected: 0u16)
  check16(actual: multiply16(a: 16384u16, b: 2u16), expected: 32768u16)
  check16(actual: multiply16(a: 65535u16, b: 1u16), expected: 65535u16)
  check16(actual: multiply16(a: 0u16, b: 65535u16), expected: 0u16)
  check16(actual: divide16(a: 65535u16, b: 2u16), expected: 32767u16)
  check16(actual: divide16(a: 65535u16, b: 32768u16), expected: 1u16)
  check16(actual: divide16(a: 65535u16, b: 1u16), expected: 65535u16)
  check16(actual: divide16(a: 0u16, b: 65535u16), expected: 0u16)
  check16(actual: divide16(a: 32767u16, b: 32768u16), expected: 0u16)
  check16(actual: modulo16(a: 65535u16, b: 2u16), expected: 1u16)
  check16(actual: modulo16(a: 65535u16, b: 32768u16), expected: 32767u16)
  check16(actual: modulo16(a: 32768u16, b: 65535u16), expected: 32768u16)
  check16(actual: modulo16(a: 65535u16, b: 1u16), expected: 0u16)
  check16(actual: modulo16(a: 0u16, b: 65535u16), expected: 0u16)
  Console.writeLine("u16 arithmetic ok")
  check32(actual: sum32, expected: 2147483649u32)
  check32(actual: difference32, expected: 4294967294u32)
  check32(actual: product32, expected: 2147483648u32)
  check32(actual: quotient32, expected: 2147483647u32)
  check32(actual: remainder32, expected: 2147483647u32)
  check32(actual: add32(a: 2147483648u32, b: 1u32), expected: 2147483649u32)
  check32(actual: add32(a: 4294967294u32, b: 1u32), expected: 4294967295u32)
  check32(actual: add32(a: 4294967295u32, b: 0u32), expected: 4294967295u32)
  check32(actual: add32(a: 0u32, b: 4294967295u32), expected: 4294967295u32)
  check32(actual: subtract32(a: 4294967295u32, b: 1u32), expected: 4294967294u32)
  check32(actual: subtract32(a: 4294967295u32, b: 2147483648u32), expected: 2147483647u32)
  check32(actual: subtract32(a: 0u32, b: 0u32), expected: 0u32)
  check32(actual: subtract32(a: 4294967295u32, b: 4294967295u32), expected: 0u32)
  check32(actual: multiply32(a: 1073741824u32, b: 2u32), expected: 2147483648u32)
  check32(actual: multiply32(a: 4294967295u32, b: 1u32), expected: 4294967295u32)
  check32(actual: multiply32(a: 0u32, b: 4294967295u32), expected: 0u32)
  check32(actual: divide32(a: 4294967295u32, b: 2u32), expected: 2147483647u32)
  check32(actual: divide32(a: 4294967295u32, b: 2147483648u32), expected: 1u32)
  check32(actual: divide32(a: 4294967295u32, b: 1u32), expected: 4294967295u32)
  check32(actual: divide32(a: 0u32, b: 4294967295u32), expected: 0u32)
  check32(actual: divide32(a: 2147483647u32, b: 2147483648u32), expected: 0u32)
  check32(actual: modulo32(a: 4294967295u32, b: 2u32), expected: 1u32)
  check32(actual: modulo32(a: 4294967295u32, b: 2147483648u32), expected: 2147483647u32)
  check32(actual: modulo32(a: 2147483648u32, b: 4294967295u32), expected: 2147483648u32)
  check32(actual: modulo32(a: 4294967295u32, b: 1u32), expected: 0u32)
  check32(actual: modulo32(a: 0u32, b: 4294967295u32), expected: 0u32)
  Console.writeLine("u32 arithmetic ok")
  check64(actual: sum64, expected: 9223372036854775809u64)
  check64(actual: difference64, expected: 18446744073709551614u64)
  check64(actual: product64, expected: 9223372036854775808u64)
  check64(actual: quotient64, expected: 9223372036854775807u64)
  check64(actual: remainder64, expected: 9223372036854775807u64)
  check64(actual: add64(a: 9223372036854775808u64, b: 1u64), expected: 9223372036854775809u64)
  check64(actual: add64(a: 18446744073709551614u64, b: 1u64), expected: 18446744073709551615u64)
  check64(actual: add64(a: 18446744073709551615u64, b: 0u64), expected: 18446744073709551615u64)
  check64(actual: add64(a: 0u64, b: 18446744073709551615u64), expected: 18446744073709551615u64)
  check64(actual: subtract64(a: 18446744073709551615u64, b: 1u64), expected: 18446744073709551614u64)
  check64(actual: subtract64(a: 18446744073709551615u64, b: 9223372036854775808u64), expected: 9223372036854775807u64)
  check64(actual: subtract64(a: 0u64, b: 0u64), expected: 0u64)
  check64(actual: subtract64(a: 18446744073709551615u64, b: 18446744073709551615u64), expected: 0u64)
  check64(actual: multiply64(a: 4611686018427387904u64, b: 2u64), expected: 9223372036854775808u64)
  check64(actual: multiply64(a: 18446744073709551615u64, b: 1u64), expected: 18446744073709551615u64)
  check64(actual: multiply64(a: 0u64, b: 18446744073709551615u64), expected: 0u64)
  check64(actual: divide64(a: 18446744073709551615u64, b: 2u64), expected: 9223372036854775807u64)
  check64(actual: divide64(a: 18446744073709551615u64, b: 9223372036854775808u64), expected: 1u64)
  check64(actual: divide64(a: 18446744073709551615u64, b: 1u64), expected: 18446744073709551615u64)
  check64(actual: divide64(a: 0u64, b: 18446744073709551615u64), expected: 0u64)
  check64(actual: divide64(a: 9223372036854775807u64, b: 9223372036854775808u64), expected: 0u64)
  check64(actual: modulo64(a: 18446744073709551615u64, b: 2u64), expected: 1u64)
  check64(actual: modulo64(a: 18446744073709551615u64, b: 9223372036854775808u64), expected: 9223372036854775807u64)
  check64(actual: modulo64(a: 9223372036854775808u64, b: 18446744073709551615u64), expected: 9223372036854775808u64)
  check64(actual: modulo64(a: 18446744073709551615u64, b: 1u64), expected: 0u64)
  check64(actual: modulo64(a: 0u64, b: 18446744073709551615u64), expected: 0u64)
  Console.writeLine("u64 arithmetic ok")
end function
