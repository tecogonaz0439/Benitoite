// spec: 01-04 Int
fn main() -> Unit uses IO {
  Console.println(Int.toString(-7 / 2))
  Console.println(Int.toString(-7 % 2))
  Console.println(Int.toString(7 % -2))
  Console.println(Int.toString(Int.floorDiv(-7, 2)))
  Console.println(Int.toString(Int.mod(-7, 2)))
  Console.println(Int.toString(-9223372036854775808 % -1))
}
