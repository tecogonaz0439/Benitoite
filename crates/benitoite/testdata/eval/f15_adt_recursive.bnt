// spec: 01-05 型の宣言
// spec: 01-05 値の構築
// spec: 01-05 パターン
// spec: 01-08 関数の呼び出し
import Benitoite.Unofficial.IO.Console
data Tree
 Leaf(Integer)
 Branch(Tree, Tree)
end data
function sum(tree: Tree) -> Integer
 return match tree with
 case Tree.Leaf(value) -> value
 case Tree.Branch(left, right) -> sum(left) + sum(right)
 end match
end function
function main() -> Unit uses Console.Write
 bind tree <- Tree.Branch(Tree.Branch(Tree.Leaf(1), Tree.Leaf(2)), Tree.Branch(Tree.Leaf(3), Tree.Leaf(4)))
 Console.writeLine(Integer.toString(sum(tree)))
end function
