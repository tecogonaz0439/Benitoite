// spec: 01-08 評価順序
import Benitoite.Unofficial.IO.Console

function main() -> Unit uses Console.Write
  bind values <- [1, 2, 3]
  bind mapped <- List.map(values, lambda(value)
    Console.writeLine("map " + Integer.toString(value))
    return value * 2
  end lambda)
  Console.writeLine(String.join(List.map(mapped, lambda(value) return Integer.toString(value) end lambda), ","))
  bind filtered <- List.filter(values, lambda(value)
    Console.writeLine("filter " + Integer.toString(value))
    return value <> 2
  end lambda)
  Console.writeLine(String.join(List.map(filtered, lambda(value) return Integer.toString(value) end lambda), ","))
  bind total <- List.fold(values, 0, lambda(acc, value)
    Console.writeLine("fold " + Integer.toString(acc) + " " + Integer.toString(value))
    return acc + value
  end lambda)
  Console.writeLine(Integer.toString(total))
  List.forEach(values, lambda(value) return Console.writeLine("each " + Integer.toString(value)) end lambda)
  Console.writeLine(if List.any(values, lambda(value)
    Console.writeLine("any " + Integer.toString(value))
    return value = 2
  end lambda) then "true" else "false" end if)
  Console.writeLine(if List.all(values, lambda(value)
    Console.writeLine("all " + Integer.toString(value))
    return value < 2
  end lambda) then "true" else "false" end if)
  bind found <- List.find(values, lambda(value)
    Console.writeLine("find " + Integer.toString(value))
    return value = 2
  end lambda)
  return Console.writeLine(match found with
    case Option.Some(value) -> Integer.toString(value)
    case Option.None -> "None"
  end match)
end function
