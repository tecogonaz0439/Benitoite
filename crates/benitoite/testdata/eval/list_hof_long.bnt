// spec: 01-08 正格評価
// 100 万要素では二方式と参照インタプリタを走らせるゴールデン検査に 81 秒かかったため、5 万要素に抑える。64 KiB の上限で長さに比例した入れ子も検出する（設計書 03-06「関数を引数にとる関数の共通の規則」、07-03「差分テスト」）。
import Benitoite.Unofficial.IO.Console

function main() -> Unit uses Console.Write
  bind values <- List.range(0, 50000)
  bind mapped <- List.map(values, lambda(value) return value end lambda)
  bind filtered <- List.filter(mapped, lambda(value) return value < 0 end lambda)
  bind total <- List.fold(mapped, 0, lambda(acc, value) return acc + value end lambda)
  Console.writeLine(Integer.toString(List.length(mapped)))
  Console.writeLine(Integer.toString(List.length(filtered)))
  return Console.writeLine(Integer.toString(total))
end function
