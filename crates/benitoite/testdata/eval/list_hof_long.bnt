// spec: 01-08 正格評価
// ゴールデン検査の時間を抑えるため、5 万要素に抑える。差分比較からは外す。64 KiB の上限で長さに比例した入れ子も検出する（設計書 03-06「関数を引数にとる関数の共通の規則」、07-03「差分テスト」）。
import Benitoite.Unofficial.IO.Console

function main() -> Unit uses Console.Write
  bind values <- List.range(start: 0, stop: 50000)
  bind mapped <- List.map(xs: values, f: lambda(value) return value end lambda)
  bind filtered <- List.filter(xs: mapped, p: lambda(value) return value < 0 end lambda)
  bind total <- List.fold(xs: mapped, initial: 0, f: lambda(acc, value) return acc + value end lambda)
  Console.writeLine(Integer.toString(List.length(mapped)))
  Console.writeLine(Integer.toString(List.length(filtered)))
  return Console.writeLine(Integer.toString(total))
end function
