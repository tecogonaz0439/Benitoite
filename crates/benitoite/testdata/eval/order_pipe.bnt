// spec: 01-08 評価順序
import Benitoite.Unofficial.IO.Console

function read() -> List[String] uses Console.Write
  Console.writeLine("read")
  return ["", "x"]
end function

function keep_nonempty(value: String) -> Boolean uses Console.Write
  Console.writeLine(value)
  return not String.isEmpty(value)
end function

function main() -> Unit uses Console.Write
  bind filtered <- read() |> List.filter(keep_nonempty)
  return Console.writeLine(Integer.toString(List.length(filtered)))
end function
