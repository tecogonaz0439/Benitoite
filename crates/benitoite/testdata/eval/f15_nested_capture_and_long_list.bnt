function curry(x: Integer) -> function() -> function(y: Integer) -> Integer
 return lambda() return lambda(y: Integer) return x + y end lambda end lambda
end function
function main() -> Unit uses Console.Write
 Console.writeLine(Integer.toString(deep(7)))
 bind outer <- curry(3)
 bind inner <- outer()
 Console.writeLine(Integer.toString(inner(4)))
 Console.writeLine(Integer.toString(List.fold(xs: List.map(xs: List.range(start: 0, stop: 512), f: lambda(value) return value + 1 end lambda), initial: 0, f: lambda(acc, value) return acc + value end lambda)))
end function
