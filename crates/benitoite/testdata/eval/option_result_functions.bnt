// spec: 01-05 prelude が定める型
import Benitoite.Unofficial.IO.Console

function show_option(value: Option[Integer]) -> String
  return match value with
    case Option.Some(number) -> "Some(" + Integer.toString(number) + ")"
    case Option.None -> "None"
  end match
end function

function show_result(value: Result[Integer, String]) -> String
  return match value with
    case Result.Ok(number) -> "Ok(" + Integer.toString(number) + ")"
    case Result.Error(message) -> "Err(" + message + ")"
  end match
end function

function main() -> Unit uses Console.Write
  Console.writeLine(show_option(Option.map(o: Option.Some(2), f: lambda(value) return value * 3 end lambda)))
  Console.writeLine(show_option(Option.map(o: Option.None, f: lambda(value: Integer) return value * 3 end lambda)))
  Console.writeLine(show_option(Option.andThen(o: Option.Some(2), f: lambda(value) return Option.Some(value + 1) end lambda)))
  Console.writeLine(show_option(Option.andThen(o: Option.None, f: lambda(value: Integer) return Option.Some(value + 1) end lambda)))
  Console.writeLine(Integer.toString(Option.unwrapOr(o: Option.Some(4), fallback: 9)))
  Console.writeLine(Integer.toString(Option.unwrapOr(o: Option.None, fallback: 9)))
  Console.writeLine(if Option.isSome(Option.Some(1)) then "true" else "false" end if)
  Console.writeLine(if Option.isNone(Option.None) then "true" else "false" end if)
  Console.writeLine(show_result(Option.okOr(o: Option.Some(5), error: "missing")))
  Console.writeLine(show_result(Option.okOr(o: Option.None, error: "missing")))
  Console.writeLine(show_result(Result.map(r: Result.Ok(2), f: lambda(value) return value + 3 end lambda)))
  Console.writeLine(show_result(Result.map(r: Result.Error("bad"), f: lambda(value: Integer) return value + 3 end lambda)))
  Console.writeLine(show_result(Result.mapError(r: Result.Ok(3), f: lambda(error: String) return error + "!" end lambda)))
  Console.writeLine(show_result(Result.mapError(r: Result.Error("bad"), f: lambda(error) return error + "!" end lambda)))
  Console.writeLine(show_result(Result.andThen(r: Result.Ok(4), f: lambda(value) return Result.Ok(value + 1) end lambda)))
  Console.writeLine(show_result(Result.andThen(r: Result.Error("bad"), f: lambda(value: Integer) return Result.Ok(value + 1) end lambda)))
  Console.writeLine(Integer.toString(Result.unwrapOr(r: Result.Ok(6), fallback: 9)))
  Console.writeLine(Integer.toString(Result.unwrapOr(r: Result.Error("bad"), fallback: 9)))
  Console.writeLine(if Result.isOk(Result.Ok(1)) then "true" else "false" end if)
  Console.writeLine(if Result.isError(Result.Error("bad")) then "true" else "false" end if)
  Console.writeLine(match Result.ok(Result.Ok(7)) with
    case Option.Some(value) -> Integer.toString(value)
    case Option.None -> "None"
  end match)
  return Console.writeLine(match Result.ok(Result.Error("bad")) with
    case Option.Some(value) -> Integer.toString(value)
    case Option.None -> "None"
  end match)
end function
