// spec: 01-05 prelude が定める型
import Benitoite.Unofficial.IO.Console

function show_option(value: Option[Integer]) -> String
  return match value with
    case Option.Some(number) -> "Some(" + Integer.toString(number) + ")"
    case Option.None -> "None"
  end match
end function

function show_result(value: Result[Integer, String]) -> String
  return match value with
    case Result.Ok(number) -> "Ok(" + Integer.toString(number) + ")"
    case Result.Error(message) -> "Err(" + message + ")"
  end match
end function

function main() -> Unit uses Console.Write
  Console.writeLine(show_option(Option.map(Option.Some(2), lambda(value) return value * 3 end lambda)))
  Console.writeLine(show_option(Option.map(Option.None, lambda(value: Integer) return value * 3 end lambda)))
  Console.writeLine(show_option(Option.andThen(Option.Some(2), lambda(value) return Option.Some(value + 1) end lambda)))
  Console.writeLine(show_option(Option.andThen(Option.None, lambda(value: Integer) return Option.Some(value + 1) end lambda)))
  Console.writeLine(Integer.toString(Option.unwrapOr(Option.Some(4), 9)))
  Console.writeLine(Integer.toString(Option.unwrapOr(Option.None, 9)))
  Console.writeLine(if Option.isSome(Option.Some(1)) then "true" else "false" end if)
  Console.writeLine(if Option.isNone(Option.None) then "true" else "false" end if)
  Console.writeLine(show_result(Option.okOr(Option.Some(5), "missing")))
  Console.writeLine(show_result(Option.okOr(Option.None, "missing")))
  Console.writeLine(show_result(Result.map(Result.Ok(2), lambda(value) return value + 3 end lambda)))
  Console.writeLine(show_result(Result.map(Result.Error("bad"), lambda(value: Integer) return value + 3 end lambda)))
  Console.writeLine(show_result(Result.mapError(Result.Ok(3), lambda(message: String) return message + "!" end lambda)))
  Console.writeLine(show_result(Result.mapError(Result.Error("bad"), lambda(message) return message + "!" end lambda)))
  Console.writeLine(show_result(Result.andThen(Result.Ok(4), lambda(value) return Result.Ok(value + 1) end lambda)))
  Console.writeLine(show_result(Result.andThen(Result.Error("bad"), lambda(value: Integer) return Result.Ok(value + 1) end lambda)))
  Console.writeLine(Integer.toString(Result.unwrapOr(Result.Ok(6), 9)))
  Console.writeLine(Integer.toString(Result.unwrapOr(Result.Error("bad"), 9)))
  Console.writeLine(if Result.isOk(Result.Ok(1)) then "true" else "false" end if)
  Console.writeLine(if Result.isError(Result.Error("bad")) then "true" else "false" end if)
  Console.writeLine(match Result.ok(Result.Ok(7)) with
    case Option.Some(value) -> Integer.toString(value)
    case Option.None -> "None"
  end match)
  return Console.writeLine(match Result.ok(Result.Error("bad")) with
    case Option.Some(value) -> Integer.toString(value)
    case Option.None -> "None"
  end match)
end function
