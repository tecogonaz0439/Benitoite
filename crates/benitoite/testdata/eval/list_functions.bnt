// spec: 01-08 正格評価
fn show_ints(values: List[Int]) -> String {
  String.join(List.map(values, fn(value) { Int.toString(value) }), ",")
}

fn show_option_int(value: Option[Int]) -> String {
  match value {
    Some(number) => "Some(" + Int.toString(number) + ")"
    None => "None"
  }
}

fn main() -> Unit uses IO {
  Console.println(Int.toString(List.length([])))
  Console.println(if List.isEmpty([]) { "true" } else { "false" })
  Console.println(show_option_int(List.head([])))
  Console.println(show_option_int(List.head([8, 9])))
  Console.println(show_ints(List.tail([8, 9]) |> Option.unwrapOr([])))
  Console.println(show_option_int(List.tail([]) |> Option.map(fn(values) { List.length(values) })))
  Console.println(show_option_int(List.get([10, 20, 30], -1)))
  Console.println(show_option_int(List.get([10, 20, 30], 3)))
  Console.println(show_ints(List.take([1, 2, 3], -1)))
  Console.println(show_ints(List.take([1, 2, 3], 9)))
  Console.println(show_ints(List.drop([1, 2, 3], -1)))
  Console.println(show_ints(List.drop([1, 2, 3], 9)))
  Console.println(show_ints(List.range(4, 2)))
  Console.println(show_ints(List.range(2, 5)))
  Console.println(if List.contains([1, 2, 3], 2) { "true" } else { "false" })
  Console.println(show_ints(List.concat([1, 2], [3, 4])))
  Console.println(show_ints(List.reverse([1, 2, 3])))
  Console.println(show_ints(List.prepend([2, 3], 1)))
  Console.println(show_ints(List.append([1, 2], 3)))
}
