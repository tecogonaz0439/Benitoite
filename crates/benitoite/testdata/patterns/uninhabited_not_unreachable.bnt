// spec: 01-05 選ばれない分岐の検査
import Benitoite.Unofficial.IO.Console

data L
    Mk(L)
end data

function inspect(value: L) -> Unit
    return match value with
        case L.Mk(_) -> ()
    end match
end function

function main() -> Unit uses Console.Write
    return Console.writeLine("ok")
end function
