// spec: 01-05 パターン
// spec: 01-05 match の意味
import Benitoite.Unofficial.IO.Console

data Expr
    Lit(Integer)
    Add(Expr, Expr)
end data

function evaluate(expression: Expr) -> Integer
    return match expression with
        case Expr.Lit(0) -> 0
        case Expr.Lit(value) -> value
        case Expr.Add(Expr.Lit(left), Expr.Lit(right)) -> left + right
        case Expr.Add(_, _) -> -1
    end match
end function

function main() -> Unit uses Console.Write
    bind expression <- Expr.Add(Expr.Lit(2), Expr.Lit(3))
    return Console.writeLine(Integer.toString(evaluate(expression)))
end function
