// spec: 01-05 網羅性の検査
import Benitoite.Unofficial.IO.Console

function float_name(value: Float) -> String
    return match value with
        case _ -> "float"
    end match
end function

function list_size(values: List[Integer]) -> Integer
    return match values with
        case items -> List.length(items)
    end match
end function

function main() -> Unit uses Console.Write
    Console.writeLine(float_name(1.0))
    return Console.writeLine(Integer.toString(list_size([1, 2])))
end function
