// spec: 01-05 網羅性の検査
function int_case(value: Integer) -> Unit
    return match value with
        case 0 -> ()
        case 1 -> ()
    end match
end function

function string_case(value: String) -> Unit
    return match value with
        case "a" -> ()
        case "b" -> ()
    end match
end function

function char_case(value: Character) -> Unit
    return match value with
        case 'a' -> ()
        case 'b' -> ()
    end match
end function

function main() -> Unit
    return ()
end function
