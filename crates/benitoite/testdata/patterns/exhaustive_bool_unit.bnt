// spec: 01-05 網羅性の検査
// spec: 01-04 Boolean
// spec: 01-04 Unit
import Benitoite.Unofficial.IO.Console

function main() -> Unit uses Console.Write
    bind boolean <- match true with
        case true -> "true"
        case false -> "false"
    end match
    bind unit <- match () with
        case () -> "unit"
    end match
    return Console.writeLine(boolean + " " + unit)
end function
