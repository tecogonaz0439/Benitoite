// spec: 01-05 パターンの拡張（初回リリース版）
function f(xs: List[Integer]) -> Unit
  match xs with
    case [], [x] -> ()
    case _ -> ()
  end match
end function
function g(xs: List[Integer]) -> Unit
  match xs with
    case [x], [] -> ()
    case _ -> ()
  end match
end function
function main() -> Unit
  ()
end function
