// spec: 01-06 型クラス（初回リリース版）
// spec: 01-02 型クラス（初回リリース版）
// spec: 01-06 組み込みの制約（初回リリース版）
import Benitoite.Unofficial.IO.Console
trait Echo[T]
  function echo(x: T) -> T
end trait
implement Echo[Integer]
  function echo(x: Integer) -> Integer return x end function
end implement
implement[T: Echo] Echo[Option[T]]
  function echo(x: Option[T]) -> Option[T]
    return Option.map(x, Echo.echo)
  end function
end implement
function repeated[T: Echo & equality](x: T) -> Boolean
  return Echo.echo(x) = x
end function
function main() -> Unit uses Console.Write
  Console.writeLine("${repeated(Option.Some(7))}")
end function
