// spec: 01-06 標準の型クラス（初回リリース版）
import Benitoite.Trait
function pairWith[A, B](first: A) -> function(value: B) -> Pair[A, B]
  return lambda(value) return Pair(first, value) end lambda
end function
function pairUp[F[_]: Trait.Monad, A, B](xs: F[A], ys: F[B]) -> F[Pair[A, B]]
  return Trait.Monad.flatMap(x: xs, f: lambda(value)
    return Trait.Functor.map(x: ys, f: pairWith(value))
  end lambda)
end function
function main() -> Unit
  bind _ <- Trait.Show.show([Option.Some(Pair(1, "a"))])
  bind _ <- Trait.Order.compare(x: [1, 2], y: [1, 3])
  bind _ <- pairUp(xs: [1, 2], ys: ["a", "b"])
  bind _ <- pairUp(xs: Option.Some(1), ys: Option.Some("a"))
end function
