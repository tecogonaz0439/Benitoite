// spec: 01-06 型クラス（初回リリース版）
trait Score[T]
  function score(x: T) -> Integer
end trait
implement Score[function(value: Integer) -> Integer]
  function score(x: function(value: Integer) -> Integer) -> Integer
    return 0
  end function
end implement
trait Other[T]
  function score(x: T) -> Integer
end trait
function use(f: function(value: Integer) -> Integer) -> Unit
  bind _ <- Score.score(1)
  bind _ <- Other.score(f)
end function
function main() -> Unit
  ()
end function
