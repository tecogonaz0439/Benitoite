// spec: 01-06 型の別名（初回リリース版）
// spec: 01-06 型クラス（初回リリース版）
type Bad = Option[Integer, Integer]
trait Score[T]
  function score(x: T) -> Integer
end trait
implement Score[Bad]
  function score(x: Bad) -> Integer
    return 0
  end function
end implement
implement Score[Unit]
  function score(x: Unit) -> Integer
    return 0
  end function
end implement
function use() -> Unit
  bind x: Bad <- ()
  bind _ <- Score.score(x)
  bind _ <- Score.score(x)
  bind _ <- Score.score(())
end function
function main() -> Unit
  ()
end function
