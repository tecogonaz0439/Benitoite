// spec: 01-06 型クラス（初回リリース版）
trait Echo[T]
  function echo(x: T) -> T
end trait
implement Echo[Integer]
  function echo(x: Integer) -> String return "bad" end function
end implement
function use() -> Unit
  bind _ <- Echo.echo(1)
  bind _ <- Echo.echo(2)
end function
function main() -> Unit
  ()
end function
