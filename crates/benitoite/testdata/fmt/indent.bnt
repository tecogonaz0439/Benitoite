// spec: 01-02 ブロックと文
// 06-03「字下げ」
import Benitoite.IO.Console

function classify(n: Integer) -> String
      if n < 0 then
  return "negative"
        else if n = 0 then
  return "zero"
            else
                  bind label <- match n with
              case 1 -> "one"
                         case _ ->
           "many"
                  end match
  return label
    end if
end function

function main() -> Unit uses Console.Write
List.forEach([1, 2], lambda(item)
      Console.writeLine(classify(item))
        end lambda)
      bind total <- 1
  + 2
       + 3
  Console.writeLine(
            "${total}"
              )
end function
