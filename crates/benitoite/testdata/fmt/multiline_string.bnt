// spec: 01-01 複数行の文字列と raw 文字列（初回リリース版）
// 06-03「複数行の文字列」
import Benitoite.IO.Console

function main() -> Unit uses Console.Write
bind deeper <- """
  first
    indented${1}

  last
  """
          bind shallower <- r"""
            raw \n
            """
  Console.writeLine(deeper)
  Console.writeLine(shallower)
end function
