// spec: 01-07 IO の失敗
// spec: 01-07 IO を行う組み込み関数
import Benitoite.Unofficial.IO.Console
import Benitoite.Unofficial.IO.File

function main() -> Unit uses Console.Write, File.Read
  return match File.readText("input.txt") with
    case Result.Ok(contents) -> Console.writeLine(Integer.toString(List.length(String.lines(contents))))
    case Result.Error(_) -> Console.writeLine("read failed")
  end match
end function
