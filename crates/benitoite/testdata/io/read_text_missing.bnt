// spec: 01-07 IO の失敗
// spec: 01-07 IO を行う組み込み関数
import Benitoite.Unofficial.IO.Console
import Benitoite.Unofficial.IO.File

function main() -> Unit uses Console.Write, File.Read
  return match File.readText("missing.txt") with
    case Result.Ok(_) -> Console.writeLine("unexpected success")
    case Result.Error(_) -> Console.writeLine("error branch")
  end match
end function
