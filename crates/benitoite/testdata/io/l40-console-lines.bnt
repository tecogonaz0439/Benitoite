// spec: 01-07 外部から受け取る文字列
// 設計書 03-07「Console」「共通の規則」。
// 関門: CLI の取り込み・型・エフェクトと関数の組み合わせから得る出力を守る。
// 登録や呼び出しの接続漏れは本体の単体テストで届かず、専用の差し込み口は不要である。
import Benitoite.Trait
import Benitoite.Unofficial.IO.Console
function main() -> Result[Unit, String] uses Console.Read, Console.Write
  bind first <- try Console.readLine() |> Result.mapError(_, IOError.message)
  bind rest <- try Console.readAllLines() |> Result.mapError(_, IOError.message)
  bind eof <- try Console.readAllLines() |> Result.mapError(_, IOError.message)
  Console.writeLine(Trait.Show.show(first))
  Console.writeLine(Trait.Show.show(rest))
  Console.writeLine(Trait.Show.show(eof))
  return Result.Ok(())
end function
