// spec: 01-10 リソースの型
// spec: 01-10 `with` の構文
// 関門: with の中の逐次読み取りを守り、Reader の位置と改行・末尾の接続の退行を捕まえる。
// CLI への接続と診断・出力を守る。段ごとのテストではこの接続を通らず、専用の差し込み口は要らない。
import Benitoite.Unofficial.IO.Console
import Benitoite.Unofficial.IO.File

function main() -> Result[Unit, String] uses File.Read, State, Console.Write
  with reader = try File.openReader("input.txt") |> Result.mapError(r: _, f: lambda(error) return IOError.message(error) end lambda) do
    bind first <- try File.readLine(reader) |> Result.mapError(r: _, f: lambda(error) return IOError.message(error) end lambda)
    bind second <- try File.readLine(reader) |> Result.mapError(r: _, f: lambda(error) return IOError.message(error) end lambda)
    bind last <- try File.readLine(reader) |> Result.mapError(r: _, f: lambda(error) return IOError.message(error) end lambda)
    bind eof <- try File.readLine(reader) |> Result.mapError(r: _, f: lambda(error) return IOError.message(error) end lambda)
    Console.writeLine(Option.unwrapOr(o: first, fallback: "eof"))
    Console.writeLine("[${Option.unwrapOr(o: second, fallback: "eof")}]")
    Console.writeLine(Option.unwrapOr(o: last, fallback: "eof"))
    Console.writeLine(if eof = Option.None then "eof" else "extra line" end if)
  end with
  return Result.Ok(())
end function
