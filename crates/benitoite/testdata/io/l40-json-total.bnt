// 設計書 03-08「Json」の totalAmount の例。
// 関門: CLI の取り込み・型・エフェクトと関数の組み合わせから得る出力を守る。
// 登録や呼び出しの接続漏れは本体の単体テストで届かず、専用の差し込み口は不要である。
import Benitoite.Unofficial.IO.Console
import Benitoite.Unofficial.IO.File
import Benitoite.Unofficial.Json
function totalAmount(path: String) -> Result[Integer, String] uses File.Read
  bind text <- try File.readText(path) |> Result.mapError(r: _, f: lambda(error) return IOError.message(error) end lambda)
  bind document <- try Json.parse(text) |> Result.mapError(r: _, f: lambda(error) return Json.ParseError.message(error) end lambda)
  bind items <- Json.asArray(document) |> Option.unwrapOr(o: _, fallback: [])
  return Result.Ok(List.fold(xs: items, initial: 0, f: lambda(acc, value)
    return match Json.get(value: value, k: "amount") with
      case Option.Some(Json.Value.Integer(n)) -> acc + n
      case _ -> acc
    end match
  end lambda))
end function
function main() -> Result[Unit, String] uses File.Read, Console.Write
  bind total <- try totalAmount("amounts.json")
  Console.writeLine(Integer.toString(total))
  return Result.Ok(())
end function
