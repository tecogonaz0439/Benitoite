// 関門: 手書きゲストのビット列と記憶域で、空の選択と flags の幅・タグ順を守る。
import Benitoite.Unofficial.IO.Console
data D1
  F1
end data
@external("wasm", "x.wasm", "f1")
function f1(v: Set[D1]) -> Pair[Set[D1], Integer]
data D8
  F1
  F2
  F3
  F4
  F5
  F6
  F7
  F8
end data
@external("wasm", "x.wasm", "f8")
function f8(v: Set[D8]) -> Pair[Set[D8], Integer]
data D9
  F1
  F2
  F3
  F4
  F5
  F6
  F7
  F8
  F9
end data
@external("wasm", "x.wasm", "f9")
function f9(v: Set[D9]) -> Pair[Set[D9], Integer]
data D16
  F1
  F2
  F3
  F4
  F5
  F6
  F7
  F8
  F9
  F10
  F11
  F12
  F13
  F14
  F15
  F16
end data
@external("wasm", "x.wasm", "f16")
function f16(v: Set[D16]) -> Pair[Set[D16], Integer]
data D17
  F1
  F2
  F3
  F4
  F5
  F6
  F7
  F8
  F9
  F10
  F11
  F12
  F13
  F14
  F15
  F16
  F17
end data
@external("wasm", "x.wasm", "f17")
function f17(v: Set[D17]) -> Pair[Set[D17], Integer]
data D32
  F1
  F2
  F3
  F4
  F5
  F6
  F7
  F8
  F9
  F10
  F11
  F12
  F13
  F14
  F15
  F16
  F17
  F18
  F19
  F20
  F21
  F22
  F23
  F24
  F25
  F26
  F27
  F28
  F29
  F30
  F31
  F32
end data
@external("wasm", "x.wasm", "f32")
function f32(v: Set[D32]) -> Pair[Set[D32], Integer]
@external("wasm", "x.wasm", "clear")
function clear(v: Set[D32]) -> Set[D32]
function main() -> Unit uses Console.Write
  bind r1 <- f1(Set.fromList([D1.F1]))
  Console.writeLine("${Set.size(Pair.first(r1))} ${Set.contains(Pair.first(r1), D1.F1)} ${Pair.second(r1)}")
  bind r8 <- f8(Set.fromList([D8.F8, D8.F1]))
  Console.writeLine("${Set.size(Pair.first(r8))} ${Set.contains(Pair.first(r8), D8.F8)} ${Pair.second(r8)}")
  bind r9 <- f9(Set.fromList([D9.F9, D9.F1]))
  Console.writeLine("${Set.size(Pair.first(r9))} ${Set.contains(Pair.first(r9), D9.F9)} ${Pair.second(r9)}")
  bind r16 <- f16(Set.fromList([D16.F16, D16.F1]))
  Console.writeLine("${Set.size(Pair.first(r16))} ${Set.contains(Pair.first(r16), D16.F16)} ${Pair.second(r16)}")
  bind r17 <- f17(Set.fromList([D17.F17, D17.F1]))
  Console.writeLine("${Set.size(Pair.first(r17))} ${Set.contains(Pair.first(r17), D17.F17)} ${Pair.second(r17)}")
  bind r32 <- f32(Set.fromList([D32.F32, D32.F1]))
  Console.writeLine("${Set.size(Pair.first(r32))} ${Set.contains(Pair.first(r32), D32.F32)} ${Pair.second(r32)}")
  bind empty <- f32(Set.empty())
  Console.writeLine("${Set.size(Pair.first(empty))} ${Pair.second(empty)}")
  Console.writeLine("${Set.size(clear(Set.fromList([D32.F32])))}")
end function
