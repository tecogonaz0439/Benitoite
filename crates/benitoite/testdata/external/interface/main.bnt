// spec: 01-02 外部の関数の宣言
import Benitoite.Unofficial.IO.Console
@external("wasm", "x.wasm", "bnt:test/api@1.2.0#add")
function add(a: Integer, b: Integer) -> Integer
@external("wasm", "x.wasm", "top")
function top() -> Integer
function main() -> Unit uses Console.Write
  Console.writeLine("${add(a: 20, b: 22)}")
  Console.writeLine("${List.fold(xs: [1, 2, 3], initial: top(), f: lambda(acc, value) return add(a: acc, b: value) end lambda)}")
end function
