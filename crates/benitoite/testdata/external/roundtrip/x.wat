;; 各呼び出しは新しいメモリを持つ。引数は 1024 以降、戻り値の記述は 0 以降に置く。
(component
(core module $m (memory (export "memory") 1)
(func (export "realloc") (param i32 i32 i32 i32) (result i32) i32.const 1024)
(func (export "integer") (param i64) (result i64) local.get 0)
(func (export "float") (param f64) (result f64) local.get 0)
(func (export "boolean") (param i32) (result i32) local.get 0)
(func (export "character") (param i32) (result i32) local.get 0)
(func (export "byte") (param i32) (result i32) local.get 0)
(func (export "string") (param i32 i32) (result i32) i32.const 0 local.get 0 i32.store i32.const 4 local.get 1 i32.store i32.const 0)
(func (export "bytes") (param i32 i32) (result i32) i32.const 0 local.get 0 i32.store i32.const 4 local.get 1 i32.store i32.const 0)
(func (export "list") (param i32 i32) (result i32) i32.const 0 local.get 0 i32.store i32.const 4 local.get 1 i32.store i32.const 0)
(func (export "option") (param i32 i64) (result i32) i32.const 0 local.get 0 i32.store8 i32.const 8 local.get 1 i64.store i32.const 0)
(func (export "result") (param i32 i32 i32) (result i32) i32.const 0 local.get 0 i32.store8 i32.const 4 local.get 1 i32.store i32.const 8 local.get 2 i32.store i32.const 0)
(func (export "pair") (param i64 i32) (result i32) i32.const 0 local.get 0 i64.store i32.const 8 local.get 1 i32.store8 i32.const 0)
(func (export "triple") (param i32 i32 i32 i32) (result i32) i32.const 0 local.get 0 i32.store8 i32.const 4 local.get 1 i32.store i32.const 8 local.get 2 i32.store i32.const 12 local.get 3 i32.store i32.const 0))
(core instance $i (instantiate $m))
(type $bytes (list u8))
(type $list (list s64))
(type $option (option s64))
(type $result (result (error string)))
(type $pair (tuple s64 bool))
(type $triple (tuple u8 char string))
(func (export "integer") (param "v" s64) (result s64) (canon lift (core func $i "integer")))
(func (export "float") (param "v" f64) (result f64) (canon lift (core func $i "float")))
(func (export "boolean") (param "v" bool) (result bool) (canon lift (core func $i "boolean")))
(func (export "character") (param "v" char) (result char) (canon lift (core func $i "character")))
(func (export "byte") (param "v" u8) (result u8) (canon lift (core func $i "byte")))
(func (export "string") (param "v" string) (result string) (canon lift (core func $i "string") (memory (core memory $i "memory")) (realloc (core func $i "realloc"))))
(func (export "bytes") (param "v" $bytes) (result $bytes) (canon lift (core func $i "bytes") (memory (core memory $i "memory")) (realloc (core func $i "realloc"))))
(func (export "list") (param "v" $list) (result $list) (canon lift (core func $i "list") (memory (core memory $i "memory")) (realloc (core func $i "realloc"))))
(func (export "option") (param "v" $option) (result $option) (canon lift (core func $i "option") (memory (core memory $i "memory")) (realloc (core func $i "realloc"))))
(func (export "result") (param "v" $result) (result $result) (canon lift (core func $i "result") (memory (core memory $i "memory")) (realloc (core func $i "realloc"))))
(func (export "pair") (param "v" $pair) (result $pair) (canon lift (core func $i "pair") (memory (core memory $i "memory")) (realloc (core func $i "realloc"))))
(func (export "triple") (param "v" $triple) (result $triple) (canon lift (core func $i "triple") (memory (core memory $i "memory")) (realloc (core func $i "realloc")))))
