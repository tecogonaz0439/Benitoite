// 関門: 幅を保った両方向の変換と、別名を使う既存の呼び出しを実際のゲストで確かめる。
import Benitoite.Unofficial.IO.Console
@external("wasm", "x.wasm", "flip-s8")
function flipS8(v: Integer8) -> Integer8
@external("wasm", "x.wasm", "flip-s16")
function flipS16(v: Integer16) -> Integer16
@external("wasm", "x.wasm", "flip-s32")
function flipS32(v: Integer32) -> Integer32
@external("wasm", "x.wasm", "flip-s64")
function flipS64(v: Integer64) -> Integer64
@external("wasm", "x.wasm", "flip-u8")
function flipU8(v: UnsignedInteger8) -> UnsignedInteger8
@external("wasm", "x.wasm", "flip-u16")
function flipU16(v: UnsignedInteger16) -> UnsignedInteger16
@external("wasm", "x.wasm", "flip-u32")
function flipU32(v: UnsignedInteger32) -> UnsignedInteger32
@external("wasm", "x.wasm", "flip-u64")
function flipU64(v: UnsignedInteger64) -> UnsignedInteger64
@external("wasm", "x.wasm", "negate-f32")
function negateF32(v: Float32) -> Float32
@external("wasm", "x.wasm", "negate-f64")
function negateF64(v: Float64) -> Float64
@external("wasm", "x.wasm", "flip-u64")
function unsignedAlias(v: UnsignedInteger) -> UnsignedInteger
function main() -> Unit uses Console.Write
  Console.writeLine("${flipS8(-128s8)} ${flipS8(127s8)}")
  Console.writeLine("${flipS16(-32768s16)} ${flipS16(32767s16)}")
  Console.writeLine("${flipS32(-2147483648s32)} ${flipS32(2147483647s32)}")
  Console.writeLine("${flipS64(-9223372036854775808s64)} ${flipS64(9223372036854775807s64)}")
  Console.writeLine("${flipU8(0u8)} ${flipU8(255u8)}")
  Console.writeLine("${flipU16(0u16)} ${flipU16(65535u16)}")
  Console.writeLine("${flipU32(0u32)} ${flipU32(4294967295u32)}")
  Console.writeLine("${flipU64(0u64)} ${flipU64(18446744073709551615u64)}")
  Console.writeLine("${flipU64(9223372036854775808u64)} ${unsignedAlias(18446744073709551615u64)}")
  Console.writeLine("${negateF32(0.1f32)} ${negateF32(0.0f32)} ${negateF32(-0.0f32)} ${negateF64(1.25f64)}")
  Console.writeLine("${Float32.isNaN(negateF32(Float32.squareRoot(-1.0f32)))} ${negateF32(1.0f32 / 0.0f32)} ${negateF32(-1.0f32 / 0.0f32)}")
  Console.writeLine("${negateF32(16777217.0f32)}")
end function
