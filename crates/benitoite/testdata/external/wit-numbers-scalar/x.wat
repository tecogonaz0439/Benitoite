;; 最下位ビットの反転と浮動小数の符号の反転で、引数と戻り値を独立した期待値と比較する。
(component
  (core module $m
    (func (export "flip-s8") (param i32) (result i32) local.get 0 i32.const 1 i32.xor)
    (func (export "flip-s16") (param i32) (result i32) local.get 0 i32.const 1 i32.xor)
    (func (export "flip-s32") (param i32) (result i32) local.get 0 i32.const 1 i32.xor)
    (func (export "flip-s64") (param i64) (result i64) local.get 0 i64.const 1 i64.xor)
    (func (export "flip-u8") (param i32) (result i32) local.get 0 i32.const 1 i32.xor)
    (func (export "flip-u16") (param i32) (result i32) local.get 0 i32.const 1 i32.xor)
    (func (export "flip-u32") (param i32) (result i32) local.get 0 i32.const 1 i32.xor)
    (func (export "flip-u64") (param i64) (result i64) local.get 0 i64.const 1 i64.xor)
    (func (export "negate-f32") (param f32) (result f32) local.get 0 f32.neg)
    (func (export "negate-f64") (param f64) (result f64) local.get 0 f64.neg)
  )
  (core instance $i (instantiate $m))
  (func (export "flip-s8") (param "v" s8) (result s8) (canon lift (core func $i "flip-s8")))
  (func (export "flip-s16") (param "v" s16) (result s16) (canon lift (core func $i "flip-s16")))
  (func (export "flip-s32") (param "v" s32) (result s32) (canon lift (core func $i "flip-s32")))
  (func (export "flip-s64") (param "v" s64) (result s64) (canon lift (core func $i "flip-s64")))
  (func (export "flip-u8") (param "v" u8) (result u8) (canon lift (core func $i "flip-u8")))
  (func (export "flip-u16") (param "v" u16) (result u16) (canon lift (core func $i "flip-u16")))
  (func (export "flip-u32") (param "v" u32) (result u32) (canon lift (core func $i "flip-u32")))
  (func (export "flip-u64") (param "v" u64) (result u64) (canon lift (core func $i "flip-u64")))
  (func (export "negate-f32") (param "v" f32) (result f32) (canon lift (core func $i "negate-f32")))
  (func (export "negate-f64") (param "v" f64) (result f64) (canon lift (core func $i "negate-f64")))
)
