// spec: 01-07 エフェクトの型と権限制御の区別
import Benitoite.Unofficial.IO.Console

function write_message() -> Unit uses Console.Write
  return Console.writeLine("not allowed here")
end function

function pure_caller() -> Unit
  return write_message()
end function

function main() -> Unit
  return pure_caller()
end function
