// spec: 01-07 プログラムの入口
// spec: 01-07 IO を行う組み込み関数
import Benitoite.Unofficial.IO.Console
import Benitoite.Unofficial.IO.File

function main() -> Result[Unit, String] uses Console.Write, File.Read
  return match File.readText("missing.txt") with
    case Result.Ok(text) ->
      Console.writeLine(Integer.toString(List.length(String.lines(text))))
      Result.Ok(())

    case Result.Error(_) -> Result.Error("could not read input.txt")
  end match
end function
