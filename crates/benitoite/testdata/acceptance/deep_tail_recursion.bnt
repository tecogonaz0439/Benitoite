// spec: 01-08 末尾呼び出し
// 最小実行版はデバッグビルドで動かすため、所要時間を抑えて 100 万回にする。
import Benitoite.Unofficial.IO.Console

function count_down(n: Integer, count: Integer) -> Integer
  return if n = 0 then count else count_down(n - 1, count + 1) end if
end function

function main() -> Unit uses Console.Write
  return Console.writeLine(Integer.toString(count_down(1000000, 0)))
end function
