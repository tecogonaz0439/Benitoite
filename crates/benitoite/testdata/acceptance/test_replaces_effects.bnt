// spec: 01-07 利用者が定義するエフェクトとハンドラ（初回リリース版）
// spec: 01-06 エフェクトの宣言とハンドラの型付け（初回リリース版）
// 受け入れ: 00-03「初回リリース版」の完了条件の、影響の大きい操作の差し替え（07-03「受け入れ例と仕様の項目の対応」）。
// 06-04「組み込みの操作の差し替え」: Process.run・Process.exit・File.writeText をテストのハンドラで差し替え、外部に行わない。
import Benitoite.Unofficial.IO.File
import Benitoite.Unofficial.IO.Process

function deploy(target: String) -> Result[Integer, String] uses Process.Run
  bind output <- try Process.run(Process.command(program: "deploy-tool", arguments: ["--target", target])) |> Result.mapError(r: _, f: lambda(error) return IOError.message(error) end lambda)
  return Result.Ok(Process.Output.exitCode(output))
end function

function failHard(message: String) -> Integer uses Process.Exit
  return if message = "" then 0 else Process.exit(2) end if
end function

function saveReport(path: String, lines: List[String]) -> Result[Unit, String] uses File.Write
  return File.writeText(path: path, text: String.join(xs: lines, separator: "\n")) |> Result.mapError(r: _, f: lambda(error) return IOError.message(error) end lambda)
end function

@test("Process.run is replaced by the handler")
function runIsReplaced() -> Unit uses Assert.Check, Process.Run
  bind result <- handle
    deploy("staging")
  with
    case Process.run(command) ->
      Assert.equal(actual: Process.Command.program(command), expected: "deploy-tool")
      Assert.equal(actual: Process.Command.arguments(command), expected: ["--target", "staging"])
      resume(Result.Ok(Process.Output(exitCode: 0, standardOutput: "done\n", standardError: "")))
  end handle
  Assert.equal(actual: result, expected: Result.Ok(0))
end function

@test("Process.exit is replaced by the handler")
function exitIsReplaced() -> Unit uses Assert.Check
  bind code <- handle
    failHard("broken")
  with
    case Process.exit(status) -> status + 100
  end handle
  Assert.equal(actual: code, expected: 102)
end function

@test("File.writeText is replaced by the handler")
function writeIsReplaced() -> Unit uses Assert.Check, File.Read, File.Write
  bind result <- handle
    saveReport(path: "acceptance-report.txt", lines: ["a", "b"])
  with
    case File.writeText(path, text) ->
      Assert.equal(actual: path, expected: "acceptance-report.txt")
      Assert.equal(actual: text, expected: "a\nb")
      resume(Result.Ok(()))
  end handle
  Assert.equal(actual: result, expected: Result.Ok(()))
  Assert.equal(actual: File.exists("acceptance-report.txt") |> Result.mapError(r: _, f: lambda(error) return IOError.message(error) end lambda), expected: Result.Ok(false))
end function
