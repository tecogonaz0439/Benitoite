// spec: 01-11 タスクの集まり
// 設計書 03-08「Json」、03-09「応答を作る関数と、要求を調べる関数」。
// 関門: Json.parse の不具合がハンドラからサーバ全体を止める TODO-194 の退行を捕まえる。
// 単体テストでは届かない、特殊なキーの POST の後も次の要求へ応答する契約を守る。
import Benitoite.Unofficial.Network.Http
import Benitoite.Unofficial.Json
import Benitoite.Unofficial.IO.Console

function route(request: Http.Request) -> Http.Response
  return match String.fromUTF8(Http.Request.body(request)) with
    case Option.None -> Http.text(status: 400, s: "invalid UTF-8")
    case Option.Some(text) ->
      match Json.parse(text) with
        case Result.Error(error) -> Http.text(status: 400, s: Json.ParseError.message(error))
        case Result.Ok(value) -> Http.json(status: 200, value: value)
      end match
  end match
end function

function serveLoop(listener: Http.Listener, group: TaskGroup, remaining: Integer) -> Result[Unit, String] uses Http.Listen, State
  if remaining = 0 then return Result.Ok(()) end if
  bind exchange <- try Http.accept(listener) |> Result.mapError(r: _, f: lambda(error) return NetworkError.message(error) end lambda)
  bind _ <- TaskGroup.spawn(group: group, action: lambda()
    with current = exchange do
      return Http.respond(exchange: current, response: route(Http.requestOf(current))) |> Result.mapError(r: _, f: lambda(error) return NetworkError.message(error) end lambda)
    end with
  end lambda)
  return serveLoop(listener: listener, group: group, remaining: remaining - 1)
end function

function post(base: String, body: String) -> Result[Unit, String] uses Http.Connect, Console.Write
  bind request <- Http.clientRequest(method: "POST", url: base + "/")
  bind response <- try Http.send(Http.ClientRequest(..request, body: String.toUTF8(body))) |> Result.mapError(r: _, f: lambda(error) return NetworkError.message(error) end lambda)
  Console.writeLine(Integer.toString(Http.Response.status(response)))
  Console.writeLine(Option.unwrapOr(o: String.fromUTF8(Http.Response.body(response)), fallback: "invalid UTF-8"))
  return Result.Ok(())
end function

function main() -> Result[Unit, String] uses Http.Listen, Http.Connect, Console.Write, State
  with listener = try Http.listen(host: "127.0.0.1", port: 0) |> Result.mapError(r: _, f: lambda(error) return NetworkError.message(error) end lambda),
    group = TaskGroup.open() do
    bind base <- "http://127.0.0.1:" + Integer.toString(Http.listenerPort(listener))
    bind server <- TaskGroup.spawn(group: group, action: lambda() return serveLoop(listener: listener, group: group, remaining: 4) end lambda)
    bind _ <- try post(base: base, body: "{\"\$serde_json::private::Number\":\"1e9999\"}")
    bind _ <- try post(base: base, body: "{\"\$serde_json::private::Number\":\"123\"}")
    bind _ <- try post(base: base, body: "1e400")
    bind _ <- try post(base: base, body: "{\"ok\":true}")
    bind _ <- try Task.await(server)
    return Result.Ok(())
  end with
end function
