// spec: 01-11 タスクとハンドラ
// 関門: 起動の位置は taskOrigins にだけ残し、子の最初の段は位置なしで報告する（ADR 0325）。
effect Probe
  function ask(n: Integer) -> Integer
end effect

function main() -> Unit uses State
  with group = TaskGroup.open() do
    bind _ <- handle
      bind _ <- TaskGroup.spawn(group, lambda() return ask(1) end lambda)
      0
    with
      case ask(n) -> n
    end handle
  end with
end function
