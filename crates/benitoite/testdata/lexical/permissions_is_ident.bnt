// spec: 01-01 キーワード
// spec: 01-01 識別子
import Benitoite.Unofficial.IO.Console

function main() -> Unit uses Console.Write
  bind permissions <- 1
  bind scope_value <- 2
  bind record_value <- 3
  bind from <- 4
  return Console.writeLine(Integer.toString(permissions + scope_value + record_value + from))
end function