import Benitoite.Unofficial.IO.Console

function main() -> Unit uses Console.Write
  Console.writeLine(Integer.toString(-9223372036854775808s64))
  Console.writeLine(Float.toString(-1.5f64))
  Console.writeLine(Byte.toString(0xffu8))
  Console.writeLine(Integer.toString(0xfff32))
  Console.writeLine(Integer.toString(match 2s64 with
    case 0s64..1s64 -> 0s64
    case 2s64 -> 2s64
    case _ -> 3s64
  end match))
end function
