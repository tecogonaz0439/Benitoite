//! Pairs of two values.

/// A pair of two values, written `Pair(a, b)`.
public data Pair[A, B]
  Pair(A, B)
end data

/// Returns the first value.
public function first[A, B](p: Pair[A, B]) -> A
  bind Pair(a, _) <- p
  return a
end function

/// Returns the second value.
public function second[A, B](p: Pair[A, B]) -> B
  bind Pair(_, b) <- p
  return b
end function
