//! Regular expressions. A single match (`isMatch`, `find`, `replaceFirst`) takes time proportional to the product of the input length and pattern size in the worst case.
//! Repeated matching (`findAll`, `replaceAll`, `replaceAllWith`, `split`) can take time proportional to the square of the input length times the pattern size in the worst case. The types `Pattern` and `Match` are built in.

/// Builds a regular expression. Returns the reason as `Result.Error` when the syntax is wrong.
@builtin("Regex.compile")
public function compile(source: String) -> Result[Pattern, String]

/// Returns whether some part of `text` matches.
@builtin("Regex.isMatch")
public function isMatch(pattern: Pattern, text: String) -> Boolean

/// Returns the leftmost match.
@builtin("Regex.find")
public function find(pattern: Pattern, text: String) -> Option[Match]

/// Returns the non-overlapping matches from the left.
public function findAll(pattern: Pattern, text: String) -> List[Match]
  return findAllFrom(pattern: pattern, text: text, start: 0, afterMatch: false, acc: [])
end function

/// Returns the matched text.
@builtin("Regex.matchText")
public function matchText(m: Match) -> String

/// Returns the byte position where the match starts.
@builtin("Regex.matchByteStart")
public function matchByteStart(m: Match) -> Integer

/// Returns the byte position where the match ends. The match is from the start up to, but not including, the end.
@builtin("Regex.matchByteEnd")
public function matchByteEnd(m: Match) -> Integer

/// Returns the text of capture group `index`, where 0 is the whole match.
@builtin("Regex.group")
public function group(m: Match, index: Integer) -> Option[String]

/// Returns the text of the capture group named `name`.
@builtin("Regex.namedGroup")
public function namedGroup(m: Match, name: String) -> Option[String]

/// Replaces the first match with `replacement`, taken literally.
@builtin("Regex.replaceFirst")
public function replaceFirst(pattern: Pattern, text: String, replacement: String) -> String

/// Replaces every match with `replacement`, taken literally.
public function replaceAll(pattern: Pattern, text: String, replacement: String) -> String
  return replaceAllFrom(pattern: pattern, text: text, replacement: replacement, start: 0, afterMatch: false, parts: Pair(Pair([], []), 0))
end function

/// Splits `text` at each match.
public function split(pattern: Pattern, text: String) -> List[String]
  return splitFrom(pattern: pattern, text: text, start: 0, afterMatch: false, acc: [])
end function

/// Replaces every match with `f` applied to it. `f` is called for each match from the left.
public function replaceAllWith[effect E](pattern: Pattern, text: String, f: function(matched: Match) -> String uses E) -> String uses E
  return replaceFrom(pattern: pattern, text: text, f: f, start: 0, afterMatch: false, parts: Pair(Pair([], []), 0))
end function

@builtin("Regex.findAt")
function findAt(pattern: Pattern, text: String, start: Integer, afterMatch: Boolean) -> Option[Match]

@builtin("Regex.spanAt")
function spanAt(pattern: Pattern, text: String, start: Integer, afterMatch: Boolean) -> Option[Pair[Integer, Integer]]

@builtin("Regex.maxStringBytes")
function maxStringBytes() -> Integer

function findAllFrom(pattern: Pattern, text: String, start: Integer, afterMatch: Boolean, acc: List[Match]) -> List[Match]
  return match findAt(pattern: pattern, text: text, start: start, afterMatch: afterMatch) with
    case Option.None -> acc
    case Option.Some(m) -> findAllFrom(pattern: pattern, text: text, start: matchByteEnd(m), afterMatch: true, acc: List.append(xs: acc, x: m))
  end match
end function

function splitFrom(pattern: Pattern, text: String, start: Integer, afterMatch: Boolean, acc: List[String]) -> List[String]
  return match spanAt(pattern: pattern, text: text, start: start, afterMatch: afterMatch) with
    case Option.None -> List.append(xs: acc, x: sliceOrEmpty(text: text, start: start, stop: String.byteLength(text)))
    case Option.Some(Pair(s, e)) -> splitFrom(pattern: pattern, text: text, start: e, afterMatch: true, acc: List.append(xs: acc, x: sliceOrEmpty(text: text, start: start, stop: s)))
  end match
end function

function replaceAllFrom(pattern: Pattern, text: String, replacement: String, start: Integer, afterMatch: Boolean, parts: Pair[Pair[List[String], List[String]], Integer]) -> String
  return match spanAt(pattern: pattern, text: text, start: start, afterMatch: afterMatch) with
    case Option.None -> finishParts(appendPart(parts: parts, part: sliceOrEmpty(text: text, start: start, stop: String.byteLength(text))))
    case Option.Some(Pair(s, e)) ->
      bind next <- appendPart(parts: appendPart(parts: parts, part: sliceOrEmpty(text: text, start: start, stop: s)), part: replacement)
      replaceAllFrom(pattern: pattern, text: text, replacement: replacement, start: e, afterMatch: true, parts: next)
  end match
end function

function replaceFrom[effect E](pattern: Pattern, text: String, f: function(matched: Match) -> String uses E, start: Integer, afterMatch: Boolean, parts: Pair[Pair[List[String], List[String]], Integer]) -> String uses E
  return match findAt(pattern: pattern, text: text, start: start, afterMatch: afterMatch) with
    case Option.None -> finishParts(appendPart(parts: parts, part: sliceOrEmpty(text: text, start: start, stop: String.byteLength(text))))
    case Option.Some(m) ->
      bind replaced <- f(m)
      bind next <- appendPart(parts: appendPart(parts: parts, part: sliceOrEmpty(text: text, start: start, stop: matchByteStart(m))), part: replaced)
      replaceFrom(pattern: pattern, text: text, f: f, start: matchByteEnd(m), afterMatch: true, parts: next)
  end match
end function

// 部分の数でリストの上限に達しないよう、4096 部分ごとに一度だけ結合する。
// まとまりと最後の結合で各部分のバイトを二度だけ写す。
// 文字列の上限は組み込みの関数から得て、累積の長さが超えたら結合の上限検査で止める
// （設計書 03-08「Regex」、02-09「一つの操作で作る値の大きさの上限」）。
function appendPart(parts: Pair[Pair[List[String], List[String]], Integer], part: String) -> Pair[Pair[List[String], List[String]], Integer]
  bind Pair(Pair(pending, chunks), bytes) <- parts
  bind next <- List.append(xs: pending, x: part)
  bind nextBytes <- bytes + String.byteLength(part)
  if nextBytes > maxStringBytes() then
    bind _ <- finishParts(Pair(Pair(next, chunks), nextBytes))
  end if
  return if List.length(next) = 4096 then
    Pair(Pair([], List.append(xs: chunks, x: String.join(xs: next, separator: ""))), nextBytes)
  else
    Pair(Pair(next, chunks), nextBytes)
  end if
end function

function finishParts(parts: Pair[Pair[List[String], List[String]], Integer]) -> String
  bind Pair(Pair(pending, chunks), _) <- parts
  return String.join(xs: List.append(xs: chunks, x: String.join(xs: pending, separator: "")), separator: "")
end function

function sliceOrEmpty(text: String, start: Integer, stop: Integer) -> String
  return Option.unwrapOr(o: String.byteSlice(s: text, start: start, stop: stop), fallback: "")
end function
