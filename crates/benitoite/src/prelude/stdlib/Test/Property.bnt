//! Pure property trials with explicit random state and bounded shrinking.
//! Budgets count candidate trials and individual generation/continuation calls.
//! Callback time and allocation still depend on the input and callback implementation.
//!
//! ```benitoite test
//! import Benitoite.Unofficial.Test.Property
//! @test
//! function propertyExample() -> Unit uses Assert.Check
//!   bind config <- Property.Config(seed: 42, trials: 3, size: 4, maxShrinks: 10, maxShrinkWork: 20)
//!   bind result <- Property.check(config: config, gen: Property.constant(7), shrinker: Property.shrinkInteger(), property: lambda(value)
//!     return if value = 7 then Result.Ok(()) else Result.Error("expected seven") end if
//!   end lambda)
//!   match result with
//!     case Result.Ok(_) -> return ()
//!     case Result.Error(_) -> Assert.fail("property failed")
//!   end match
//! end function
//! ```

import Benitoite.Unofficial.IO.Random

/// A pure generator. Direct calls interpret size according to the stored function.
public record Gen[T]
  run: function(generator: Random.Generator, size: Integer) -> Pair[T, Random.Generator]
end record

/// Ordered steps; check does not require equality on T.
public record Shrinker[T]
  candidates: function(value: T) -> ShrinkStep[T]
end record

/// One pure shrinking step. Continuations are called only when the consumer advances.
public data ShrinkStep[T]
  Done
  Yield(T, function() -> ShrinkStep[T])
  Skip(function() -> ShrinkStep[T])
end data

/// Maps yielded values, preserving Skip and deferring every continuation.
public function mapSteps[A, B](steps: ShrinkStep[A], f: function(value: A) -> B) -> ShrinkStep[B]
  return match steps with
    case ShrinkStep.Done -> ShrinkStep.Done
    case ShrinkStep.Yield(value, next) -> ShrinkStep.Yield(f(value), lambda() return mapSteps(steps: next(), f: f) end lambda)
    case ShrinkStep.Skip(next) -> ShrinkStep.Skip(lambda() return mapSteps(steps: next(), f: f) end lambda)
  end match
end function

/// Appends a deferred sequence; reaching left's Done returns a Skip before calling right.
public function appendSteps[T](left: ShrinkStep[T], right: function() -> ShrinkStep[T]) -> ShrinkStep[T]
  return match left with
    case ShrinkStep.Done -> ShrinkStep.Skip(right)
    case ShrinkStep.Yield(value, next) -> ShrinkStep.Yield(value, lambda() return appendSteps(left: next(), right: right) end lambda)
    case ShrinkStep.Skip(next) -> ShrinkStep.Skip(lambda() return appendSteps(left: next(), right: right) end lambda)
  end match
end function

/// Inclusive budgets: trials 1..10000, size 0..10000, maxShrinks 0..100000, maxShrinkWork 0..1000000.
public record Config
  seed: Integer
  trials: Integer
  size: Integer
  maxShrinks: Integer
  maxShrinkWork: Integer
end record

/// A failing input and its replay information. reduced is not necessarily minimal.
public record Counterexample[T]
  config: Config
  trial: Integer
  original: T
  reduced: T
  originalMessage: String
  message: String
  shrinks: Integer
  shrinkWork: Integer
  limitReached: Boolean
  libraryVersion: String
end record

/// Configuration errors never call the generator, shrinker, or property.
public data CheckFailure[T]
  InvalidConfig(String)
  Falsified(Counterexample[T])
end data

/// Returns a value without advancing the generator.
public function constant[T](value: T) -> Gen[T]
  return Gen(run: lambda(generator, size) return Pair(value, generator) end lambda)
end function

/// Transforms generated values without inventing an inverse shrinker.
public function map[A, B](gen: Gen[A], f: function(value: A) -> B) -> Gen[B]
  return Gen(run: lambda(generator, size)
    bind run <- Gen.run(gen)
    bind pair <- run(generator: generator, size: size)
    return Pair(f(Pair.first(pair)), Pair.second(pair))
  end lambda)
end function

/// Generates left then right, passing the next random state and the same size.
public function both[A, B](left: Gen[A], right: Gen[B]) -> Gen[Pair[A, B]]
  return Gen(run: lambda(generator, size)
    bind runLeft <- Gen.run(left)
    bind runRight <- Gen.run(right)
    bind first <- runLeft(generator: generator, size: size)
    bind second <- runRight(generator: Pair.second(first), size: size)
    return Pair(Pair(Pair.first(first), Pair.first(second)), Pair.second(second))
  end lambda)
end function

/// Inclusive bounds, with deliberate bias to zero and endpoints; not uniform.
public function integer(low: Integer, high: Integer) -> Result[Gen[Integer], String]
  if low > high then
    return Result.Error("integer: low must not exceed high")
  end if
  if low = high then
    return Result.Ok(constant(low))
  end if
  return Result.Ok(Gen(run: lambda(generator, size)
    bind branch <- Random.nextInteger(generator: generator, low: 0, high: 8)
    bind next <- Pair.second(branch)
    return match Pair.first(branch) with
      case 0 -> Pair(if low <= 0 and high >= 0 then 0 else low end if, next)
      case 1 -> Pair(low, next)
      case 2 -> Pair(high, next)
      case _ ->
        bind endpoint <- Random.nextInteger(generator: next, low: 0, high: 2)
        if Pair.first(endpoint) = 0 then
          Pair(high, Pair.second(endpoint))
        else
          Random.nextInteger(generator: Pair.second(endpoint), low: low, high: high)
        end if
    end match
  end lambda))
end function

/// Generates false or true from a single 0/1 draw.
public function boolean() -> Gen[Boolean]
  return Gen(run: lambda(generator, size)
    bind pair <- Random.nextInteger(generator: generator, low: 0, high: 2)
    return Pair(Pair.first(pair) = 1, Pair.second(pair))
  end lambda)
end function

/// Chooses 0, 1, -1, or a finite nextFloat-derived value in [-1, 1).
public function float() -> Gen[Float]
  return Gen(run: lambda(generator, size)
    bind branch <- Random.nextInteger(generator: generator, low: 0, high: 4)
    bind next <- Pair.second(branch)
    return match Pair.first(branch) with
      case 0 -> Pair(0.0, next)
      case 1 -> Pair(1.0, next)
      case 2 -> Pair(-1.0, next)
      case _ ->
        bind pair <- Random.nextFloat(next)
        Pair(Pair.first(pair) * 2.0 - 1.0, Pair.second(pair))
    end match
  end lambda)
end function

/// Generates valid Unicode scalars, including non-ASCII, with length 0..size. Direct run requires size in 0..10000.
public function string() -> Gen[String]
  return map(gen: list(character()), f: charactersToString)
end function

function character() -> Gen[Character]
  return Gen(run: lambda(generator, size)
    bind pair <- Random.nextInteger(generator: generator, low: 0, high: 1112064)
    bind number <- Pair.first(pair)
    bind scalar <- if number >= 55296 then number + 2048 else number end if
    return Pair(Option.unwrapOr(o: Character.fromInteger(scalar), fallback: '\u{0}'), Pair.second(pair))
  end lambda)
end function

/// Generates 0..size elements, passing the same size to each element generator. Direct run requires size in 0..10000.
public function list[T](element: Gen[T]) -> Gen[List[T]]
  return Gen(run: lambda(generator, size)
    bind length <- Random.nextInteger(generator: generator, low: 0, high: size + 1)
    return listFrom(element: element, generator: Pair.second(length), size: size, remaining: Pair.first(length), acc: [])
  end lambda)
end function

function listFrom[T](element: Gen[T], generator: Random.Generator, size: Integer, remaining: Integer, acc: List[T]) -> Pair[List[T], Random.Generator]
  if remaining = 0 then
    return Pair(acc, generator)
  end if
  bind run <- Gen.run(element)
  bind pair <- run(generator: generator, size: size)
  return listFrom(element: element, generator: Pair.second(pair), size: size, remaining: remaining - 1, acc: List.append(xs: acc, x: Pair.first(pair)))
end function

/// Chooses None with probability 1/4, otherwise generating Some.
public function option[T](element: Gen[T]) -> Gen[Option[T]]
  return Gen(run: lambda(generator, size)
    bind branch <- Random.nextInteger(generator: generator, low: 0, high: 4)
    if Pair.first(branch) = 0 then
      return Pair(Option.None, Pair.second(branch))
    end if
    bind run <- Gen.run(element)
    bind pair <- run(generator: Pair.second(branch), size: size)
    return Pair(Option.Some(Pair.first(pair)), Pair.second(pair))
  end lambda)
end function

/// Makes 0..size key/value draws; duplicate keys keep the first value, without retry. Direct run requires size in 0..10000.
public function stringMap[T](value: Gen[T]) -> Gen[Map[String, T]]
  return map(gen: list(both(left: string(), right: value)), f: firstValues)
end function

function firstValues[T](value: List[Pair[String, T]]) -> Map[String, T]
  return firstValuesFrom(pairs: value, i: 0, acc: Map.empty())
end function

function firstValuesFrom[T](pairs: List[Pair[String, T]], i: Integer, acc: Map[String, T]) -> Map[String, T]
  return match List.get(xs: pairs, i: i) with
    case Option.None -> acc
    case Option.Some(pair) ->
      bind key <- Pair.first(pair)
      bind next <- if Map.contains(m: acc, k: key) then acc else Map.set(m: acc, k: key, value: Pair.second(pair)) end if
      firstValuesFrom(pairs: pairs, i: i + 1, acc: next)
  end match
end function

function charactersToString(value: List[Character]) -> String
  return String.fromCharacters(value)
end function

function some[T](value: T) -> Option[T]
  return Option.Some(value)
end function

/// Tries zero, then successive halves toward zero, without negating the input.
public function shrinkInteger() -> Shrinker[Integer]
  return Shrinker(candidates: lambda(value) return integerSteps(value) end lambda)
end function

function integerSteps(value: Integer) -> ShrinkStep[Integer]
  if value = 0 then
    return ShrinkStep.Done
  end if
  return ShrinkStep.Yield(0, lambda() return integerHalves(value div 2) end lambda)
end function

function integerHalves(value: Integer) -> ShrinkStep[Integer]
  if value = 0 then
    return ShrinkStep.Done
  end if
  return ShrinkStep.Yield(value, lambda() return integerHalves(value div 2) end lambda)
end function

/// Tries zero and a finite half; zero has no candidates. Non-finite inputs try zero.
public function shrinkFloat() -> Shrinker[Float]
  return Shrinker(candidates: lambda(value) return floatSteps(value) end lambda)
end function

function floatSteps(value: Float) -> ShrinkStep[Float]
  if value = 0.0 then
    return ShrinkStep.Done
  end if
  if Float.isNaN(value - value) then
    return ShrinkStep.Yield(0.0, lambda() return ShrinkStep.Done end lambda)
  end if
  return uniqueSteps(original: value, steps: ShrinkStep.Yield(0.0, lambda()
    return ShrinkStep.Yield(value / 2.0, lambda() return ShrinkStep.Done end lambda)
  end lambda), seen: [])
end function

/// Shrinks true to false; false has no candidates.
public function shrinkBoolean() -> Shrinker[Boolean]
  return Shrinker(candidates: lambda(value) return booleanSteps(value) end lambda)
end function

function booleanSteps(value: Boolean) -> ShrinkStep[Boolean]
  return if value then ShrinkStep.Yield(false, lambda() return ShrinkStep.Done end lambda) else ShrinkStep.Done end if
end function

/// Shrinks to None first, then shrinks the contained value; removes duplicates.
public function shrinkOption[T: equality](element: Shrinker[T]) -> Shrinker[Option[T]]
  return Shrinker(candidates: lambda(value)
    return optionSteps(value: value, element: Shrinker.candidates(element))
  end lambda)
end function

function optionSteps[T: equality](value: Option[T], element: function(value: T) -> ShrinkStep[T]) -> ShrinkStep[Option[T]]
  return match value with
    case Option.None -> ShrinkStep.Done
    case Option.Some(x) -> uniqueSteps(original: value, steps: ShrinkStep.Yield(Option.None, lambda() return mapSteps(steps: element(x), f: some) end lambda), seen: [])
  end match
end function

/// Tries empty, contiguous deletions of halving widths, then one element at a time.
public function shrinkList[T: equality](element: Shrinker[T]) -> Shrinker[List[T]]
  return Shrinker(candidates: lambda(value)
    return listShrinkSteps(value: value, element: Shrinker.candidates(element))
  end lambda)
end function

function listShrinkSteps[T: equality](value: List[T], element: function(value: T) -> ShrinkStep[T]) -> ShrinkStep[List[T]]
  if List.isEmpty(value) then
    return ShrinkStep.Done
  end if
  return uniqueSteps(original: value, steps: ShrinkStep.Yield([], lambda()
    return deleteSteps(xs: value, element: element, length: List.length(value), width: List.length(value) div 2, i: 0)
  end lambda), seen: [])
end function

function deleteSteps[T](xs: List[T], element: function(value: T) -> ShrinkStep[T], length: Integer, width: Integer, i: Integer) -> ShrinkStep[List[T]]
  if width = 0 then
    return ShrinkStep.Skip(lambda() return replaceSteps(xs: xs, element: element, i: 0) end lambda)
  end if
  if i > length - width then
    return ShrinkStep.Skip(lambda() return deleteSteps(xs: xs, element: element, length: length, width: width div 2, i: 0) end lambda)
  end if
  return ShrinkStep.Yield(removePart(xs: xs, start: i, width: width), lambda()
    return deleteSteps(xs: xs, element: element, length: length, width: width, i: i + 1)
  end lambda)
end function

function removePart[T](xs: List[T], start: Integer, width: Integer) -> List[T]
  return List.concatenate(xs: List.take(xs: xs, n: start), ys: List.drop(xs: xs, n: start + width))
end function

function replaceSteps[T](xs: List[T], element: function(value: T) -> ShrinkStep[T], i: Integer) -> ShrinkStep[List[T]]
  return match List.get(xs: xs, i: i) with
    case Option.None -> ShrinkStep.Done
    case Option.Some(x) -> ShrinkStep.Skip(lambda()
      return appendSteps(left: mapSteps(steps: element(x), f: lambda(value)
        return List.concatenate(xs: List.append(xs: List.take(xs: xs, n: i), x: value), ys: List.drop(xs: xs, n: i + 1))
      end lambda), right: lambda() return replaceSteps(xs: xs, element: element, i: i + 1) end lambda)
    end lambda)
  end match
end function

// 候補生成、原値との比較、既出との比較をそれぞれ別の段へ分ける。
// SetやOrderではなくequalityと初出順を保つ（設計書 06-04「プロパティベーステスト」）。
function uniqueSteps[T: equality](original: T, steps: ShrinkStep[T], seen: List[T]) -> ShrinkStep[T]
  return match steps with
    case ShrinkStep.Done -> ShrinkStep.Done
    case ShrinkStep.Skip(next) -> ShrinkStep.Skip(lambda() return uniqueSteps(original: original, steps: next(), seen: seen) end lambda)
    case ShrinkStep.Yield(value, next) -> ShrinkStep.Skip(lambda()
      if value = original then
        return ShrinkStep.Skip(lambda() return uniqueSteps(original: original, steps: next(), seen: seen) end lambda)
      end if
      if List.isEmpty(seen) then
        return ShrinkStep.Yield(value, lambda() return uniqueSteps(original: original, steps: next(), seen: [value]) end lambda)
      end if
      return ShrinkStep.Skip(lambda() return compareSeen(original: original, value: value, next: next, seen: seen, remaining: seen) end lambda)
    end lambda)
  end match
end function

function compareSeen[T: equality](original: T, value: T, next: function() -> ShrinkStep[T], seen: List[T], remaining: List[T]) -> ShrinkStep[T]
  return match List.head(remaining) with
    case Option.None -> ShrinkStep.Yield(value, lambda() return uniqueSteps(original: original, steps: next(), seen: List.append(xs: seen, x: value)) end lambda)
    case Option.Some(previous) ->
      if value = previous then
        ShrinkStep.Skip(lambda() return uniqueSteps(original: original, steps: next(), seen: seen) end lambda)
      else
        bind rest <- List.drop(xs: remaining, n: 1)
        if List.isEmpty(rest) then
          ShrinkStep.Yield(value, lambda() return uniqueSteps(original: original, steps: next(), seen: List.append(xs: seen, x: value)) end lambda)
        else
          ShrinkStep.Skip(lambda() return compareSeen(original: original, value: value, next: next, seen: seen, remaining: rest) end lambda)
        end if
      end if
  end match
end function

/// Shrinks by Unicode scalar deletions and scalar values, never UTF-8 byte fragments.
public function shrinkString() -> Shrinker[String]
  return Shrinker(candidates: lambda(value)
    return mapSteps(steps: listShrinkSteps(value: String.characters(value), element: characterSteps), f: charactersToString)
  end lambda)
end function

function characterSteps(value: Character) -> ShrinkStep[Character]
  return scalarSteps(integerSteps(Character.toInteger(value)))
end function

function scalarSteps(numbers: ShrinkStep[Integer]) -> ShrinkStep[Character]
  return match numbers with
    case ShrinkStep.Done -> ShrinkStep.Done
    case ShrinkStep.Skip(next) -> ShrinkStep.Skip(lambda() return scalarSteps(next()) end lambda)
    case ShrinkStep.Yield(value, next) -> ShrinkStep.Skip(lambda()
      return match Character.fromInteger(value) with
        case Option.None -> ShrinkStep.Skip(lambda() return scalarSteps(next()) end lambda)
        case Option.Some(c) -> ShrinkStep.Yield(c, lambda() return scalarSteps(next()) end lambda)
      end match
    end lambda)
  end match
end function

/// Deletes keys in key order, then shrinks one value at a time in key order.
public function shrinkStringMap[T: equality](value: Shrinker[T]) -> Shrinker[Map[String, T]]
  return mapShrinker(value)
end function

function mapShrinker[T: equality](element: Shrinker[T]) -> Shrinker[Map[String, T]]
  return Shrinker(candidates: lambda(value)
    return mapShrinkSteps(original: value, element: Shrinker.candidates(element))
  end lambda)
end function

function mapShrinkSteps[T: equality](original: Map[String, T], element: function(value: T) -> ShrinkStep[T]) -> ShrinkStep[Map[String, T]]
  // Map.toListは候補の列ではなく鍵順の入力である。
  bind pairs <- Map.toList(original)
  return uniqueSteps(original: original, steps: deleteMapSteps(original: original, element: element, pairs: pairs, remaining: pairs), seen: [])
end function

function deleteMapSteps[T](original: Map[String, T], element: function(value: T) -> ShrinkStep[T], pairs: List[Pair[String, T]], remaining: List[Pair[String, T]]) -> ShrinkStep[Map[String, T]]
  return match List.head(remaining) with
    case Option.None -> ShrinkStep.Skip(lambda() return replaceMapSteps(original: original, element: element, remaining: pairs) end lambda)
    case Option.Some(pair) -> ShrinkStep.Yield(Map.remove(m: original, k: Pair.first(pair)), lambda()
      return deleteMapSteps(original: original, element: element, pairs: pairs, remaining: List.drop(xs: remaining, n: 1))
    end lambda)
  end match
end function

function replaceMapSteps[T](original: Map[String, T], element: function(value: T) -> ShrinkStep[T], remaining: List[Pair[String, T]]) -> ShrinkStep[Map[String, T]]
  return match List.head(remaining) with
    case Option.None -> ShrinkStep.Done
    case Option.Some(pair) -> ShrinkStep.Skip(lambda()
      return appendSteps(left: mapSteps(steps: element(Pair.second(pair)), f: lambda(value)
        return Map.set(m: original, k: Pair.first(pair), value: value)
      end lambda), right: lambda() return replaceMapSteps(original: original, element: element, remaining: List.drop(xs: remaining, n: 1)) end lambda)
    end lambda)
  end match
end function

/// Runs pure trials and shrinks only Result.Error; runtime stops propagate normally.
public function check[T](config: Config, gen: Gen[T], shrinker: Shrinker[T], property: function(value: T) -> Result[Unit, String]) -> Result[Unit, CheckFailure[T]]
  if Config.trials(config) < 1 or Config.trials(config) > 10000 then
    return Result.Error(CheckFailure.InvalidConfig("trials must be in 1..10000"))
  end if
  if Config.size(config) < 0 or Config.size(config) > 10000 then
    return Result.Error(CheckFailure.InvalidConfig("size must be in 0..10000"))
  end if
  if Config.maxShrinks(config) < 0 or Config.maxShrinks(config) > 100000 then
    return Result.Error(CheckFailure.InvalidConfig("maxShrinks must be in 0..100000"))
  end if
  if Config.maxShrinkWork(config) < 0 or Config.maxShrinkWork(config) > 1000000 then
    return Result.Error(CheckFailure.InvalidConfig("maxShrinkWork must be in 0..1000000"))
  end if
  return trials(config: config, gen: gen, shrinker: shrinker, property: property, generator: Random.fromSeed(Config.seed(config)), trial: 1)
end function

function trials[T](config: Config, gen: Gen[T], shrinker: Shrinker[T], property: function(value: T) -> Result[Unit, String], generator: Random.Generator, trial: Integer) -> Result[Unit, CheckFailure[T]]
  if trial > Config.trials(config) then
    return Result.Ok(())
  end if
  bind run <- Gen.run(gen)
  bind pair <- run(generator: generator, size: Config.size(config))
  bind value <- Pair.first(pair)
  return match property(value) with
    case Result.Ok(_) -> trials(config: config, gen: gen, shrinker: shrinker, property: property, generator: Pair.second(pair), trial: trial + 1)
    case Result.Error(message) ->
      bind failure <- Counterexample(config: config, trial: trial, original: value, reduced: value, originalMessage: message, message: message, shrinks: 0, shrinkWork: 0, limitReached: false, libraryVersion: "2.0.0")
      Result.Error(CheckFailure.Falsified(reduce(failure: failure, shrinker: shrinker, property: property)))
  end match
end function

function reduce[T](failure: Counterexample[T], shrinker: Shrinker[T], property: function(value: T) -> Result[Unit, String]) -> Counterexample[T]
  return advance(failure: failure, shrinker: shrinker, property: property, next: lambda()
    bind candidates <- Shrinker.candidates(shrinker)
    return candidates(Counterexample.reduced(failure))
  end lambda)
end function

function budgetReached[T](failure: Counterexample[T]) -> Boolean
  bind config <- Counterexample.config(failure)
  return Counterexample.shrinks(failure) >= Config.maxShrinks(config) or Counterexample.shrinkWork(failure) >= Config.maxShrinkWork(config)
end function

// 呼ぶ直前に数え、予算を使い切った後にDoneを調べるための呼び出しもしない。
// 相互の駆動は末尾呼び出しに保つ（設計書 06-04「プロパティベーステスト」）。
function advance[T](failure: Counterexample[T], shrinker: Shrinker[T], property: function(value: T) -> Result[Unit, String], next: function() -> ShrinkStep[T]) -> Counterexample[T]
  if budgetReached(failure) then
    return Counterexample(..failure, limitReached: true)
  end if
  bind counted <- Counterexample(..failure, shrinkWork: Counterexample.shrinkWork(failure) + 1)
  return tryCandidates(failure: counted, shrinker: shrinker, property: property, remaining: next())
end function

function tryCandidates[T](failure: Counterexample[T], shrinker: Shrinker[T], property: function(value: T) -> Result[Unit, String], remaining: ShrinkStep[T]) -> Counterexample[T]
  return match remaining with
    case ShrinkStep.Done -> failure
    case ShrinkStep.Skip(next) -> advance(failure: failure, shrinker: shrinker, property: property, next: next)
    case ShrinkStep.Yield(value, next) ->
      if budgetReached(failure) then
        return Counterexample(..failure, limitReached: true)
      end if
      bind counted <- Counterexample(..failure, shrinks: Counterexample.shrinks(failure) + 1, shrinkWork: Counterexample.shrinkWork(failure) + 1)
      match property(value) with
        case Result.Ok(_) -> advance(failure: counted, shrinker: shrinker, property: property, next: next)
        case Result.Error(message) -> reduce(failure: Counterexample(..counted, reduced: value, message: message), shrinker: shrinker, property: property)
      end match
  end match
end function

/// Formats replay budgets, original and reduced inputs and messages using caller-supplied show.
public function formatFailure[T](failure: CheckFailure[T], show: function(value: T) -> String) -> String
  return match failure with
    case CheckFailure.InvalidConfig(message) -> "Invalid property configuration: " + message
    case CheckFailure.Falsified(example) ->
      bind config <- Counterexample.config(example)
      "Property counterexample (library " + Counterexample.libraryVersion(example) + ")\nseed=" + Integer.toString(Config.seed(config))
        + " trials=" + Integer.toString(Config.trials(config)) + " size=" + Integer.toString(Config.size(config))
        + " maxShrinks=" + Integer.toString(Config.maxShrinks(config)) + " maxShrinkWork=" + Integer.toString(Config.maxShrinkWork(config)) + " trial=" + Integer.toString(Counterexample.trial(example))
        + " shrinks=" + Integer.toString(Counterexample.shrinks(example)) + " shrinkWork=" + Integer.toString(Counterexample.shrinkWork(example)) + " limitReached=" + (if Counterexample.limitReached(example) then "true" else "false" end if)
        + "\noriginal: " + show(Counterexample.original(example)) + "\noriginal message: " + Counterexample.originalMessage(example)
        + "\nreduced: " + show(Counterexample.reduced(example)) + "\nmessage: " + Counterexample.message(example)
  end match
end function
