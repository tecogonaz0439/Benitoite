//! Checks host and absolute-path spelling against an explicit scope. Success preserves the condition and target; it does not grant permission or guarantee DNS resolution, filesystem identity, isolation, or IO success.
//!
//! Use the public checks and projections. These checks do not authorize IO.
//!
//! ```benitoite test
//! import Benitoite.Unofficial.Scope
//! @test
//! function scopeExample() -> Unit uses Assert.Check
//!   match Scope.checkHost(pattern: "*.example.com", host: "API.EXAMPLE.COM") with
//!     case Result.Ok(value) -> Assert.equal(actual: Scope.host(value), expected: "api.example.com")
//!     case Result.Error(_) -> Assert.fail("host did not match")
//!   end match
//!   match Scope.checkPath(pattern: "/data/**", path: "/data/report.txt") with
//!     case Result.Ok(value) -> Assert.equal(actual: Scope.path(value), expected: "/data/report.txt")
//!     case Result.Error(_) -> Assert.fail("path did not match")
//!   end match
//!   match Scope.checkEndpoint(hostPattern: "example.com", host: "example.com", minimumPort: 443, maximumPort: 443, port: 443) with
//!     case Result.Ok(value) -> Assert.equal(actual: Scope.endpointPort(value), expected: 443)
//!     case Result.Error(_) -> Assert.fail("endpoint did not match")
//!   end match
//! end function
//! ```
//!
//! ```benitoite error
//! import Benitoite.Unofficial.Scope
//! function main() -> Unit
//!   bind value <- Scope.CheckedHost(pattern: "example.com", host: "example.com")
//!   return ()
//! end function
//! ```
//! ```diagnostic
//! E0340
//! ```
//!
//! ```benitoite error
//! import Benitoite.Unofficial.Scope
//! function main() -> Unit
//!   bind result <- Scope.checkHost(pattern: "*.example.com", host: "example.com")
//!   return ()
//! end function
//! ```
//! ```diagnostic
//! E0462
//! ```

import Benitoite.Trait

/// A lowercase host and the lowercase pattern it satisfies.
@opaque
public record CheckedHost
  pattern: String
  host: String
end record

/// An absolute path and its exact or tree pattern, with spelling preserved.
@opaque
public record CheckedPath
  pattern: String
  path: String
end record

/// A lowercase host and an inclusive port range, retaining all five inputs.
@opaque
public record CheckedEndpoint
  hostPattern: String
  host: String
  minimumPort: Integer
  maximumPort: Integer
  port: Integer
end record

/// Failures retain original inputs. Forms are checked before membership.
public data ScopeError
  InvalidPattern(String, String)
  InvalidTarget(String, String)
  InvalidPortRange(Integer, Integer)
  InvalidPort(Integer)
  OutsideScope(String, String)
  PortOutsideScope(Integer, Integer, Integer)
end data

/// Checks an exact host, *.host (one label), or **.host (one or more labels). Wildcards exclude the stem itself. Known invalid direct arguments are rejected before execution.
public function checkHost(pattern: String, host: String) -> Result[CheckedHost, ScopeError]
  return match inspectHost(pattern: pattern, host: host) with
    case Result.Ok(Pair(p, h)) -> Result.Ok(CheckedHost(pattern: p, host: h))
    case Result.Error(Pair(number, reason)) -> Result.Error(stringError(number: number, reason: reason, pattern: pattern, target: host))
  end match
end function

/// Checks an exact absolute path or a trailing /** tree, which includes its stem. This does not resolve links or access the filesystem.
public function checkPath(pattern: String, path: String) -> Result[CheckedPath, ScopeError]
  return match inspectPath(pattern: pattern, path: path) with
    case Result.Ok(Pair(p, t)) -> Result.Ok(CheckedPath(pattern: p, path: t))
    case Result.Error(Pair(number, reason)) -> Result.Error(stringError(number: number, reason: reason, pattern: pattern, target: path))
  end match
end function

/// Checks host forms, inclusive bounds 0..65535, the port, host membership, then port membership. Known invalid parts of a direct call are rejected even if other arguments are dynamic.
public function checkEndpoint(hostPattern: String, host: String, minimumPort: Integer, maximumPort: Integer, port: Integer) -> Result[CheckedEndpoint, ScopeError]
  return match inspectEndpoint(hostPattern: hostPattern, host: host, minimumPort: minimumPort, maximumPort: maximumPort, port: port) with
    case Result.Ok(Pair(p, h)) -> Result.Ok(CheckedEndpoint(hostPattern: p, host: h, minimumPort: minimumPort, maximumPort: maximumPort, port: port))
    case Result.Error(Pair(number, reason)) ->
      if number = 3 then Result.Error(ScopeError.InvalidPortRange(minimumPort, maximumPort))
      else if number = 4 then Result.Error(ScopeError.InvalidPort(port))
      else if number = 6 then Result.Error(ScopeError.PortOutsideScope(minimumPort, maximumPort, port))
      else Result.Error(stringError(number: number, reason: reason, pattern: hostPattern, target: host)) end if
  end match
end function

/// Returns the lowercase host.
public function host(value: CheckedHost) -> String
  return CheckedHost.host(value)
end function

/// Returns the lowercase host pattern.
public function hostPattern(value: CheckedHost) -> String
  return CheckedHost.pattern(value)
end function

/// Returns the path as accepted.
public function path(value: CheckedPath) -> String
  return CheckedPath.path(value)
end function

/// Returns the path pattern as accepted.
public function pathPattern(value: CheckedPath) -> String
  return CheckedPath.pattern(value)
end function

/// Returns the lowercase endpoint host.
public function endpointHost(value: CheckedEndpoint) -> String
  return CheckedEndpoint.host(value)
end function

/// Returns the lowercase endpoint host pattern.
public function endpointHostPattern(value: CheckedEndpoint) -> String
  return CheckedEndpoint.hostPattern(value)
end function

/// Returns the checked port.
public function endpointPort(value: CheckedEndpoint) -> Integer
  return CheckedEndpoint.port(value)
end function

/// Returns the inclusive lower port bound.
public function endpointMinimumPort(value: CheckedEndpoint) -> Integer
  return CheckedEndpoint.minimumPort(value)
end function

/// Returns the inclusive upper port bound.
public function endpointMaximumPort(value: CheckedEndpoint) -> Integer
  return CheckedEndpoint.maximumPort(value)
end function

@builtin("Scope.checkHost")
function inspectHost(pattern: String, host: String) -> Result[Pair[String, String], Pair[Integer, String]]

@builtin("Scope.checkPath")
function inspectPath(pattern: String, path: String) -> Result[Pair[String, String], Pair[Integer, String]]

@builtin("Scope.checkEndpoint")
function inspectEndpoint(hostPattern: String, host: String, minimumPort: Integer, maximumPort: Integer, port: Integer) -> Result[Pair[String, String], Pair[Integer, String]]

function stringError(number: Integer, reason: String, pattern: String, target: String) -> ScopeError
  return if number = 1 then ScopeError.InvalidPattern(pattern, reason)
  else if number = 2 then ScopeError.InvalidTarget(target, reason)
  else ScopeError.OutsideScope(pattern, target) end if
end function

// 表示用の入力を4096バイトに収め、引用後は一引数2000バイト以内にする。
// 切り詰めは引用前に行い、完成したエスケープ・引用符・括弧を残す。UTF-8の境目を最大三バイト戻す
// （設計書 03-06「Scope」）。保存した入力そのものは変えない。
function limited(text: String) -> String
  return if String.byteLength(text) <= 4096 then text else prefix(text: text, stop: 4093) + "..." end if
end function

function prefix(text: String, stop: Integer) -> String
  return match String.byteSlice(s: text, start: 0, stop: stop) with
    case Option.Some(value) -> value
    case Option.None -> prefix(text: text, stop: stop - 1)
  end match
end function

function quoted(text: String) -> String
  return fitQuoted(limited(text))
end function

function fitQuoted(text: String) -> String
  bind shown <- Trait.Show.show(text)
  return if String.byteLength(shown) <= 2000 then shown
  else fitQuoted(prefix(text: text, stop: String.byteLength(text) div 2) + "...") end if
end function

function renderStrings(name: String, first: String, second: String) -> String
  bind a <- quoted(first)
  bind b <- quoted(second)
  bind omitted <- String.byteLength(first) > 4096 or String.byteLength(second) > 4096 or a <> Trait.Show.show(limited(first)) or b <> Trait.Show.show(limited(second))
  return "${name}(${a}, ${b})" + if omitted then "..." else "" end if
end function

implement Trait.Show[ScopeError]
  function show(x: ScopeError) -> String
    return match x with
      case ScopeError.InvalidPattern(pattern, reason) -> renderStrings(name: "InvalidPattern", first: pattern, second: reason)
      case ScopeError.InvalidTarget(target, reason) -> renderStrings(name: "InvalidTarget", first: target, second: reason)
      case ScopeError.InvalidPortRange(minimum, maximum) -> "InvalidPortRange(${minimum}, ${maximum})"
      case ScopeError.InvalidPort(port) -> "InvalidPort(${port})"
      case ScopeError.OutsideScope(pattern, target) -> renderStrings(name: "OutsideScope", first: pattern, second: target)
      case ScopeError.PortOutsideScope(minimum, maximum, port) -> "PortOutsideScope(${minimum}, ${maximum}, ${port})"
    end match
  end function
end implement
