/-- 制約の照合の関数を替えても、署名に含まれる効果原子は変わらない。 -/
theorem signatureWith (sat : List TParam → Ty → TParam → Prop) (row : StandardModel.Primitive) :
    CheckArguments.SignatureSupport atoms (row.signatureWith sat).params
      (row.signatureWith sat).ret (row.signatureWith sat).eff (row.signatureWith sat).tel := by
  rw [StandardModel.Primitive.signatureWith_eq]
  exact signature row

/-- 標準表に内部行を加えた表の、全署名の支持を構成する。 -/
theorem table {P : Refinement.Program} (data : StandardModel.DataTable P)
    (rows : PredicateProjection.Table.Rows) {name signature}
    (found : (PredicateProjection.Table.builtins data rows).sig name = some signature) :
    CheckArguments.SignatureSupport atoms signature.params signature.ret signature.eff signature.tel := by
  rcases PredicateProjection.Table.lookup_cases data found with ⟨row, _, rfl⟩ | ⟨row, _, rfl⟩
  · exact signatureWith data.sat row
  · exact CheckPreparation.row_support _ row

