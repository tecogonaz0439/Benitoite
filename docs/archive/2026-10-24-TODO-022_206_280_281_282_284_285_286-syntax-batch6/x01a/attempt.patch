index 00000000..8e00540b
--- /dev/null
+++ b/crates/benitoite/src/typeck/interval/observation.rs
@@ -0,0 +1,65 @@
+//! 独立交換の照合用の任意の記録先（設計書 02-05「区間解析の式の識別」）。
+//! 解析済みの対応だけを読む。無効時は複写・確保も予算操作も行わない。
+
+use super::{BodyReport, arithmetic::Candidate, identity::IdentityMap};
+use serde_json::{Value, json};
+use std::cell::RefCell;
+
+fn span(s: crate::base::Span) -> Value {
+    json!([s.file.0, s.start.0, s.end.0])
+}
+
+thread_local! {
+    static SINK: RefCell<Option<Vec<Value>>> = const { RefCell::new(None) };
+}
+
+struct Restore(Option<Vec<Value>>);
+impl Drop for Restore {
+    fn drop(&mut self) {
+        SINK.with(|sink| *sink.borrow_mut() = self.0.take());
+    }
+}
+
+/// 同じスレッドの通常の検査を観測する内部用入口。入れ子と panic でも元に戻す。
+/// AST の参照を保存せず、利用者の診断や解析の予算には影響しない。
+#[doc(hidden)]
+pub fn observe_intervals<T>(work: impl FnOnce() -> T) -> (T, Vec<Value>) {
+    let restore = Restore(SINK.with(|sink| sink.replace(Some(Vec::new()))));
+    let result = work();
+    let records = SINK.with(|sink| sink.borrow_mut().take()).unwrap_or_default();
+    drop(restore);
+    (result, records)
+}
+
+fn candidate(c: &Candidate) -> Value {
+    json!({"preorder":c.preorder.to_string(), "node":c.origin.node.0,
+        "primary":span(c.primary), "operation":format!("{:?}", c.operation),
+        "cause":match c.cause {
+            super::arithmetic::Cause::Overflow => "overflow",
+            super::arithmetic::Cause::ZeroDivisor => "zeroDivisor",
+            super::arithmetic::Cause::OutsideDomain => "outsideDomain",
+        }})
+}
+
+pub(super) fn record(identity: &IdentityMap<'_>, report: &BodyReport) {
+    SINK.with(|sink| {
+        let mut sink = sink.borrow_mut();
+        let Some(records) = sink.as_mut() else { return };
+        let occurrences: Vec<_> = (0..identity.occurrences.len())
+            .filter_map(|i| identity.occurrences.get(i))
+            .map(|e| json!({"preorder":e.preorder.to_string(),
+                "parent":e.parent.map(|n| n.to_string()), "end":e.end.map(|n| n.to_string()),
+                "form":format!("{:?}",e.form), "node":e.origin.map(|o|o.node.0),
+                "span":e.origin.map(|o|span(o.span))}))
+            .collect();
+        let candidates: Vec<_> = report.flow.as_ref().into_iter()
+            .flat_map(|flow| &flow.candidates).map(candidate).collect();
+        let independent: Vec<_> = report.flow.as_ref().into_iter()
+            .flat_map(|flow| &flow.independent)
+            .map(|input|json!({"start":input.start.to_string(),
+                "candidates":input.candidates.iter().map(candidate).collect::<Vec<_>>()})).collect();
+        records.push(json!({"definition":identity.definition, "occurrences":occurrences,
+            "next":identity.next.to_string(), "coverage":format!("{:?}",report.coverage),
+            "candidates":candidates,"independent":independent}));
+    });
+}
