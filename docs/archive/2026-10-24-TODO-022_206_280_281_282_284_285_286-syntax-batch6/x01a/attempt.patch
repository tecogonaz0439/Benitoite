@@ -0,0 +1,175 @@
+//! Surface の宣言順を独立に辿り、通常解析が取得した接頭辞と照合する。
+use super::*;
+use std::collections::BTreeMap;
+
+pub(super) struct Connected {
+    pub definition: Value,
+    pub correspondence: Vec<Value>,
+    pub candidates: Value,
+}
+
+fn strip(value: &Value) -> Value {
+    if value.get("$interval").is_some() {
+        return strip(&value["expr"]);
+    }
+    match value {
+        Value::Array(xs) => json!(xs.iter().map(strip).collect::<Vec<_>>()),
+        Value::Object(xs) => Value::Object(xs.iter().map(|(k,v)|(k.clone(),strip(v))).collect()),
+        _ => value.clone(),
+    }
+}
+
+struct Walk<'a> {
+    name: &'a str,
+    constants: BTreeMap<String, Value>,
+    active: std::collections::BTreeSet<String>,
+    entries: Vec<Value>,
+}
+
+impl Walk<'_> {
+    fn block(&mut self, block: &Value, parent: usize) {
+        if block == "empty" { return; }
+        let (tag, fields) = block.as_object().unwrap().iter().next().unwrap();
+        match tag.as_str() {
+            "builderBind" => self.block(&fields["rest"],parent),
+            "last" | "lastBind" | "lastDiscard" | "lastPat" => self.expr(&fields["expr"],Some(parent),None),
+            "bind" | "discard" | "seq" | "bindPat" => {
+                self.expr(&fields["expr"],Some(parent),None);
+                self.block(&fields["rest"],parent);
+            }
+            _ => panic!("unknown Surface Block: {tag}"),
+        }
+    }
+    fn list(&mut self, list: &Value, parent: usize) {
+        for e in list.as_array().unwrap() { self.expr(e,Some(parent),None); }
+    }
+    fn holes(&mut self, args: &Value, parent: usize) {
+        for arg in args.as_array().unwrap() {
+            if let Some(e) = arg.get("expr") { self.expr(&e["inner"],Some(parent),None); }
+            else { assert!(arg.get("hole").is_some(),"unknown HoleArg {arg}"); }
+        }
+    }
+    fn expr(&mut self, wrapped: &Value, parent: Option<usize>, root_type: Option<&Value>) {
+        let (value, metadata) = if root_type.is_some() { (wrapped,Value::Null) } else {
+            assert!(wrapped.get("$interval").is_some(),"missing source correspondence: {wrapped}");
+            (&wrapped["expr"],wrapped["$interval"].clone())
+        };
+        let (tag, fields) = if value == "unit" { ("unit",&Value::Null) } else {
+            let obj = value.as_object().unwrap();
+            assert_eq!(obj.len(),1,"Surface expression {value}");
+            let (tag,fields) = obj.iter().next().unwrap(); (tag.as_str(),fields)
+        };
+        let form = match tag {
+            "constName" => "Const", "lam" => "Lambda", "ite" => "IfElse", "matchE" => "Match",
+            "returnE" => "Return", "tryResultReturn" => "TryResult", "tryOptionReturn" => "TryOption",
+            "withE" => "With", "lazyE" => "Lazy", "handleE" => "Handle",
+            "literal" if fields["value"]["integer"]["value"].as_i64().is_some_and(|n|n<0) => "NegInt",
+            other => {
+                let mut chars = other.chars();
+                // The constructor spelling is the public Surface spelling; only its initial is capitalized.
+                let form = format!("{}{}",chars.next().unwrap().to_uppercase(),chars.as_str());
+                let index = self.entries.len();
+                self.push(index,parent,&metadata,root_type,form,value);
+                self.children(tag,fields,index);
+                self.entries[index]["end"] = json!(self.entries.len().to_string());
+                return;
+            }
+        };
+        let index = self.entries.len();
+        self.push(index,parent,&metadata,root_type,form.to_owned(),value);
+        self.children(tag,fields,index);
+        self.entries[index]["end"] = json!(self.entries.len().to_string());
+    }
+    fn push(&mut self,index:usize,parent:Option<usize>,metadata:&Value,root_type:Option<&Value>,form:String,value:&Value) {
+        self.entries.push(json!({"preorder":index.to_string(),"parent":parent.map(|n|n.to_string()),
+            "form":form,"node":metadata["node"],"span":metadata["span"],
+            "type":root_type.unwrap_or(&metadata["type"]),"expression":strip(value)}));
+    }
+    fn children(&mut self,tag:&str,f:&Value,parent:usize) {
+        match tag {
+            "local" | "funName" | "funDicts" | "methName" | "primName" | "opName" | "opDicts" | "raise" |
+            "nullCon" | "conValue" | "literal" | "negInt" | "negFloat" | "negDecimal" | "negInteger8" |
+            "negInteger16" | "negInteger32" | "negFloat32" | "unit" => {},
+            "constName" => {
+                let name = f["name"].as_str().unwrap();
+                assert!(self.active.insert(name.to_owned()),"cyclic constant {name}");
+                let body = self.constants.get(name).unwrap().clone();
+                self.expr(&body,Some(parent),None);
+                self.active.remove(name);
+            }
+            "builderOp" | "conCall" | "record" => self.list(&f["args"],parent),
+            "list" => self.list(&f["elems"],parent),
+            "paren" | "neg" | "not" | "returnE" | "tryResult" | "tryResultReturn" | "tryOption" | "tryOptionReturn" | "resume" => self.expr(&f["inner"],Some(parent),None),
+            "block" | "lam" | "lazyE" => self.block(&f["body"],parent),
+            "handleFail" => { self.block(&f["body"],parent); self.block(&f["clause"],parent); },
+            "recordUpdate" => { self.expr(&f["base"],Some(parent),None); self.list(&f["args"],parent); },
+            "call" => { self.expr(&f["callee"],Some(parent),None); self.list(&f["args"],parent); },
+            "pipe" | "binary" | "and" | "or" => { self.expr(&f["lhs"],Some(parent),None); self.expr(&f["rhs"],Some(parent),None); },
+            "partialCall" => { self.expr(&f["callee"],Some(parent),None); self.holes(&f["args"],parent); },
+            "partialCon" => self.holes(&f["args"],parent),
+            "listSpread" => { self.expr(&f["concat"],Some(parent),None); self.list(&f["before"],parent); self.expr(&f["spread"],Some(parent),None); self.list(&f["after"],parent); },
+            "interpolation" => { self.list(&f["es"],parent); self.list(&f["converters"],parent); },
+            "ite" => { self.expr(&f["cond"],Some(parent),None); self.block(&f["yes"],parent); self.block(&f["no"],parent); },
+            "elseIf" => { self.expr(&f["cond"],Some(parent),None); self.block(&f["yes"],parent); self.expr(&f["no"],Some(parent),None); },
+            "ifOnly" => { self.expr(&f["cond"],Some(parent),None); self.block(&f["yes"],parent); },
+            "matchE" => {
+                self.expr(&f["scrutinee"],Some(parent),None);
+                for arm in f["arms"].as_array().unwrap() {
+                    let arm = &arm["mk"];
+                    if !arm["guard"].is_null() { self.expr(&arm["guard"],Some(parent),None); }
+                    self.block(&arm["body"],parent);
+                }
+            },
+            "tryResultDie" | "tryOptionDie" => { self.expr(&f["inner"],Some(parent),None); if !f["message"].is_null() { self.expr(&f["message"],Some(parent),None); } },
+            "withE" => { self.expr(&f["bound"],Some(parent),None); self.block(&f["body"],parent); },
+            "handleE" => { self.block(&f["body"],parent); for clause in f["clauses"].as_array().unwrap() { self.block(&clause["body"],parent); } },
+            _ => panic!("unknown Surface Expr {tag} in {}",self.name),
+        }
+    }
+}
+
+pub(super) fn connect(raw: &Value, observed: &Value) -> Connected {
+    assert_eq!(raw["outside"],json!([]),"out-of-scope Surface {}",raw["name"]);
+    assert_eq!(raw["name"],observed["definition"]);
+    let name = raw["name"].as_str().unwrap();
+    let mut walk = Walk { name, constants:raw["constants"].as_array().unwrap().iter()
+        .map(|entry|(entry["name"].as_str().unwrap().to_owned(),entry["body"].clone())).collect(),
+        active:Default::default(),entries:Vec::new() };
+    walk.expr(&json!({"block":{"body":raw["body"]}}),None,Some(&raw["type"]));
+    let actual = observed["occurrences"].as_array().unwrap();
+    assert!(actual.len()<=walk.entries.len());
+    for (actual,expected) in actual.iter().zip(&walk.entries) {
+        for field in ["preorder","parent","form","node","span"] {
+            assert_eq!(actual[field],expected[field],"{name} key {} field {field}",actual["preorder"]);
+        }
+        if !actual["end"].is_null() { assert_eq!(actual["end"],expected["end"],"{name} subtree end"); }
+    }
+    assert_eq!(observed["next"],actual.len().to_string());
+    if observed["coverage"]=="Prepared" { assert_eq!(actual.len(),walk.entries.len(),"{name} missing suffix"); }
+    // 候補は表全体を照合した後にだけ複写する。独立入力自身の候補も捨てない。
+    let mut candidates = observed["candidates"].as_array().unwrap().clone();
+    for independent in observed["independent"].as_array().unwrap() {
+        candidates.extend(independent["candidates"].as_array().unwrap().iter().cloned());
+    }
+    for candidate in &candidates {
+        let index:usize = candidate["preorder"].as_str().unwrap().parse().unwrap();
+        assert_eq!(candidate["node"],walk.entries[index]["node"],"{name} candidate source");
+    }
+    let types:Vec<_> = walk.entries.iter().map(|entry|json!({"key":[name,entry["preorder"]],"type":entry["type"]})).collect();
+    let source_keys:Vec<_> = walk.entries.iter().filter(|entry| {
+        let e = &entry["expression"];
+        let ty = if entry["form"]=="Neg" { &e["neg"]["operand"] } else { &e["binary"]["operand"] };
+        let arithmetic = matches!(e["binary"]["op"].as_str(),Some("add"|"sub"|"mul"|"intDiv"|"mod")) || entry["form"]=="Neg";
+        arithmetic && matches!(ty["base"]["name"].as_str(),Some("Integer"|"Integer8"|"Integer16"|"Integer32"|"UnsignedInteger16"|"UnsignedInteger32"|"UnsignedInteger64"))
+    }).map(|entry|json!([name,entry["preorder"]])).collect();
+    Connected { definition:json!({"name":name,"kind":raw["kind"],"params":raw["params"],"type":raw["type"],"body":strip(&raw["body"]),"types":types,"sourceKeys":source_keys}),
+        correspondence:walk.entries,candidates:json!({"parent":observed["candidates"],"independent":observed["independent"]}) }
+}
+
+pub(super) fn corpus(raw:&Value, mut connected:Connected, expected:Value) -> Value {
+    connected.definition["expected"] = expected;
+    json!({"kind":"interval-corpus","version":1,"surfaceVersion":14,"traversalVersion":1,"profile":"base",
+        "inputs":[{"name":raw["name"],"fuel":"200","limits":{"body":{"operations":"100000","items":"100000"},"whole":{"operations":"1000000","items":"1000000"}},
+            "initial":{"body":{"operations":"0","temporary":"0","saved":"0","peak":"0"},"whole":{"operations":"0","saved":"0","peak":"0"}},
+            "constants":strip(&raw["constants"]),"standards":[],"apiAt":[],"modules":[{"name":raw["module"],"definitions":[connected.definition]}]}]})
+}
