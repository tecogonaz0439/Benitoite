+        assert_eq!(checked.error_count(),0,"{label}: {:?}",checked.diagnostics);
+        let p = checked.program.as_ref().unwrap();
+        let core = pipeline::desugar_checked(p).unwrap();
+        let definitions = exchange::interval_definitions(p,&core);
+        for raw in definitions {
+            let actual = observed.iter().find(|entry|entry["definition"]==raw["name"]).unwrap_or_else(||panic!("missing {}: {observed:?}",raw["name"]));
+            let connected = source::connect(&raw,actual);
+            records.push(json!({"name":raw["name"],"correspondence":connected.correspondence,"candidates":connected.candidates}));
