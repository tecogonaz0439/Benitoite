+#[test]
+fn export_interval_identity() {
+    let output = export_directory("interval-identity");
+    fs::create_dir_all(&output).unwrap();
+    let cases = [
+        ("point", "const point: Integer = 42"),
+        ("division", "function division() -> Integer\n return 8 div 0\nend function"),
+        ("flow", "const zero: Integer = 0\nfunction flow(x: Integer) -> Integer\n bind alias <- zero\n return if x = 0 then 8 div x else if false then 9 mod 0 else alias end if end if\nend function"),
