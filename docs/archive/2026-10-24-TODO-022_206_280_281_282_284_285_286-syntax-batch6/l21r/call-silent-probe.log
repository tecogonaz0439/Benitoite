Benitoite.Interval.BudgetAnalysis.analyzeExpr_warning_syntactic_reach (limits : Limits) (state : Budget.State)
  (fuel : Nat) (env : AbstractEnv) (key : OperationKey) (source : Expr) (warning : IntervalWarning)
  (member : warning ∈ (analyzeExpr limits state fuel env key source).approx.warnings) :
  InSyntacticReach key (syntacticReachExpr source) warning
Benitoite.Interval.BudgetAnalysis.analyzeBody_warning_syntactic_reach (limits : Limits) (state : Budget.State)
  (fuel : Nat) (definition : String) (seed : BodySeed) (warning : IntervalWarning)
