      "advisories": [
        {
          "id": "RUSTSEC-2026-0346",
          "package": "rustls",
          "versions": [
            "0.23.45"
          ],
          "notes": [
            "ID: RUSTSEC-2026-0346",
            "Advisory: https://rustsec.org/advisories/RUSTSEC-2026-0346",
            "The `Debug` implementations of `Tls12ClientSessionValue` and\n`Tls13ClientSessionValue` were derived, and so included the TLS 1.2 master\nsecret or TLS 1.3 resumption PSK in their output.\n\nCustom `ClientSessionStore` implementations that format these values with\n`Debug` (for example, when logging) could disclose these secrets to readers of\nthe logs. This conflicts with rustls's\n[key-material redaction policy](https://github.com/rustls/rustls/blob/99f2358cae2954837dbb866faf6727de75489ab9/SECURITY.md#boundary-public-api).\n\nOrdinary connection and built-in session cache `Debug` output is redacted and\nis not affected.",
            "Announcement: https://github.com/rustls/rustls/pull/3299",
            "Solution: Upgrade to >=0.23.46 (try `cargo update -p rustls`)"
          ],
          "graphs": [
