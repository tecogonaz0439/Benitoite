import Benitoite.Interval.Sound
open Benitoite.Interval Benitoite.Release

example (kind : IntKind) : kind.min < 0 ↔
    kind = .integer8 ∨ kind = .integer16 ∨ kind = .integer32 ∨ kind = .integer64 := by
  cases kind <;> decide +kernel

