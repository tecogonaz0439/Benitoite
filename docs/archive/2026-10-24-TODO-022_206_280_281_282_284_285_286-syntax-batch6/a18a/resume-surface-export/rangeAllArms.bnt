import Benitoite.Unofficial.Range
function checkInteger(minimum: Integer, maximum: Integer, value: Integer) -> Integer
 return value
end function
function sample(value: Integer) -> Integer
 return match Range.checkInteger(value: value, maximum: 10, minimum: 0) with
 case Result.Ok(c) if Range.value(value: c) = 0 -> 1 div 0
 case Result.Error(_) -> 1 div 0
 case _ -> 1
 end match
end function
