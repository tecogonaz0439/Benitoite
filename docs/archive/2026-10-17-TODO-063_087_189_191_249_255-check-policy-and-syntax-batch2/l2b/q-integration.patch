+    | .V_Bytes => exact .V_Bytes
+    | .V_Dict hi hts hvs => exact .V_Dict hi hts (HasTypeVsQ.q_mono hvs hq)
+    | .V_Super hv hc hs => exact .V_Super (HasTypeVQ.q_mono hv hq) hc hs
+    | .V_Sub h hle hw => exact .V_Sub (HasTypeVQ.q_mono h hq) hle hw
