index 00000000..57342bc5
--- /dev/null
+++ b/formal/Benitoite/Release/Effect.lean
@@ -0,0 +1,123 @@
+import Benitoite.Release.TypeShift
+
+/-!
+# 型を保持するエフェクトの操作
+
+名前と行の点ごとの所属と、正規化した Fail の型の所属を区別する。
+包含は両方を要求する（設計書 07-04「01-12 との対応」）。
+-/
+
+namespace Benitoite.Release.Eff
+
+open Benitoite.Release.Order
+
+/-- 空の効果。 -/
+def empty : Eff := .mk (fun _ => false) []
+
+/-- 名前一つの効果。 -/
+def single (l : EffName) : Eff := ofAtoms (fun a => a == .name l)
+
+/-- 行一つの効果。 -/
+def row (i : Nat) : Eff := ofAtoms (fun a => a == .rho i)
+
+/-- Fail の型を正規化してから一要素の効果にする。 -/
+noncomputable def singleFail (t : Ty) : Eff := .mk (fun _ => false) [t.norm]
+
+/-- 名前と行の包含と、Fail の型の集合としての包含。 -/
+def Sub (e f : Eff) : Prop :=
+  (∀ a, mem e a → mem f a) ∧ (∀ t, memFail e t → memFail f t)
+
+/-- 和は、子の正規化と Fail 列の整列・重複除去を通す。 -/
+noncomputable def union (e f : Eff) : Eff := norm (.mk (fun a => test e a || test f a) (e.fails ++ f.fails))
+
+theorem mem_empty (a : Atom) : mem empty a ↔ False := by simp [mem, test, atoms, empty]
+
+theorem mem_single (l : EffName) (a : Atom) : mem (single l) a ↔ a = .name l := by
+  simp [mem, test, single, ofAtoms, atoms]
+
+theorem mem_row (i : Nat) (a : Atom) : mem (row i) a ↔ a = .rho i := by
+  simp [mem, test, row, ofAtoms, atoms]
+
+theorem mem_union (e f : Eff) (a : Atom) : mem (union e f) a ↔ mem e a ∨ mem f a := by
+  simp [mem, test, union, norm, atoms]
+
+theorem memFail_empty (t : Ty) : memFail empty t ↔ False := by
+  simp [memFail, empty, fails]
+
+theorem memFail_single (l : EffName) (t : Ty) : memFail (single l) t ↔ False := by
+  simp [memFail, single, ofAtoms, fails]
+
+theorem memFail_singleFail (a b : Ty) : memFail (singleFail a) b ↔ a.norm = b.norm := by
+  simp [memFail, singleFail, fails, Ty.norm_idem]
+
+theorem memFail_union (e f : Eff) (t : Ty) : memFail (union e f) t ↔ memFail e t ∨ memFail f t := by
+  unfold union
+  rw [norm_memFail]
+  simp only [memFail, fails, List.mem_append, or_and_right, exists_or]
+
+/-- 正規化は名前と行の所属を保つ。 -/
+@[simp] theorem mem_norm (e : Eff) (a : Atom) : mem (norm e) a ↔ mem e a := by
+  cases e; rfl
+
+/-- 生の表現の重複と順序は、包含の結果に影響しない。 -/
+theorem sub_norm (e f : Eff) : Sub e f ↔ Sub (norm e) (norm f) := by
+  simp only [Sub, mem_norm, norm_memFail]
+
+/-- 和は正規形である。 -/
+theorem union_canonical (e f : Eff) : Canonical (union e f) := norm_idem _
+
+/-- 名前だけの効果は、型の正規化の計算を必要としない。 -/
+theorem canonical_ofAtoms (a : Atom → Bool) : Canonical (ofAtoms a) := rfl
+
+/-- 正規形に限れば、両方の包含から生の効果の等号が得られる。 -/
+theorem eq_of_sub_of_sub {e f : Eff} (he : Canonical e) (hf : Canonical f)
+    (hef : Sub e f) (hfe : Sub f e) : e = f := by
+  have ha : e.atoms = f.atoms := by
+    funext a
+    exact Bool.eq_iff_iff.mpr ⟨hef.1 a, hfe.1 a⟩
+  have hfs : (norm e).fails = (norm f).fails := by
+    cases e with
+    | mk a es =>
+      cases f with
+      | mk b fs =>
+        simp only [norm, fails]
+        apply (sortUnique_eq_iff_mem).mpr
+        intro t
+        simp only [Ty.normTys_eq_map, List.mem_map]
+        constructor
+        · rintro ⟨x, hx, rfl⟩
+          obtain ⟨y, hy, hyx⟩ := hef.2 x ⟨x, hx, rfl⟩
+          exact ⟨y, hy, hyx⟩
+        · rintro ⟨x, hx, rfl⟩
+          obtain ⟨y, hy, hyx⟩ := hfe.2 x ⟨x, hx, rfl⟩
+          exact ⟨y, hy, hyx⟩
+  apply ext (fun a => Bool.eq_iff_iff.mp (congrFun ha a))
+  exact (congrArg fails he).symm.trans (hfs.trans (congrArg fails hf))
+
+/-- 型変数の移動は効果の包含を保つ。 -/
+theorem shift_mono (k c : Nat) {e f : Eff} (h : Sub e f) : Sub (shift k c e) (shift k c f) := by
+  cases e with
+  | mk a fs =>
+    cases f with
+    | mk b gs =>
+      constructor
+      · exact h.1
+      · intro t ht
+        rw [shift, norm_memFail] at ht ⊢
+        simp only [memFail, rawShift, fails, Ty.rawShiftTys_eq_map, List.mem_map] at ht ⊢
+        obtain ⟨x, ⟨y, hy, rfl⟩, hyt⟩ := ht
+        obtain ⟨z, hz, hzy⟩ := h.2 y ⟨y, hy, rfl⟩
+        refine ⟨z.rawShift k c, ⟨z, hz, rfl⟩, ?_⟩
+        rw [Ty.norm_rawShift] at hyt ⊢
+        exact (congrArg (Ty.rawShift k c) hzy).trans hyt
+
+/-- 最上位の効果は未整列でも、正規化した効果と相互に包含する。 -/
+theorem sub_norm_self (e : Eff) : Sub e (norm e) := by
+  simp only [Sub, mem_norm, norm_memFail]
+  exact ⟨fun _ => id, fun _ => id⟩
+
+theorem norm_sub_self (e : Eff) : Sub (norm e) e := by
+  simp only [Sub, mem_norm, norm_memFail]
+  exact ⟨fun _ => id, fun _ => id⟩
+
+end Benitoite.Release.Eff
diff --git a/formal/Benitoite/Release/LegacyCheck.lean b/formal/Benitoite/Release/LegacyCheck.lean
new file mode 100644
index 00000000..4a4097ca
--- /dev/null
+++ b/formal/Benitoite/Release/LegacyCheck.lean
@@ -0,0 +1,40 @@
+import Benitoite.Release.Normalize
+
+/-!
+# 旧入力の計算できる検査
+
+型と潜在効果をすべて辿り、Failを持たない入力を検出する。
+検査器の移行中の制限に使う（設計書 07-04「01-12 との対応」）。
+-/
+namespace Benitoite.Release
+
+/-- 最上位にFailの型があれば旧入力ではない。 -/
+def Eff.isLegacy (e : Eff) : Bool := e.fails.isEmpty
+
+mutual
+  def Ty.isLegacy : Ty → Bool
+    | .data _ ts | .tapp _ ts => Ty.areLegacy ts
+    | .list t | .reference t | .lazy t | .set t | .dict _ t => t.isLegacy
+    | .fn _ ps r e => Ty.areLegacy ps && r.isLegacy && Eff.isLegacy e
+    | .cont a b e => a.isLegacy && b.isLegacy && Eff.isLegacy e
+    | .map a b => a.isLegacy && b.isLegacy
+    | _ => true
+  def Ty.areLegacy : List Ty → Bool
+    | [] => true
+    | t :: ts => t.isLegacy && Ty.areLegacy ts
+end
+
+@[simp] theorem Eff.isLegacy_spec (e : Eff) : Eff.isLegacy e = true ↔ Eff.Legacy e :=
+  List.isEmpty_iff
+
+mutual
+  theorem Ty.isLegacy_spec (t : Ty) : t.isLegacy = true ↔ t.Legacy := by
+    cases t <;> simp [Ty.isLegacy, Ty.Legacy, Ty.isLegacy_spec, Ty.areLegacy_spec,
+      Eff.isLegacy_spec, Bool.and_eq_true, and_assoc]
+  theorem Ty.areLegacy_spec (ts : List Ty) : Ty.areLegacy ts = true ↔ Ty.LegacyTys ts := by
+    cases ts with
+    | nil => simp [Ty.areLegacy, Ty.LegacyTys]
+    | cons t ts => simp only [Ty.areLegacy, Ty.LegacyTys, Bool.and_eq_true, Ty.isLegacy_spec, Ty.areLegacy_spec]
+end
+
+end Benitoite.Release
diff --git a/formal/Benitoite/Release/Lemmas/VariableBind.lean b/formal/Benitoite/Release/Lemmas/VariableBind.lean
new file mode 100644
index 00000000..b312e40b
--- /dev/null
+++ b/formal/Benitoite/Release/Lemmas/VariableBind.lean
@@ -0,0 +1,97 @@
+import Benitoite.Release.Lemmas.Closed
+
+/-!
+# 開いた型の像による代入と整形式
+
+同じ外側の型パラメータを参照する型と行の像から、代入後の型の範囲と正規形を得る。
+Fail内部も同時に代入する（設計書 01-12「型付け規則」）。
+-/
+namespace Benitoite.Release
+
+mutual
+  theorem Ty.bind_clean {n m : Nat} (θ : SubstEnv)
+      (ht : ∀ i < m, TyOK n (θ.types i))
+      (he : ∀ e ∈ θ.rows, Eff.VarsIn n (fun _ => True) e)
+      (t : Ty) (h : TyOK m t) : TyOK n (Ty.bind θ t) := by
+    cases t <;> simp only [TyOK, Ty.VarsIn] at h <;>
+      simp only [Ty.bind, Ty.rawBind, Ty.norm, TyOK, Ty.VarsIn]
+    all_goals first
+      | trivial
+      | exact Ty.bind_clean θ ht he _ h
+      | exact Ty.bindTys_clean θ ht he _ h
+      | skip
+    case tvar i => exact Ty.norm_VarsIn _ (ht i h)
+    case fn ns ps r e =>
+      refine ⟨?_, Ty.bindTys_clean θ ht he ps h.2.1,
+        Ty.bind_clean θ ht he r h.2.2.1, Eff.bind_clean θ ht he e h.2.2.2.1, Eff.norm_idem _⟩
+      simpa only [NamesWF, Ty.normTys_eq_map, Ty.rawBindTys_eq_map, List.length_map] using h.1
+    case map a b => exact ⟨Ty.bind_clean θ ht he a h.1, Ty.bind_clean θ ht he b h.2⟩
+    case tapp i ts =>
+      have hh := Ty.applyTo_varsIn (Ty.norm_VarsIn _ (ht i h.1))
+        (Ty.bindTys_clean θ ht he ts h.2)
+      rw [Ty.applyTo_eq_raw_norm, Ty.norm_rawApplyTo] at hh
+      exact hh
+
+  theorem Ty.bindTys_clean {n m : Nat} (θ : SubstEnv)
+      (ht : ∀ i < m, TyOK n (θ.types i))
+      (he : ∀ e ∈ θ.rows, Eff.VarsIn n (fun _ => True) e)
+      (ts : List Ty) (h : Ty.VarsInList m (fun _ => True) ts) :
+      Ty.VarsInList n (fun _ => True) (Ty.normTys (Ty.rawBindTys θ ts)) := by
+    cases ts with
+    | nil => trivial
+    | cons t ts => exact ⟨Ty.bind_clean θ ht he t h.1, Ty.bindTys_clean θ ht he ts h.2⟩
+
+  theorem Eff.bind_clean {n m : Nat} (θ : SubstEnv)
+      (ht : ∀ i < m, TyOK n (θ.types i))
+      (he : ∀ e ∈ θ.rows, Eff.VarsIn n (fun _ => True) e)
+      (e : Eff) (h : Eff.VarsIn m (fun _ => True) e) :
+      Eff.VarsIn n (fun _ => True) (Eff.bind θ e) := by
+    cases e with
+    | mk a fs =>
+      refine ⟨fun _ _ => trivial, Ty.VarsInList.iff.mpr ?_⟩
+      intro t hm
+      change t ∈ Order.sortUnique tyCompare
+        (Ty.normTys (Ty.rawBindTys θ fs ++ Eff.rowFails θ.rows a)) at hm
+      rw [Ty.normTys_append] at hm
+      rcases List.mem_append.mp (Order.mem_sortUnique.mp hm) with hm | hm
+      · exact Ty.VarsInList.iff.mp (Ty.bindTys_clean θ ht he fs h.2) t hm
+      · obtain ⟨x, hx, rfl⟩ := List.mem_map.mp (show t ∈ (Eff.rowFails θ.rows a).map Ty.norm from by
+          simpa only [Ty.normTys_eq_map] using hm)
+        obtain ⟨i, e, hi, _, hx⟩ := Eff.mem_rowFails.mp hx
+        cases e with
+        | mk b gs =>
+          exact Ty.norm_VarsIn x
+            (Ty.VarsInList.iff.mp (he (.mk b gs) (List.mem_of_getElem? hi)).2 x hx)
+end
+
+theorem Ty.subst_clean {n : Nat} (ts : List Ty) (es : List Eff)
+    (ht : Ty.VarsInList n (fun _ => True) ts)
+    (he : ∀ e ∈ es, Eff.VarsIn n (fun _ => True) e) (t : Ty) (h : TyOK ts.length t) :
+    TyOK n (t.subst ts es) := by
+  rw [Ty.subst, Ty.substAt_eq_bind]
+  apply Ty.bind_clean (m := ts.length)
+  · intro i hi
+    simpa [SubstEnv.at, hi, Ty.rawShift_zero] using
+      Ty.VarsInList.iff.mp ht ts[i] (List.getElem_mem hi)
+  · intro e hm
+    obtain ⟨f, hf, rfl⟩ := List.mem_map.mp hm
+    rw [Eff.rawShift_zero]
+    exact he f hf
+  · exact h
+
+theorem Eff.subst_clean {n : Nat} (ts : List Ty) (es : List Eff)
+    (ht : Ty.VarsInList n (fun _ => True) ts)
+    (he : ∀ e ∈ es, Eff.VarsIn n (fun _ => True) e) (e : Eff)
+    (h : Eff.VarsIn ts.length (fun _ => True) e) :
+    Eff.VarsIn n (fun _ => True) (Eff.substAt 0 ts es e) := by
+  apply Eff.bind_clean (m := ts.length)
+  · intro i hi
+    simpa [SubstEnv.at, hi, Ty.rawShift_zero] using
+      Ty.VarsInList.iff.mp ht ts[i] (List.getElem_mem hi)
+  · intro f hm
+    obtain ⟨g, hg, rfl⟩ := List.mem_map.mp hm
+    rw [Eff.rawShift_zero]
+    exact he g hg
+  · exact h
+
+end Benitoite.Release
diff --git a/formal/Benitoite/Release/Normalize.lean b/formal/Benitoite/Release/Normalize.lean
new file mode 100644
index 00000000..b4eb5c7b
--- /dev/null
+++ b/formal/Benitoite/Release/Normalize.lean
@@ -0,0 +1,206 @@
+import Benitoite.Release.Order.Types
+
+/-!
+# 型とエフェクトの正規形
+
+型内部を先に正規化し、Fail の型の列を固定順で整列して重複を除く。
+名前と行の関数は変更しない（設計書 07-04「01-12 との対応」）。
+-/
+
+namespace Benitoite.Release
+
+open Order
+
+mutual
+  /-- 型のすべての子と、埋め込まれた効果を正規化する。 -/
+  noncomputable def Ty.norm : Ty → Ty
+    | .base b => .base b
+    | .opaque o => .opaque o
+    | .data d as => .data d (Ty.normTys as)
+    | .list a => .list a.norm
+    | .fn ns ps r e => .fn ns (Ty.normTys ps) r.norm (Eff.norm e)
+    | .tvar i => .tvar i
+    | .reference a => .reference a.norm
+    | .lazy a => .lazy a.norm
+    | .cont b t e => .cont b.norm t.norm (Eff.norm e)
+    | .map a b => .map a.norm b.norm
+    | .set a => .set a.norm
+    | .bytes => .bytes
+    | .dict cl a => .dict cl a.norm
+    | .tapp i as => .tapp i (Ty.normTys as)
+    | .ctor c => .ctor c
+  termination_by structural t => t
+
+  /-- 型列も同じ構造再帰に含める。 -/
+  noncomputable def Ty.normTys : List Ty → List Ty
+    | [] => []
+    | a :: as => a.norm :: Ty.normTys as
+  termination_by structural as => as
+
+  /-- 名前と行を保ち、子の正規化後に Fail 列を整列する。 -/
+  noncomputable def Eff.norm : Eff → Eff
+    | .mk a fs => .mk a (sortUnique tyCompare (Ty.normTys fs))
+  termination_by structural e => e
+end
+
+@[simp] theorem Ty.normTys_eq_map (as : List Ty) : Ty.normTys as = as.map Ty.norm := by
+  induction as with
+  | nil => rfl
+  | cons a as ih => simp only [Ty.normTys, List.map_cons, ih]
+
+/-- 正規形は正規化の固定点である。 -/
+def Ty.Canonical (t : Ty) : Prop := t.norm = t
+
+/-- 最上位の計算の効果には、この条件を要求しない。 -/
+def Eff.Canonical (e : Eff) : Prop := e.norm = e
+
+private theorem normTys_sortUnique {as : List Ty} (h : Ty.normTys as = as) :
+    Ty.normTys (sortUnique tyCompare as) = sortUnique tyCompare as := by
+  rw [Ty.normTys_eq_map] at h ⊢
+  have hf : ∀ a ∈ as, a.norm = a := by
+    intro a ha
+    exact List.map_eq_map_iff.mp (h.trans (List.map_id as).symm) a ha
+  induction hs : sortUnique tyCompare as with
+  | nil => rfl
+  | cons a bs _ih =>
+    simp only [List.map_cons]
+    congr 1
+    · exact hf a (mem_sortUnique.mp (by rw [hs]; exact List.mem_cons_self))
+    · calc
+        bs.map Ty.norm = bs.map id := List.map_congr_left (fun b hb =>
+          hf b (mem_sortUnique.mp (by rw [hs]; exact List.mem_cons_of_mem a hb)))
+        _ = bs := List.map_id bs
+
+mutual
+  /-- 正規化は型で冪等である。 -/
+  theorem Ty.norm_idem (t : Ty) : t.norm.norm = t.norm := by
+    cases t <;> simp only [Ty.norm, Ty.norm_idem, Ty.normTys_idem, Eff.norm_idem]
+
+  /-- 型列でも二度目の正規化は変化を起こさない。 -/
+  theorem Ty.normTys_idem (as : List Ty) : Ty.normTys (Ty.normTys as) = Ty.normTys as := by
+    cases as with
+    | nil => rfl
+    | cons a as => simp only [Ty.normTys, Ty.norm_idem, Ty.normTys_idem]
+
+  /-- 効果でも子の冪等性と整列の冪等性を使う。 -/
+  theorem Eff.norm_idem (e : Eff) : e.norm.norm = e.norm := by
+    cases e with
+    | mk a fs =>
+      simp only [Eff.norm, normTys_sortUnique (Ty.normTys_idem fs), sortUnique_idem]
+end
+
+/-- 生の効果の Fail 所属は、要素の正規形によって定める。 -/
+def Eff.memFail (e : Eff) (t : Ty) : Prop := ∃ x ∈ e.fails, x.norm = t.norm
+
+/-- 正規化前後で Fail の意味を保つ。 -/
+theorem Eff.norm_memFail (e : Eff) (t : Ty) : e.norm.memFail t ↔ e.memFail t := by
+  cases e with
+  | mk a fs =>
+    simp only [Eff.memFail, Eff.norm, Eff.fails, mem_sortUnique, Ty.normTys_eq_map, List.mem_map]
+    constructor
+    · rintro ⟨x, ⟨y, hy, rfl⟩, hx⟩
+      exact ⟨y, hy, (Ty.norm_idem y) ▸ hx⟩
+    · rintro ⟨x, hx, ht⟩
+      exact ⟨x.norm, ⟨x, hx, rfl⟩, (Ty.norm_idem x).trans ht⟩
+
+mutual
+  /-- Fail のない旧型は、効果の支持の有限性によらず保持する。 -/
+  def Ty.Legacy : Ty → Prop
+    | .base _ | .opaque _ | .tvar _ | .bytes | .ctor _ => True
+    | .data _ as | .tapp _ as => Ty.LegacyTys as
+    | .list a | .reference a | .lazy a | .set a | .dict _ a => a.Legacy
+    | .fn _ ps r e => Ty.LegacyTys ps ∧ r.Legacy ∧ Eff.Legacy e
+    | .cont b t e => b.Legacy ∧ t.Legacy ∧ Eff.Legacy e
+    | .map a b => a.Legacy ∧ b.Legacy
+
+  def Ty.LegacyTys : List Ty → Prop
+    | [] => True
+    | a :: as => a.Legacy ∧ Ty.LegacyTys as
+
+  def Eff.Legacy (e : Eff) : Prop := e.fails = []
+end
+
+mutual
+  /-- 旧型の正規化は恒等である。 -/
+  theorem Ty.norm_legacy (t : Ty) (h : t.Legacy) : t.norm = t := by
+    cases t <;> simp only [Ty.Legacy] at h <;>
+      simp only [Ty.norm]
+    all_goals first
+      | rfl
+      | exact congrArg _ (Ty.norm_legacy _ h)
+      | exact congrArg _ (Ty.normTys_legacy _ h)
+      | skip
+    case fn ns ps r e =>
+      rw [Ty.normTys_legacy ps h.1, Ty.norm_legacy r h.2.1, Eff.norm_legacy e h.2.2]
+    case cont b t e =>
+      rw [Ty.norm_legacy b h.1, Ty.norm_legacy t h.2.1, Eff.norm_legacy e h.2.2]
+    case map a b => rw [Ty.norm_legacy a h.1, Ty.norm_legacy b h.2]
+
+  theorem Ty.normTys_legacy (as : List Ty) (h : Ty.LegacyTys as) : Ty.normTys as = as := by
+    cases as with
+    | nil => rfl
+    | cons a as =>
+      simp only [Ty.normTys, Ty.norm_legacy a h.1, Ty.normTys_legacy as h.2]
+
+  /-- Fail 列が空なら、原子の関数の比較へ到達しない。 -/
+  theorem Eff.norm_legacy (e : Eff) (h : e.Legacy) : e.norm = e := by
+    cases e with
+    | mk a fs => cases h; rfl
+end
+
+mutual
+  /-- すべての深さで Fail の列が高々一要素である。 -/
+  def Ty.FailsLeOne : Ty → Prop
+    | .base _ | .opaque _ | .tvar _ | .bytes | .ctor _ => True
+    | .data _ as | .tapp _ as => Ty.FailsLeOneTys as
+    | .list a | .reference a | .lazy a | .set a | .dict _ a => a.FailsLeOne
+    | .fn _ ps r e => Ty.FailsLeOneTys ps ∧ r.FailsLeOne ∧ Eff.FailsLeOne e
+    | .cont b t e => b.FailsLeOne ∧ t.FailsLeOne ∧ Eff.FailsLeOne e
+    | .map a b => a.FailsLeOne ∧ b.FailsLeOne
+
+  def Ty.FailsLeOneTys : List Ty → Prop
+    | [] => True
+    | a :: as => a.FailsLeOne ∧ Ty.FailsLeOneTys as
+
+  def Eff.FailsLeOne : Eff → Prop
+    | .mk _ fs => fs.length ≤ 1 ∧ Ty.FailsLeOneTys fs
+end
+
+mutual
+  /-- 読者が作る高々一つの Fail の型は、比較の計算を必要とせず正規形となる。 -/
+  theorem Ty.canonical_of_failsLeOne (t : Ty) (h : t.FailsLeOne) : t.Canonical := by
+    cases t <;> simp only [Ty.FailsLeOne] at h <;> unfold Ty.Canonical <;> simp only [Ty.norm]
+    all_goals first
+      | rfl
+      | exact congrArg _ (Ty.canonical_of_failsLeOne _ h)
+      | exact congrArg _ (Ty.canonicalTys_of_failsLeOne _ h)
+      | skip
+    case fn ns ps r e =>
+      rw [Ty.canonicalTys_of_failsLeOne ps h.1, Ty.canonical_of_failsLeOne r h.2.1,
+        Eff.canonical_of_failsLeOne e h.2.2]
+    case cont b t e =>
+      rw [Ty.canonical_of_failsLeOne b h.1, Ty.canonical_of_failsLeOne t h.2.1,
+        Eff.canonical_of_failsLeOne e h.2.2]
+    case map a b => rw [Ty.canonical_of_failsLeOne a h.1, Ty.canonical_of_failsLeOne b h.2]
+
+  theorem Ty.canonicalTys_of_failsLeOne (as : List Ty) (h : Ty.FailsLeOneTys as) : Ty.normTys as = as := by
+    cases as with
+    | nil => rfl
+    | cons a as =>
+      rw [Ty.normTys, Ty.canonical_of_failsLeOne a h.1, Ty.canonicalTys_of_failsLeOne as h.2]
+
+  theorem Eff.canonical_of_failsLeOne (e : Eff) (h : Eff.FailsLeOne e) : Eff.Canonical e := by
+    cases e with
+    | mk a fs =>
+      obtain ⟨hlen, hfs⟩ := h
+      unfold Eff.Canonical
+      simp only [Eff.norm, Ty.canonicalTys_of_failsLeOne fs hfs]
+      cases fs with
+      | nil => rfl
+      | cons t ts =>
+        cases ts with
+        | nil => rfl
+        | cons u us => simp at hlen
+end
+
+end Benitoite.Release
diff --git a/formal/Benitoite/Release/TypeBounds.lean b/formal/Benitoite/Release/TypeBounds.lean
new file mode 100644
index 00000000..d4fb0aff
--- /dev/null
+++ b/formal/Benitoite/Release/TypeBounds.lean
@@ -0,0 +1,274 @@
+import Benitoite.Release.TypeRegularity
+import Benitoite.Release.TypeSubstLemmas
+
+/-!
+# 正規化前の型の範囲と整形式
+
+生の代入で列が未整列になる段階と、正規化後の型の整形式を分けて証明する。
+同じ共有型上の補助述語であり、型付けの整形式を弱めるものではない
+（設計書 01-12「型付け規則」）。
+-/
+
+namespace Benitoite.Release
+
+open Order
+
+mutual
+  /-- 正規形の条件を除いた、型変数の範囲と契約名の条件。 -/
+  def Ty.RawWF (n : Nat) : Ty → Prop
+    | .base _ | .opaque _ | .bytes | .ctor _ => True
+    | .data _ as => Ty.RawWFList n as
+    | .tapp i as => i < n ∧ Ty.RawWFList n as
+    | .list a | .reference a | .lazy a | .set a | .dict _ a => a.RawWF n
+    | .fn ns ps r e => NamesWF ns ps ∧ Ty.RawWFList n ps ∧ r.RawWF n ∧ Eff.RawWF n e
+    | .tvar i => i < n
+    | .cont b t e => b.RawWF n ∧ t.RawWF n ∧ Eff.RawWF n e
+    | .map a b => a.RawWF n ∧ b.RawWF n
+
+  def Ty.RawWFList (n : Nat) : List Ty → Prop
+    | [] => True
+    | a :: as => a.RawWF n ∧ Ty.RawWFList n as
+
+  def Eff.RawWF (n : Nat) : Eff → Prop
+    | .mk _ fs => Ty.RawWFList n fs
+end
+
+theorem Ty.RawWFList.iff {n : Nat} {as : List Ty} : Ty.RawWFList n as ↔ ∀ a ∈ as, a.RawWF n := by
+  induction as with
+  | nil => simp [Ty.RawWFList]
+  | cons a as ih => simp [Ty.RawWFList, ih]
+
+mutual
+  theorem Ty.WF.raw {n : Nat} (t : Ty) (h : Ty.WF n t) : t.RawWF n := by
+    cases t <;> simp only [Ty.WF] at h <;> simp only [Ty.RawWF]
+    all_goals first
+      | trivial
+      | exact h
+      | exact Ty.WF.raw _ h
+      | exact Ty.WFList.raw _ h
+      | skip
+    case fn ns ps r e => exact ⟨h.1, Ty.WFList.raw ps h.2.1, Ty.WF.raw r h.2.2.1, Eff.WF.raw e h.2.2.2.1⟩
+    case cont b t e => exact ⟨Ty.WF.raw b h.1, Ty.WF.raw t h.2.1, Eff.WF.raw e h.2.2.1⟩
+    case map a b => exact ⟨Ty.WF.raw a h.1, Ty.WF.raw b h.2⟩
+    case tapp i as => exact ⟨h.1, Ty.WFList.raw as h.2⟩
+
+  theorem Ty.WFList.raw {n : Nat} (as : List Ty) (h : Ty.WFList n as) : Ty.RawWFList n as := by
+    cases as with
+    | nil => trivial
+    | cons a as => exact ⟨Ty.WF.raw a h.1, Ty.WFList.raw as h.2⟩
+
+  theorem Eff.WF.raw {n : Nat} (e : Eff) (h : Eff.WF n e) : Eff.RawWF n e := by
+    cases e with
+    | mk a fs => exact Ty.WFList.raw fs h
+end
+
+mutual
+  /-- 正規化は、生の型の範囲と契約名から正規形を含む整形式を構築する。 -/
+  theorem Ty.norm_rawWF {n : Nat} (t : Ty) (h : t.RawWF n) : Ty.WF n t.norm := by
+    cases t <;> simp only [Ty.RawWF] at h <;> simp only [Ty.norm, Ty.WF]
+    all_goals first
+      | trivial
+      | exact h
+      | exact Ty.norm_rawWF _ h
+      | exact Ty.normTys_rawWF _ h
+      | skip
+    case fn ns ps r e => exact ⟨by simpa only [NamesWF, Ty.normTys_eq_map, List.length_map] using h.1,
+      Ty.normTys_rawWF ps h.2.1, Ty.norm_rawWF r h.2.2.1, Eff.norm_rawWF e h.2.2.2, Eff.norm_idem e⟩
+    case cont b t e => exact ⟨Ty.norm_rawWF b h.1, Ty.norm_rawWF t h.2.1,
+      Eff.norm_rawWF e h.2.2, Eff.norm_idem e⟩
+    case map a b => exact ⟨Ty.norm_rawWF a h.1, Ty.norm_rawWF b h.2⟩
+    case tapp i as => exact ⟨h.1, Ty.normTys_rawWF as h.2⟩
+
+  theorem Ty.normTys_rawWF {n : Nat} (as : List Ty) (h : Ty.RawWFList n as) : Ty.WFList n (Ty.normTys as) := by
+    cases as with
+    | nil => trivial
+    | cons a as => exact ⟨Ty.norm_rawWF a h.1, Ty.normTys_rawWF as h.2⟩
+
+  theorem Eff.norm_rawWF {n : Nat} (e : Eff) (h : Eff.RawWF n e) : Eff.WF n (Eff.norm e) := by
+    cases e with
+    | mk a fs =>
+      apply Ty.WFList.iff.mpr
+      intro t ht
+      exact Ty.WFList.iff.mp (Ty.normTys_rawWF fs h) t (mem_sortUnique.mp ht)
+end
+
+/-- 生の型構成子への適用も、型変数の範囲と契約名を保つ。 -/
+theorem TyCon.rawApply_rawWF {n : Nat} (c : TyCon) (as : List Ty) (h : Ty.RawWFList n as) :
+    (c.rawApply as).RawWF n := by
+  cases c <;> cases as <;> simp only [TyCon.rawApply, Ty.RawWF, List.headD_nil,
+    List.headD_cons, List.tail_nil, List.tail_cons] at *
+  all_goals first | trivial | exact h | exact h.1 | skip
+  case map.cons a as =>
+    cases as with
+    | nil => exact ⟨h.1, trivial⟩
+    | cons b bs => exact ⟨h.1, h.2.1⟩
+
+theorem Ty.rawApplyTo_rawWF {n : Nat} (t : Ty) (as : List Ty) (ht : t.RawWF n) (has : Ty.RawWFList n as) :
+    (t.rawApplyTo as).RawWF n := by
+  cases t with
+  | ctor c => exact TyCon.rawApply_rawWF c as has
+  | tvar i => exact ⟨ht, has⟩
+  | _ => exact ht
+
+mutual
+  /-- 生の同時代入は、範囲内の型の像と行の像が満たす範囲を保つ。 -/
+  theorem Ty.rawBind_rawWF {m n : Nat} (θ : SubstEnv) (hts : ∀ i < m, (θ.types i).RawWF n)
+      (hes : ∀ e ∈ θ.rows, Eff.RawWF n e) (t : Ty) (h : t.RawWF m) : (t.rawBind θ).RawWF n := by
+    cases t <;> simp only [Ty.RawWF] at h <;> simp only [Ty.rawBind, Ty.RawWF]
+    all_goals first
+      | trivial
+      | exact Ty.rawBind_rawWF θ hts hes _ h
+      | exact Ty.rawBindTys_rawWF θ hts hes _ h
+      | skip
+    case fn ns ps r e => exact ⟨by simpa only [NamesWF, Ty.rawBindTys_eq_map, List.length_map] using h.1,
+      Ty.rawBindTys_rawWF θ hts hes ps h.2.1, Ty.rawBind_rawWF θ hts hes r h.2.2.1,
+      Eff.rawBind_rawWF θ hts hes e h.2.2.2⟩
+    case tvar i => exact hts i h
+    case cont b t e => exact ⟨Ty.rawBind_rawWF θ hts hes b h.1,
+      Ty.rawBind_rawWF θ hts hes t h.2.1, Eff.rawBind_rawWF θ hts hes e h.2.2⟩
+    case map a b => exact ⟨Ty.rawBind_rawWF θ hts hes a h.1, Ty.rawBind_rawWF θ hts hes b h.2⟩
+    case tapp i as => exact Ty.rawApplyTo_rawWF _ _ (hts i h.1) (Ty.rawBindTys_rawWF θ hts hes as h.2)
+
+  theorem Ty.rawBindTys_rawWF {m n : Nat} (θ : SubstEnv) (hts : ∀ i < m, (θ.types i).RawWF n)
+      (hes : ∀ e ∈ θ.rows, Eff.RawWF n e) (as : List Ty) (h : Ty.RawWFList m as) :
+      Ty.RawWFList n (Ty.rawBindTys θ as) := by
+    cases as with
+    | nil => trivial
+    | cons a as => exact ⟨Ty.rawBind_rawWF θ hts hes a h.1, Ty.rawBindTys_rawWF θ hts hes as h.2⟩
+
+  theorem Eff.rawBind_rawWF {m n : Nat} (θ : SubstEnv) (hts : ∀ i < m, (θ.types i).RawWF n)
+      (hes : ∀ e ∈ θ.rows, Eff.RawWF n e) (e : Eff) (h : Eff.RawWF m e) : Eff.RawWF n (Eff.rawBind θ e) := by
+    cases e with
+    | mk a fs =>
+      apply Ty.RawWFList.iff.mpr
+      intro t ht
+      rcases List.mem_append.mp ht with ht | ht
+      · exact Ty.RawWFList.iff.mp (Ty.rawBindTys_rawWF θ hts hes fs h) t ht
+      · obtain ⟨i, e, he, _, hte⟩ := Eff.mem_rowFails.mp ht
+        have hfe : Ty.RawWFList n e.fails := by cases e; exact hes _ (List.mem_of_getElem? he)
+        exact Ty.RawWFList.iff.mp hfe t hte
+end
+
+/-- 正規化した一般の代入は、整形式の型と整形式の置換像から整形式を得る。 -/
+theorem Ty.bind_wf {m n : Nat} (θ : SubstEnv) (hts : ∀ i < m, Ty.WF n (θ.types i))
+    (hes : ∀ e ∈ θ.rows, Eff.WF n e) (t : Ty) (h : Ty.WF m t) : Ty.WF n (Ty.bind θ t) := by
+  exact Ty.norm_rawWF _ (Ty.rawBind_rawWF θ (fun i hi => Ty.WF.raw _ (hts i hi))
+    (fun e he => Eff.WF.raw _ (hes e he)) t (Ty.WF.raw t h))
+
+mutual
+  /-- 生の変数移動は、恒等の行置換を持つ生の一般代入である。 -/
+  theorem Ty.rawShift_eq_rawBind (k c : Nat) (t : Ty) : t.rawShift k c = t.rawBind (SubstEnv.shift k c) := by
+    cases t <;> simp only [Ty.rawShift, Ty.rawBind, Ty.rawShift_eq_rawBind,
+      Ty.rawShiftTys_eq_rawBindTys, Eff.rawShift_eq_rawBind]
+    case tvar i => rfl
+    case tapp i as => rfl
+
+  theorem Ty.rawShiftTys_eq_rawBindTys (k c : Nat) (as : List Ty) :
+      Ty.rawShiftTys k c as = Ty.rawBindTys (SubstEnv.shift k c) as := by
+    cases as with
+    | nil => rfl
+    | cons a as => simp only [Ty.rawShiftTys, Ty.rawBindTys, Ty.rawShift_eq_rawBind, Ty.rawShiftTys_eq_rawBindTys]
+
+  theorem Eff.rawShift_eq_rawBind (k c : Nat) (e : Eff) :
+      Eff.rawShift k c e = Eff.rawBind (SubstEnv.shift k c) e := by
+    cases e with
+    | mk a fs => simp only [Eff.rawShift, Eff.rawBind, SubstEnv.shift, Eff.substAtoms_nil,
+      Eff.rowFails_nil, List.append_nil, Ty.rawShiftTys_eq_rawBindTys]
+end
+
+/-- 移動後の型は、移動前の範囲に移動量を加えた範囲で整形式である。 -/
+theorem Ty.shift_wf {n : Nat} (k : Nat) (t : Ty) (h : Ty.WF n t) : Ty.WF (n + k) (t.shift k 0) := by
+  rw [Ty.shift_eq_norm_rawShift, Ty.rawShift_eq_rawBind]
+  apply Ty.bind_wf (SubstEnv.shift k 0) (hes := by simp [SubstEnv.shift]) (t := t) (h := h)
+  intro i hi
+  simp only [SubstEnv.shift, Nat.not_lt_zero, ↓reduceIte, Ty.WF]
+  omega
+
+/-- 有限列の代入は、閉じた型と行の像から、残った束縛の範囲で整形式を得る。 -/
+theorem Ty.substAt_wf {c : Nat} {ts : List Ty} (es : List Eff)
+    (hts : ∀ t ∈ ts, Ty.WF 0 t) (hes : ∀ e ∈ es, Eff.WF 0 e)
+    (t : Ty) (h : Ty.WF (c + ts.length) t) : Ty.WF c (t.substAt c ts es) := by
+  rw [Ty.substAt_eq_bind]
+  apply Ty.bind_wf (SubstEnv.at c ts es) (t := t) (h := h)
+  · intro i hi
+    simp only [SubstEnv.at]
+    split
+    · assumption
+    · rename_i hc
+      have hj : i - c < ts.length := by omega
+      simp only [hj, ↓reduceIte, List.getElem?_eq_getElem hj, Option.getD_some]
+      have ht := hts _ (List.getElem_mem hj)
+      rw [Ty.rawShift_of_wf c _ ht]
+      exact Ty.WF.mono (Nat.zero_le c) _ ht
+  · intro e he
+    obtain ⟨f, hf, rfl⟩ := List.mem_map.mp he
+    have hw := hes f hf
+    rw [Eff.rawShift_of_wf c f hw]
+    exact Eff.WF.mono (Nat.zero_le c) f hw
+
+/-- 宣言の外側での代入では、型と行の像が結果の束縛の範囲に収まればよい。 -/
+theorem Ty.subst_wf {n : Nat} {ts : List Ty} (es : List Eff)
+    (hts : ∀ t ∈ ts, Ty.WF n t) (hes : ∀ e ∈ es, Eff.WF n e)
+    (t : Ty) (h : Ty.WF ts.length t) : Ty.WF n (t.subst ts es) := by
+  unfold Ty.subst
+  rw [Ty.substAt_eq_bind]
+  apply Ty.bind_wf (SubstEnv.at 0 ts es) (t := t) (h := h)
+  · intro i hi
+    simp only [SubstEnv.at, Nat.not_lt_zero, ↓reduceIte, Nat.sub_zero, hi,
+      List.getElem?_eq_getElem hi, Option.getD_some, Ty.rawShift_zero]
+    exact hts _ (List.getElem_mem hi)
+  · intro e he
+    obtain ⟨f, hf, rfl⟩ := List.mem_map.mp he
+    simpa only [Eff.rawShift_zero] using hes f hf
+
+/-- 効果の中の Fail 型についても、一般の代入は整形式を保つ。 -/
+theorem Eff.bind_wf {m n : Nat} (θ : SubstEnv) (hts : ∀ i < m, Ty.WF n (θ.types i))
+    (hes : ∀ e ∈ θ.rows, Eff.WF n e) (e : Eff) (h : Eff.WF m e) : Eff.WF n (Eff.bind θ e) := by
+  exact Eff.norm_rawWF _ (Eff.rawBind_rawWF θ (fun i hi => Ty.WF.raw _ (hts i hi))
+    (fun e he => Eff.WF.raw _ (hes e he)) e (Eff.WF.raw e h))
+
+/-- 束縛の外側での型と行の同時代入は、Fail 型の整形式を保つ。 -/
+theorem Eff.subst_wf {n : Nat} {ts : List Ty} (es : List Eff)
+    (hts : ∀ t ∈ ts, Ty.WF n t) (hes : ∀ e ∈ es, Eff.WF n e)
+    (e : Eff) (h : Eff.WF ts.length e) : Eff.WF n (Eff.substAt 0 ts es e) := by
+  apply Eff.bind_wf (SubstEnv.at 0 ts es) (e := e) (h := h)
+  · intro i hi
+    simp only [SubstEnv.at, Nat.not_lt_zero, ↓reduceIte, Nat.sub_zero, hi,
+      List.getElem?_eq_getElem hi, Option.getD_some, Ty.rawShift_zero]
+    exact hts _ (List.getElem_mem hi)
+  · intro e he
+    obtain ⟨f, hf, rfl⟩ := List.mem_map.mp he
+    simpa only [Eff.rawShift_zero] using hes f hf
+
+theorem Ty.substList_wf {n : Nat} {ts : List Ty} (es : List Eff)
+    (hts : ∀ t ∈ ts, Ty.WF n t) (hes : ∀ e ∈ es, Eff.WF n e)
+    (as : List Ty) (h : Ty.WFList ts.length as) :
+    Ty.WFList n (as.map (Ty.subst ts es)) := by
+  apply Ty.WFList.iff.mpr
+  rintro t ht
+  obtain ⟨a, ha, rfl⟩ := List.mem_map.mp ht
+  exact Ty.subst_wf es hts hes a (Ty.WFList.iff.mp h a ha)
+
+/-- 有限列の代入は、閉じた型と行の像から、残った束縛の範囲で整形式を得る。 -/
+theorem Eff.substAt_wf {c : Nat} {ts : List Ty} (es : List Eff)
+    (hts : ∀ t ∈ ts, Ty.WF 0 t) (hes : ∀ e ∈ es, Eff.WF 0 e)
+    (t : Eff) (h : Eff.WF (c + ts.length) t) : Eff.WF c (Eff.substAt c ts es t) := by
+  apply Eff.bind_wf (SubstEnv.at c ts es) (e := t) (h := h)
+  · intro i hi
+    simp only [SubstEnv.at]
+    split
+    · assumption
+    · rename_i hc
+      have hj : i - c < ts.length := by omega
+      simp only [hj, ↓reduceIte, List.getElem?_eq_getElem hj, Option.getD_some]
+      have ht := hts _ (List.getElem_mem hj)
+      rw [Ty.rawShift_of_wf c _ ht]
+      exact Ty.WF.mono (Nat.zero_le c) _ ht
+  · intro e he
+    obtain ⟨f, hf, rfl⟩ := List.mem_map.mp he
+    have hw := hes f hf
+    rw [Eff.rawShift_of_wf c f hw]
+    exact Eff.WF.mono (Nat.zero_le c) f hw
+
+
+end Benitoite.Release
diff --git a/formal/Benitoite/Release/TypeComposition.lean b/formal/Benitoite/Release/TypeComposition.lean
new file mode 100644
