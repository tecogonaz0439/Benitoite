+++ b/formal/Benitoite/Release/TypeCongruence.lean
@@ -0,0 +1,131 @@
+import Benitoite.Release.TypeBounds
+import Benitoite.Release.TypeComposition
+
+/-!
+# 変数の範囲を用いる代入の一致
+
+型の変数と Fail 内部の行について、実際に現れる像の正規形の一致を使う
+（設計書 01-12「コア計算と脱糖」）。
+-/
+
+namespace Benitoite.Release
+
+mutual
+  /-- 型の像を保ち、再帰的に現れる行の像が一致すれば、型の代入結果も一致する。 -/
+  theorem Ty.bind_congr_scoped (θ φ : SubstEnv) {n : Nat} (ht : ∀ i < n, (θ.types i).norm = (φ.types i).norm) (t : Ty) (hw : t.RawWF n)
+      (h : t.RowsIn (fun i => Eff.rowImage θ.rows i = Eff.rowImage φ.rows i)) :
+      Ty.bind θ t = Ty.bind φ t := by
+    cases t <;> simp only [Ty.RowsIn] at h <;> simp only [Ty.RawWF] at hw <;>
+      simp only [Ty.bind, Ty.rawBind, Ty.norm]
+    all_goals first
+      | rfl
+      | exact congrArg _ (Ty.bind_congr_scoped θ φ ht _ hw h)
+      | exact congrArg _ (Ty.bindTys_congr_scoped θ φ ht _ hw h)
+      | skip
+    case tapp i as =>
+      apply Ty.rawApplyTo_norm_congr (ht i hw.1)
+      exact Ty.bindTys_congr_scoped θ φ ht as hw.2 h
+    case fn ns ps r e =>
+      rw [show Ty.normTys (Ty.rawBindTys θ ps) = Ty.normTys (Ty.rawBindTys φ ps) from
+        Ty.bindTys_congr_scoped θ φ ht ps hw.2.1 h.1,
+        show (r.rawBind θ).norm = (r.rawBind φ).norm from Ty.bind_congr_scoped θ φ ht r hw.2.2.1 h.2.1,
+        show Eff.norm (Eff.rawBind θ e) = Eff.norm (Eff.rawBind φ e) from Eff.bind_congr_scoped θ φ ht e hw.2.2.2 h.2.2]
+    case tvar i => exact ht i hw
+    case cont a b e =>
+      rw [show (a.rawBind θ).norm = (a.rawBind φ).norm from Ty.bind_congr_scoped θ φ ht a hw.1 h.1,
+        show (b.rawBind θ).norm = (b.rawBind φ).norm from Ty.bind_congr_scoped θ φ ht b hw.2.1 h.2.1,
+        show Eff.norm (Eff.rawBind θ e) = Eff.norm (Eff.rawBind φ e) from Eff.bind_congr_scoped θ φ ht e hw.2.2 h.2.2]
+    case map a b =>
+      rw [show (a.rawBind θ).norm = (a.rawBind φ).norm from Ty.bind_congr_scoped θ φ ht a hw.1 h.1,
+        show (b.rawBind θ).norm = (b.rawBind φ).norm from Ty.bind_congr_scoped θ φ ht b hw.2 h.2]
+
+
+  theorem Ty.bindTys_congr_scoped (θ φ : SubstEnv) {n : Nat} (ht : ∀ i < n, (θ.types i).norm = (φ.types i).norm) (ts : List Ty) (hw : Ty.RawWFList n ts)
+      (h : Ty.RowsInList (fun i => Eff.rowImage θ.rows i = Eff.rowImage φ.rows i) ts) :
+      Ty.normTys (Ty.rawBindTys θ ts) = Ty.normTys (Ty.rawBindTys φ ts) := by
+    cases ts with
+    | nil => rfl
+    | cons t ts =>
+      simp only [Ty.rawBindTys, Ty.normTys]
+      rw [show (t.rawBind θ).norm = (t.rawBind φ).norm from Ty.bind_congr_scoped θ φ ht t hw.1 h.1,
+        Ty.bindTys_congr_scoped θ φ ht ts hw.2 h.2]
+
+  theorem Eff.bind_congr_scoped (θ φ : SubstEnv) {n : Nat} (ht : ∀ i < n, (θ.types i).norm = (φ.types i).norm) (e : Eff) (hw : Eff.RawWF n e)
+      (h : Eff.RowsIn (fun i => Eff.rowImage θ.rows i = Eff.rowImage φ.rows i) e) :
+      Eff.bind θ e = Eff.bind φ e := by
+    cases e with
+    | mk atoms fs =>
+      have hfs := Ty.bindTys_congr_scoped θ φ ht fs hw h.2
+      apply Eff.norm_ext
+      · intro a
+        rw [Eff.mem_rawBind_rowImage, Eff.mem_rawBind_rowImage]
+        apply or_congr Iff.rfl
+        apply exists_congr
+        intro i
+        apply and_congr_right
+        intro hi
+        rw [h.1 i hi]
+      · intro t
+        rw [Eff.memFail_rawBind_rowImage, Eff.memFail_rawBind_rowImage]
+        apply or_congr
+        · have hm := Iff.of_eq (congrArg (fun xs => t.norm ∈ xs) hfs)
+          simpa only [Ty.normTys_eq_map, Ty.rawBindTys_eq_map, List.map_map,
+            Function.comp_apply, List.mem_map, Eff.fails] using hm
+        · apply exists_congr
+          intro i
+          apply and_congr_right
+          intro hi
+          rw [h.1 i hi]
+end
+
+/-- 型と行をそのまま保つ代入環境。 -/
+def SubstEnv.identity : SubstEnv := ⟨Ty.tvar, []⟩
+
+mutual
+  theorem Ty.rawBind_identity (t : Ty) : t.rawBind SubstEnv.identity = t := by
+    cases t <;> simp only [Ty.rawBind, Ty.rawBind_identity,
+      Ty.rawBindTys_identity, Eff.rawBind_identity]
+    all_goals rfl
+
+  theorem Ty.rawBindTys_identity (ts : List Ty) : Ty.rawBindTys SubstEnv.identity ts = ts := by
+    cases ts with
+    | nil => rfl
+    | cons t ts => simp only [Ty.rawBindTys, Ty.rawBind_identity, Ty.rawBindTys_identity]
+
+  theorem Eff.rawBind_identity (e : Eff) : Eff.rawBind SubstEnv.identity e = e := by
+    cases e with
+    | mk a fs =>
+      change EffR.mk (Eff.substAtoms [] a) (Ty.rawBindTys SubstEnv.identity fs ++ []) = _
+      rw [Eff.substAtoms_nil, List.append_nil, Ty.rawBindTys_identity]
+end
+
+/-- 公開する恒等代入は、入力の正規形を返す。 -/
+theorem Ty.bind_identity (t : Ty) : Ty.bind SubstEnv.identity t = t.norm := by
+  rw [Ty.bind, Ty.rawBind_identity]
+
+theorem Eff.bind_identity (e : Eff) : Eff.bind SubstEnv.identity e = Eff.norm e := by
+  rw [Eff.bind, Eff.rawBind_identity]
+
+theorem Eff.rowImage_normEnv (θ : SubstEnv) (i : Nat) :
+    Eff.rowImage θ.norm.rows i = Eff.norm (Eff.rowImage θ.rows i) := by
+  cases hi : θ.rows[i]? with
+  | none => simp only [Eff.rowImage, SubstEnv.norm, List.getElem?_map, hi, Option.map_none, Option.getD_none]; rfl
+  | some e => simp only [Eff.rowImage, SubstEnv.norm, List.getElem?_map, hi, Option.map_some, Option.getD_some]
+
+theorem Ty.bind_normEnv (θ : SubstEnv) (t : Ty) : Ty.bind θ.norm t = Ty.bind θ t :=
+  Ty.norm_rawBind_normEnv θ t
+
+/-- 置換像自体の順序・重複を問わず、像の正規形が一致すれば代入結果が一致する。 -/
+theorem Ty.bind_congr_scoped_norm (θ φ : SubstEnv) {n : Nat}
+    (ht : ∀ i < n, (θ.types i).norm = (φ.types i).norm) (t : Ty) (hw : t.RawWF n)
+    (hr : t.RowsIn (fun i => Eff.norm (Eff.rowImage θ.rows i) = Eff.norm (Eff.rowImage φ.rows i))) :
+    Ty.bind θ t = Ty.bind φ t := by
+  rw [← Ty.bind_normEnv θ, ← Ty.bind_normEnv φ]
+  apply Ty.bind_congr_scoped
+  · intro i hi
+    change (θ.types i).norm.norm = (φ.types i).norm.norm
+    rw [Ty.norm_idem, Ty.norm_idem, ht i hi]
+  · exact hw
+  · exact Ty.RowsIn.mono (fun i hi => by rw [Eff.rowImage_normEnv, Eff.rowImage_normEnv]; exact hi) t hr
+
+end Benitoite.Release
diff --git a/formal/Benitoite/Release/TypeRegularity.lean b/formal/Benitoite/Release/TypeRegularity.lean
new file mode 100644
index 00000000..1770143c
--- /dev/null
+++ b/formal/Benitoite/Release/TypeRegularity.lean
@@ -0,0 +1,136 @@
+import Benitoite.Release.Typing
+
+/-!
+# 型の整形式と正規形
+
+埋め込んだ効果の正規形を整形式から導き、最上位の効果の整形式と区別する。
+設計書 01-12「型付け規則」の規則条件に対応する。
+-/
+
+namespace Benitoite.Release
+
+open Order
+
+mutual
+  /-- 整形式の型は、内部のすべての効果を含めて正規形である。 -/
+  theorem Ty.WF.canonical {n : Nat} (t : Ty) (h : Ty.WF n t) : t.Canonical := by
+    cases t <;> simp only [Ty.WF] at h <;> unfold Ty.Canonical <;> simp only [Ty.norm]
+    all_goals first
+      | rfl
+      | exact congrArg _ (Ty.WF.canonical _ h)
+      | exact congrArg _ (Ty.WFList.norm_eq _ h)
+      | skip
+    case fn ns ps r e =>
+      rw [Ty.WFList.norm_eq ps h.2.1, Ty.WF.canonical r h.2.2.1, h.2.2.2.2]
+    case cont b t e => rw [Ty.WF.canonical b h.1, Ty.WF.canonical t h.2.1, h.2.2.2]
+    case map a b => rw [Ty.WF.canonical a h.1, Ty.WF.canonical b h.2]
+    case tapp i as => rw [Ty.WFList.norm_eq as h.2]
+
+  theorem Ty.WFList.norm_eq {n : Nat} (as : List Ty) (h : Ty.WFList n as) : Ty.normTys as = as := by
+    cases as with
+    | nil => rfl
+    | cons a as => rw [Ty.normTys, Ty.WF.canonical a h.1, Ty.WFList.norm_eq as h.2]
+end
+
+/-- 型内部の Canonical の条件は、正規化によって失われない。 -/
+theorem Ty.norm_WF {n : Nat} (t : Ty) (h : Ty.WF n t) : Ty.WF n t.norm := by
+  rw [h.canonical t]
+  exact h
+
+/-- 型列の所属による整形式の表現。 -/
+theorem Ty.WFList.iff {n : Nat} {as : List Ty} : Ty.WFList n as ↔ ∀ a ∈ as, Ty.WF n a := by
+  induction as with
+  | nil => simp [Ty.WFList]
+  | cons a as ih => simp [Ty.WFList, ih]
+
+/-- 最上位の効果の列は未整列でもよい。正規化は、列に含まれる型の整形式を保つ。 -/
+theorem Eff.norm_WF {n : Nat} (e : Eff) (h : Eff.WF n e) : Eff.WF n (Eff.norm e) := by
+  cases e with
+  | mk a fs =>
+    simp only [Eff.norm, Eff.WF]
+    apply Ty.WFList.iff.mpr
+    intro t ht
+    obtain ⟨u, hu, rfl⟩ := List.mem_map.mp (mem_sortUnique.mp (by
+      simpa only [Ty.normTys_eq_map] using ht))
+    exact Ty.norm_WF u (Ty.WFList.iff.mp h u hu)
+
+/-- 包含では保存されない、最外の潜在効果の整形式と正規形。 -/
+def Ty.LatentWF (n : Nat) : Ty → Prop
+  | .fn _ _ _ e => Eff.WF n e ∧ Eff.Canonical e
+  | _ => True
+
+/-- 型の包含は、移動先の潜在効果の条件を明示すると整形式を保つ。 -/
+theorem Ty.Le.wf {n a b} (h : Ty.Le a b) (w : Ty.WF n a) (wb : Ty.LatentWF n b) : Ty.WF n b := by
+  rcases h with rfl | ⟨ns, ps, r, e, f, rfl, rfl, _⟩
+  · exact w
+  · exact ⟨w.1, w.2.1, w.2.2.1, wb⟩
+
+/-- 逆向きの整形式にも、包含から得られない元の潜在効果の条件を明示する。 -/
+theorem Ty.Le.wf_rev {n a b} (h : Ty.Le a b) (w : Ty.WF n b) (wa : Ty.LatentWF n a) : Ty.WF n a := by
+  rcases h with rfl | ⟨ns, ps, r, e, f, rfl, rfl, _⟩
+  · exact w
+  · exact ⟨w.1, w.2.1, w.2.2.1, wa⟩
+
+mutual
+  theorem Ty.WF.mono {n m : Nat} (hn : n ≤ m) (t : Ty) (h : Ty.WF n t) : Ty.WF m t := by
+    cases t <;> simp only [Ty.WF] at h ⊢
+    all_goals first
+      | exact h
+      | exact Ty.WF.mono hn _ h
+      | exact Ty.WFList.mono hn _ h
+      | skip
+    case fn ns ps r e => exact ⟨h.1, Ty.WFList.mono hn ps h.2.1, Ty.WF.mono hn r h.2.2.1,
+      Eff.WF.mono hn e h.2.2.2.1, h.2.2.2.2⟩
+    case tvar i => omega
+    case cont b t e => exact ⟨Ty.WF.mono hn b h.1, Ty.WF.mono hn t h.2.1,
+      Eff.WF.mono hn e h.2.2.1, h.2.2.2⟩
+    case map a b => exact ⟨Ty.WF.mono hn a h.1, Ty.WF.mono hn b h.2⟩
+    case tapp i as => exact ⟨by omega, Ty.WFList.mono hn as h.2⟩
+
+  theorem Ty.WFList.mono {n m : Nat} (hn : n ≤ m) (as : List Ty) (h : Ty.WFList n as) : Ty.WFList m as := by
+    cases as with
+    | nil => trivial
+    | cons a as => exact ⟨Ty.WF.mono hn a h.1, Ty.WFList.mono hn as h.2⟩
+
+  theorem Eff.WF.mono {n m : Nat} (hn : n ≤ m) (e : Eff) (h : Eff.WF n e) : Eff.WF m e := by
+    cases e with
+    | mk a fs => exact Ty.WFList.mono hn fs h
+end
+
+mutual
+  /-- 入力が cutoff より内側の変数だけを使うとき、生の移動は恒等である。 -/
+  theorem Ty.rawShift_of_wf {c : Nat} (k : Nat) (t : Ty) (h : Ty.WF c t) : t.rawShift k c = t := by
+    cases t <;> simp only [Ty.WF] at h <;> simp only [Ty.rawShift]
+    all_goals first
+      | rfl
+      | exact congrArg _ (Ty.rawShift_of_wf k _ h)
+      | exact congrArg _ (Ty.rawShiftTys_of_wf k _ h)
+      | skip
+    case fn ns ps r e => rw [Ty.rawShiftTys_of_wf k ps h.2.1, Ty.rawShift_of_wf k r h.2.2.1,
+      Eff.rawShift_of_wf k e h.2.2.2.1]
+    case tvar i => simp only [h, ↓reduceIte]
+    case cont b t e => rw [Ty.rawShift_of_wf k b h.1, Ty.rawShift_of_wf k t h.2.1,
+      Eff.rawShift_of_wf k e h.2.2.1]
+    case map a b => rw [Ty.rawShift_of_wf k a h.1, Ty.rawShift_of_wf k b h.2]
+    case tapp i as => rw [ite_eq_left h.1, Ty.rawShiftTys_of_wf k as h.2]
+
+  theorem Ty.rawShiftTys_of_wf {c : Nat} (k : Nat) (as : List Ty) (h : Ty.WFList c as) :
+      Ty.rawShiftTys k c as = as := by
+    cases as with
+    | nil => rfl
+    | cons a as => simp only [Ty.rawShiftTys, Ty.rawShift_of_wf k a h.1, Ty.rawShiftTys_of_wf k as h.2]
+
+  theorem Eff.rawShift_of_wf {c : Nat} (k : Nat) (e : Eff) (h : Eff.WF c e) : Eff.rawShift k c e = e := by
+    cases e with
+    | mk a fs => simp only [Eff.rawShift, Ty.rawShiftTys_of_wf k fs h]
+end
+
+/-- 公開する移動の恒等式には、入力の正規形も必要である。 -/
+theorem Ty.shift_of_wf {c : Nat} (k : Nat) (t : Ty) (h : Ty.WF c t) : t.shift k c = t := by
+  rw [Ty.shift_eq_norm_rawShift, Ty.rawShift_of_wf k t h, Ty.WF.canonical t h]
+
+theorem Eff.shift_of_wf {c : Nat} (k : Nat) (e : Eff) (h : Eff.WF c e) (hc : Eff.Canonical e) :
+    Eff.shift k c e = e := by
+  rw [Eff.shift, Eff.rawShift_of_wf k e h, hc]
+
+end Benitoite.Release
diff --git a/formal/Benitoite/Release/TypeRows.lean b/formal/Benitoite/Release/TypeRows.lean
new file mode 100644
index 00000000..a81ed1df
--- /dev/null
+++ b/formal/Benitoite/Release/TypeRows.lean
@@ -0,0 +1,112 @@
+import Benitoite.Release.TypeSubstLemmas
+
+/-!
+# Fail の内部を含む行の範囲
+
+潜在効果と Fail の型を同じ共有型上で辿る。行の像の一致は、最外の所属だけでは足りない
+（設計書 01-12「コア計算と脱糖」）。
+-/
+
+namespace Benitoite.Release
+
+mutual
+  /-- 型の中に再帰的に現れるすべての行が条件を満たす。 -/
+  def Ty.RowsIn (pe : Nat → Prop) : Ty → Prop
+    | .base _ | .opaque _ | .bytes | .ctor _ | .tvar _ => True
+    | .data _ as | .tapp _ as => Ty.RowsInList pe as
+    | .list a | .reference a | .lazy a | .set a | .dict _ a => a.RowsIn pe
+    | .fn _ ps r e => Ty.RowsInList pe ps ∧ r.RowsIn pe ∧ Eff.RowsIn pe e
+    | .cont a b e => a.RowsIn pe ∧ b.RowsIn pe ∧ Eff.RowsIn pe e
+    | .map a b => a.RowsIn pe ∧ b.RowsIn pe
+
+  def Ty.RowsInList (pe : Nat → Prop) : List Ty → Prop
+    | [] => True
+    | t :: ts => t.RowsIn pe ∧ Ty.RowsInList pe ts
+
+  /-- 最外の原子と、Fail の型内部の行をともに検査する。 -/
+  def Eff.RowsIn (pe : Nat → Prop) : Eff → Prop
+    | .mk a fs => (∀ i, a (.rho i) = true → pe i) ∧ Ty.RowsInList pe fs
+end
+
+theorem Ty.RowsInList.iff {pe : Nat → Prop} {ts : List Ty} :
+    Ty.RowsInList pe ts ↔ ∀ t ∈ ts, t.RowsIn pe := by
+  induction ts with
+  | nil => simp [Ty.RowsInList]
+  | cons t ts ih => simp [Ty.RowsInList, ih]
+
+mutual
+  theorem Ty.RowsIn.mono {pe pf : Nat → Prop} (hp : ∀ i, pe i → pf i)
+      (t : Ty) (h : t.RowsIn pe) : t.RowsIn pf := by
+    cases t <;> simp only [Ty.RowsIn] at h ⊢
+    all_goals first
+      | trivial
+      | exact Ty.RowsIn.mono hp _ h
+      | exact Ty.RowsInList.mono hp _ h
+      | skip
+    case fn ns ps r e => exact ⟨Ty.RowsInList.mono hp ps h.1,
+      Ty.RowsIn.mono hp r h.2.1, Eff.RowsIn.mono hp e h.2.2⟩
+    case cont a b e => exact ⟨Ty.RowsIn.mono hp a h.1,
+      Ty.RowsIn.mono hp b h.2.1, Eff.RowsIn.mono hp e h.2.2⟩
+    case map a b => exact ⟨Ty.RowsIn.mono hp a h.1, Ty.RowsIn.mono hp b h.2⟩
+
+  theorem Ty.RowsInList.mono {pe pf : Nat → Prop} (hp : ∀ i, pe i → pf i)
+      (ts : List Ty) (h : Ty.RowsInList pe ts) : Ty.RowsInList pf ts := by
+    cases ts with
+    | nil => trivial
+    | cons t ts => exact ⟨Ty.RowsIn.mono hp t h.1, Ty.RowsInList.mono hp ts h.2⟩
+
+  theorem Eff.RowsIn.mono {pe pf : Nat → Prop} (hp : ∀ i, pe i → pf i)
+      (e : Eff) (h : Eff.RowsIn pe e) : Eff.RowsIn pf e := by
+    cases e with
+    | mk a fs => exact ⟨fun i hi => hp i (h.1 i hi), Ty.RowsInList.mono hp fs h.2⟩
+end
+
+mutual
+  /-- 正規化による並べ替えと重複除去は行の範囲を保つ。 -/
+  theorem Ty.norm_rowsIn {pe : Nat → Prop} (t : Ty) (h : t.RowsIn pe) : t.norm.RowsIn pe := by
+    cases t <;> simp only [Ty.RowsIn] at h <;> simp only [Ty.norm, Ty.RowsIn]
+    all_goals first
+      | trivial
+      | exact Ty.norm_rowsIn _ h
+      | exact Ty.normTys_rowsIn _ h
+      | skip
+    case fn ns ps r e => exact ⟨Ty.normTys_rowsIn ps h.1,
+      Ty.norm_rowsIn r h.2.1, Eff.norm_rowsIn e h.2.2⟩
+    case cont a b e => exact ⟨Ty.norm_rowsIn a h.1,
+      Ty.norm_rowsIn b h.2.1, Eff.norm_rowsIn e h.2.2⟩
+    case map a b => exact ⟨Ty.norm_rowsIn a h.1, Ty.norm_rowsIn b h.2⟩
+
+  theorem Ty.normTys_rowsIn {pe : Nat → Prop} (ts : List Ty) (h : Ty.RowsInList pe ts) :
+      Ty.RowsInList pe (Ty.normTys ts) := by
+    cases ts with
+    | nil => trivial
+    | cons t ts => exact ⟨Ty.norm_rowsIn t h.1, Ty.normTys_rowsIn ts h.2⟩
+
+  theorem Eff.norm_rowsIn {pe : Nat → Prop} (e : Eff) (h : Eff.RowsIn pe e) :
+      Eff.RowsIn pe (Eff.norm e) := by
+    cases e with
+    | mk a fs =>
+      refine ⟨h.1, Ty.RowsInList.iff.mpr ?_⟩
+      intro t ht
+      exact Ty.RowsInList.iff.mp (Ty.normTys_rowsIn fs h.2) t (Order.mem_sortUnique.mp ht)
+end
+
+mutual
+  theorem Ty.rowsIn_true (t : Ty) : t.RowsIn (fun _ => True) := by
+    cases t <;> simp only [Ty.RowsIn]
+    all_goals first | trivial | exact Ty.rowsIn_true _ | exact Ty.rowsInList_true _ | skip
+    case fn ns ps r e => exact ⟨Ty.rowsInList_true ps, Ty.rowsIn_true r, Eff.rowsIn_true e⟩
+    case cont a b e => exact ⟨Ty.rowsIn_true a, Ty.rowsIn_true b, Eff.rowsIn_true e⟩
+    case map a b => exact ⟨Ty.rowsIn_true a, Ty.rowsIn_true b⟩
+
+  theorem Ty.rowsInList_true (ts : List Ty) : Ty.RowsInList (fun _ => True) ts := by
+    cases ts with
+    | nil => trivial
+    | cons t ts => exact ⟨Ty.rowsIn_true t, Ty.rowsInList_true ts⟩
+
+  theorem Eff.rowsIn_true (e : Eff) : Eff.RowsIn (fun _ => True) e := by
+    cases e with
+    | mk a fs => exact ⟨fun _ _ => trivial, Ty.rowsInList_true fs⟩
+end
+
+end Benitoite.Release
diff --git a/formal/Benitoite/Release/TypeScopedSubst.lean b/formal/Benitoite/Release/TypeScopedSubst.lean
new file mode 100644
index 00000000..10b6c066
--- /dev/null
+++ b/formal/Benitoite/Release/TypeScopedSubst.lean
@@ -0,0 +1,291 @@
+import Benitoite.Release.SubstEnv
+import Benitoite.Release.TypeCongruence
+import Benitoite.Release.TypeVariables
+
+/-!
+# 範囲内の型と行の代入
+
+一般の合成から、宣言の束縛数で制限した代入と閉じた型の恒等性を導く
+（設計書 01-12「コア計算と脱糖」）。
+-/
+
+namespace Benitoite.Release
+
+theorem Eff.substRho_true {es : List Eff} {ε : Eff} {a : Atom} :
+    Eff.mem (Eff.substRho es ε) a ↔
+      ((match a with
+        | .name l => Eff.mem ε (.name l)
+        | .rho k => es.length ≤ k ∧ Eff.mem ε (.rho k)) ∨
+       ∃ i e, es[i]? = some e ∧ Eff.mem ε (.rho i) ∧ Eff.mem e a) := by
+  rw [Eff.substRho_eq_bind, Eff.bind, Eff.mem_norm, Eff.mem_rawBind]
+  exact Eff.mem_substAtoms es ε a
+
+theorem Eff.substRho_true_scoped {es : List Eff} {ε : Eff} (h : Eff.RhosIn (· < es.length) ε)
+    {a : Atom} :
+    Eff.mem (Eff.substRho es ε) a ↔
+      ((∃ l, a = .name l ∧ Eff.mem ε (.name l)) ∨
+        ∃ i e, es[i]? = some e ∧ Eff.mem ε (.rho i) ∧ Eff.mem e a) := by
+  rw [Eff.substRho_true]
+  apply or_congr _ Iff.rfl
+  cases a with
+  | name l => simp
+  | rho k =>
+    simp only [reduceCtorEq, false_and, exists_false, iff_false, not_and]
+    intro hk hε
+    have := h.top k hε
+    omega
+
+/-- 再帰的な範囲から、切り詰めた合成列でも同じ結果を得る。 -/
+theorem Eff.substRho_comp {es es' : List Eff} {ε : Eff} (h : Eff.RhosIn (· < es.length) ε) :
+    Eff.substRho es' (Eff.substRho es ε) = Eff.substRho (es.map (Eff.substRho es')) ε := by
+  rw [Eff.substRho_composeRows]
+  apply Eff.substRho_congr_rows
+  apply Eff.RowsIn.mono (e := ε) (h := h)
+  intro i hi
+  rw [Eff.rowImage_composeRows]
+  simp [Eff.rowImage, List.getElem?_map, List.getElem?_eq_getElem hi]
+
+/-- 閉じた型への代入は、型内部の正規形を含めて恒等である。 -/
+theorem Ty.substAt_of_closed {c : Nat} (ts : List Ty) (es : List Eff)
+    (a : Ty) (h : Ty.VarsIn c (fun _ => False) a) : a.substAt c ts es = a := by
+  rw [Ty.substAt_eq_bind]
+  have hc : Ty.bind (SubstEnv.at c ts es) a = Ty.bind SubstEnv.identity a := by
+    apply Ty.bind_congr_scoped (n := c)
+    · intro i hi
+      simp only [SubstEnv.at, SubstEnv.identity, hi, ↓reduceIte]
+    · exact Ty.WF.raw a (Ty.VarsIn.wf a h)
+    · exact Ty.RowsIn.mono (fun _ hi => hi.elim) a (Ty.VarsIn.rows a h)
+  rw [hc, Ty.bind_identity, (Ty.VarsIn.wf a h).canonical a]
+
+theorem Ty.substAtList_of_closed {c : Nat} (ts : List Ty) (es : List Eff)
+    (as : List Ty) (h : Ty.VarsInList c (fun _ => False) as) :
+    as.map (Ty.substAt c ts es) = as := by
+  calc
+    _ = as.map id := List.map_congr_left (fun a ha =>
+      Ty.substAt_of_closed ts es a (Ty.VarsInList.iff.mp h a ha))
+    _ = as := List.map_id as
+
+/-- 型と行の像を同時に置き換える、宣言の範囲での合成。 -/
+theorem Ty.subst_comp {ts : List Ty} {es : List Eff} (c : Nat) (ts' : List Ty) (es' : List Eff)
+    (a : Ty) (h : Ty.VarsIn ts.length (· < es.length) a) :
+    Ty.substAt c ts' es' (Ty.subst ts es a) =
+      Ty.subst (ts.map (Ty.substAt c ts' es')) (es.map (Eff.substAt c ts' es')) a := by
+  simp only [Ty.subst, Ty.substAt_eq_bind]
+  rw [Ty.bind_comp]
+  apply Ty.bind_congr_scoped (n := ts.length)
+  · intro i hi
+    simp only [SubstEnv.compose, SubstEnv.at, Nat.not_lt_zero, ↓reduceIte, Nat.sub_zero,
+      hi, List.getElem?_eq_getElem hi, Option.getD_some, Ty.rawShift_zero,
+      List.length_map, List.getElem?_map, Option.map_some]
+    rw [Ty.substAt_eq_bind]
+    rfl
+  · exact Ty.WF.raw a (Ty.VarsIn.wf a h)
+  · apply Ty.RowsIn.mono (h := Ty.VarsIn.rows a h)
+    intro i hi
+    rw [Eff.rowImage_compose]
+    simp only [Eff.rowImage, SubstEnv.at, List.getElem?_map, List.getElem?_eq_getElem hi,
+      Option.map_some, Option.getD_some, Eff.rawShift_zero, List.map_map, Function.comp_apply,
+      Eff.rawShift_zero]
+    rfl
+
+theorem Ty.subst_comp_list {ts : List Ty} {es : List Eff} (c : Nat) (ts' : List Ty) (es' : List Eff)
+    (as : List Ty) (h : Ty.VarsInList ts.length (· < es.length) as) :
+    (as.map (Ty.subst ts es)).map (Ty.substAt c ts' es') =
+      as.map (Ty.subst (ts.map (Ty.substAt c ts' es')) (es.map (Eff.substAt c ts' es'))) := by
+  simp only [List.map_map]
+  exact List.map_congr_left (fun a ha => Ty.subst_comp c ts' es' a (Ty.VarsInList.iff.mp h a ha))
+
+/-- cutoff より内側の像は、閉じた型を用いると移動なしに読める。 -/
+theorem SubstEnv.at_type_closed (c : Nat) (ts : List Ty) (es : List Eff)
+    (hts : ∀ t ∈ ts, Ty.WF 0 t) (i : Nat) :
+    (SubstEnv.at c ts es).types i =
+      if i < c then .tvar i
+      else if hi : i - c < ts.length then ts[i - c]
+      else .tvar (i - ts.length) := by
+  dsimp only [SubstEnv.at]
+  split
+  · rfl
+  · split
+    · rename_i hi
+      rw [List.getElem?_eq_getElem hi, Option.getD_some,
+        Ty.rawShift_of_wf c _ (hts _ (List.getElem_mem hi))]
+    · rfl
+
+/-- 型の像は、移動と cutoff 付き代入を入れ替えても一致する。 -/
+theorem SubstEnv.shift_at_types {c k : Nat} {ts : List Ty} (es : List Eff)
+    (hts : ∀ t ∈ ts, Ty.WF 0 t) :
+    ((SubstEnv.shift k 0).compose (SubstEnv.at (c + k) ts es)).types =
+      ((SubstEnv.at c ts es).compose (SubstEnv.shift k 0)).types := by
+  funext i
+  change Ty.bind (SubstEnv.at (c + k) ts es) (.tvar (i + k)) =
+    Ty.bind (SubstEnv.shift k 0) ((SubstEnv.at c ts es).types i)
+  rw [← Ty.substAt_eq_bind, SubstEnv.at_type_closed c ts es hts i]
+  simp only [Ty.substAt]
+  by_cases hc : i < c
+  · have hc' : i + k < c + k := by omega
+    simp only [hc, hc', ↓reduceIte, ← Ty.shift_eq_bind, Ty.shift, Nat.not_lt_zero]
+  · have hc' : ¬ i + k < c + k := by omega
+    have he : i + k - (c + k) = i - c := by omega
+    simp only [hc, hc', ↓reduceIte, he]
+    by_cases hi : i - c < ts.length
+    · simp only [hi, ↓reduceDIte, ↓reduceIte, List.getElem?_eq_getElem hi, Option.getD_some, ← Ty.shift_eq_bind]
+      rw [Ty.shift_of_wf _ _ (hts _ (List.getElem_mem hi)),
+        Ty.shift_of_wf _ _ (hts _ (List.getElem_mem hi))]
+    · simp only [hi, ↓reduceDIte, ↓reduceIte, ← Ty.shift_eq_bind, Ty.shift, Nat.not_lt_zero]
+      congr 1
+      omega
+
+/-- 閉じた行の型の像も、移動と代入の入れ替えで一致する。 -/
+theorem Eff.shift_at_rowImages {c k : Nat} {ts : List Ty} (es : List Eff)
+    (hes : ∀ e ∈ es, Eff.WF 0 e) (i : Nat) :
+    Eff.rowImage ((SubstEnv.shift k 0).compose (SubstEnv.at (c + k) ts es)).rows i =
+      Eff.rowImage ((SubstEnv.at c ts es).compose (SubstEnv.shift k 0)).rows i := by
+  rw [Eff.rowImage_compose, Eff.rowImage_compose]
+  change Eff.bind (SubstEnv.at (c + k) ts es) (Eff.row i) =
+    Eff.bind (SubstEnv.shift k 0) (Eff.rowImage (es.map (Eff.rawShift c 0)) i)
+  rw [Eff.bind_row]
+  by_cases hi : i < es.length
+  · simp only [Eff.rowImage, SubstEnv.at, List.getElem?_map, List.getElem?_eq_getElem hi,
+      Option.map_some, Option.getD_some]
+    rw [Eff.rawShift_of_wf _ _ (hes _ (List.getElem_mem hi)),
+      Eff.rawShift_of_wf _ _ (hes _ (List.getElem_mem hi))]
+    change Eff.norm es[i] = Eff.norm (Eff.rawBind (SubstEnv.shift k 0) es[i])
+    rw [← Eff.rawShift_eq_rawBind, Eff.rawShift_of_wf _ _ (hes _ (List.getElem_mem hi))]
+  · have he : es[i]? = none := List.getElem?_eq_none (by omega)
+    simp only [Eff.rowImage, SubstEnv.at, List.getElem?_map, he, Option.map_none,
+      Option.getD_none]
+    rw [Eff.bind_row]
+    rfl
+
+/-- 移動と代入の交換。行の像内部の型も閉じていることを要求する。 -/
+theorem Ty.shift_substAt {c k : Nat} {ts : List Ty} (es : List Eff)
+    (hts : ∀ t ∈ ts, Ty.WF 0 t) (hes : ∀ e ∈ es, Eff.WF 0 e) (a : Ty) :
+    (a.shift k 0).substAt (c + k) ts es = (a.substAt c ts es).shift k 0 := by
+  simp only [Ty.shift_eq_bind, Ty.substAt_eq_bind, Ty.bind_comp]
+  apply Ty.bind_congr_rows
+  · exact SubstEnv.shift_at_types es hts
+  · have hall : ∀ t : Ty, t.RowsIn (fun i =>
+        Eff.rowImage ((SubstEnv.shift k 0).compose (SubstEnv.at (c + k) ts es)).rows i =
+          Eff.rowImage ((SubstEnv.at c ts es).compose (SubstEnv.shift k 0)).rows i) := by
+      intro t
+      exact Ty.RowsIn.mono (fun i _ => Eff.shift_at_rowImages es hes i) t (Ty.rowsIn_true t)
+    exact hall a
+
+/-- 代入後の Fail 列は、元の型への代入と、選んだ行の像の連結を正規化したものである。 -/
+theorem Eff.substAt_fails (c : Nat) (ts : List Ty) (es : List Eff) (e : Eff) :
+    (Eff.substAt c ts es e).fails = Order.sortUnique tyCompare
+      (Ty.substTysAt c ts es e.fails ++
+        Ty.normTys (Eff.rowFails (es.map (Eff.rawShift c 0)) e.atoms)) := by
+  cases e with
+  | mk a fs =>
+    simp only [Eff.substAt, Eff.rawSubstAt, Eff.rawBind, Eff.norm, Eff.fails,
+      Ty.normTys_append, Eff.atoms, SubstEnv.at, Ty.substTysAt_eq_rawBindTys]
+
+/-- 型の変数が cutoff より内側なら、型の列だけの代入は恒等である。 -/
+theorem Ty.substAt_nil_of_wf {c : Nat} (ts : List Ty) (a : Ty) (h : Ty.WF c a) :
+    a.substAt c ts [] = a := by
+  rw [Ty.substAt_eq_bind]
+  have hc : Ty.bind (SubstEnv.at c ts []) a = Ty.bind SubstEnv.identity a := by
+    apply Ty.bind_congr_scoped (n := c)
+    · intro i hi
+      simp only [SubstEnv.at, SubstEnv.identity, hi, ↓reduceIte]
+    · exact Ty.WF.raw a h
+    · exact Ty.RowsIn.mono (fun _ _ => rfl) a (Ty.rowsIn_true a)
+  rw [hc, Ty.bind_identity, h.canonical a]
+
+theorem Ty.substAtList_nil_of_wf {c : Nat} (ts : List Ty) (as : List Ty) (h : Ty.WFList c as) :
+    as.map (Ty.substAt c ts []) = as := by
+  calc
+    _ = as.map id := List.map_congr_left (fun a ha => Ty.substAt_nil_of_wf ts a (Ty.WFList.iff.mp h a ha))
+    _ = as := List.map_id as
+
+/-- 空の行置換は正規化だけを行う。 -/
+theorem Eff.substRho_nil_norm (e : Eff) : Eff.substRho [] e = Eff.norm e := by
+  rw [Eff.substRho_eq_bind]
+  exact Eff.bind_identity e
+
+/-- 空の行置換の恒等性には、最上位の正規形を明示する。 -/
+theorem Eff.substRho_nil (e : Eff) (h : Eff.Canonical e) : Eff.substRho [] e = e := by
+  rw [Eff.substRho_nil_norm, h]
+
+/-- 行だけの代入も和を保つ。 -/
+theorem Eff.substRho_union (es : List Eff) (e f : Eff) :
+    Eff.substRho es (Eff.union e f) = Eff.union (Eff.substRho es e) (Eff.substRho es f) := by
+  simp only [Eff.substRho_eq_bind, Eff.bind_union]
+
+/-- 型の像だけの代入は、閉じた Fail 型と正規形の最上位の効果を保つ。 -/
+theorem Eff.substAt_nil_of_wf {c : Nat} (ts : List Ty) (e : Eff)
+    (h : Eff.WF c e) (hc : Eff.Canonical e) : Eff.substAt c ts [] e = e := by
+  have he : Eff.bind (SubstEnv.at c ts []) e = Eff.bind SubstEnv.identity e := by
+    apply Eff.bind_congr_scoped (n := c)
+    · intro i hi
+      simp only [SubstEnv.at, SubstEnv.identity, hi, ↓reduceIte]
+    · exact Eff.WF.raw e h
+    · exact Eff.RowsIn.mono (fun _ _ => rfl) e (Eff.rowsIn_true e)
+  change Eff.bind (SubstEnv.at c ts []) e = e
+  rw [he, Eff.bind_identity, hc]
+
+/-- 型と行の像を同時に置き換える、宣言の範囲での合成。 -/
+theorem Eff.substAt_comp {ts : List Ty} {es : List Eff} (c : Nat) (ts' : List Ty) (es' : List Eff)
+    (a : Eff) (h : Eff.VarsIn ts.length (· < es.length) a) :
+    Eff.substAt c ts' es' (Eff.substAt 0 ts es a) =
+      Eff.substAt 0 (ts.map (Ty.substAt c ts' es')) (es.map (Eff.substAt c ts' es')) a := by
+  change Eff.bind (SubstEnv.at c ts' es') (Eff.bind (SubstEnv.at 0 ts es) a) =
+    Eff.bind (SubstEnv.at 0 (ts.map (Ty.substAt c ts' es')) (es.map (Eff.substAt c ts' es'))) a
+  rw [Eff.bind_comp]
+  apply Eff.bind_congr_scoped (n := ts.length)
+  · intro i hi
+    simp only [SubstEnv.compose, SubstEnv.at, Nat.not_lt_zero, ↓reduceIte, Nat.sub_zero,
+      hi, List.getElem?_eq_getElem hi, Option.getD_some, Ty.rawShift_zero,
+      List.length_map, List.getElem?_map, Option.map_some]
+    rw [Ty.substAt_eq_bind]
+    rfl
+  · exact Eff.WF.raw a (Eff.VarsIn.wf a h)
+  · apply Eff.RowsIn.mono (h := Eff.VarsIn.rows a h)
+    intro i hi
+    rw [Eff.rowImage_compose]
+    simp only [Eff.rowImage, SubstEnv.at, List.getElem?_map, List.getElem?_eq_getElem hi,
+      Option.map_some, Option.getD_some, Eff.rawShift_zero, List.map_map, Function.comp_apply,
+      Eff.rawShift_zero]
+    rfl
+
+/-- 型・行の同時代入も和を保つ。 -/
+theorem Eff.substAt_union (c : Nat) (ts : List Ty) (es : List Eff) (e f : Eff) :
+    Eff.substAt c ts es (Eff.union e f) = Eff.union (Eff.substAt c ts es e) (Eff.substAt c ts es f) :=
+  Eff.bind_union (SubstEnv.at c ts es) e f
+
+theorem Eff.substAt_empty (c : Nat) (ts : List Ty) (es : List Eff) :
+    Eff.substAt c ts es Eff.empty = Eff.empty :=
+  Eff.bind_ofAtoms_noRhos (SubstEnv.at c ts es) (fun _ => false) (fun _ => rfl)
+
+theorem Eff.substAt_single (c : Nat) (ts : List Ty) (es : List Eff) (l : EffName) :
+    Eff.substAt c ts es (Eff.single l) = Eff.single l :=
+  Eff.bind_ofAtoms_noRhos (SubstEnv.at c ts es) _ (fun _ => rfl)
+
+/-- 効果に含まれる名前は、型と行の同時代入後にも残る。 -/
+theorem Eff.substAt_name {c ts es e l} (h : Eff.mem e (.name l)) :
+    Eff.mem (Eff.substAt c ts es e) (.name l) :=
+  (Eff.mem_bind (SubstEnv.at c ts es) e (.name l)).mpr (Or.inl ⟨l, rfl, h⟩)
+
+/-- Fail 型を持つ効果も、移動と型・行代入の交換を満たす。 -/
+theorem Eff.shift_substAt {c k : Nat} {ts : List Ty} (es : List Eff)
+    (hts : ∀ t ∈ ts, Ty.WF 0 t) (hes : ∀ e ∈ es, Eff.WF 0 e) (e : Eff) :
+    Eff.substAt (c + k) ts es (Eff.shift k 0 e) = Eff.shift k 0 (Eff.substAt c ts es e) := by
+  have hshift : ∀ e : Eff, Eff.shift k 0 e = Eff.bind (SubstEnv.shift k 0) e := by
+    intro e
+    rw [Eff.shift, Eff.rawShift_eq_rawBind]
+    rfl
+  simp only [hshift]
+  change Eff.bind (SubstEnv.at (c + k) ts es) (Eff.bind (SubstEnv.shift k 0) e) =
+    Eff.bind (SubstEnv.shift k 0) (Eff.bind (SubstEnv.at c ts es) e)
+  rw [Eff.bind_comp, Eff.bind_comp]
+  apply Eff.bind_congr_rows
+  · exact SubstEnv.shift_at_types es hts
+  · exact Eff.RowsIn.mono (fun i _ => Eff.shift_at_rowImages es hes i) e (Eff.rowsIn_true e)
+
+/-- 型と行の代入は、入力の正規化に依存しない。 -/
+theorem Eff.substAt_norm (c : Nat) (ts : List Ty) (es : List Eff) (e : Eff) :
+    Eff.substAt c ts es (Eff.norm e) = Eff.substAt c ts es e :=
+  Eff.norm_rawBind (SubstEnv.at c ts es) e
+
+end Benitoite.Release
diff --git a/formal/Benitoite/Release/TypeShift.lean b/formal/Benitoite/Release/TypeShift.lean
new file mode 100644
index 00000000..8ff04e36
--- /dev/null
+++ b/formal/Benitoite/Release/TypeShift.lean
@@ -0,0 +1,189 @@
+import Benitoite.Release.Normalize
+
+/-!
+# 型とエフェクトの変数移動
+
+型内部の Fail のエラー型まで移動する。束縛を越える移動は型変数だけを対象とする。
+型構築後の正規形は、設計書 07-04「01-12 との対応」に従う。
+-/
+
+namespace Benitoite.Release
+
+open Std Order
+
+mutual
+  /-- 正規化前の型の変数移動。 -/
+  def Ty.rawShift (k c : Nat) : Ty → Ty
+    | .base b => .base b
+    | .opaque o => .opaque o
+    | .data d as => .data d (Ty.rawShiftTys k c as)
+    | .list a => .list (a.rawShift k c)
+    | .fn ns ps r e => .fn ns (Ty.rawShiftTys k c ps) (r.rawShift k c) (Eff.rawShift k c e)
+    | .tvar i => .tvar (if i < c then i else i + k)
+    | .reference a => .reference (a.rawShift k c)
+    | .lazy a => .lazy (a.rawShift k c)
+    | .cont b t e => .cont (b.rawShift k c) (t.rawShift k c) (Eff.rawShift k c e)
+    | .map a b => .map (a.rawShift k c) (b.rawShift k c)
+    | .set a => .set (a.rawShift k c)
+    | .bytes => .bytes
+    | .dict cl a => .dict cl (a.rawShift k c)
+    | .tapp i as => .tapp (if i < c then i else i + k) (Ty.rawShiftTys k c as)
+    | .ctor c => .ctor c
+  termination_by structural t => t
+
+  def Ty.rawShiftTys (k c : Nat) : List Ty → List Ty
+    | [] => []
+    | a :: as => a.rawShift k c :: Ty.rawShiftTys k c as
+  termination_by structural as => as
+
+  /-- 行変数の番号は変えず、Fail の型だけを移動する。 -/
+  def Eff.rawShift (k c : Nat) : Eff → Eff
+    | .mk a fs => .mk a (Ty.rawShiftTys k c fs)
+  termination_by structural e => e
+end
+
+@[simp] theorem Ty.rawShiftTys_eq_map (k c : Nat) (as : List Ty) :
+    Ty.rawShiftTys k c as = as.map (Ty.rawShift k c) := by
+  induction as with
+  | nil => rfl
+  | cons a as ih => simp only [Ty.rawShiftTys, List.map_cons, ih]
+
+private theorem shiftIndex_compare (k c i j : Nat) :
+    compare (if i < c then i else i + k) (if j < c then j else j + k) = compare i j := by
+  have hlt : ∀ i j, (if i < c then i else i + k) < (if j < c then j else j + k) ↔ i < j := by
+    intro i j
+    split <;> split <;> omega
+  simp only [Nat.compare_eq_ite_lt, hlt]
+
+mutual
+  /-- 生の移動は、型の生の辞書式順序を保つ。 -/
+  theorem Ty.rawShift_compare (k c : Nat) (a b : Ty) :
+      tyCompare (a.rawShift k c) (b.rawShift k c) = tyCompare a b := by
+    cases a <;> cases b <;>
+      simp only [Ty.rawShift, tyCompare, Ty.rank, Ty.rawShift_compare,
+        Ty.rawShiftTys_compare, Eff.rawShift_compare, shiftIndex_compare]
+
+  theorem Ty.rawShiftTys_compare (k c : Nat) (as bs : List Ty) :
+      tysCompare (Ty.rawShiftTys k c as) (Ty.rawShiftTys k c bs) = tysCompare as bs := by
+    cases as with
+    | nil => cases bs <;> rfl
+    | cons a as =>
+      cases bs with
+      | nil => rfl
+      | cons b bs => simp only [Ty.rawShiftTys, tysCompare, Ty.rawShift_compare, Ty.rawShiftTys_compare]
+
+  theorem Eff.rawShift_compare (k c : Nat) (e f : Eff) :
+      effCompare (Eff.rawShift k c e) (Eff.rawShift k c f) = effCompare e f := by
+    cases e with
+    | mk a fs =>
+      cases f with
+      | mk b gs => simp only [Eff.rawShift, effCompare, Ty.rawShiftTys_compare]
+end
+
+mutual
+  /-- 正規化と生の移動の順序は交換できる。 -/
+  theorem Ty.norm_rawShift (k c : Nat) (t : Ty) :
+      (t.rawShift k c).norm = t.norm.rawShift k c := by
+    cases t <;> simp only [Ty.rawShift, Ty.norm, Ty.norm_rawShift, Ty.normTys_rawShift, Eff.norm_rawShift]
+
+  theorem Ty.normTys_rawShift (k c : Nat) (as : List Ty) :
+      Ty.normTys (Ty.rawShiftTys k c as) = Ty.rawShiftTys k c (Ty.normTys as) := by
+    cases as with
+    | nil => rfl
+    | cons a as => simp only [Ty.rawShiftTys, Ty.normTys, Ty.norm_rawShift, Ty.normTys_rawShift]
+
+  theorem Eff.norm_rawShift (k c : Nat) (e : Eff) :
+      Eff.norm (Eff.rawShift k c e) = Eff.rawShift k c (Eff.norm e) := by
+    cases e with
+    | mk a fs =>
+      simp only [Eff.rawShift, Eff.norm]
+      rw [Ty.normTys_rawShift]
+      simp only [Ty.rawShiftTys_eq_map]
+      rw [sortUnique_map tyCompare tyCompare (Ty.rawShift k c) (Ty.rawShift_compare k c)]
+end
+
+
+/-- 生の移動でも、入力が正規形なら正規形を保つ。 -/
+theorem Ty.rawShift_canonical (k c : Nat) {t : Ty} (h : t.Canonical) :
+    (t.rawShift k c).Canonical := by
+  unfold Ty.Canonical at h ⊢
+  rw [Ty.norm_rawShift, h]
+
+theorem Eff.rawShift_canonical (k c : Nat) {e : Eff} (h : Eff.Canonical e) :
+    Eff.Canonical (Eff.rawShift k c e) := by
+  unfold Eff.Canonical at h ⊢
+  rw [Eff.norm_rawShift, h]
+
+/-- 効果の公開する移動も同じ正規化を通す。 -/
+noncomputable def Eff.shift (k c : Nat) (e : Eff) : Eff := Eff.norm (Eff.rawShift k c e)
+
+mutual
+  /-- 型の変数の番号を、`c` 以上のものだけ `k` ずらす。 -/
+  noncomputable def Ty.shift (k c : Nat) : Ty → Ty
+    | .base ι => .base ι
+    | .opaque o => .opaque o
+    | .data d args => .data d (Ty.shiftTys k c args)
+    | .list a => .list (Ty.shift k c a)
+    | .fn names params ret eff => .fn names (Ty.shiftTys k c params) (Ty.shift k c ret) (Eff.shift k c eff)
+    | .tvar i => if i < c then .tvar i else .tvar (i + k)
+    | .reference a => .reference (Ty.shift k c a)
+    | .lazy a => .lazy (Ty.shift k c a)
+    | .cont b t eff => .cont (Ty.shift k c b) (Ty.shift k c t) (Eff.shift k c eff)
+    | .map a b => .map (Ty.shift k c a) (Ty.shift k c b)
+    | .set a => .set (Ty.shift k c a)
+    | .bytes => .bytes
+    | .dict cl τ => .dict cl (Ty.shift k c τ)
+    | .tapp i args => .tapp (if i < c then i else i + k) (Ty.shiftTys k c args)
+    | .ctor φ => .ctor φ
+  termination_by structural t => t
+
+  /-- 型列も同じ再帰に含め、入れ子の型の移動をカーネルで簡約できるようにする。 -/
+  noncomputable def Ty.shiftTys (k c : Nat) : List Ty → List Ty
+    | [] => []
+    | a :: as => Ty.shift k c a :: Ty.shiftTys k c as
+  termination_by structural as => as
+end
+
+mutual
+  /-- 公開する型の移動と、生の移動後の正規化は一致する。 -/
+  theorem Ty.shift_eq_norm_rawShift (k c : Nat) (t : Ty) : t.shift k c = (t.rawShift k c).norm := by
+    cases t <;> simp only [Ty.shift, Ty.rawShift, Ty.norm, Ty.shift_eq_norm_rawShift,
+      Ty.shiftTys_eq_norm_rawShift, Eff.shift]
+    case tvar i => split <;> rfl
+
+  theorem Ty.shiftTys_eq_norm_rawShift (k c : Nat) (as : List Ty) :
+      Ty.shiftTys k c as = Ty.normTys (Ty.rawShiftTys k c as) := by
+    cases as with
+    | nil => rfl
+    | cons a as => simp only [Ty.shiftTys, Ty.rawShiftTys, Ty.normTys, Ty.shift_eq_norm_rawShift,
+        Ty.shiftTys_eq_norm_rawShift]
+end
+
+/-- 正規形の型の移動は正規形を保つ。 -/
+theorem Ty.shift_canonical (k c : Nat) (t : Ty) : (t.shift k c).Canonical := by
+  rw [Ty.Canonical, Ty.shift_eq_norm_rawShift]; exact Ty.norm_idem _
+
+theorem Eff.shift_canonical (k c : Nat) (e : Eff) : Eff.Canonical (Eff.shift k c e) := Eff.norm_idem _
+
+mutual
+  theorem Ty.rawShift_zero (c : Nat) (t : Ty) : t.rawShift 0 c = t := by
+    cases t <;> simp only [Ty.rawShift, Ty.rawShift_zero, Ty.rawShiftTys_zero, Eff.rawShift_zero, Nat.add_zero, ite_self]
+
+  theorem Ty.rawShiftTys_zero (c : Nat) (as : List Ty) : Ty.rawShiftTys 0 c as = as := by
+    cases as with
+    | nil => rfl
+    | cons a as => simp only [Ty.rawShiftTys, Ty.rawShift_zero, Ty.rawShiftTys_zero]
+
+  theorem Eff.rawShift_zero (c : Nat) (e : Eff) : Eff.rawShift 0 c e = e := by
+    cases e with
+    | mk a fs => simp only [Eff.rawShift, Ty.rawShiftTys_zero]
+end
+
+/-- 非正規な入力での公開操作の恒等式は、正規化までを含む。 -/
+theorem Ty.shift_zero_norm (c : Nat) (t : Ty) : t.shift 0 c = t.norm := by
+  rw [Ty.shift_eq_norm_rawShift, Ty.rawShift_zero]
+
+theorem Eff.shift_zero_norm (c : Nat) (e : Eff) : Eff.shift 0 c e = Eff.norm e := by
+  rw [Eff.shift, Eff.rawShift_zero]
+
+end Benitoite.Release
diff --git a/formal/Benitoite/Release/TypeSubst.lean b/formal/Benitoite/Release/TypeSubst.lean
