import Benitoite.Unofficial.Scope
import Benitoite.Unofficial.Network.Http

function main() -> Unit
  bind x <- Http.checkRequestIn(hostPattern: "a.example", minimumPort: 10, maximumPort: 5, request: Http.ClientRequest(method: "GET", url: "http://a.example/", headers: [], body: Bytes.empty(), timeoutMilliseconds: 1000))
  ()
end function
