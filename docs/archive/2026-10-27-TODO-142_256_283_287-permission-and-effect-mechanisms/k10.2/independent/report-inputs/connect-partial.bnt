import Benitoite.Unofficial.IO.File
import Benitoite.Unofficial.Network.Http
function protected() -> Integer uses Http.Connect["api.example", 443]
 return 1
end function
function main() -> Unit uses Http.Connect["api.example", 443]
 bind _ <- handle protected() with
 case Http.send(request) -> 0
 end handle
end function
@test
function upper() -> Unit uses Http.Connect["api.example", 443]
 main()
end function
