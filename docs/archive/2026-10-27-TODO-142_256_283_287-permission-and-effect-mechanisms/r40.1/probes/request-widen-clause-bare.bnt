import Benitoite.Unofficial.Network.Http
function sample(request: Http.RequestIn) -> Result[Http.Response, NetworkError] uses Http.Connect
 return handle Http.sendIn(request: request) with
 case Http.sendIn(captured) ->
  bind extracted: Http.RequestIn <- Http.widenRequestIn(request: captured)
  resume(Result.Ok(Http.text(status: 200, s: "handled")))
 end handle
end function
function main() -> Unit
end function
