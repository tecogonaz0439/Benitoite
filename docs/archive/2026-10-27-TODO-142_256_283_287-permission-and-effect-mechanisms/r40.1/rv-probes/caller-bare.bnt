import Benitoite.Unofficial.Scope
function sample(value: Scope.PathIn) -> String
 bind extracted: String <- Scope.pathInValue(path: value)
 return extracted
end function
function caller(raw: String) -> String
 bind checked: Result[Scope.PathIn["/data/a"], Scope.ScopeError] <- Scope.checkPathIn(pattern: "/data/a", path: raw)
 return match checked with
 case Result.Ok(value) -> sample(value: value)
 case Result.Error(_) -> "bad"
 end match
end function
function main() -> Unit
end function
