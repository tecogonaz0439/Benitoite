import Benitoite.Unofficial.IO.File
import Benitoite.Unofficial.Scope
function accept(path: Scope.PathIn["/data/a"]) -> Result[String, IOError]
 bind extracted: String <- Scope.pathInValue(path: path)
 return Result.Ok(extracted)
end function
function sample(path: Scope.PathIn["/data/a"]) -> Result[String, IOError] uses File.Read["/data/a"]
 return handle File.readTextIn(path: path) with
 case File.readTextIn(captured) -> resume(accept(path: captured))
 end handle
end function
function main() -> Unit
end function
