+/-! 比較の試行（L00.06c、案 (ii)）: 構造を持つ名前の単射な符号化。名前と範囲の要素は任意の文字
+（`'\u0000'` を含む）を持てるので、文字の桁（1〜`codeBase - 1`）と別の二つの区切りの桁を使う。 -/
+
+/-- 名前の符号の桁の基数。文字の桁と二つの区切りの桁を収める。0 は列の終端だけに使う。 -/
+def digitBase : Nat := codeBase + 2
+
+/-- 名前と範囲の区切りの桁。文字の桁には現れない。 -/
+def sepName : Nat := codeBase
+
+/-- 範囲の要素の終わりの桁。文字の桁には現れない。 -/
+def sepSeg : Nat := codeBase + 1
+
+/-- 桁の列の符号。 -/
+def digitsCode : List Nat → Nat
+  | [] => 0
+  | d :: ds => d + digitBase * digitsCode ds
+
+/-- 文字列の文字の桁。 -/
+def charDigits (s : String) : List Nat := s.toList.map (fun c => c.toNat + 1)
+
+/-- 範囲の記述の桁。先頭は種類の桁、続いて各要素の文字の桁と終わりの桁。 -/
+def scopeDigits : NameScope → List Nat
+  | .top => [1]
+  | .pathExact segs => 2 :: segs.flatMap (fun x => charDigits x ++ [sepSeg])
+  | .pathTree stem => 3 :: stem.flatMap (fun x => charDigits x ++ [sepSeg])
+
+/-- 名前の記述の桁。元の名前の文字の桁、区切り、範囲の桁。 -/
+def nameDigits (s : EffName) : List Nat := charDigits s.base ++ sepName :: scopeDigits s.scope
+
+private theorem digitsCode_injective {xs ys : List Nat} (hx : ∀ d ∈ xs, 0 < d ∧ d < digitBase)
+    (hy : ∀ d ∈ ys, 0 < d ∧ d < digitBase) (h : digitsCode xs = digitsCode ys) : xs = ys := by
+  induction xs generalizing ys with
+  | nil =>
+    cases ys with
+    | nil => rfl
+    | cons d ds => have := (hy d (by simp)).1; simp [digitsCode] at h; omega
+  | cons c cs ih =>
+    cases ys with
+    | nil => have := (hx c (by simp)).1; simp [digitsCode] at h; omega
+    | cons d ds =>
+      have hc := (hx c (by simp)).2
+      have hd := (hy d (by simp)).2
+      have hr := congrArg (· % digitBase) h
+      simp only [digitsCode, Nat.add_mod, Nat.mul_mod_right, Nat.add_zero,
+        Nat.mod_eq_of_lt hc, Nat.mod_eq_of_lt hd] at hr
+      subst hr
+      have hm : digitBase * digitsCode cs = digitBase * digitsCode ds := by
+        simp only [digitsCode] at h; omega
+      have ht : digitsCode cs = digitsCode ds :=
+        Nat.eq_of_mul_eq_mul_left (by simp [digitBase]) hm
+      exact congrArg (c :: ·) (ih (fun x hm => hx x (by simp [hm])) (fun x hm => hy x (by simp [hm])) ht)
+
+private theorem charDigit_bound (c : Char) : 0 < c.toNat + 1 ∧ c.toNat + 1 < codeBase := by
+  have h := c.valid
+  simp only [UInt32.isValidChar, Nat.isValidChar] at h
+  change 0 < c.val.toNat + 1 ∧ c.val.toNat + 1 < 1114113
+  omega
+
+private theorem charDigits_bound {s : String} {d : Nat} (h : d ∈ charDigits s) : 0 < d ∧ d < codeBase := by
+  simp only [charDigits, List.mem_map] at h
+  obtain ⟨c, _, rfl⟩ := h
+  exact charDigit_bound c
+
+private theorem charDigits_injective {s t : String} (h : charDigits s = charDigits t) : s = t := by
+  apply String.toList_inj.mp
+  have aux : ∀ cs ds : List Char, cs.map (fun c => c.toNat + 1) = ds.map (fun c => c.toNat + 1) → cs = ds := by
+    intro cs
+    induction cs with
+    | nil => intro ds h; cases ds <;> simp_all
+    | cons c cs ih =>
+      intro ds h
+      cases ds with
+      | nil => simp at h
+      | cons d ds =>
+        simp only [List.map_cons, List.cons.injEq] at h
+        rw [Char.toNat_inj.mp (by omega : c.toNat = d.toNat), ih ds h.2]
+  exact aux _ _ h
+
+/-- 区切りの桁を含まない二つの前置きの後ろで区切ると、前置きと残りが一致する。 -/
+private theorem split_sep {sep : Nat} {xs xs' ys ys' : List Nat} (hx : sep ∉ xs) (hx' : sep ∉ xs')
+    (h : xs ++ sep :: ys = xs' ++ sep :: ys') : xs = xs' ∧ ys = ys' := by
+  induction xs generalizing xs' with
+  | nil =>
+    cases xs' with
+    | nil => simpa using h
+    | cons d ds => simp only [List.nil_append, List.cons_append, List.cons.injEq] at h
+                   exact absurd (h.1 ▸ List.mem_cons_self) hx'
+  | cons c cs ih =>
+    cases xs' with
+    | nil => simp only [List.nil_append, List.cons_append, List.cons.injEq] at h
+             exact absurd (h.1 ▸ List.mem_cons_self) hx
+    | cons d ds =>
+      simp only [List.cons_append, List.cons.injEq] at h
+      obtain ⟨rfl, h2⟩ := h
+      have := ih (fun m => hx (List.mem_cons_of_mem _ m)) (fun m => hx' (List.mem_cons_of_mem _ m)) h2
+      exact ⟨by rw [this.1], this.2⟩
+
+private theorem sepSeg_not_mem (s : String) : sepSeg ∉ charDigits s := fun h => by
+  have := (charDigits_bound h).2; simp only [sepSeg] at this; omega
+
+private theorem sepName_not_mem (s : String) : sepName ∉ charDigits s := fun h => by
+  have := (charDigits_bound h).2; simp only [sepName] at this; omega
+
+private theorem segs_injective {xs ys : List String}
+    (h : xs.flatMap (fun x => charDigits x ++ [sepSeg]) = ys.flatMap (fun x => charDigits x ++ [sepSeg])) :
+    xs = ys := by
+  induction xs generalizing ys with
+  | nil =>
+    cases ys with
+    | nil => rfl
+    | cons y ys => simp at h
+  | cons x xs ih =>
+    cases ys with
+    | nil => simp at h
+    | cons y ys =>
+      simp only [List.flatMap_cons, List.append_assoc, List.singleton_append] at h
+      have := split_sep (sepSeg_not_mem x) (sepSeg_not_mem y) h
+      rw [charDigits_injective this.1, ih this.2]
+
+private theorem scopeDigits_injective {r s : NameScope} (h : scopeDigits r = scopeDigits s) : r = s := by
+  cases r <;> cases s <;> simp only [scopeDigits, List.cons.injEq, reduceCtorEq, true_and] at h ⊢ <;> first | rfl | omega | exact congrArg _ (segs_injective h)
+
+private theorem nameDigits_bound {s : EffName} {d : Nat} (h : d ∈ nameDigits s) : 0 < d ∧ d < digitBase := by
+  have hseg : ∀ (xs : List String), d ∈ xs.flatMap (fun x => charDigits x ++ [sepSeg]) →
+      0 < d ∧ d < digitBase := by
+    intro xs hm
+    simp only [List.mem_flatMap, List.mem_append, List.mem_singleton] at hm
+    obtain ⟨x, _, hm | rfl⟩ := hm
+    · have := charDigits_bound hm; simp only [digitBase]; omega
+    · simp [sepSeg, digitBase, codeBase]
+  simp only [nameDigits, List.mem_append, List.mem_cons] at h
+  rcases h with h | rfl | h
+  · have := charDigits_bound h; simp only [digitBase]; omega
+  · simp [sepName, digitBase, codeBase]
+  · cases hs : s.scope with
+    | top => rw [hs] at h; simp [scopeDigits] at h; subst h; simp [digitBase, codeBase]
+    | pathExact segs =>
+      rw [hs] at h; simp only [scopeDigits, List.mem_cons] at h
+      rcases h with rfl | h
+      · simp [digitBase, codeBase]
+      · exact hseg segs h
