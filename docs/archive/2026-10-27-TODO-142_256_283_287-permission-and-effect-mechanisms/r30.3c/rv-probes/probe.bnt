import Benitoite.Trait
import Benitoite.Unofficial.Network.Http
import Benitoite.Unofficial.IO.Console
import Benitoite.Unofficial.Scope
function one(pattern: String, url: String) -> Unit uses Console.Write, Http.Connect
 bind request <- Http.ClientRequest(method: "GET", url: url, headers: [], body: String.toUTF8(""), timeoutMilliseconds: 1500)
 match Http.checkRequestIn(hostPattern: pattern, minimumPort: 18091, maximumPort: 18091, request: request) with
  case Result.Error(Http.RequestCheckError.Scope(e)) -> Console.writeLine("REJECT-SCOPE " + pattern + " " + url + " " + Trait.Show.show(e))
  case Result.Error(_) -> Console.writeLine("REJECT-OTHER " + pattern + " " + url)
  case Result.Ok(value) ->
   bind projected <- Http.requestInValue(request: value)
   match Http.send(projected) with
    case Result.Ok(response) -> match String.fromUTF8(Http.Response.body(response)) with
      case Option.Some(text) -> Console.writeLine("ACCEPT " + url + " -> " + text)
      case Option.None -> Console.writeLine("ACCEPT " + url + " -> nonutf8")
     end match
    case Result.Error(error) -> Console.writeLine("ACCEPT " + url + " -> NetworkError " + NetworkError.message(error))
   end match
 end match
end function
function h(pattern: String, host: String) -> Unit uses Console.Write
 match Scope.checkHost(pattern: pattern, host: host) with
  case Result.Ok(_) -> Console.writeLine("HOST-OK " + pattern + " " + host)
  case Result.Error(e) -> Console.writeLine("HOST-ERR " + pattern + " " + host + " " + Trait.Show.show(e))
 end match
 match Scope.checkEndpoint(hostPattern: pattern, host: host, minimumPort: 0, maximumPort: 65535, port: 80) with
  case Result.Ok(_) -> Console.writeLine("EP-OK " + pattern + " " + host)
  case Result.Error(e) -> Console.writeLine("EP-ERR " + pattern + " " + host + " " + Trait.Show.show(e))
 end match
end function
