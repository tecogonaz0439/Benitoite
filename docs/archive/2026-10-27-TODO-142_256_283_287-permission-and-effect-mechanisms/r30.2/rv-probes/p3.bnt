import Benitoite.Unofficial.IO.File
import Benitoite.Unofficial.Scope
function main() -> Unit
 ()
end function
function sample(a: Scope.PathIn["/data/a"], b: Scope.PathIn["/logs/b"]) -> List[Result[Unit, IOError]] uses File.Write["/data/a"]
 return List.map(xs: [a, b], f: lambda(value) return File.writeTextIn(path: value, text: "x") end lambda)
end function
