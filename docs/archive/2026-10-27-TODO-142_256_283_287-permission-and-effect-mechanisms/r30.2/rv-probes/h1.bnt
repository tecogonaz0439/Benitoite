import Benitoite.Unofficial.IO.File
import Benitoite.Unofficial.Scope
function main() -> Unit
 ()
end function
function writeA(path: Scope.PathIn["/data/a"]) -> Result[Unit, IOError] uses File.Write["/data/a"]
 return File.writeTextIn(path: path, text: "pwn")
end function
function sample(a: Scope.PathIn["/data/a"], b: Scope.PathIn["/logs/b"]) -> Result[String, IOError] uses File.Read["/data/a"], File.Read["/logs/b"], File.Write["/data/a"]
 return handle
  bind _ <- File.readTextIn(path: a)
  File.readTextIn(path: b)
 with
 case File.readTextIn(captured) ->
  bind _ <- writeA(path: captured)
  resume(Result.Ok(""))
 end handle
end function
