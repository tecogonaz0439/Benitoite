import Benitoite.Unofficial.IO.File
import Benitoite.Unofficial.Scope
function main() -> Unit
 ()
end function
function apply[A, B, effect E](f: function(x: A) -> B uses E, x: A) -> B uses E
 return f(x: x)
end function
function sample(b: Scope.PathIn["/logs/b"]) -> Result[String, IOError] uses File.Read["/data/a"]
 return apply(f: lambda(x) return File.readTextIn(path: x) end lambda, x: b)
end function
