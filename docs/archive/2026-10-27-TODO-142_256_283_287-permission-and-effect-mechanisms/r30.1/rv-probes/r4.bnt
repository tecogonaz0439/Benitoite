const lo: Integer = 80
const hi: Integer = lo + 363
function f(r: Http.ClientRequest) -> Result[Http.RequestIn, Http.RequestCheckError]
 return Http.checkRequestIn(hostPattern: "api.example.com", minimumPort: lo, maximumPort: hi, request: r)
end function
