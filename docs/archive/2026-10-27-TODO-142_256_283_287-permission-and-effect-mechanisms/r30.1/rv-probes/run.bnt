import Benitoite.Trait
import Benitoite.Unofficial.Scope
import Benitoite.Unofficial.Network.Http
import Benitoite.Unofficial.IO.Console
function dyn(p: String, h: String, lo: Integer, hi: Integer, po: Integer) -> Result[Scope.CheckedEndpoint, Scope.ScopeError]
 return Scope.checkEndpoint(hostPattern: p, host: h, minimumPort: lo, maximumPort: hi, port: po)
end function
function main() -> Unit uses Console.Write
 match dyn(p: "192.168.1.0/24", h: "192.168.1.20", lo: 1, hi: 65535, po: 80) with
  case Result.Ok(v) ->
   match dyn(p: Scope.endpointHostPattern(v), h: Scope.endpointHost(v), lo: 1, hi: 65535, po: 80) with
    case Result.Ok(w) -> Console.writeLine("0 OK " + Scope.endpointHostPattern(v) + " " + Scope.endpointHost(v) + " reuse=" + Scope.endpointHostPattern(w))
    case Result.Error(e) -> Console.writeLine("0 OK-REUSE-FAIL " + Trait.Show.show(e))
   end match
  case Result.Error(e) -> Console.writeLine("0 ERR " + Trait.Show.show(e))
 end match
