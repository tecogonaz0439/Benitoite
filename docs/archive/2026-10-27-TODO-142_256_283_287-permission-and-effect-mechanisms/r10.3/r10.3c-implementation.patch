+// 物理行をまたいで次の要素や本体を飲み込まないための終端。
+fn element_end(kind: TokenKind) -> bool {
+    matches!(
+        kind,
+        TokenKind::StringLit
+            | TokenKind::StrEnd
+            | TokenKind::IntLit
+            | TokenKind::FloatLit
+            | TokenKind::DecimalLit
+            | TokenKind::CharLit
+            | TokenKind::KwTrue
+            | TokenKind::KwFalse
+            | TokenKind::LowerIdent
+            | TokenKind::UpperIdent
+            | TokenKind::RParen
+            | TokenKind::RBracket
+    )
+}
+fn binary_operator(kind: TokenKind) -> bool {
+    matches!(
+        kind,
+        TokenKind::PipeGt
+            | TokenKind::KwOr
+            | TokenKind::KwAnd
+            | TokenKind::Eq
+            | TokenKind::NotEq
+            | TokenKind::Lt
+            | TokenKind::Le
+            | TokenKind::Gt
+            | TokenKind::Ge
+            | TokenKind::Plus
+            | TokenKind::Minus
+            | TokenKind::Star
+            | TokenKind::Slash
+            | TokenKind::KwDiv
+            | TokenKind::KwMod
+    )
+}
