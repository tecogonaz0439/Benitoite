+/-- 比較の試行（案 (ii)）: 添字の置き換えは型の変数の範囲を保つ。 -/
+theorem Ty.withIndex_varsIn {n : Nat} {pe : Nat → Prop} (R : NameScope) (t : Ty) (h : t.VarsIn n pe) :
+    (Ty.withIndex R t).VarsIn n pe := by
+  cases t <;> simp_all [Ty.withIndex, Ty.VarsIn]
+
+/-- 比較の試行（案 (ii)）: 表の署名を具体化しても、宣言した変数だけを使う。 -/
+theorem PrimSig.inst_scoped {s : PrimSig} (R : NameScope) (h : s.Scoped) : (s.inst R).Scoped := by
+  unfold PrimSig.inst
+  split
+  · obtain ⟨hn, hp, hr, he⟩ := h
+    refine ⟨⟨by simp [hn.1], hn.2⟩, ?_, hr, ?_⟩
+    · rw [Ty.VarsInList.iff] at hp ⊢
+      intro a ha
+      rw [List.mem_mapIdx] at ha
+      obtain ⟨i, hi, rfl⟩ := ha
+      split
+      · exact Ty.withIndex_varsIn _ _ (hp _ (List.getElem_mem _))
+      · exact hp _ (List.getElem_mem _)
+    · simp [Eff.VarsIn, Eff.single, Eff.ofAtoms, Ty.VarsInList]
+  · exact h
+
