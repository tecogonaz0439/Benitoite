import Benitoite.Unofficial.Network.Http
import Benitoite.Unofficial.IO.Console
function go(a: Http.RequestIn["127.0.0.1", 18411]) -> Result[Http.Response, NetworkError]
 return handle Http.sendIn(request: a) with
 case Http.sendIn(captured) -> resume(Result.Ok(Http.text(status: 200, s: "y")))
 case Http.send(c) -> resume(Result.Ok(Http.text(status: 200, s: "x")))
 end handle
end function
function main() -> Unit
 ()
end function
