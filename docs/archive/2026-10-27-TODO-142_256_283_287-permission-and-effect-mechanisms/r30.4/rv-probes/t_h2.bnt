import Benitoite.Unofficial.Network.Http
import Benitoite.Unofficial.IO.Console
function go(a: Http.RequestIn["127.0.0.1", 18411]) -> Result[Http.Response, NetworkError] uses Http.Connect["127.0.0.1", 18411]
 return handle Http.sendIn(request: a) with
 case Http.sendIn(captured) -> resume(Http.send(request: Http.clientRequest(method: "GET", url: "http://127.0.0.1:18412/")))
 case Http.send(c) -> resume(Http.send(request: c))
 end handle
end function
function main() -> Unit
 ()
end function
