import Benitoite.Unofficial.Network.Http
import Benitoite.Unofficial.IO.Console
function fwd(r: Http.RequestIn) -> Result[Http.Response, NetworkError] uses Http.Connect
 return Http.sendIn(request: r)
end function
function go(a: Http.RequestIn["127.0.0.1", 18411]) -> Result[Http.Response, NetworkError] uses Http.Connect["127.0.0.1", 18411]
 return handle Http.sendIn(request: a) with
 case Http.sendIn(captured) -> resume(fwd(r: captured))
 end handle
end function
function main() -> Unit
 ()
end function
