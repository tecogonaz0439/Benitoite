+// corpus 10 の名前の原子は、範囲を持たない旧形式の意味どおり明示 Top にする。
+// 固定入力は変更せず、現在の出力との比較に必要な表現だけを合わせる。
+fn legacy_atom_tops(value: &mut Value) {
+    match value {
+        Value::Object(fields) => {
+            if let Some(Value::Object(atom)) = fields.get_mut("name")
+                && atom.len() == 1
+                && atom.get("value").is_some_and(Value::is_string)
+            {
+                atom.insert("ix".into(), json!({"fixed":"top"}));
+            }
+            fields.values_mut().for_each(legacy_atom_tops);
+        }
+        Value::Array(values) => values.iter_mut().for_each(legacy_atom_tops),
+        Value::Null | Value::Bool(_) | Value::Number(_) | Value::String(_) => {}
+    }
+}
