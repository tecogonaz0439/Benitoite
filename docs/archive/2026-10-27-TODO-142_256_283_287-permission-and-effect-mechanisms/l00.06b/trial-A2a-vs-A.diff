+/-- L00.06b の試行 A2（案 (i)）: 節の添字 S で具体化した操作の型。組み込みの操作の引数型は表の署名を S で具体化した
+もの、それ以外は `opSig` と同じである。結果・型パラメータ・引数名・エフェクトの名前は S によらない。 -/
+def opSigAt (P : Program) (B : Builtins) (S : ScopeRange) (o : OpRef) : Option OpSig :=
+  match o with
+  | .prim b =>
+      match B.sig b with
+      | some s =>
+          match s.opEff with
+          | some l => some ⟨s.tparams, s.names, (s.inst S).params, s.ret, l⟩
+          | none => none
+      | none => none
+  | o => opSig P B o
+
+/-- L00.06b の試行 A2: Top の節の添字は旧の操作の型である。 -/
+theorem opSigAt_top (P : Program) (B : Builtins) (o : OpRef) : opSigAt P B .top o = opSig P B o := by
+  cases o <;> simp [opSigAt, opSig]
+
+/-- L00.06b の試行 A2: 節の添字で具体化した操作の型は、引数型の対象の位置だけが旧の操作の型と違いうる。 -/
+theorem opSigAt_rel {P : Program} {B : Builtins} {S : ScopeRange} {o : OpRef} {sg sg' : OpSig}
+    (h : opSig P B o = some sg) (h' : opSigAt P B S o = some sg') :
+    sg'.tparams = sg.tparams ∧ sg'.names = sg.names ∧ sg'.ret = sg.ret ∧ sg'.eff = sg.eff ∧
+      (sg'.params = sg.params ∨
+        (S ≠ .top ∧ ∃ (p : Nat) (o' : OpaqueName), sg'.params[p]? = some (Ty.opaque o' S))) := by
+  cases o with
+  | fail => cases h
+  | user o =>
+      simp only [opSigAt] at h'
+      rw [h] at h'; cases h'
+      exact ⟨rfl, rfl, rfl, rfl, Or.inl rfl⟩
+  | prim b =>
+      cases hs : B.sig b with
+      | none => simp [opSig, hs] at h
+      | some s =>
+          cases hl : s.opEff with
+          | none => simp [opSig, hs, hl] at h
+          | some l =>
+              simp only [opSig, hs, hl, Option.some.injEq] at h
+              simp only [opSigAt, hs, hl, Option.some.injEq] at h'
+              subst h h'
+              refine ⟨rfl, rfl, rfl, rfl, ?_⟩
+              rcases s.inst_cases S with he | ⟨hS, p, o', hp⟩
+              · left; simp [he]
+              · right; exact ⟨hS, p, o', hp⟩
+
