 return handle tick() with
 case tick() ->
 bind _ <- run0(protected)
 bind _ <- run1(protected)
 bind _ <- run2(protected)
 bind _ <- run3(protected)
 bind _ <- run4(protected)
 bind _ <- run5(protected)
 bind _ <- run6(protected)
 bind _ <- run7(protected)
 bind _ <- run8(protected)
 resume(run9(protected))
 end handle
end function
function main() -> Unit uses File.Read["/data/a"]
 bind _ <- sample()
end function
