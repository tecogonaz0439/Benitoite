def Benitoite.Surface.ScopeSound.reqEndpoint : (Const → Option Scope.Domain.Target) →
  Val → Option Scope.Domain.Endpoint :=
fun reqTarget x =>
  match x with
  | Val.const c =>
    match reqTarget c with
    | some (Scope.Domain.Target.endpoint e) => some e
    | x => none
  | x => none
