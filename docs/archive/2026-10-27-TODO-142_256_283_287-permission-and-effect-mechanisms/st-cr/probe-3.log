Benitoite.Release.HasTypeVQ.V_CheckedRequest {P : Program} {B : Builtins} {Ψ : StoreTy} {Q : NoFailCtx}
  {C : List TParam} {Γ : List (Option Ty)} {o : OpaqueName} {R : Scope.Domain.Range} {t : Scope.Domain.Target}
