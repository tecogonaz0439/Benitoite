Benitoite.Release.Refinement.ClosureTy.match_source {P : Benitoite.Release.Refinement.Program}
  {B : Benitoite.Release.Refinement.Builtins} {Ψ : Benitoite.Release.Refinement.StoreTy}
  {R : Option Benitoite.Release.Refinement.Ty} {cap : Benitoite.Release.Refinement.Capture}
  {vs : Benitoite.Release.Refinement.Val} {arms : List Benitoite.Release.Refinement.Arm}
  {a : Benitoite.Release.Refinement.Ty} {e : Benitoite.Release.Refinement.Eff}
  (hq :
    Benitoite.Release.Refinement.ClosureTy P B Ψ [] R
      (Benitoite.Release.Refinement.Closure.mk cap (Benitoite.Release.Refinement.Comp.match vs arms)) a e) :
  ∃ Γ Φ Rs root obs arms0 input as es L ρ,
    Benitoite.Release.Refinement.CaptureOk P B Ψ R Γ Φ cap ∧
      Benitoite.Release.Refinement.HasTypeV P B Ψ [] Γ Φ root input ∧
        (∀ (t : Benitoite.Release.Refinement.Term),
            obs = Option.some t →
              root.toTerm? = Option.some t ∧ ∃ sort, Benitoite.Release.Refinement.Term.HasSort Γ t sort) ∧
          Benitoite.Release.Refinement.HasTypeArmsQ P B Ψ Benitoite.Release.Qempty [] Γ Φ Rs obs arms0 input as es L ∧
            Benitoite.Release.Refinement.CaptureLocals Ψ cap.env L ρ ∧
              arms = Benitoite.Release.Refinement.Arm.resolveLocalsList ρ arms0 ∧
                vs = root ∧
                  cap.closeR Rs = R ∧
                    cap.closeTy as = a ∧
                      cap.closeEff es = e ∧
                        (∀ (r : Benitoite.Release.Refinement.Ty),
                            Rs = Option.some r → Benitoite.Release.Refinement.Ty.Declared P [] Γ r) ∧
                          Benitoite.Release.Refinement.Exhaustive P input
                            (Benitoite.Release.Refinement.unguardedPats arms0)
