Benitoite.Release.Refinement.Eff.mem_rawBind (θ : Benitoite.Release.Refinement.SubstEnv)
  (e : Benitoite.Release.Refinement.Eff) (a : Benitoite.Release.Atom) :
  (Benitoite.Release.Refinement.Eff.rawBind θ e).mem a ↔
    (∃ b,
        e.mem b ∧
          Benitoite.Release.Atom.instR θ.ranges b = a ∧
            match b with
            | Benitoite.Release.Atom.name l ix => True
            | Benitoite.Release.Atom.rho i => θ.rows.length ≤ i) ∨
      ∃ i f, θ.rows[i]? = some f ∧ e.mem (Benitoite.Release.Atom.rho i) ∧ f.mem a
