              a =
                Benitoite.Release.Atom.name l
                  (Benitoite.Scope.Signature.Ix.fixed
                    (Benitoite.Scope.Domain.Range.endpoint { host := host, ports := { lo := 5, hi := 9 } }))))
        [])
