Benitoite.Release.Refinement.OpenSubstitution.path_witness :
  Benitoite.Release.Refinement.predBind (fun x => Benitoite.Release.Refinement.Term.integer 7)
        Benitoite.Release.Refinement.OpenSubstitution.path =
      Benitoite.Release.Refinement.Pred.eq (Benitoite.Release.Refinement.Term.integer 7)
        (Benitoite.Release.Refinement.Term.integer 7) ∧
    Benitoite.Release.Refinement.predBind (fun i => Benitoite.Release.Refinement.Term.integer (if i = 2 then 6 else 7))
          (Benitoite.Release.Refinement.predBind Benitoite.Release.Refinement.OpenSubstitution.σ
            Benitoite.Release.Refinement.OpenSubstitution.path) =
        Benitoite.Release.Refinement.Pred.eq
          ((Benitoite.Release.Refinement.Term.integer 6).add (Benitoite.Release.Refinement.Term.integer 1))
          (Benitoite.Release.Refinement.Term.integer 7) ∧
      6 + 1 = 7
