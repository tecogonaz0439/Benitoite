Benitoite.Release.Refinement.OpenSubstitution.open_images :
  Benitoite.Release.Refinement.OpenSubstitution.θ.types 0 =
      (Benitoite.Release.Refinement.Ty.base Benitoite.Release.BaseTy.integer).refined
        (Benitoite.Release.Refinement.Pred.le (Benitoite.Release.Refinement.Term.var 0)
          ((Benitoite.Release.Refinement.Term.var 3).add (Benitoite.Release.Refinement.Term.integer 1))) ∧
    Benitoite.Release.Refinement.OpenSubstitution.θ.types 1 = Benitoite.Release.Refinement.Ty.tvar 1 ∧
      Benitoite.Release.Refinement.mapIx
            (Benitoite.Release.Refinement.rangeAt 0 Benitoite.Release.Refinement.OpenSubstitution.θ.ranges)
            (Benitoite.Scope.Signature.Ix.rvar 1) =
          Benitoite.Scope.Signature.Ix.rvar 1 ∧
        (Benitoite.Release.Refinement.Eff.rawSubstV Benitoite.Release.Refinement.OpenSubstitution.σ
                Benitoite.Release.Refinement.OpenSubstitution.rowImage).mem
            (Benitoite.Release.Atom.rho 1) ∧
          (Benitoite.Release.Refinement.Eff.rawSubstV Benitoite.Release.Refinement.OpenSubstitution.σ
                  Benitoite.Release.Refinement.OpenSubstitution.rowImage).mem
              (Benitoite.Release.Atom.name "Write" (Benitoite.Scope.Signature.Ix.rvar 1)) ∧
            (Benitoite.Release.Refinement.Eff.rawSubstV Benitoite.Release.Refinement.OpenSubstitution.σ
                  Benitoite.Release.Refinement.OpenSubstitution.rowImage).mem
              (Benitoite.Release.Atom.nameTop "Read")
