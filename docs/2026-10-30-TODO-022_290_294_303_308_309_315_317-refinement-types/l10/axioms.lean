    unless names.length > 0 || mod == `Benitoite.Release.Refinement.Exchange do
      throwError "AUDIT_EMPTY {mod}"
    logInfo m!"AUDIT_MODULE {mod} {names.length}"
    for name in names do
      elabCommand (← `(#print axioms $(mkIdent name)))

