    "name": "List.filterFrom",
    "file": "crates/benitoite/src/prelude/stdlib/List.bnt",
    "line": 85,
    "definition": "function filterFrom[T, effect E](xs: List[T], p: function(value: T) -> Boolean uses E, i: Integer, acc: List[T]) -> List[T] uses E\n  return match get(xs: xs, i: i) with\n    case Option.None -> acc\n    case Option.Some(x) ->\n      if p(x) then\n        filterFrom(xs: xs, p: p, i: i + 1, acc: append(xs: acc, x: x))\n      else\n        filterFrom(xs: xs, p: p, i: i + 1, acc: acc)\n      end if\n  end match\nend function",
    "source": {
