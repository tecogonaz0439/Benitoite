+    (state : StateTyE P B σ Eb (.run q k μ))
+    (view : q.view = .app (.fnRef f ts es (rs.map RangeIx.fixed)) ws) :
+    ∃ Ψ R a ec d result effects, StoreOk P B σ Ψ μ ∧ ClosureTy P B Ψ [] R q a ec ∧
+      (P.defs f = some d) ∧
