+/-- IO・終了の型付きの呼出しから、継続の効果の原子と操作の表の所属を得る。 -/
+theorem StateTyE.primitive_effect_input {P B σ Eb q b s ts es rs ws k μ}
+    (hP : P.WellFormed) (hPB : P.WellTyped B) (hB : B.CoreAssumptions P)
+    (h : StateTyE P B σ Eb (.run q k μ))
+    (hv : q.view = .app (.prim b ts es (List.map RangeIx.fixed rs)) ws)
+    (hsig : B.sig b = some s) (hkind : s.kind = .io ∨ s.kind = .exit) :
+    ∃ Ψ R a z e l bs ix, ContTy P B σ Ψ R e k a z Eb none ∧
+      B.effects l = some bs ∧ b ∈ bs ∧ e.mem (.name l ix) := by
+  obtain ⟨Ψ,R,a,z,e,e1,hs,hq,he,hk,_,hclosed,_⟩ := h
+  have hcode := hq.app_view_typed hP hPB hB hs.wf hs.sorted hs.declared hv
+  have hg : ∀ w ∈ ws, w.Ground := by
+    intro w hw
+    exact hq.view_read_ground hclosed (by rw [hv]; exact List.mem_cons_of_mem _ hw)
+  obtain ⟨callerTy,hcall⟩ := hcode.read_values (.prim b ts es (List.map RangeIx.fixed rs)) List.mem_cons_self
+  obtain ⟨hranges,hadm,_⟩ := hcall.primitive_inputs hsig
+  obtain ⟨eff,bs,_,heffects,hb,hnrows,hshape⟩ := primitive_effect_shape hB hsig hkind
+  have hes : es = [] := List.length_eq_zero_iff.mp (hadm.rowCount.trans hnrows)
+  subst es
+  obtain ⟨r,f,hba,_,hcov⟩ := hcode.primitive_call hg rfl hsig
+  have hargs : HasTypeTelArgsQ P B Ψ Qempty [] [] [] ws (instantiatedTel (Tel.instR rs s.tel) ts []) r f := by
+    have hh := hba.arguments
+    rw [instantiatedTel_norm_images] at hh
+    exact hh
+  obtain ⟨ix,hmem,_⟩ := primitive_inst_member hshape hranges.1
+  have hm : f.mem (.name eff (.fixed ix)) := by
+    change f.atoms (.name eff (.fixed ix)) = true
+    rw [primitive_arguments_atoms hargs]
+    exact hmem
+  obtain ⟨ix1,hm1,_⟩ := covered_name_general hcov hm
+  exact ⟨Ψ,R,a,z,e,eff,bs,ix1,hk,heffects,hb,he.1 _ hm1⟩
