+  have hq' := ClosureTy.pure (.C_Return (R := R'') hv) (empty_annotation ha)
+    (fun r hh => ⟨(hr r hh).wf,(hr r hh).declared⟩) hn hRn
+  exact ⟨.E_Update (by change Comp.ret (closeVal Capture.empty v) = _; rw [hc]),
