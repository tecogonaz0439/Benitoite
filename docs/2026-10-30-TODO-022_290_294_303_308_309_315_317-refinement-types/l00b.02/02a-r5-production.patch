+/-- 関数の型パラメータの宣言。操作・実装の値型パラメータの制約とは分ける。 -/
+structure TParamDecl where
+  constraints : Benitoite.Release.TParam := {}
+  kind : TyKind := .value
+
+def embedTParam (p : Benitoite.Release.TParam) : TParamDecl := ⟨p, .value⟩
