Benitoite.Release.Refinement.TelBodyTy.shift_values {P : Program} {B : Builtins} {store : StoreTy} {Q : NoFailCtx}
  {C : List TParam} {Γ : Ctx} {Φ : List Pred} {t : Tel} {body : Comp} (h : TelBodyTy P B store Q C Γ Φ t body)
  {k c : Nat} {Δ : Ctx} {Ξ : List Pred} {store' : StoreTy} (hA : Builtins.ValueAssumptions P B) (hw : store.WF)
  (hext : store.Extends store') (hm : FullShiftMap k c Γ Δ)
  (hf : ∀ (p : Pred), p ∈ Φ → Entails (Δ.facts ++ Ξ) (Pred.shiftV k c p)) :
  TelBodyTy P B store' Q C Δ Ξ (Tel.shiftV k c t) (Comp.rename (upRen (telBinders t) (shiftIndex k c)) body)
Benitoite.Release.Refinement.TelBodyTy.shift_types {P : Program} {B : Builtins} {store : StoreTy} {Q : NoFailCtx}
  {C : List TParam} {Γ : Ctx} {Φ : List Pred} {t : Tel} {body : Comp} (h : TelBodyTy P B store Q C Γ Φ t body)
  {C' : List TParam} {Δ : Ctx} {k c : Nat} (hA : Builtins.TypeAssumptions P B) (hw : store.WF)
  (hC : TypeParamRenaming C C' (shiftIndex k c)) (hn : C'.length = C.length + k) (hm : TypeCtxMap k c Γ Δ) :
  TelBodyTy P B store Q C' Δ Φ (shiftTelTypes k c t) (Comp.shiftEAt k c body)
Benitoite.Release.Refinement.StateTy (P : Program) (B : Builtins) (σ : PathEnv) (s : State) : Prop
Benitoite.Release.Refinement.Step.E_Lam {P : Program} {B : Builtins} {σ : PathEnv} {q : Closure} {signature : Tel}
  {body : Closure} {ws : List Val} {k : Cont} {μ : Store} :
  q.view = Comp.app (Val.closure signature body) ws →
    ws.length = signature.arity → Step P B σ (State.run q k μ) none (State.run (body.apply ws) (markPush k) μ)
