Benitoite.Release.Refinement.ContTy.K_Guard {P : Program} {B : Builtins} {σ : PathEnv} {Ψ : StoreTy} {R : Option Ty}
  {ε : Eff} {v : Val} {cap : Capture} {arms : List Arm} {next : Nat} {body : Closure} {k : Cont} {a b : Ty} {Eb : Eff}
  {Re : Option Ty} {e1 : Eff} {Γ : Ctx} {Φ : List Pred} {Rs : Option Ty} {vs : Val} {t as : Ty} {es : Eff} :
  CaptureOk P B Ψ R Γ Φ cap →
    HasTypeV P B Ψ [] Γ Φ vs t →
      HasTypeArmsQ P B Ψ Qempty [] Γ Φ Rs arms t as es →
        Ty.Declared P [] Γ (Ty.dependentFn (Tel.done as es)) →
          (∀ (r : Ty), Rs = some r → Ty.Declared P [] Γ r) →
            Exhaustive P t (unguardedPats arms) →
              v = closeVal cap vs →
                cap.closeR Rs = R →
                  cap.closeTy as = a →
                    cap.closeEff es = e1 →
                      ClosureTy P B Ψ [] R body a e1 →
                        e1.Sub ε →
                          MatchPrefix v arms next →
                            ContTy P B σ Ψ R ε k a b Eb Re →
                              Frame.Adequate σ (Frame.guardF v cap arms next body) →
                                ContTy P B σ Ψ none Eff.empty (Frame.guardF v cap arms next body :: k)
                                  (Ty.base BaseTy.boolean) b Eb Re
Benitoite.Release.Refinement.ContTy.K_Handle_Fail {P : Program} {B : Builtins} {σ : PathEnv} {Ψ : StoreTy}
  {R : Option Ty} {ε ec rest : Eff} {E : Ty} {cap : Capture} {h : List Clause} {k : Cont} {t b : Ty} {Eb : Eff}
  {Re : Option Ty} {Γ : Ctx} {Φ : List Pred} {Rs : Option Ty} {ts : Ty} {ecs : Eff} {Es : Ty} :
  ContTy P B σ Ψ R ε k t b Eb Re →
    Eff.Covers [] [] ε rest →
      NoFail Qempty rest →
        CaptureOk P B (hideBuilders Ψ) R Γ Φ cap →
          HasFailureClause P B (hideBuilders Ψ) Qempty [] Γ Φ Es Rs h ts ecs →
            cap.closeR Rs = R →
              cap.closeTy ts = t →
                cap.closeEff ecs = ec →
                  cap.closeTy Es = E →
                    (∀ (a : Ty), Rs = some a → Ty.Declared P [] Γ a) →
                      Eff.Covers [] [] ε ec →
                        Ty.Annotation P [] [] t →
                          Frame.Adequate σ (Frame.handleF cap h) →
                            ContTy P B σ Ψ R ((Eff.singleFail E).union rest) (Frame.handleF cap h :: k) t b Eb Re
Benitoite.Release.Refinement.StoreOk.cont_result_declared {P : Program} {B : Builtins} {σ : PathEnv} {Ψ : StoreTy}
  {μ : Store} {l : Nat} {a b : Ty} {e : Eff} {R : Option Ty} {C : List TParam} {Γ : Ctx} (h : StoreOk P B σ Ψ μ)
  (hl : Ψ l = some (LocTy.cont a b e R)) : Ty.Declared P C Γ b
Benitoite.Release.Refinement.TelBodyTy.subst {P : Program} {B : Builtins} {Ψ : StoreTy} {Q : NoFailCtx}
  {C : List TParam} {Γ : Ctx} {Φ : List Pred} {t : Tel} {body : Comp} {Δ : Ctx} {Ξ : List Pred} {ν : Nat → Val}
  (h : TelBodyTy P B Ψ Q C Γ Φ t body) (hA : Builtins.SubstitutionAssumptions P B) (hw : Ψ.WF)
  (ht : ∀ (R0 : Option Ty), SubstOk P B Ψ Q C Γ Φ Δ Ξ R0 ν)
  (hf : ∀ (p : Pred), p ∈ Φ → Entails (Δ.facts ++ Ξ) (predBind (valEnv ν).values p))
  (ρ : Nat → LocalRef := LocalRef.bound) :
  TelBodyTy P B Ψ Q C Δ Ξ (Tel.bind (valEnv ν) t)
    (Comp.subst (upSubst (telBinders t) ν) body (upLocalSubst (telBinders t) ρ))
Benitoite.Release.Refinement.TelBodyTy.narrow {P : Program} {B : Builtins} {store : StoreTy} {Q : NoFailCtx}
  {C : List TParam} {Γ : Ctx} {Φ : List Pred} {t : Tel} {body : Comp} {Δ : Ctx} {Ξ : List Pred}
  (h : TelBodyTy P B store Q C Γ Φ t body) (hA : Builtins.ValueAssumptions P B) (hw : store.WF)
