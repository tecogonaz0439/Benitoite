+/-- 項の全参照は、その文脈で値の型を持つ位置を指す。Noneは読まない。 -/
+def Term.References (Γ : Ctx) : Term → Prop
+  | .var i => ∃ a, Γ[i]? = some (some a)
+  | .integer _ => True
+  | .add a b => a.References Γ ∧ b.References Γ
+
+/-- selfを含め、参照の規約をsortとは独立に表す。 -/
+def Pred.References (Γ : Ctx) (self : Option Ty) : Pred → Prop
+  | .truth | .falsity => True
+  | .eq a b | .le a b | .lt a b =>
+      let Δ := match self with | none => Γ | some a => some a :: Γ
+      a.References Δ ∧ b.References Δ
+  | .and p q | .or p q => p.References Γ self ∧ q.References Γ self
+  | .not p => p.References Γ self
+
+theorem Term.references_wf {Γ : Ctx} {t : Term} (h : t.References Γ) : termWF Γ.length t := by
+  induction t with
+  | var i => obtain ⟨a, hi⟩ := h; exact (List.getElem?_eq_some_iff.mp hi).1
+  | integer _ => trivial
+  | add a b ia ib => exact ⟨ia h.1, ib h.2⟩
+
+theorem termSorted.references {Γ : Ctx} {t : Term} (h : termSorted Γ t) : t.References Γ := by
+  induction t with
+  | var i => obtain ⟨a, hi, _⟩ := h; exact ⟨a, hi⟩
+  | integer _ => trivial
+  | add a b ia ib => exact ⟨ia h.1, ib h.2⟩
+
+theorem Pred.Sorted.references {Γ : Ctx} {self : Option Ty} {p : Pred}
+    (h : p.Sorted Γ self) : p.References Γ self := by
+  induction p with
+  | truth | falsity => trivial
+  | eq a b | le a b | lt a b => exact ⟨h.1.references, h.2.references⟩
+  | and p q ip iq | or p q ip iq => exact ⟨ip h.1, iq h.2⟩
+  | not p ip => exact ip h
+
+theorem Pred.references_wf {Γ : Ctx} {a : Ty} {p : Pred}
+    (h : p.References Γ (some a)) : p.WF (Γ.length+1) := by
+  induction p with
+  | truth | falsity => trivial
+  | eq a b | le a b | lt a b => exact ⟨Term.references_wf h.1, Term.references_wf h.2⟩
+  | and p q ip iq | or p q ip iq => exact ⟨ip h.1, iq h.2⟩
+  | not p ip => exact ip h
 
