+  refine ⟨?_, rfl, rfl, rfl⟩
+  intro i
+  simp only [typeEnvAt, Nat.not_lt_zero, ↓reduceIte, Nat.sub_zero,
+    List.length_map, List.getElem?_map]
+  split
+  · cases ht : ts[i]? with
+    | none => rfl
+    | some a => simp only [Option.map_some, Option.getD_some, shiftTypes_zero, Ty.norm_idem]
+  · rfl
