+theorem SubstEnv.normRows_up (θ : SubstEnv) : θ.up.normRows = θ.normRows.up := by
+  cases θ
+  simp only [SubstEnv.normRows, SubstEnv.up, List.map_map]
+  congr 2
+  funext e
+  exact Eff.norm_shiftV e 1 0
