have this := fun t =>
  {
    values := fun i a hi ha =>
      Nat.casesAuxOn (motive := fun a =>
        i = a → termSorted [] ({ types := Ty.tvar, rows := [], ranges := [], values := fun x => t }.values i)) i
        (fun h =>
          Eq.ndrec (motive := fun i =>
            [some (Ty.base Benitoite.Release.BaseTy.integer).list][i]? = some (some a) →
              termSorted [] ({ types := Ty.tvar, rows := [], ranges := [], values := fun x => t }.values i))
            (fun hi =>
              Eq.casesOn (motive := fun a_1 t_1 =>
                a = a_1 →
                  Eq.mp
                        (Eq.trans (Option.some.injEq (some (Ty.base Benitoite.Release.BaseTy.integer).list) (some a))
                          (Option.some.injEq (Ty.base Benitoite.Release.BaseTy.integer).list a))
                        hi ≍
                      t_1 →
                    termSorted [] ({ types := Ty.tvar, rows := [], ranges := [], values := fun x => t }.values 0))
                (Eq.mp
                  (Eq.trans (Option.some.injEq (some (Ty.base Benitoite.Release.BaseTy.integer).list) (some a))
                    (Option.some.injEq (Ty.base Benitoite.Release.BaseTy.integer).list a))
                  hi)
                (fun h =>
                  Eq.ndrec (motive := fun a =>
                    a.IntegerCarrier →
                      ∀ (hi : (Ty.base Benitoite.Release.BaseTy.integer).list = a),
                        hi ≍ Eq.refl (Ty.base Benitoite.Release.BaseTy.integer).list →
                          termSorted [] ({ types := Ty.tvar, rows := [], ranges := [], values := fun x => t }.values 0))
                    (fun ha hi h => False.elim ha) (Eq.symm h) ha
                    (Eq.mp
                      (Eq.trans (Option.some.injEq (some (Ty.base Benitoite.Release.BaseTy.integer).list) (some a))
                        (Option.some.injEq (Ty.base Benitoite.Release.BaseTy.integer).list a))
                      hi))
                (Eq.refl a)
                (HEq.refl
                  (Eq.mp
                    (Eq.trans (Option.some.injEq (some (Ty.base Benitoite.Release.BaseTy.integer).list) (some a))
                      (Option.some.injEq (Ty.base Benitoite.Release.BaseTy.integer).list a))
                    hi)))
            (Eq.symm h) hi)
        (fun i_1 h =>
          Eq.ndrec (motive := fun i =>
            [some (Ty.base Benitoite.Release.BaseTy.integer).list][i]? = some (some a) →
              termSorted [] ({ types := Ty.tvar, rows := [], ranges := [], values := fun x => t }.values i))
            (fun hi =>
              False.elim
                (Eq.mp
                  (Eq.trans
                    (congrFun'
                      (congrArg Eq
                        (getElem?_neg [some (Ty.base Benitoite.Release.BaseTy.integer).list] (i_1 + 1)
                          (of_eq_true
                            (Eq.trans
                              (congrArg Not
                                (Eq.trans
                                  (Eq.trans (congrArg (LT.lt (i_1 + 1)) (Nat.zero_add 1)) Nat.lt_one_iff._simp_1)
                                  (Eq.trans Nat.add_eq_zero_iff._simp_1
                                    (Eq.trans (congrArg (And (i_1 = 0)) (Nat.succ_ne_self._simp_1 0))
                                      (and_false (i_1 = 0))))))
                              not_false_eq_true))))
                      (some (some a)))
                    (eq_false' fun h => False.elim (noConfusion_of_Nat Option.ctorIdx h)))
                  hi))
            (Eq.symm h) hi)
        (Eq.refl i),
    facts := fun p hp =>
      False.elim
        (Eq.mp
          (Eq.trans
            (congrFun'
              (congrArg Membership.mem
                (Eq.trans
                  (congrFun'
                    (congrArg HAppend.hAppend
                      (Eq.trans
                        (Eq.trans
                          (congrArg
                            (List.flatMap fun x =>
                              match x.fst with
                              | none => []
                              | some a => List.map (fun p => p.open (Term.var x.snd)) a.assume)
                            (congrArg (List.cons (some (Ty.base Benitoite.Release.BaseTy.integer).list, 0))
                              (congrArg (@List.zipIdx (Option Ty) []) (Nat.zero_add 1))))
                          List.flatMap_cons)
                        (Eq.trans (congr (congrArg HAppend.hAppend List.map_nil) List.flatMap_nil)
                          (List.append_nil []))))
                    [])
                  (List.append_nil [])))
              p)
            List.not_mem_nil._simp_1)
          hp) };
this : ∀ (t : Term),
  Transport { types := Ty.tvar, rows := [], ranges := [], values := fun x => t }
    [some (Ty.base Benitoite.Release.BaseTy.integer).list] [] [] []
