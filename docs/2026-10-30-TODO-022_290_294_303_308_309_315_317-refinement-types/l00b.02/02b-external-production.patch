+import Benitoite.Release.Refinement.Admissible
+
+/-!
+# 外部宣言の有限な表と受け渡す型
+
+名目IDと成分内のresourceの対応を保ち、所有権ヒープは表現しない。
+型の展開は有限な導出と全構成子の有限列で検査する。有限の同名の入れ子は除外しない。
+-/
+namespace Benitoite.Release.Refinement
+noncomputable section
+
+def typeEnv (ts : List Ty) : SubstEnv := typeEnvAt 0 ts []
+
+/-- 外部ABIに渡せる基本型。Unitは結果位置で別に認める。 -/
+def ExternalScalar : BaseTy → Prop
+  | .integer | .integer8 | .integer16 | .integer32 | .unsignedInteger16
+  | .unsignedInteger32 | .unsignedInteger64 | .byte | .float | .float32
+  | .boolean | .character | .string => True
+  | _ => False
+
+/-- 篩はABIの鍵のcarrierを変えない。浮動小数と複合型は鍵として渡さない。 -/
+def ExternalMapKey : Ty → Prop
+  | .base b => ExternalScalar b ∧ b ≠ .float ∧ b ≠ .float32
+  | .refined a _ => ExternalMapKey a
+  | _ => False
+
+/-- 有限に展開できる受渡し型。ABIのUnitの省略等の細部は交換側で照合する。 -/
+inductive ExternalValueType (P : Program) (component : ComponentId) : Bool → Ty → Prop where
+  | scalar {unit b} : ExternalScalar b → ExternalValueType P component unit (.base b)
+  | unit : ExternalValueType P component true (.base .unit)
+  | bytes {unit} : ExternalValueType P component unit .bytes
+  | handle {unit id ts td} : P.externalType id = some td → td.component = component →
+      td.id = id → td.arity = 0 → ts = [] → ExternalValueType P component unit (.external id ts)
+  | list {unit a} : ExternalValueType P component false a → ExternalValueType P component unit (.list a)
+  | map {unit k v} : ExternalMapKey k → ExternalValueType P component false v →
+      ExternalValueType P component unit (.map k v)
+  | flags {unit d ts} (cs : List ConName) : cs.Nodup → 1 ≤ cs.length → cs.length ≤ 32 →
+      (∀ c, c ∈ cs ↔ ∃ cd, P.cons c = some cd ∧ cd.data = d) → P.DataArity d ts.length →
+      (∀ c cd, P.cons c = some cd → cd.data = d → cd.args = []) →
+      ExternalValueType P component unit (.set (.data d ts))
+  | data {unit d ts} (cs : List ConName) : cs.Nodup → cs ≠ [] →
+      (∀ c, c ∈ cs ↔ ∃ cd, P.cons c = some cd ∧ cd.data = d) → P.DataArity d ts.length →
+      (∀ c cd, P.cons c = some cd → cd.data = d →
+        ∀ a ∈ cd.args, ExternalValueType P component true (a.subst ts [])) →
+      ExternalValueType P component unit (.data d ts)
+  | refined {unit a p} : ExternalValueType P component unit a →
+      ExternalValueType P component unit (.refined a p)
+
+/-- usesの過不足を検査するための、型の全入れ子にある外部型の出現。 -/
+inductive ExternalOccurrence (P : Program) : Ty → List ExternalPathStep → ExternalId → Prop where
+  | root {id ts} : ExternalOccurrence P (.external id ts) [] id
+  | element {a path id} : ExternalOccurrence P a path id → ExternalOccurrence P (.list a) (.element :: path) id
+  | key {a b path id} : ExternalOccurrence P a path id → ExternalOccurrence P (.map a b) (.key :: path) id
+  | value {a b path id} : ExternalOccurrence P b path id → ExternalOccurrence P (.map a b) (.value :: path) id
+  | field {d ts c cd i a path id} : P.cons c = some cd → cd.data = d → cd.ntys = ts.length →
+      cd.args[i]? = some a → ExternalOccurrence P (a.subst ts []) path id →
+      ExternalOccurrence P (.data d ts) (.field c i :: path) id
+  | refined {a p path id} : ExternalOccurrence P a path id → ExternalOccurrence P (.refined a p) path id
+
+/-- Telの宣言順の番号と結果位置を保持する。 -/
+inductive ExternalUseAt (P : Program) : Nat → Tel → ExternalUse → Prop where
+  | argument {n name a rest path id} : ExternalOccurrence P a path id →
+      ExternalUseAt P n (.param name a rest) ⟨.argument n, path, .borrow, id⟩
+  | next {n name a rest use} : ExternalUseAt P (n+1) rest use →
+      ExternalUseAt P n (.param name a rest) use
+  | result {n a e path id} : ExternalOccurrence P a path id →
+      ExternalUseAt P n (.done a e) ⟨.result, path, .own, id⟩
+
+inductive ExternalTelWF (P : Program) (component : ComponentId) (effect : Eff) : Tel → Prop where
+  | done {a e} : ExternalValueType P component true a → e = effect →
+      ExternalTelWF P component effect (.done a e)
+  | param {name a rest} : ExternalValueType P component false a →
+      ExternalTelWF P component effect rest → ExternalTelWF P component effect (.param name a rest)
+
+structure ExternalSignature.WF (P : Program) (d : ExternalSignature) : Prop where
+  monomorphic : d.tparams = []
+  kinds : d.kinds = []
+  annotation : Ty.Annotation P [] [] (.dependentFn d.parameters)
+  kinded : Ty.HasKind P [] (.dependentFn d.parameters) .value
+  uses_exact : ∀ use, use ∈ d.uses ↔ ExternalUseAt P 0 d.parameters use
+  uses_unique : d.uses.Nodup
+  shape : ExternalTelWF P d.component (if d.uses = [] then Eff.empty else (EffR.mk (fun a => match a with | .name n (.fixed .top) => decide (n = stateEff) | _ => false) [])) d.parameters
+
+structure Program.ExternalWF (P : Program) : Prop where
+  unique : (P.externals.map Prod.fst).Nodup
+  keys : ∀ key decl, (key, decl) ∈ P.externals → match key, decl with
+    | .type id, .type td => td.id = id ∧ td.arity = 0
+    | .function id, .function id' d => id = id' ∧ ExternalSignature.WF P d
+    | _, _ => False
+
+private theorem externalLookup_mem {P : Program} {key : ExternalKey} {decl : ExternalDecl}
+    (h : P.externals.lookup key = some decl) : (key, decl) ∈ P.externals := by
+  obtain ⟨l₁, l₂, he, _⟩ := List.lookup_eq_some_iff.mp h
+  rw [he]
+  exact List.mem_append_right _ (List.mem_cons_self)
+
+theorem Program.ExternalWF.type_lookup {P : Program} (hw : P.ExternalWF) {id td}
+    (h : P.externalType id = some td) : td.id = id ∧ td.arity = 0 := by
+  unfold Program.externalType at h
+  cases he : P.externals.lookup (.type id) with
+  | none => simp [he] at h
+  | some decl =>
+    cases decl with
+    | type d =>
+      simp only [he, Option.some.injEq] at h
+      cases h
+      exact hw.keys _ _ (externalLookup_mem he)
+    | function _ _ => simp [he] at h
+
+theorem Program.ExternalWF.function_lookup {P : Program} (hw : P.ExternalWF) {f d}
+    (h : P.externalFunction f = some d) : d.WF P := by
+  unfold Program.externalFunction at h
+  cases he : P.externals.lookup (.function f) with
+  | none => simp [he] at h
+  | some decl =>
+    cases decl with
+    | type _ => simp [he] at h
+    | function id sg =>
+      simp only [he, Option.some.injEq] at h
+      cases h
+      exact (hw.keys _ _ (externalLookup_mem he)).2
+
+/-- 宣言は単相であるが、コアの呼出しは型引数の個数・kind・制約を明示して照合する。 -/
+structure ExternalCallAdmissible (P : Program) (B : Builtins) (C : List TParam)
+    (d : ExternalSignature) (ts : List Ty) : Prop where
+  count : ts.length = d.tparams.length
+  kinds : TypeArgsKinded P C ts d.kinds
+  constraints : SatAll B C ts d.tparams
+  types : TypeAnnotations P C [] ts
+
+theorem ExternalCallAdmissible.types_nil {P B C d ts} (h : ExternalCallAdmissible P B C d ts)
+    (hw : d.WF P) : ts = [] := by
+  have := h.count
+  rw [hw.monomorphic] at this
+  exact List.eq_nil_of_length_eq_zero this
+
+theorem ExternalCallAdmissible.map {P B C d ts} (h : ExternalCallAdmissible P B C d ts)
+    (hw : d.WF P) (g : Ty → Ty) : ExternalCallAdmissible P B C d (ts.map g) := by
+  rw [h.types_nil hw] at *
+  exact h
+
+end
+end Benitoite.Release.Refinement
--- before/formal/Benitoite/Release/Refinement/ExternalResponse.lean
+++ after/formal/Benitoite/Release/Refinement/ExternalResponse.lean
@@ -0,0 +1,40 @@
+import Benitoite.Release.Refinement.Typing
+import Benitoite.Release.Refinement.Ground
+
+/-!
+# 外部応答の型付き入力と三つの信頼条件
+
+errは実行時エラー、exitは外部応答では禁止する。正常応答の存在と決定性は要求しない。
+-/
+namespace Benitoite.Release.Refinement
+
+noncomputable def ExternalSignature.instantiate (d : ExternalSignature) (ts : List Ty) (vs : List Val) :
+    Option (Ty × Eff) :=
+  if ts.length = d.tparams.length then Tel.instantiate (Tel.bind (typeEnv ts) d.parameters) vs else none
+
+structure ExternalArgs (P : Program) (B : Builtins) (Ψ : StoreTy) (d : ExternalSignature)
+    (ts : List Ty) (vs : List Val) (a : Ty) (e : Eff) : Prop where
+  admissible : ExternalCallAdmissible P B [] d ts
+  arguments : HasTypeTelArgsQ P B Ψ Qempty [] [] [] vs (Tel.bind (typeEnv ts) d.parameters) a e
+  ground : ∀ v ∈ vs, v.Ground
+  types : ∀ t ∈ ts, t.WF 0 0 0 ∧ t.Canonical
+  result : a.WF 0 0 0 ∧ a.Canonical
+  effect : Eff.WF 0 0 0 e ∧ e.Canonical
+
+def Outcome.Typed (P : Program) (B : Builtins) (Ψ : StoreTy) (out : Outcome) (a : Ty) : Prop :=
+  match out with
+  | .val v => HasTypeV P B Ψ [] [] [] v a ∧ v.Ground
+  | .err _ | .exit _ => True
+
+structure Builtins.ExternalAssumptions (P : Program) (B : Builtins) : Prop where
+  external_typed : ∀ Ψ f d ts vs a e out obs,
+    P.ExternalWF → P.externalFunction f = some d → ExternalArgs P B Ψ d ts vs a e →
+    B.externalResponse f ts vs out obs → Outcome.Typed P B Ψ out a ∧ (∀ n : Int, out ≠ .exit n)
+  external_exists : ∀ Ψ f d ts vs a e,
+    P.ExternalWF → P.externalFunction f = some d → ExternalArgs P B Ψ d ts vs a e →
+    ∃ out obs, B.externalResponse f ts vs out obs
+  external_no_targets : ∀ Ψ f d ts vs a e out obs,
+    P.ExternalWF → P.externalFunction f = some d → ExternalArgs P B Ψ d ts vs a e →
+    B.externalResponse f ts vs out obs → obs = []
+
+end Benitoite.Release.Refinement
--- before/formal/Benitoite/Release/Refinement/Ground.lean
+++ after/formal/Benitoite/Release/Refinement/Ground.lean
@@ -0,0 +1,75 @@
+import Benitoite.Release.Refinement.Admissible
+
+/-!
+# 実引数と応答の閉性
+
+型・行・範囲・値の自由変数を構文で検査する。場所番号と名目IDは束縛変数ではない。
+-/
+namespace Benitoite.Release.Refinement
+
+private def localBound (n : Nat) : LocalRef → Prop
+  | .bound i => i < n
+  | .loc _ => True
+private def builderBound (nt n : Nat) : BuilderKind → Prop
+  | .list a => a.WF 0 nt n
+  | _ => True
+
+mutual
+  def Val.ClosedAt (nt nv : Nat) : Val → Prop
+    | .var i => i < nv
+    | .const _ | .loc _ | .bytesV _ | .checked _ => True
+    | .fnRef _ ts es => (∀ a ∈ ts, a.WF 0 nt nv) ∧ (∀ e ∈ es, Eff.WF 0 nt nv e ∧ e.Canonical)
+    | .prim _ ts es rs => (∀ a ∈ ts, a.WF 0 nt nv) ∧
+        (∀ e ∈ es, Eff.WF 0 nt nv e ∧ e.Canonical) ∧ (∀ r ∈ rs, r.WF)
+    | .externalRef _ ts | .externalHandle _ ts => ∀ a ∈ ts, a.WF 0 nt nv
+    | .lam ns ps body => NamesWF ns ps ∧ (∀ a ∈ ps, a.WF 0 nt nv) ∧
+        Comp.ClosedAt nt (nv + ps.length) body
+    | .dependentLam t body => Tel.WF 0 nt nv t ∧ Comp.ClosedAt nt (nv + telBinders t) body
+    | .closure t q => Tel.WF 0 0 0 t ∧ Closure.ClosedAt (telBinders t) q
+    | .con _ ts vs | .dict _ ts vs => (∀ a ∈ ts, a.WF 0 nt nv) ∧ Val.ClosedList nt nv vs
+    | .list vs | .setV vs => Val.ClosedList nt nv vs
+    | .op _ ts => ∀ a ∈ ts, a.WF 0 nt nv
+    | .raise a e => a.WF 0 nt nv ∧ e.WF 0 nt nv
+    | .mapV ks vs => Val.ClosedList nt nv ks ∧ Val.ClosedList nt nv vs
+    | .super v _ => v.ClosedAt nt nv
+    | .checkedRequest _ req => req.ClosedAt 0 0
+  def Val.ClosedList (nt nv : Nat) : List Val → Prop
+    | [] => True
+    | v :: vs => v.ClosedAt nt nv ∧ Val.ClosedList nt nv vs
+  def Comp.ClosedAt (nt nv : Nat) : Comp → Prop
+    | .builderLet b m => builderBound nt nv b ∧ m.ClosedAt nt (nv+1)
+    | .builderOp b _ r vs => builderBound nt nv b ∧ localBound nv r ∧ Val.ClosedList nt nv vs
+    | .ret v | .escape v => v.ClosedAt nt nv
+    | .letIn m n => m.ClosedAt nt nv ∧ n.ClosedAt nt (nv+1)
+    | .app v vs => v.ClosedAt nt nv ∧ Val.ClosedList nt nv vs
+    | .ite v m n => v.ClosedAt nt nv ∧ m.ClosedAt nt nv ∧ n.ClosedAt nt nv
+    | .match v arms => v.ClosedAt nt nv ∧ Arm.ClosedList nt nv arms
+    | .lazyC m => m.ClosedAt nt nv
+    | .use v m => v.ClosedAt nt nv ∧ m.ClosedAt nt nv
+    | .handle m cs => m.ClosedAt nt nv ∧ Clause.ClosedList nt nv cs
+    | .resume k v => k.ClosedAt nt nv ∧ v.ClosedAt nt nv
+    | .meth v _ ts es vs => v.ClosedAt nt nv ∧ (∀ a ∈ ts, a.WF 0 nt nv) ∧
+        (∀ e ∈ es, Eff.WF 0 nt nv e ∧ e.Canonical) ∧ Val.ClosedList nt nv vs
+    | .externalCall _ ts vs => (∀ a ∈ ts, a.WF 0 nt nv) ∧ Val.ClosedList nt nv vs
+  def Arm.ClosedList (nt nv : Nat) : List Arm → Prop
+    | [] => True
+    | .mk alts guard body :: arms =>
+        (match guard with | none => True | some g => g.ClosedAt nt (nv + Benitoite.Release.Arm.bindersOf alts)) ∧
+        body.ClosedAt nt (nv + Benitoite.Release.Arm.bindersOf alts) ∧ Arm.ClosedList nt nv arms
+  def Clause.ClosedList (nt nv : Nat) : List Clause → Prop
+    | [] => True
+    | .mk _ arity ntys body :: cs => body.ClosedAt (nt+ntys) (nv+arity+1) ∧ Clause.ClosedList nt nv cs
+    | .fail e body :: cs => e.WF 0 nt nv ∧ body.ClosedAt (nt+1) (nv+2) ∧ Clause.ClosedList nt nv cs
+  def Capture.Closed : Capture → Prop
+    | .mk vs => captureSlotsClosed vs
+  def captureSlotsClosed : List (Option Val) → Prop
+    | [] => True
+    | none :: vs => captureSlotsClosed vs
+    | some v :: vs => v.ClosedAt 0 0 ∧ captureSlotsClosed vs
+  def Closure.ClosedAt (inputs : Nat) : Closure → Prop
+    | .mk cap m => cap.Closed ∧ m.ClosedAt 0 (cap.values.length + inputs)
+end
+
+def Val.Ground (v : Val) : Prop := v.ClosedAt 0 0
+
+end Benitoite.Release.Refinement
--- before/formal/Benitoite/Release/Refinement/MethodArguments.lean
+++ after/formal/Benitoite/Release/Refinement/MethodArguments.lean
@@ -54,6 +54,42 @@
 theorem Tel.bind_done (r e θ) : Tel.bind θ (.done r e) = .done (r.bind θ) (Eff.bind θ e) := rfl
 
 /-- 部分観測のNoneを保ったまま、逐次具体化と外側の値置換を交換する。 -/
+theorem Tel.bind_norm (t : Tel) (θ : SubstEnv) : Tel.bind θ t.norm = Tel.bind θ t := Tel.norm_rawBind θ t
+
+theorem Tel.bind_renaming (t : Tel) (k c : Nat) :
+    Tel.bind (renEnv (shiftIndex k c)) t = (Tel.shiftV k c t).norm := by
+  rw [Tel.shiftV_eq_rawBind]
+  rfl
+
+/-- paramの一束縛を除く具体化と、外側の単調な移動の交換。 -/
+theorem Tel.open_shift (t : Tel) (v : Val) (k c : Nat) :
+    Tel.bind (Tel.argumentsEnv (v.rename (shiftIndex k c))) (Tel.shiftV k (c+1) t) =
+      Tel.shiftV k c (Tel.bind (Tel.argumentsEnv v) t) := by
+  have hh := Tel.bind_open_exchange t (renEnv (shiftIndex k c)).values v.toTerm?
+  have hv : (v.rename (shiftIndex k c)).toTerm? =
+      v.toTerm?.bind (termBind? (renEnv (shiftIndex k c)).values) := by
+    rw [Val.toTerm_rename]
+    cases v.toTerm? <;> simp [renEnv, termBind?_renaming]
+  have hup : SubstEnv.valuesOnly (upValues (renEnv (shiftIndex k c)).values) =
+      renEnv (shiftIndex k (c+1)) := by
+    rw [renEnv_values, upValues_shiftIndex]
+    rfl
+  rw [hup, Tel.bind_renaming, Tel.bind_norm] at hh
+  rw [← argumentsEnv_eq] at hh
+  change Tel.bind (renEnv (shiftIndex k c)) (Tel.bind (Tel.argumentsEnv v) t) = _ at hh
+  rw [Tel.bind_renaming, Tel.norm_shiftV] at hh
+  have hn : (Tel.bind (Tel.argumentsEnv v) t).norm = Tel.bind (Tel.argumentsEnv v) t := Tel.norm_idem _
+  rw [hn] at hh
+  rw [argumentsEnv_eq, hv]
+  exact hh.symm
